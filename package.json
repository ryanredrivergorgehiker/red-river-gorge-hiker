{
  "name": "red-river-gorge-hiker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run generate:route-elevation && npm run build:site",
    "preview": "astro preview",
    "validate": "tsx scripts/validate-products.ts",
    "test": "python3 -m unittest discover -s tests -p \"test*.py\" -v",
    "check": "npm run generate:route-elevation && astro check && npm test && npm run build:site",
    "generate:route-elevation": "node scripts/generate-route-elevation.mjs",
    "validate:routes": "node scripts/validate-routes.mjs",
    "build:site": "npm run validate && npm run validate:routes && astro build"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.5",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
