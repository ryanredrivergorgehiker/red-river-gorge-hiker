---
interface Props {
  title: string;
  catalogId: string;
  alt?: string;
  eager?: boolean;
}

const { title, catalogId, alt, eager = false } = Astro.props;
const accessibleDescription = alt ?? `Approved photograph unavailable: ${title}`;
---
<figure
  class="artwork unavailable"
  data-artwork
  data-loading={eager ? 'eager' : 'lazy'}
  oncontextmenu="return false"
>
  <div class="asset-note" role="img" aria-label={accessibleDescription}>
    <span>{catalogId}</span>
    <strong>Approved watermarked image pending</strong>
    <small>No substitute image is shown.</small>
  </div>
  <div class="art-overlay" aria-hidden="true"></div>
  <figcaption>{title} · Photography by Ryan D. Lewis</figcaption>
</figure>
<script>
  document.querySelectorAll('[data-artwork]').forEach((element) => {
    element.addEventListener('dragstart', (event) => event.preventDefault());
  });
</script>
