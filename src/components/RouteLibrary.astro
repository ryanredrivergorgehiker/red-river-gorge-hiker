---
import '../styles/routes.css';

interface RouteCard {
  slug: string;
  title: string;
  publicationClass: 'A' | 'B' | 'C';
  routeCategory: 'day-hike' | 'backpacking' | 'off-trail';
  internalTrailContext: string;
  shape: string;
  distanceMi: number;
  physicalDifficulty: string;
  navigationDifficulty: string;
  lastInformationReview: string;
}

interface Props { routes: RouteCard[]; }

const { routes } = Astro.props;
const base = import.meta.env.BASE_URL;
const routeCategoryLabel = (category: RouteCard['routeCategory']) => ({
  'day-hike': 'Day hike',
  backpacking: 'Backpacking',
  'off-trail': 'Off-trail'
}[category]);
---
<section class="route-library" data-route-library>
  <div class="route-library-controls">
    <label>Search routes
      <input type="search" data-route-search placeholder="Search by route name" />
    </label>
    <fieldset class="route-library-category-filter">
      <legend>Route category</legend>
      <div class="route-library-category-options">
        <label><input type="checkbox" data-route-category-filter="day-hike" checked /> Day hikes</label>
        <label><input type="checkbox" data-route-category-filter="backpacking" checked /> Backpacking</label>
        <label><input type="checkbox" data-route-category-filter="off-trail" checked /> Off-trail</label>
      </div>
    </fieldset>
  </div>

  <p class="route-library-count" aria-live="polite" data-route-count>{routes.length} route{routes.length === 1 ? '' : 's'}</p>

  <div class="route-card-grid">
    {routes.map((route) => (
      <article
        class="route-card"
        data-route-card
        data-title={route.title.toLowerCase()}
        data-category={route.routeCategory}
      >
        <p class="eyebrow">{routeCategoryLabel(route.routeCategory)} · {route.internalTrailContext}</p>
        <h2><a href={base + 'routes/' + route.slug + '/'}>{route.title}</a></h2>
        <dl class="route-card-facts">
          <div><dt>Distance</dt><dd>{route.distanceMi.toFixed(2)} mi</dd></div>
          <div><dt>Category</dt><dd>{routeCategoryLabel(route.routeCategory)}</dd></div>
          <div><dt>Trail context</dt><dd>{route.internalTrailContext}</dd></div>
          <div><dt>Shape</dt><dd>{route.shape}</dd></div>
          <div><dt>Difficulty</dt><dd>{route.physicalDifficulty}</dd></div>
        </dl>
        <p>{route.navigationDifficulty}</p>
        <p class="route-small">Information reviewed {route.lastInformationReview}.</p>
        <a class="route-text-link" href={base + 'routes/' + route.slug + '/'}>View route →</a>
      </article>
    ))}
  </div>

  <p class="route-library-empty" data-route-empty hidden>No routes match those filters.</p>
</section>

<script>
  for (const library of document.querySelectorAll<HTMLElement>('[data-route-library]')) {
    const search = library.querySelector<HTMLInputElement>('[data-route-search]');
    const categoryInputs = Array.from(library.querySelectorAll<HTMLInputElement>('[data-route-category-filter]'));
    const cards = Array.from(library.querySelectorAll<HTMLElement>('[data-route-card]'));
    const count = library.querySelector<HTMLElement>('[data-route-count]');
    const empty = library.querySelector<HTMLElement>('[data-route-empty]');

    const apply = () => {
      const query = search?.value.trim().toLowerCase() ?? '';
      const enabledCategories = new Set(
        categoryInputs.filter((input) => input.checked).map((input) => input.dataset.routeCategoryFilter)
      );
      let visible = 0;

      for (const card of cards) {
        const category = card.dataset.category;
        const show = (!query || card.dataset.title?.includes(query))
          && Boolean(category && enabledCategories.has(category));

        card.hidden = !show;
        if (show) visible += 1;
      }

      if (count) count.textContent = visible + ' route' + (visible === 1 ? '' : 's');
      if (empty) empty.hidden = visible !== 0;
    };

    search?.addEventListener('input', apply);
    categoryInputs.forEach((input) => input.addEventListener('change', apply));
  }
</script>
