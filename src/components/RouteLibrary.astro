---
import '../styles/routes.css';
interface RouteCard {
  slug: string;
  title: string;
  publicationClass: 'A' | 'B' | 'C';
  tripType: 'day-hike' | 'backpacking' | 'multi-day';
  trailStatus: 'official' | 'mixed' | 'off-trail';
  trailStatusDisplay: string;
  shape: string;
  distanceMi: number;
  physicalDifficulty: string;
  navigationDifficulty: string;
  lastInformationReview: string;
}
interface Props { routes: RouteCard[]; }
const { routes } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<section class="route-library" data-route-library>
  <div class="route-library-controls">
    <label>Search routes
      <input type="search" data-route-search placeholder="Search by route name" />
    </label>
    <label>Trip type
      <select data-route-trip>
        <option value="">All trip types</option>
        <option value="day-hike">Day hikes</option>
        <option value="backpacking">Backpacking</option>
        <option value="multi-day">Multi-day</option>
      </select>
    </label>
    <label>Trail status
      <select data-route-status>
        <option value="">All trail types</option>
        <option value="official">Official / on-trail</option>
        <option value="mixed">Mixed</option>
        <option value="off-trail">Selected off-trail</option>
      </select>
    </label>
  </div>
  <p class="route-library-count" aria-live="polite" data-route-count>{routes.length} route{routes.length === 1 ? '' : 's'}</p>
  <div class="route-card-grid">
    {routes.map((route) => (
      <article
        class="route-card"
        data-route-card
        data-title={route.title.toLowerCase()}
        data-trip={route.tripType}
        data-status={route.trailStatus}
      >
        <p class="eyebrow">Class {route.publicationClass} · {route.tripType.replace('-', ' ')}</p>
        <h2><a href={`${base}routes/${route.slug}/`}>{route.title}</a></h2>
        <dl class="route-card-facts">
          <div><dt>Distance</dt><dd>{route.distanceMi.toFixed(2)} mi</dd></div>
          <div><dt>Trail</dt><dd>{route.trailStatusDisplay}</dd></div>
          <div><dt>Shape</dt><dd>{route.shape}</dd></div>
          <div><dt>Difficulty</dt><dd>{route.physicalDifficulty}</dd></div>
        </dl>
        <p>{route.navigationDifficulty}</p>
        <p class="route-small">Information reviewed {route.lastInformationReview}.</p>
        <a class="route-text-link" href={`${base}routes/${route.slug}/`}>View route →</a>
      </article>
    ))}
  </div>
  <p class="route-library-empty" data-route-empty hidden>No approved routes match those filters.</p>
</section>
<script>
  for (const library of document.querySelectorAll<HTMLElement>('[data-route-library]')) {
    const search = library.querySelector<HTMLInputElement>('[data-route-search]');
    const trip = library.querySelector<HTMLSelectElement>('[data-route-trip]');
    const status = library.querySelector<HTMLSelectElement>('[data-route-status]');
    const cards = Array.from(library.querySelectorAll<HTMLElement>('[data-route-card]'));
    const count = library.querySelector<HTMLElement>('[data-route-count]');
    const empty = library.querySelector<HTMLElement>('[data-route-empty]');
    const apply = () => {
      const query = search?.value.trim().toLowerCase() ?? '';
      let visible = 0;
      for (const card of cards) {
        const show = (!query || card.dataset.title?.includes(query))
          && (!trip?.value || card.dataset.trip === trip.value)
          && (!status?.value || card.dataset.status === status.value);
        card.hidden = !show;
        if (show) visible += 1;
      }
      if (count) count.textContent = `${visible} route${visible === 1 ? '' : 's'}`;
      if (empty) empty.hidden = visible !== 0;
    };
    search?.addEventListener('input', apply);
    trip?.addEventListener('change', apply);
    status?.addEventListener('change', apply);
  }
</script>
