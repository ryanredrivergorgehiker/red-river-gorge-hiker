---
const measurementId = 'G-HM48NST64P';
const pinterestTagId = '2613133188222';
const siteHostname = Astro.site ? new URL(Astro.site).hostname : '';
// Keep staging debug selection at build time; do not restore runtime window.location.hostname.endsWith('github.io') behavior.
const gaConfig = {
  send_page_view: true,
  allow_google_signals: false,
  allow_ad_personalization_signals: false,
  ...(siteHostname.endsWith('github.io') ? { debug_mode: true } : {}),
};
---

<span
  data-rrgh-analytics-controller
  data-measurement-id={measurementId}
  data-pinterest-tag-id={pinterestTagId}
  hidden
></span>

<script define:vars={{ gaConfig }}>
  (() => {
    const controller = document.querySelector('[data-rrgh-analytics-controller]');
    if (!controller) return;

    const measurementId = controller.getAttribute('data-measurement-id');
    const pinterestTagId = controller.getAttribute('data-pinterest-tag-id');
    if (!measurementId) return;

    const sharedCookieName = 'rrgh-analytics-consent-v1';
    const regionCookieName = 'rrgh-region-country-v1';
    const currentLocalStorageKey = 'rrgh-analytics-consent-v2';
    const legacyLocalStorageKey = 'rrgh-analytics-consent-v1';
    const rrghGaCookieName = '_ga_HM48NST64P';
    const oneYearSeconds = 60 * 60 * 24 * 365;
    const oneHourSeconds = 60 * 60;
    const cloudflareCountryEndpoint = 'https://one.one.one.one/cdn-cgi/trace';

    const consentRequired = {
      'austria': 1,
      'belgium': 1,
      'bulgaria': 1,
      'croatia': 1,
      'cyprus': 1,
      'czechia': 1,
      'czech republic': 1,
      'denmark': 1,
      'estonia': 1,
      'finland': 1,
      'france': 1,
      'germany': 1,
      'greece': 1,
      'hungary': 1,
      'ireland': 1,
      'italy': 1,
      'latvia': 1,
      'lithuania': 1,
      'luxembourg': 1,
      'malta': 1,
      'netherlands': 1,
      'poland': 1,
      'portugal': 1,
      'romania': 1,
      'slovakia': 1,
      'slovenia': 1,
      'spain': 1,
      'sweden': 1,
      'iceland': 1,
      'liechtenstein': 1,
      'norway': 1,
      'united kingdom': 1,
      'great britain': 1,
      'switzerland': 1
    };
    const consentRequiredCodes = {
      'at': 1, 'be': 1, 'bg': 1, 'hr': 1, 'cy': 1, 'cz': 1, 'dk': 1,
      'ee': 1, 'fi': 1, 'fr': 1, 'de': 1, 'gr': 1, 'hu': 1, 'ie': 1,
      'it': 1, 'lv': 1, 'lt': 1, 'lu': 1, 'mt': 1, 'nl': 1, 'pl': 1,
      'pt': 1, 'ro': 1, 'sk': 1, 'si': 1, 'es': 1, 'se': 1, 'is': 1,
      'li': 1, 'no': 1, 'gb': 1, 'ch': 1
    };
    const approvedDefaultOn = {
      'united states': 1,
      'united states of america': 1
    };
    const approvedDefaultOnCodes = { 'us': 1 };

    const toggleControls = Array.from(document.querySelectorAll('[data-rrgh-analytics-toggle]'));
    let effectiveOn = false;
    let gaLoadStarted = false;
    let gaActuallyLoaded = false;
    let pinterestLoaded = false;

    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };

    window.gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied'
    });

    const readLocalChoice = (key) => {
      try { return window.localStorage.getItem(key); }
      catch { return null; }
    };

    const readCookieValue = (name) => {
      try {
        const prefix = `${name}=`;
        const entry = document.cookie
          .split(';')
          .map((part) => part.trim())
          .find((part) => part.startsWith(prefix));
        if (!entry) return null;
        return decodeURIComponent(entry.slice(prefix.length));
      } catch {
        return null;
      }
    };

    const normalizeCountrySignal = (value) => {
      if (!value) return null;
      const signal = String(value).trim().toLowerCase();
      if (!signal || signal.length > 80 || !/^[a-z][a-z .'-]*$/.test(signal)) return null;
      return signal;
    };

    const readSharedChoice = () => {
      const value = readCookieValue(sharedCookieName);
      return value === 'allowed' || value === 'declined' ? value : null;
    };

    const readBridgedCountry = () => normalizeCountrySignal(readCookieValue(regionCookieName));

    const rrghCookieDomainSuffix = () => {
      try {
        const hostname = window.location.hostname.toLowerCase();
        const onRrghDomain = hostname === 'redrivergorgehiker.com'
          || hostname === 'www.redrivergorgehiker.com'
          || hostname.endsWith('.redrivergorgehiker.com');
        return onRrghDomain ? '; Domain=.redrivergorgehiker.com' : '';
      } catch {
        return '';
      }
    };

    const writeSharedChoice = (choice) => {
      if (choice !== 'allowed' && choice !== 'declined') return false;
      try {
        document.cookie = `${sharedCookieName}=${encodeURIComponent(choice)}; Max-Age=${oneYearSeconds}; Path=/${rrghCookieDomainSuffix()}; Secure; SameSite=Lax`;
        return readSharedChoice() === choice;
      } catch {
        return false;
      }
    };

    const writeRegionCountry = (country) => {
      const signal = normalizeCountrySignal(country);
      if (!signal) return false;
      try {
        document.cookie = `${regionCookieName}=${encodeURIComponent(signal)}; Max-Age=${oneHourSeconds}; Path=/${rrghCookieDomainSuffix()}; Secure; SameSite=Lax`;
        return readBridgedCountry() === signal;
      } catch {
        return false;
      }
    };

    const migrateLegacyChoice = () => {
      const shared = readSharedChoice();
      if (shared) return shared;

      const current = readLocalChoice(currentLocalStorageKey);
      if (current === 'granted') {
        return writeSharedChoice('allowed') ? 'allowed' : null;
      }
      if (current === 'denied') {
        return writeSharedChoice('declined') ? 'declined' : null;
      }

      const legacy = readLocalChoice(legacyLocalStorageKey);
      if (legacy === 'denied') {
        return writeSharedChoice('declined') ? 'declined' : null;
      }

      // Older grants did not cover the current unified GA4 + Pinterest scope.
      return null;
    };

    const privacySignalRequiresOff = () => {
      try {
        return Boolean(window.navigator && Reflect.get(window.navigator, 'globalPrivacyControl') === true);
      } catch {
        return false;
      }
    };

    const showEffectiveState = (on, source) => {
      effectiveOn = Boolean(on);
      window.rrghAnalyticsEffectiveOn = effectiveOn;
      window.rrghAnalyticsEffectiveSource = source;
      toggleControls.forEach((control) => {
        control.textContent = effectiveOn ? 'RRGH Analytics: On' : 'RRGH Analytics: Off';
        control.setAttribute('aria-pressed', effectiveOn ? 'true' : 'false');
        control.setAttribute('data-effective-source', source);
      });
    };

    const clearRrghAnalyticsCookie = () => {
      const expired = 'expires=Thu, 01 Jan 1970 00:00:00 GMT; Max-Age=0; Path=/; Secure; SameSite=Lax';
      document.cookie = `${rrghGaCookieName}=; ${expired}`;
      document.cookie = `${rrghGaCookieName}=; ${expired}; Domain=.redrivergorgehiker.com`;
    };

    const loadGoogleAnalytics = () => {
      if (gaLoadStarted) return;
      gaLoadStarted = true;
      window.rrghAnalyticsGaLoaded = false;
      Reflect.set(window, `ga-disable-${measurementId}`, false);

      window.gtag('consent', 'update', {
        analytics_storage: 'granted',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
      script.addEventListener('load', () => {
        gaActuallyLoaded = true;
        window.rrghAnalyticsGaLoaded = true;
      });
      script.addEventListener('error', () => {
        gaActuallyLoaded = false;
        window.rrghAnalyticsGaLoaded = false;
      });
      document.head.appendChild(script);

      window.gtag('js', new Date());
      window.gtag('config', measurementId, gaConfig);
    };

    const loadPinterest = () => {
      if (pinterestLoaded || !pinterestTagId) return;
      pinterestLoaded = true;

      if (!window.pintrk) {
        window.pintrk = function () {
          window.pintrk.queue.push(Array.prototype.slice.call(arguments));
        };
        window.pintrk.queue = [];
        window.pintrk.version = '3.0';
      }

      window.pintrk('setconsent', true);
      window.pintrk('load', pinterestTagId);
      window.pintrk('page');
      window.pintrk('track', 'pagevisit');

      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://s.pinimg.com/ct/core.js';
      document.head.appendChild(script);
    };

    const turnMeasurementOn = (source) => {
      showEffectiveState(true, source);
      loadGoogleAnalytics();
      loadPinterest();
    };

    const turnMeasurementOff = (source, cleanup) => {
      showEffectiveState(false, source);
      Reflect.set(window, `ga-disable-${measurementId}`, true);
      window.gtag('consent', 'update', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
      if (window.pintrk) window.pintrk('setconsent', false);
      if (cleanup) clearRrghAnalyticsCookie();
    };

    const applyExplicitChoice = (choice) => {
      if (privacySignalRequiresOff()) {
        turnMeasurementOff('privacy-signal', true);
        return;
      }
      if (choice === 'declined') {
        turnMeasurementOff('explicit-declined', true);
        return;
      }
      if (choice === 'allowed') {
        turnMeasurementOn('explicit-allowed');
      }
    };

    const fetchCloudflareCountry = async () => {
      const response = await fetch(cloudflareCountryEndpoint, {
        credentials: 'omit',
        cache: 'no-store',
        mode: 'cors',
        referrerPolicy: 'no-referrer'
      });
      if (!response.ok) throw new Error(`Cloudflare country lookup failed: ${response.status}`);
      const text = await response.text();
      const match = text.match(/(?:^|\n)loc=([A-Z]{2})(?:\n|$)/);
      if (!match) throw new Error('Cloudflare country lookup did not return a valid country code');
      const country = normalizeCountrySignal(match[1]);
      if (!country) throw new Error('Cloudflare country code was invalid');
      writeRegionCountry(country);
      return country;
    };

    const determineAutomaticCountry = async () => {
      const bridged = readBridgedCountry();
      if (bridged) return { country: bridged, source: 'first-party-country-cookie' };
      const cloudflare = await fetchCloudflareCountry();
      return { country: cloudflare, source: 'cloudflare-country-lookup' };
    };

    const applyRegionalDefault = async () => {
      try {
        const resolved = await determineAutomaticCountry();
        const country = resolved.country;
        window.rrghAutomaticCountry = country;
        window.rrghAutomaticCountrySource = resolved.source;

        // Explicit choice or privacy signal may have changed while regional state was resolving.
        if (privacySignalRequiresOff()) {
          turnMeasurementOff('privacy-signal', true);
          return;
        }
        const latest = readSharedChoice();
        if (latest) {
          applyExplicitChoice(latest);
          return;
        }

        if (approvedDefaultOn[country] || approvedDefaultOnCodes[country]) {
          turnMeasurementOn('regional-default-on');
          return;
        }
        if (consentRequired[country] || consentRequiredCodes[country]) {
          turnMeasurementOff('consent-required', true);
          return;
        }
        turnMeasurementOff('unapproved-region', true);
      } catch {
        window.rrghAutomaticCountry = null;
        window.rrghAutomaticCountrySource = null;
        turnMeasurementOff('regional-error', true);
      }
    };

    const toggleAnalytics = () => {
      if (effectiveOn) {
        const hadLoadedMeasurement = gaLoadStarted || pinterestLoaded;
        writeSharedChoice('declined');
        turnMeasurementOff('explicit-declined', true);
        if (hadLoadedMeasurement) window.location.reload();
        return;
      }

      if (privacySignalRequiresOff()) {
        turnMeasurementOff('privacy-signal', true);
        return;
      }

      if (writeSharedChoice('allowed')) {
        turnMeasurementOn('explicit-allowed');
      } else {
        turnMeasurementOff('preference-storage-error', true);
      }
    };

    toggleControls.forEach((control) => {
      control.addEventListener('click', toggleAnalytics);
    });

    const trackStoreHandoff = (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const anchor = target.closest('a[href]');
      if (!(anchor instanceof HTMLAnchorElement)) return;

      let destination;
      try { destination = new URL(anchor.href, window.location.href); }
      catch { return; }

      if (destination.hostname.toLowerCase() !== 'store.redrivergorgehiker.com') return;
      if (!effectiveOn || !gaActuallyLoaded) return;

      const itemType = anchor.dataset.storeItemType;
      const itemSlug = anchor.dataset.storeItemSlug;
      const parameters = {
        link_url: destination.href,
        link_text: (anchor.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 200),
        source_path: window.location.pathname,
        ...(itemType ? { item_type: itemType } : {}),
        ...(itemSlug ? { item_slug: itemSlug } : {})
      };

      window.gtag('event', 'store_handoff_click', parameters);
    };

    document.addEventListener('click', trackStoreHandoff, { capture: true });

    const initialize = async () => {
      showEffectiveState(false, 'initializing');
      const explicitChoice = migrateLegacyChoice();

      if (privacySignalRequiresOff()) {
        turnMeasurementOff('privacy-signal', true);
        return;
      }
      if (explicitChoice) {
        applyExplicitChoice(explicitChoice);
        return;
      }

      await applyRegionalDefault();
    };

    void initialize();
  })();
</script>
