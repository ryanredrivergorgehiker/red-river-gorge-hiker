<script>
  import L from 'leaflet';
  import { mapSources } from '../data/map/layers';
  import {
    addLocalDays,
    buildTerrainHorizonProfile,
    buildTerrainSamplePoints,
    formatRrgDate,
    formatRrgTime,
    getAstronomicalSunDay,
    getTerrainDirectTimes,
    redRiverDateParts
  } from '../lib/sunlight';

  const formatDistance = (meters: number) => {
    const miles = meters / 1609.344;
    if (miles >= 0.1) return miles.toFixed(miles < 10 ? 2 : 1) + ' mi';
    return Math.round(meters * 3.28084).toLocaleString() + ' ft';
  };

  const toUtm = (lat: number, lon: number) => {
    const a = 6378137;
    const eccSquared = 0.00669438;
    const k0 = 0.9996;
    const zoneNumber = Math.floor((lon + 180) / 6) + 1;
    const longOrigin = (zoneNumber - 1) * 6 - 180 + 3;
    const latRad = lat * Math.PI / 180;
    const lonRad = lon * Math.PI / 180;
    const longOriginRad = longOrigin * Math.PI / 180;
    const eccPrimeSquared = eccSquared / (1 - eccSquared);
    const N = a / Math.sqrt(1 - eccSquared * Math.sin(latRad) * Math.sin(latRad));
    const T = Math.tan(latRad) * Math.tan(latRad);
    const C = eccPrimeSquared * Math.cos(latRad) * Math.cos(latRad);
    const A = Math.cos(latRad) * (lonRad - longOriginRad);
    const M = a * (
      (1 - eccSquared / 4 - 3 * eccSquared * eccSquared / 64 - 5 * eccSquared ** 3 / 256) * latRad
      - (3 * eccSquared / 8 + 3 * eccSquared * eccSquared / 32 + 45 * eccSquared ** 3 / 1024) * Math.sin(2 * latRad)
      + (15 * eccSquared * eccSquared / 256 + 45 * eccSquared ** 3 / 1024) * Math.sin(4 * latRad)
      - (35 * eccSquared ** 3 / 3072) * Math.sin(6 * latRad)
    );
    const easting = k0 * N * (
      A + (1 - T + C) * A ** 3 / 6
      + (5 - 18 * T + T * T + 72 * C - 58 * eccPrimeSquared) * A ** 5 / 120
    ) + 500000;
    let northing = k0 * (
      M + N * Math.tan(latRad) * (
        A * A / 2
        + (5 - T + 9 * C + 4 * C * C) * A ** 4 / 24
        + (61 - 58 * T + T * T + 600 * C - 330 * eccPrimeSquared) * A ** 6 / 720
      )
    );
    if (lat < 0) northing += 10000000;
    const bandLetters = 'CDEFGHJKLMNPQRSTUVWXX';
    const bandIndex = Math.max(0, Math.min(bandLetters.length - 1, Math.floor((lat + 80) / 8)));
    const band = bandLetters[bandIndex] ?? 'N';
    return zoneNumber + band + ' ' + Math.round(easting).toLocaleString() + ' m E · ' + Math.round(northing).toLocaleString() + ' m N';
  };

  const featureValue = (properties: Record<string, unknown> | undefined, names: string[]) => {
    if (!properties) return '';
    for (const name of names) {
      const value = properties[name];
      if (value !== undefined && value !== null && String(value).trim()) return String(value).trim();
      const found = Object.keys(properties).find((key) => key.toLowerCase() === name.toLowerCase());
      if (found && properties[found] !== undefined && properties[found] !== null && String(properties[found]).trim()) {
        return String(properties[found]).trim();
      }
    }
    return '';
  };

  const geometryLines = (geometry: any): number[][][] => {
    if (!geometry) return [];
    if (geometry.type === 'LineString') return [geometry.coordinates ?? []];
    if (geometry.type === 'MultiLineString') return geometry.coordinates ?? [];
    return [];
  };

  class MinHeap {
    items: Array<{ key: string; distance: number }> = [];

    push(item: { key: string; distance: number }) {
      this.items.push(item);
      let index = this.items.length - 1;
      while (index > 0) {
        const parent = Math.floor((index - 1) / 2);
        if (this.items[parent]!.distance <= this.items[index]!.distance) break;
        [this.items[parent], this.items[index]] = [this.items[index]!, this.items[parent]!];
        index = parent;
      }
    }

    pop() {
      if (!this.items.length) return undefined;
      const root = this.items[0];
      const last = this.items.pop();
      if (this.items.length && last) {
        this.items[0] = last;
        let index = 0;
        while (true) {
          const left = index * 2 + 1;
          const right = left + 1;
          let smallest = index;
          if (left < this.items.length && this.items[left]!.distance < this.items[smallest]!.distance) smallest = left;
          if (right < this.items.length && this.items[right]!.distance < this.items[smallest]!.distance) smallest = right;
          if (smallest === index) break;
          [this.items[index], this.items[smallest]] = [this.items[smallest]!, this.items[index]!];
          index = smallest;
        }
      }
      return root;
    }
  }

  const initializeMap = async (shell: HTMLElement) => {
    const container = shell.querySelector<HTMLElement>('[data-rrgh-route-map]');
    if (!container || container.dataset.loaded === 'true') return;
    container.dataset.loaded = 'true';

    const mode = container.dataset.mode ?? 'embedded';
    const routeConfigs = JSON.parse(container.dataset.routes ?? '[]');
    const status = shell.querySelector<HTMLElement>('[data-map-status]');
    const mobileStatus = shell.querySelector<HTMLElement>('[data-map-mobile-status]');
    const stage = shell.querySelector<HTMLElement>('.route-map-stage');
    const loadingOverlay = shell.querySelector<HTMLElement>('[data-map-loading]');
    const loadingProgress = shell.querySelector<HTMLElement>('[data-map-loading-progress]');
    const loadingPercent = shell.querySelector<HTMLElement>('[data-map-loading-percent]');
    const loadingLabel = shell.querySelector<HTMLElement>('[data-map-loading-label]');
    type MapActivityKind = 'watershed' | 'sunlight';
    const setMapActivity = (kind: MapActivityKind, loading: boolean) => {
      const indicator = shell.querySelector<HTMLElement>('[data-map-activity="' + kind + '"]');
      if (indicator) indicator.hidden = !loading;
      if (kind === 'watershed') container.dataset.watershedActivityVisible = loading ? 'true' : 'false';
      if (kind === 'sunlight') container.dataset.sunlightActivityVisible = loading ? 'true' : 'false';
    };
    setMapActivity('watershed', false);
    setMapActivity('sunlight', false);
    const fullscreenButtons = Array.from(shell.querySelectorAll<HTMLButtonElement>('[data-map-action="fullscreen"]'));
    let loadProgressValue = 0;
    const setLoadProgress = (value: number, label?: string) => {
      loadProgressValue = Math.max(loadProgressValue, Math.max(0, Math.min(100, Math.round(value))));
      container.dataset.mapLoadProgress = String(loadProgressValue);
      if (loadingProgress) loadingProgress.style.width = loadProgressValue + '%';
      if (loadingPercent) loadingPercent.textContent = loadProgressValue + '%';
      if (label && loadingLabel) loadingLabel.textContent = label;
      if (loadProgressValue >= 100 && loadingOverlay) {
        if (loadingLabel) loadingLabel.textContent = 'Map ready';
        window.setTimeout(() => { loadingOverlay.hidden = true; }, 180);
      }
    };
    setLoadProgress(4, 'Please wait while map loads…');
    const planButtons = Array.from(shell.querySelectorAll<HTMLButtonElement>('[data-map-tool="plan"]'));
    const saveButtons = Array.from(shell.querySelectorAll<HTMLButtonElement>('[data-map-tool="save"]'));
    const explorePlanOpenButtons = Array.from(shell.querySelectorAll<HTMLButtonElement>('[data-sheet-open="explore"], [data-sheet-open="plan"]'));
    let informalTrailsReady = false;
    const layerPanel = shell.querySelector<HTMLDetailsElement>('.route-layer-panel');
    const searchPanel = shell.querySelector<HTMLElement>('[data-map-sheet="search"]');
    const explorePanel = shell.querySelector<HTMLElement>('[data-map-sheet="explore"]');
    const exploreList = shell.querySelector<HTMLElement>('[data-explore-route-list]');
    const planPanel = shell.querySelector<HTMLElement>('[data-map-sheet="plan"]');
    const planPanelTitle = shell.querySelector<HTMLElement>('[data-plan-panel-title]');
    const planMinimize = shell.querySelector<HTMLButtonElement>('[data-plan-minimize]');
    const planClose = shell.querySelector<HTMLButtonElement>('[data-plan-close]');
    const planConfirm = shell.querySelector<HTMLDialogElement>('[data-plan-confirm]');
    const planConfirmMessage = shell.querySelector<HTMLElement>('[data-plan-confirm-message]');
    const planConfirmOk = shell.querySelector<HTMLButtonElement>('[data-plan-confirm-ok]');
    const planMobileHistory = shell.querySelector<HTMLElement>('[data-plan-mobile-history]');
    const planMobileUndo = shell.querySelector<HTMLButtonElement>('[data-plan-mobile-action="undo"]');
    const planMobileRedo = shell.querySelector<HTMLButtonElement>('[data-plan-mobile-action="redo"]');
    type ActiveMapTool = 'measure' | 'area' | 'bearing' | 'watershed' | 'plan' | null;
    let activeTool: ActiveMapTool = null;
    const sharePanel = shell.querySelector<HTMLElement>('[data-map-sheet="share"]');
    const shareUrlInput = shell.querySelector<HTMLInputElement>('[data-share-url]');
    const shareDescription = shell.querySelector<HTMLElement>('[data-share-description]');
    const shareCopy = shell.querySelector<HTMLButtonElement>('[data-share-copy]');
    const shareStatus = shell.querySelector<HTMLElement>('[data-share-status]');
    const undoButton = shell.querySelector<HTMLButtonElement>('[data-plan-action="undo"]');
    const redoButton = shell.querySelector<HTMLButtonElement>('[data-plan-action="redo"]');
    const planPanPad = shell.querySelector<HTMLElement>('[data-plan-pan-pad]');
    const searchInput = shell.querySelector<HTMLInputElement>('[data-map-search]');
    const searchResults = shell.querySelector<HTMLElement>('[data-map-search-results]');
    const coordinateCard = shell.querySelector<HTMLElement>('[data-coordinate-card]');
    const coordinateDd = shell.querySelector<HTMLElement>('[data-coordinate-dd]');
    const coordinateUtm = shell.querySelector<HTMLElement>('[data-coordinate-utm]');
    const coordinateElevation = shell.querySelector<HTMLElement>('[data-coordinate-elevation]');
    const coordinateCopy = shell.querySelector<HTMLButtonElement>('[data-coordinate-copy]');
    const coordinateClose = shell.querySelector<HTMLButtonElement>('[data-coordinate-close]');
    const planLiveStats = shell.querySelector<HTMLElement>('[data-plan-live-stats]');
    const planStatsTitle = shell.querySelector<HTMLElement>('[data-plan-stats-title]');
    const planStatsNote = shell.querySelector<HTMLElement>('[data-plan-stats-note]');
    const planStatsDistance = shell.querySelector<HTMLElement>('[data-plan-stats-distance]');
    const planStatsGain = shell.querySelector<HTMLElement>('[data-plan-stats-gain]');
    const planStatsLoss = shell.querySelector<HTMLElement>('[data-plan-stats-loss]');
    const planStatsRange = shell.querySelector<HTMLElement>('[data-plan-stats-range]');
    const planStatLabelA = shell.querySelector<HTMLElement>('[data-plan-stat-label="a"]');
    const planStatLabelB = shell.querySelector<HTMLElement>('[data-plan-stat-label="b"]');
    const planStatLabelC = shell.querySelector<HTMLElement>('[data-plan-stat-label="c"]');
    const planStatLabelD = shell.querySelector<HTMLElement>('[data-plan-stat-label="d"]');
    const planHelp = shell.querySelector<HTMLElement>('[data-plan-help]');
    const coordinateSunToday = shell.querySelector<HTMLElement>('[data-coordinate-sun-today]');
    const coordinateSunriseToday = shell.querySelector<HTMLElement>('[data-coordinate-sunrise-today]');
    const coordinateFirstDirectToday = shell.querySelector<HTMLElement>('[data-coordinate-first-direct-today]');
    const coordinateLastDirectToday = shell.querySelector<HTMLElement>('[data-coordinate-last-direct-today]');
    const coordinateSunsetToday = shell.querySelector<HTMLElement>('[data-coordinate-sunset-today]');
    const coordinateSunTable = shell.querySelector<HTMLElement>('[data-coordinate-sun-table]');
    const coordinateSunSource = shell.querySelector<HTMLElement>('[data-coordinate-sun-source]');
    const coordinateSunDetails = shell.querySelector<HTMLDetailsElement>('[data-coordinate-sun-details]');
    const sunlightPresetTimes = shell.querySelector<HTMLElement>('[data-sunlight-preset-times]');
    const mobilePresetSelect = shell.querySelector<HTMLSelectElement>('[data-mobile-map-preset]');
    const mobileQuickRef = shell.querySelector<HTMLDetailsElement>('.route-map-mobile-quickref');

    if (layerPanel) layerPanel.open = false;

    type ReadyGroup = 'core' | 'routes' | 'planning' | 'share';
    const readiness: Record<ReadyGroup, boolean> = { core: false, routes: false, planning: false, share: false };
    const syncReadyGroup = (group: ReadyGroup) => {
      for (const element of shell.querySelectorAll<HTMLElement>('[data-ready-group="' + group + '"]')) {
        element.dataset.ready = String(readiness[group]);
        if (element instanceof HTMLButtonElement || element instanceof HTMLInputElement || element instanceof HTMLSelectElement) {
          element.disabled = !readiness[group];
        }
      }
    };
    const setReadiness = (group: ReadyGroup, ready: boolean) => {
      readiness[group] = ready;
      syncReadyGroup(group);
    };
    for (const group of ['core', 'routes', 'planning', 'share'] as ReadyGroup[]) syncReadyGroup(group);

    const setPlanningGraphReady = (ready: boolean) => {
      informalTrailsReady = ready;
      setReadiness('planning', ready && graph.size > 1);
      container.dataset.trailPlanningReady = String(ready && graph.size > 1);
    };

    container.dataset.trailPlanningReady = 'false';
    container.dataset.planDetourGuardCount = '0';
    container.dataset.namedRoadGapBridgeCount = '0';

    const setStatus = (message: string, kind: 'normal' | 'warning' = 'normal') => {
      if (status) {
        status.textContent = message;
        status.dataset.kind = kind;
      }
      if (mobileStatus) {
        mobileStatus.textContent = message;
        mobileStatus.dataset.kind = kind;
      }
    };

    const map = L.map(container, {
      zoomControl: false,
      attributionControl: true,
      scrollWheelZoom: false,
      doubleClickZoom: true,
      touchZoom: true,
      dragging: true,
      boxZoom: true,
      keyboard: true,
      minZoom: 8,
      maxZoom: 20,
      maxBoundsViscosity: 0.88,
      preferCanvas: true
    });
    L.control.scale({ position: 'topleft', imperial: true, metric: true, maxWidth: 130 }).addTo(map);
    setLoadProgress(10, 'Starting map…');

    const panes: Record<string, number> = {
      hillshade: 180,
      baseTopo: 200,
      baseUsTopo: 210,
      baseAerial: 220,
      weather: 240,
      landUnits: 270,
      specialManagement: 285,
      wilderness: 300,
      localRoads: 340,
      localRoadLabels: 345,
      roads: 350,
      informalTrails: 370,
      trails: 390,
      stateParkTrails: 400,
      counties: 415,
      lidarSun: 425,
      oilGas: 495,
      areaLabels: 500,
      routes: 440,
      recreation: 450,
      routeStarts: 460,
      landmarks: 470,
      mapPoint: 485,
      planning: 490
    };
    for (const [name, zIndex] of Object.entries(panes)) {
      const pane = map.createPane(name);
      pane.style.zIndex = String(zIndex);
      if (name === 'baseTopo' || name === 'baseUsTopo') {
        pane.style.mixBlendMode = 'multiply';
      }
    }

    const priorOverflow = { body: document.body.style.overflow, html: document.documentElement.style.overflow };
    let fullscreenReturnScrollY: number | null = null;
    const rememberFullscreenReturnPosition = () => {
      if (fullscreenReturnScrollY === null) fullscreenReturnScrollY = window.scrollY;
    };
    const restoreFullscreenReturnPosition = () => {
      const scrollY = fullscreenReturnScrollY;
      fullscreenReturnScrollY = null;
      if (scrollY === null) return;
      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => window.scrollTo({ top: scrollY, left: 0, behavior: 'auto' }));
      });
    };
    const focusModeActive = () => shell.dataset.focusMode === 'true';
    const realFullscreenActive = () => document.fullscreenElement === shell;
    const mobileFullscreenActive = () =>
      window.matchMedia('(max-width: 700px)').matches && (realFullscreenActive() || focusModeActive());
    const syncFullscreenUi = () => {
      const active = realFullscreenActive() || focusModeActive();
      for (const button of fullscreenButtons) {
        button.setAttribute('aria-label', active ? 'Exit full screen map' : 'Enter full screen map');
        button.setAttribute('aria-pressed', String(active));
        button.title = active ? 'Exit full screen' : 'Enter full screen';
        const label = button.querySelector<HTMLElement>('[data-fullscreen-label]');
        if (label) label.textContent = active ? 'Exit full screen' : 'Full screen';
      }
      container.dataset.fullscreenMode = realFullscreenActive() ? 'native' : focusModeActive() ? 'focus' : 'off';
      if (!active && mobileQuickRef) mobileQuickRef.open = false;
      window.requestAnimationFrame(() => {
        map.invalidateSize({ pan: false });
        if (active && window.matchMedia('(max-width: 700px)').matches && checked(gorgeLayerId)) {
          void loadVisibleGorgeSectors();
        }
      });
    };
    const enterFocusMode = () => {
      shell.dataset.focusMode = 'true';
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
      syncFullscreenUi();
    };
    const exitFocusMode = () => {
      delete shell.dataset.focusMode;
      document.body.style.overflow = priorOverflow.body;
      document.documentElement.style.overflow = priorOverflow.html;
      syncFullscreenUi();
      restoreFullscreenReturnPosition();
    };
    const toggleFullscreen = async () => {
      if (realFullscreenActive()) {
        try { await document.exitFullscreen(); } catch {}
        return;
      }
      if (focusModeActive()) {
        exitFocusMode();
        return;
      }
      rememberFullscreenReturnPosition();
      if (typeof shell.requestFullscreen === 'function') {
        try {
          await shell.requestFullscreen();
          return;
        } catch {
          // iPhone and some embedded browsers do not permit arbitrary-element fullscreen.
        }
      }
      enterFocusMode();
    };
    for (const button of fullscreenButtons) button.addEventListener('click', () => { void toggleFullscreen(); });
    document.addEventListener('fullscreenchange', () => {
      if (!realFullscreenActive() && focusModeActive()) {
        exitFocusMode();
      } else {
        syncFullscreenUi();
        if (!realFullscreenActive()) restoreFullscreenReturnPosition();
      }
    });

    const areaLabelGroup = L.layerGroup().addTo(map);
    const areaLabels = [
      { fullHtml: 'NATURAL<br>BRIDGE', short: 'NB', lat: 37.775, lng: -83.687, fullSize: [150, 76], mobileFullSize: [118, 70] },
      { fullHtml: 'RED<br>RIVER<br>GORGE', short: 'RRG', lat: 37.823, lng: -83.638, fullSize: [150, 94], mobileFullSize: [116, 86] },
      { fullHtml: 'CLIFTY<br>WILDERNESS', short: 'CW', lat: 37.837, lng: -83.565, fullSize: [170, 76], mobileFullSize: [128, 70] }
    ];
    const isMobileFullMap = () => mode === 'full' && window.matchMedia('(max-width: 700px)').matches;
    const areaLabelModeForZoom = (zoom: number) => {
      if (isMobileFullMap()) {
        if (zoom >= 14) return 'hidden';
        if (zoom >= 12) return 'initials-near';
        if (zoom >= 10) return 'full';
        return 'initials-broad';
      }
      if (zoom >= 16) return 'hidden';
      if (zoom >= 14) return 'initials-near';
      if (zoom >= 11) return 'full';
      return 'initials-broad';
    };
    const syncAreaLabels = () => {
      areaLabelGroup.clearLayers();
      const zoom = map.getZoom();
      const labelMode = areaLabelModeForZoom(zoom);
      container.dataset.areaLabelMode = labelMode;
      if (labelMode === 'hidden') return;
      const full = labelMode === 'full';
      for (const label of areaLabels) {
        const iconSize: [number, number] = full
          ? (isMobileFullMap() ? label.mobileFullSize as [number, number] : label.fullSize as [number, number])
          : [64, 48];
        const html = full
          ? '<span class="rrgh-area-label-text">' + label.fullHtml + '</span>'
          : '<span class="rrgh-area-label-text">' + label.short + '</span>';
        L.marker([label.lat, label.lng], {
          pane: 'areaLabels',
          interactive: false,
          keyboard: false,
          icon: L.divIcon({
            className: 'rrgh-area-label ' + (full ? 'is-full' : 'is-initials ') + (labelMode === 'initials-broad' ? 'is-broad' : labelMode === 'initials-near' ? 'is-near' : ''),
            html,
            iconSize,
            iconAnchor: [iconSize[0] / 2, iconSize[1] / 2]
          })
        }).addTo(areaLabelGroup);
      }
    };
    map.on('zoomend', syncAreaLabels);

    const homeCenter = L.latLng(37.8196836, -83.6396027);
    const mobileHomeCenter = L.latLng(37.8196836, -83.6240);
    const homeZoom = 13;
    const mobileHomeZoom = 11;
    const setHomeView = () => {
      if (isMobileFullMap()) {
        map.setView(mobileHomeCenter, mobileHomeZoom, { animate: false });
        container.dataset.homeView = 'gorge-overview';
      } else {
        map.setView(homeCenter, homeZoom, { animate: false });
        container.dataset.homeView = 'detail';
      }
      syncAreaLabels();
    };
    const updateSunlightPresetTimes = () => {
      if (!sunlightPresetTimes) return;
      const today = redRiverDateParts();
      const sun = getAstronomicalSunDay(homeCenter.lat, homeCenter.lng, today);
      sunlightPresetTimes.textContent = 'Today · Sunrise ' + formatRrgTime(sun.sunrise) + ' · Sunset ' + formatRrgTime(sun.sunset);
    };
    updateSunlightPresetTimes();

    const syncViewportDiagnostics = () => {
      const center = map.getCenter();
      const northWest = map.getBounds().getNorthWest();
      container.dataset.mapCenter = center.lat.toFixed(7) + ',' + center.lng.toFixed(7);
      container.dataset.mapNorthWest = northWest.lat.toFixed(7) + ',' + northWest.lng.toFixed(7);
    };

    if (mode === 'full') {
      setHomeView();
    } else {
      map.setView([37.8185, -83.5795], 14);
    }
    syncAreaLabels();

    const mapLayers = new Map<string, any>();
    const opacitySetters = new Map<string, (value: number) => void>();
    let homeBounds: any = null;
    let locationLayer: any = null;
    let coordinatePointLayer: any = null;
    let coordinatePoint: { lat: number; lng: number; utm: string } | null = null;
    let sunlightRequestRevision = 0;
    let sunlightController: AbortController | null = null;
    const sunlightHorizonCache = new Map<string, { profile: any; sourceLabel: string; originElevationMeters: number }>();
    let sharedViewApplied = false;
    const searchItems: Array<{ label: string; detail: string; bounds?: any; latlng?: any; open?: () => void }> = [];
    const sourceById = (id: string) => mapSources.find((source) => source.id === id);

    const checked = (id: string) => shell.querySelector<HTMLInputElement>('[data-map-layer="' + id + '"]')?.checked ?? false;
    const opacity = (id: string) => {
      const input = shell.querySelector<HTMLInputElement>('[data-opacity="' + id + '"]');
      return Math.max(0, Math.min(1, Number(input?.value ?? 100) / 100));
    };
    const aerialExclusiveIds = new Set(['kytopo', 'usgs-topo', 'ky-hillshade']);
    const aerialLayerIds = new Set(['kyaerial-phase3', 'kyaerial-phase2-leafoff']);
    const aerialActive = () => Array.from(aerialLayerIds).some((id) => checked(id));
    const syncFineTuneControl = (id: string) => {
      const enabled = checked(id);
      const fineToggle = shell.querySelector<HTMLInputElement>('[data-fine-tune-layer="' + id + '"]');
      const slider = shell.querySelector<HTMLInputElement>('[data-opacity="' + id + '"]');
      const blockedByAerial = aerialExclusiveIds.has(id) && aerialActive();
      const mainToggle = shell.querySelector<HTMLInputElement>('[data-map-layer="' + id + '"]');
      const blockedByPreset = Boolean(mainToggle?.disabled);
      if (fineToggle) {
        fineToggle.checked = enabled;
        fineToggle.disabled = blockedByPreset;
        fineToggle.title = blockedByPreset ? 'This layer is temporarily unavailable.' : '';
        if (id !== 'rrg-lidar-sun' && id !== oilGasLayerId) fineToggle.indeterminate = false;
      }
      if (slider) {
        slider.disabled = !enabled || blockedByAerial || blockedByPreset;
        slider.title = blockedByPreset
          ? 'This layer is temporarily unavailable.'
          : blockedByAerial
            ? 'Unavailable while aerial imagery is active.'
            : (!enabled ? 'Turn this layer on to adjust opacity.' : '');
      }
    };
    const syncAllFineTuneControls = () => {
      for (const control of shell.querySelectorAll<HTMLInputElement>('[data-fine-tune-layer]')) {
        const id = control.dataset.fineTuneLayer;
        if (id) syncFineTuneControl(id);
      }
    };

    const syncVisibility = (id: string) => {
      const layer = mapLayers.get(id);
      if (!layer) return;
      if (checked(id) && !map.hasLayer(layer)) layer.addTo(map);
      if (!checked(id) && map.hasLayer(layer)) map.removeLayer(layer);
    };

    const syncOpacity = (id: string) => {
      opacitySetters.get(id)?.(opacity(id));
    };

    const tilePane: Record<string, string> = {
      kytopo: 'baseTopo',
      'kyaerial-phase3': 'baseAerial',
      'kyaerial-phase2-leafoff': 'baseAerial',
      'usgs-topo': 'baseUsTopo',
      'ky-hillshade': 'hillshade'
    };

    for (const source of mapSources.filter((item) => item.kind === 'tile' && item.enabled && item.browserLoaded && item.url)) {
      const layer = L.tileLayer(source.url, {
        attribution: source.attribution,
        minZoom: source.minZoom,
        maxZoom: source.maxZoom,
        maxNativeZoom: source.maxNativeZoom,
        opacity: opacity(source.id),
        pane: tilePane[source.id] ?? 'tilePane',
        keepBuffer: 3
      });
      mapLayers.set(source.id, layer);
      opacitySetters.set(source.id, (value) => layer.setOpacity(value));
      syncVisibility(source.id);
    }
    setLoadProgress(18, 'Base map ready…');

    const weatherLayerId = 'rrgh-weather';
    const weatherLayer = L.layerGroup();
    const weatherSelect = shell.querySelector<HTMLSelectElement>('[data-weather-product]');
    const weatherStatus = shell.querySelector<HTMLElement>('[data-weather-status]');
    const weatherLegend = shell.querySelector<HTMLElement>('[data-weather-legend]');
    let weatherManifestPromise: Promise<any> | null = null;
    let weatherOverlay: any = null;
    const weatherManifestUrl = import.meta.env.BASE_URL + 'data/map/weather/manifest.json';
    mapLayers.set(weatherLayerId, weatherLayer);
    const loadWeatherManifest = async () => {
      if (!weatherManifestPromise) {
        weatherManifestPromise = fetch(weatherManifestUrl, { credentials: 'same-origin', cache: 'no-cache' })
          .then((response) => {
            if (!response.ok) throw new Error('Weather manifest HTTP ' + response.status);
            return response.json();
          });
      }
      return weatherManifestPromise;
    };
    const renderWeatherLegend = (legend: any[]) => {
      if (!weatherLegend) return;
      weatherLegend.replaceChildren();
      for (const item of Array.isArray(legend) ? legend : []) {
        if (!item?.label || !item?.imageData) continue;
        const row = document.createElement('span');
        row.className = 'route-weather-legend-item';
        const img = document.createElement('img');
        img.alt = '';
        img.src = 'data:' + (item.contentType || 'image/png') + ';base64,' + item.imageData;
        const label = document.createElement('span');
        label.textContent = item.label;
        row.append(img, label);
        weatherLegend.append(row);
      }
      weatherLegend.hidden = weatherLegend.childElementCount === 0;
    };
    const loadWeatherOverlay = async () => {
      const productId = weatherSelect?.value || 'precip-10d';
      container.dataset.weatherLoadState = 'loading';
      if (weatherStatus) weatherStatus.textContent = 'Loading RRGH-hosted NOAA overlay…';
      try {
        const manifest = await loadWeatherManifest();
        const product = manifest?.products?.[productId];
        const bounds = manifest?.boundsWgs84;
        if (!product?.file || !Array.isArray(bounds) || bounds.length !== 4) throw new Error('Weather cache manifest is incomplete.');
        weatherLayer.clearLayers();
        const [west, south, east, north] = bounds.map(Number);
        weatherOverlay = L.imageOverlay(
          import.meta.env.BASE_URL + product.file,
          [[south, west], [north, east]],
          { pane: 'weather', opacity: opacity(weatherLayerId), interactive: false, alt: product.label || 'Weather overlay' }
        );
        weatherLayer.addLayer(weatherOverlay);
        renderWeatherLegend(product.legend || []);
        container.dataset.weatherProduct = productId;
        container.dataset.weatherFetchedAt = String(manifest.fetchedAtUtc || '');
        container.dataset.weatherLoadState = 'loaded';
        if (weatherStatus) {
          const fetched = manifest.fetchedAtUtc ? new Date(manifest.fetchedAtUtc).toLocaleString() : 'latest cache';
          weatherStatus.textContent = (product.label || productId) + ' · ' + (product.unit || 'inches') + ' · NOAA/NWS cache ' + fetched + '.';
        }
        syncVisibility(weatherLayerId);
      } catch (error) {
        console.error(error);
        container.dataset.weatherLoadState = 'error';
        if (weatherStatus) weatherStatus.textContent = 'Weather overlay is temporarily unavailable. Other map layers are unaffected.';
        if (weatherLegend) weatherLegend.hidden = true;
      }
    };
    opacitySetters.set(weatherLayerId, (value) => weatherOverlay?.setOpacity(value));
    weatherSelect?.addEventListener('change', () => {
      if (checked(weatherLayerId)) void loadWeatherOverlay();
    });

    const sunPotentialStyle = (kind: 'sunrise' | 'sunset', strength: number, hard: boolean, multiplier: number) => {
      const color = kind === 'sunset' ? '#4640b0' : '#f2685c';
      const boundedStrength = Math.max(0, Math.min(1, strength));
      return {
        color,
        weight: hard ? 1.5 : 0,
        opacity: hard ? multiplier : 0,
        fillColor: color,
        fillOpacity: (hard ? 0.92 : 0.12 + boundedStrength * 0.58) * multiplier,
        lineJoin: 'round'
      };
    };

    const gorgeLayerId = 'rrg-lidar-sun';
    const gorgeLayer = L.layerGroup();
    type GorgeSunImage = { overlay: any; kind: 'sunrise' | 'sunset' };
    type GorgeSunPath = { layer: any; kind: 'sunrise' | 'sunset' };
    type GorgeSectorResources = {
      images: GorgeSunImage[];
      paths: GorgeSunPath[];
      hardLayer: any;
      hardFeatures: number;
    };
    const gorgeSunImages: GorgeSunImage[] = [];
    const gorgeSunPaths: GorgeSunPath[] = [];
    const loadedGorgeSectorIds = new Set<string>();
    const gorgeSectorResources = new Map<string, GorgeSectorResources>();
    const mobileFullscreenSunMaxSectors = 6;
    let gorgeManifest: any = null;
    let gorgeManifestPromise: Promise<any> | null = null;
    let gorgeHardFeatureCount = 0;
    let gorgeLoadRevision = 0;

    const releaseGorgeImage = (item: GorgeSunImage) => {
      if (gorgeLayer.hasLayer(item.overlay)) gorgeLayer.removeLayer(item.overlay);
      const image = item.overlay.getElement?.() as HTMLImageElement | undefined;
      if (image) {
        image.removeAttribute('src');
        image.removeAttribute('srcset');
      }
      const index = gorgeSunImages.indexOf(item);
      if (index >= 0) gorgeSunImages.splice(index, 1);
    };

    const releaseGorgeSector = (id: string) => {
      const resources = gorgeSectorResources.get(id);
      if (!resources) {
        loadedGorgeSectorIds.delete(id);
        return;
      }
      for (const image of resources.images) releaseGorgeImage(image);
      if (resources.hardLayer && gorgeLayer.hasLayer(resources.hardLayer)) gorgeLayer.removeLayer(resources.hardLayer);
      for (const path of resources.paths) {
        const index = gorgeSunPaths.indexOf(path);
        if (index >= 0) gorgeSunPaths.splice(index, 1);
      }
      gorgeHardFeatureCount = Math.max(0, gorgeHardFeatureCount - resources.hardFeatures);
      gorgeSectorResources.delete(id);
      loadedGorgeSectorIds.delete(id);
    };

    const pruneMobileFullscreenGorgeSectors = (keepIds: Set<string>) => {
      if (!mobileFullscreenActive()) return;
      for (const id of Array.from(gorgeSectorResources.keys())) {
        if (!keepIds.has(id)) releaseGorgeSector(id);
      }
      container.dataset.rrgLidarSunLoadedSectors = String(loadedGorgeSectorIds.size);
      container.dataset.rrgLidarSunImageCount = String(gorgeSunImages.length);
      container.dataset.rrgLidarSunHardFeatureCount = String(gorgeHardFeatureCount);
    };

    const sunKindToggle = (kind: 'sunrise' | 'sunset') =>
      shell.querySelector<HTMLInputElement>('[data-sun-kind-toggle="' + kind + '"]');
    const sunKindEnabled = (kind: 'sunrise' | 'sunset') => sunKindToggle(kind)?.checked ?? false;

    const syncSunPotentialStyles = (value = opacity(gorgeLayerId)) => {
      gorgeSunImages.forEach((item) => {
        item.overlay.setOpacity(sunKindEnabled(item.kind) ? value : 0);
      });
      gorgeSunPaths.forEach((item) => {
        const multiplier = sunKindEnabled(item.kind) ? value : 0;
        item.layer.setStyle(sunPotentialStyle(item.kind, 1, true, multiplier));
      });
    };

    const syncSunPotentialControls = () => {
      const sunrise = sunKindEnabled('sunrise');
      const sunset = sunKindEnabled('sunset');
      const any = sunrise || sunset;
      const mixed = sunrise !== sunset;
      const master = shell.querySelector<HTMLInputElement>('[data-sun-potential-master]');
      const fineToggle = shell.querySelector<HTMLInputElement>('[data-fine-tune-layer="' + gorgeLayerId + '"]');
      const slider = shell.querySelector<HTMLInputElement>('[data-opacity="' + gorgeLayerId + '"]');
      if (master) {
        master.checked = any;
        master.indeterminate = mixed;
      }
      if (fineToggle) {
        fineToggle.checked = any;
        fineToggle.indeterminate = mixed;
      }
      if (slider) {
        slider.disabled = !any;
        slider.title = any ? '' : 'Turn Sunrise / Sunset Potential on to adjust opacity.';
      }
      syncVisibility(gorgeLayerId);
      syncSunPotentialStyles();
      if (any) {
        void loadVisibleGorgeSectors();
      } else {
        gorgeLoadRevision += 1;
        setMapActivity('sunlight', false);
        if (mobileFullscreenActive()) pruneMobileFullscreenGorgeSectors(new Set());
        container.dataset.rrgLidarSunLoadState = 'idle';
      }
    };

    const setSunKinds = (enabled: boolean) => {
      const sunrise = sunKindToggle('sunrise');
      const sunset = sunKindToggle('sunset');
      if (sunrise) sunrise.checked = enabled;
      if (sunset) sunset.checked = enabled;
      syncSunPotentialControls();
    };

    mapLayers.set(gorgeLayerId, gorgeLayer);
    opacitySetters.set(gorgeLayerId, (value) => syncSunPotentialStyles(value));
    syncVisibility(gorgeLayerId);

    const loadGorgeManifest = async () => {
      if (gorgeManifest) return gorgeManifest;
      if (!gorgeManifestPromise) {
        gorgeManifestPromise = fetch(import.meta.env.BASE_URL + 'data/map/rrg-lidar-sun-continuous-manifest.json', {
          credentials: 'same-origin',
          cache: 'no-cache'
        }).then(async (response) => {
          if (!response.ok) throw new Error('Gorge continuous sunlight manifest HTTP ' + response.status);
          gorgeManifest = await response.json();
          if (
            gorgeManifest?.version !== 'lidar-continuous-gradient-v1' ||
            Number(gorgeManifest?.minimumElevationFeet) !== 1100 ||
            gorgeManifest?.rendering?.gradient !== 'continuous raster alpha WebP' ||
            gorgeManifest?.rendering?.separateSunriseSunsetRasters !== true ||
            gorgeManifest?.rendering?.terrainQualificationChanged !== false ||
            gorgeManifest?.rendering?.hardLipGeometryChanged !== false ||
            gorgeManifest?.rendering?.acceptedHardLipReusedVerbatim !== true
          ) {
            throw new Error('Gorge continuous sunlight manifest failed rendering contract.');
          }
          container.dataset.rrgLidarSunSectorCount = String(Array.isArray(gorgeManifest?.sectors) ? gorgeManifest.sectors.length : 0);
          return gorgeManifest;
        });
      }
      return gorgeManifestPromise;
    };

    const waitForSunImage = (overlay: any, id: string, kind: 'sunrise' | 'sunset') =>
      new Promise<void>((resolve, reject) => {
        const onLoad = () => {
          overlay.off('error', onError);
          resolve();
        };
        const onError = () => {
          overlay.off('load', onLoad);
          reject(new Error('Gorge continuous sunlight ' + kind + ' image failed for sector ' + id));
        };
        overlay.once('load', onLoad);
        overlay.once('error', onError);
      });

    const loadVisibleGorgeSectors = async () => {
      if (!checked(gorgeLayerId)) return;
      const revision = ++gorgeLoadRevision;
      let activityShown = false;
      const showActivity = () => {
        if (activityShown) return;
        activityShown = true;
        container.dataset.rrgLidarSunLoadState = 'loading';
        setMapActivity('sunlight', true);
      };
      try {
        if (!gorgeManifest) showActivity();
        const manifest = await loadGorgeManifest();
        if (revision !== gorgeLoadRevision || !checked(gorgeLayerId)) return;
        const mobileGuard = mobileFullscreenActive();
        const view = mobileGuard ? map.getBounds().pad(0.08) : map.getBounds().pad(0.35);
        const sectors = Array.isArray(manifest?.sectors) ? manifest.sectors : [];
        const center = map.getCenter();
        const intersecting = sectors.filter((sector: any) => {
          const id = String(sector?.id ?? '');
          const bounds = Array.isArray(sector?.boundsWgs84) ? sector.boundsWgs84 : [];
          if (!id || bounds.length !== 4) return false;
          const [west, south, east, north] = bounds.map(Number);
          return view.intersects(L.latLngBounds([[south, west], [north, east]]));
        });
        const targetSectors = mobileGuard
          ? intersecting
              .map((sector: any) => {
                const [west, south, east, north] = sector.boundsWgs84.map(Number);
                const sectorCenter = L.latLng((south + north) / 2, (west + east) / 2);
                return { sector, distance: center.distanceTo(sectorCenter) };
              })
              .sort((a: any, b: any) => a.distance - b.distance)
              .slice(0, mobileFullscreenSunMaxSectors)
              .map((item: any) => item.sector)
          : intersecting;
        const keepIds = new Set<string>(targetSectors.map((sector: any) => String(sector?.id ?? '')).filter(Boolean));
        if (mobileGuard) pruneMobileFullscreenGorgeSectors(keepIds);
        const pending = targetSectors.filter((sector: any) => {
          const id = String(sector?.id ?? '');
          return id && !loadedGorgeSectorIds.has(id);
        });
        if (!pending.length) {
          container.dataset.rrgLidarSunLoadState = 'loaded';
          container.dataset.rrgLidarSunLoadedSectors = String(loadedGorgeSectorIds.size);
          return;
        }
        showActivity();

        const imageLoads: Promise<void>[] = [];
        for (const sector of pending) {
          const id = String(sector?.id ?? '');
          const bounds = Array.isArray(sector?.boundsWgs84) ? sector.boundsWgs84 : [];
          const sunriseRasterFile = String(sector?.sunriseRasterFile ?? '');
          const sunsetRasterFile = String(sector?.sunsetRasterFile ?? '');
          const hardFile = String(sector?.hardFile ?? '');
          if (!id || bounds.length !== 4 || !sunriseRasterFile || !sunsetRasterFile || !hardFile || loadedGorgeSectorIds.has(id)) continue;
          const [west, south, east, north] = bounds.map(Number);
          const sectorBounds = L.latLngBounds([[south, west], [north, east]]);
          if (!view.intersects(sectorBounds)) continue;

          loadedGorgeSectorIds.add(id);
          const sectorImages: GorgeSunImage[] = [];
          const sectorPaths: GorgeSunPath[] = [];
          let hardLayer: any = null;
          let hardFeatures = 0;
          try {
            const sunriseOverlay = L.imageOverlay(
              import.meta.env.BASE_URL + sunriseRasterFile,
              sectorBounds,
              {
                pane: 'lidarSun',
                opacity: sunKindEnabled('sunrise') ? opacity(gorgeLayerId) : 0,
                interactive: false
              }
            );
            const sunriseReady = waitForSunImage(sunriseOverlay, id, 'sunrise');
            sunriseOverlay.addTo(gorgeLayer);
            const sunriseItem: GorgeSunImage = { overlay: sunriseOverlay, kind: 'sunrise' };
            gorgeSunImages.push(sunriseItem);
            sectorImages.push(sunriseItem);
            imageLoads.push(sunriseReady);

            const sunsetOverlay = L.imageOverlay(
              import.meta.env.BASE_URL + sunsetRasterFile,
              sectorBounds,
              {
                pane: 'lidarSun',
                opacity: sunKindEnabled('sunset') ? opacity(gorgeLayerId) : 0,
                interactive: false
              }
            );
            const sunsetReady = waitForSunImage(sunsetOverlay, id, 'sunset');
            sunsetOverlay.addTo(gorgeLayer);
            const sunsetItem: GorgeSunImage = { overlay: sunsetOverlay, kind: 'sunset' };
            gorgeSunImages.push(sunsetItem);
            sectorImages.push(sunsetItem);
            imageLoads.push(sunsetReady);

            const hardResponse = await fetch(import.meta.env.BASE_URL + hardFile, {
              credentials: 'same-origin',
              cache: 'no-cache'
            });
            if (!hardResponse.ok) throw new Error('Gorge continuous sunlight hard sector ' + id + ' HTTP ' + hardResponse.status);
            const hardData = await hardResponse.json();
            hardFeatures = Array.isArray(hardData?.features) ? hardData.features.length : 0;
            hardLayer = L.geoJSON(hardData, {
              pane: 'lidarSun',
              interactive: false,
              style: (feature: any) => {
                const kind: 'sunrise' | 'sunset' = feature?.properties?.kind === 'sunset' ? 'sunset' : 'sunrise';
                return sunPotentialStyle(kind, 1, true, sunKindEnabled(kind) ? opacity(gorgeLayerId) : 0);
              },
              onEachFeature: (feature: any, layer: any) => {
                const kind: 'sunrise' | 'sunset' = feature?.properties?.kind === 'sunset' ? 'sunset' : 'sunrise';
                const pathItem: GorgeSunPath = { layer, kind };
                gorgeSunPaths.push(pathItem);
                sectorPaths.push(pathItem);
              }
            });
            hardLayer.addTo(gorgeLayer);
            gorgeHardFeatureCount += hardFeatures;
            gorgeSectorResources.set(id, { images: sectorImages, paths: sectorPaths, hardLayer, hardFeatures });
          } catch (error) {
            for (const image of sectorImages) releaseGorgeImage(image);
            if (hardLayer && gorgeLayer.hasLayer(hardLayer)) gorgeLayer.removeLayer(hardLayer);
            for (const path of sectorPaths) {
              const index = gorgeSunPaths.indexOf(path);
              if (index >= 0) gorgeSunPaths.splice(index, 1);
            }
            gorgeHardFeatureCount = Math.max(0, gorgeHardFeatureCount - hardFeatures);
            gorgeSectorResources.delete(id);
            loadedGorgeSectorIds.delete(id);
            throw error;
          }
        }

        await Promise.all(imageLoads);
        if (revision !== gorgeLoadRevision || !checked(gorgeLayerId)) return;
        container.dataset.rrgLidarSunLoadedSectors = String(loadedGorgeSectorIds.size);
        container.dataset.rrgLidarSunImageCount = String(gorgeSunImages.length);
        container.dataset.rrgLidarSunHardFeatureCount = String(gorgeHardFeatureCount);
        container.dataset.rrgLidarSunLoadState = 'loaded';
        syncVisibility(gorgeLayerId);
        syncSunPotentialStyles();
      } catch (error) {
        if (revision !== gorgeLoadRevision) return;
        console.error(error);
        container.dataset.rrgLidarSunLoadError = 'true';
        container.dataset.rrgLidarSunLoadState = 'error';
      } finally {
        if (revision === gorgeLoadRevision && activityShown) setMapActivity('sunlight', false);
      }
    };

    void loadGorgeManifest().then(() => {
      if (checked(gorgeLayerId)) return loadVisibleGorgeSectors();
    }).catch((error) => {
      console.error(error);
      container.dataset.rrgLidarSunLoadError = 'true';
    });
    map.on('moveend', () => {
      if (checked(gorgeLayerId)) void loadVisibleGorgeSectors();
    });
    map.on('zoomend', () => {
      if (checked(gorgeLayerId) && mobileFullscreenActive()) void loadVisibleGorgeSectors();
    });

    const oilGasLayerId = 'kgs-oil-gas-wells';
    const oilGasServiceUrl = 'https://kgs.uky.edu/arcgis/rest/services/KYOilGas/KYOilGasWells_static_WGS84/MapServer/1/query';
    const oilGasWellReportBase = 'https://kgs.uky.edu/kygeode/services/oilgas/wellReport.asp?id=';
    const oilGasLayer = L.layerGroup();
    const oilGasMarkers: any[] = [];
    const oilGasMaxRecords = 1500;
    const oilGasMinZoom = 10;
    const oilGasStatus = shell.querySelector<HTMLElement>('[data-oil-gas-status]');
    const oilGasQueryCache = new Map<string, any>();
    const oilGasKinds = ['oil', 'gas', 'oil-gas', 'dry', 'service', 'cbm', 'other'] as const;
    type OilGasKind = typeof oilGasKinds[number];
    let oilGasController: AbortController | null = null;
    let oilGasRequestRevision = 0;
    let oilGasMoveTimer = 0;
    let oilGasAttributionVisible = false;
    let oilGasLastData: any = null;
    let oilGasLastCacheKey = '';
    const oilGasAttribution = 'Oil &amp; gas wells © <a href="https://kgs.uky.edu/data/oilgas/" target="_blank" rel="noopener">Kentucky Geological Survey / University of Kentucky</a> · data transformed for web display';

    const setOilGasStatus = (message: string, kind: 'normal' | 'warning' = 'normal') => {
      if (oilGasStatus) {
        oilGasStatus.textContent = message;
        oilGasStatus.dataset.kind = kind;
      }
    };

    const oilGasCode = (properties: any) =>
      String(properties?.original_result_symbol || properties?.original_result || '').trim().toUpperCase();

    const oilGasKindFor = (properties: any): OilGasKind => {
      const code = oilGasCode(properties);
      if (code === 'OIL') return 'oil';
      if (code === 'GAS') return 'gas';
      if (code === 'O&G') return 'oil-gas';
      if (code === 'DRY' || code === 'D&A') return 'dry';
      if (code === 'SRV' || code === 'SRI') return 'service';
      if (code === 'CBM') return 'cbm';
      return 'other';
    };

    const oilGasType = (properties: any) => {
      const code = oilGasCode(properties);
      return ({
        OIL: 'Oil well',
        GAS: 'Gas well',
        'O&G': 'Oil and gas well',
        DRY: 'Dry and abandoned well',
        'D&A': 'Dry and abandoned well',
        SRV: 'Service / secondary recovery well',
        SRI: 'Service / secondary recovery well',
        CBM: 'Coal bed methane gas well',
        LOC: 'Well location'
      } as Record<string, string>)[code] ?? 'Other well';
    };

    const oilGasColorForKind = (kind: OilGasKind) => ({
      oil: '#b56a2b',
      gas: '#2f78b7',
      'oil-gas': '#7a4d9f',
      dry: '#7a7d7b',
      service: '#004da8',
      cbm: '#247f72',
      other: '#b24d3a'
    } as Record<OilGasKind, string>)[kind];

    const oilGasColor = (properties: any) => oilGasColorForKind(oilGasKindFor(properties));

    const oilGasKindToggle = (kind: OilGasKind) =>
      shell.querySelector<HTMLInputElement>('[data-oil-gas-kind="' + kind + '"]');
    const oilGasKindEnabled = (kind: OilGasKind) => oilGasKindToggle(kind)?.checked ?? false;
    const oilGasAnyKindEnabled = () => oilGasKinds.some((kind) => oilGasKindEnabled(kind));

    const formatOilGasDate = (value: unknown) => {
      const numeric = Number(value);
      if (!Number.isFinite(numeric) || numeric <= 0) return '';
      return new Intl.DateTimeFormat('en-US', {
        year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC'
      }).format(new Date(numeric));
    };

    const oilGasValue = (value: unknown) => {
      if (value === null || value === undefined) return '';
      const text = String(value).trim();
      return text === '' || text.toLowerCase() === 'null' ? '' : text;
    };

    const oilGasBoreLabel = (value: unknown) => ({
      V: 'Vertical',
      D: 'Deviated',
      H: 'Horizontal'
    } as Record<string, string>)[String(value ?? '').trim().toUpperCase()] ?? oilGasValue(value);

    const createOilGasPopup = (properties: any) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'route-oil-gas-popup';

      const eyebrow = document.createElement('small');
      eyebrow.className = 'route-oil-gas-eyebrow';
      eyebrow.textContent = 'KENTUCKY GEOLOGICAL SURVEY';

      const title = document.createElement('strong');
      title.className = 'route-oil-gas-title';
      title.textContent = oilGasType(properties);

      const rows = document.createElement('dl');
      rows.className = 'route-oil-gas-facts';
      const add = (label: string, value: unknown) => {
        const text = oilGasValue(value);
        if (!text) return;
        const dt = document.createElement('dt');
        dt.textContent = label;
        const dd = document.createElement('dd');
        dd.textContent = text;
        rows.append(dt, dd);
      };

      add('KGS record', properties?.record_number);
      add('Permit', properties?.permit || properties?.justified_permit);
      add('API', properties?.API_Number);
      add('Completed', formatOilGasDate(properties?.date_completed));
      add('Original operator', properties?.operator);
      add('Most recent operator', properties?.most_recent_operator);
      add('Well number', properties?.well_number);
      add('Total depth', Number.isFinite(Number(properties?.total_depth)) ? Number(properties.total_depth).toLocaleString('en-US') + ' ft' : '');
      add('Surface elevation', Number.isFinite(Number(properties?.surface_elevation)) ? Math.round(Number(properties.surface_elevation)).toLocaleString('en-US') + ' ft' : '');
      add('Total-depth formation', properties?.tdfm_name);
      add('Deepest producing formation', properties?.deepest_pay_name);
      add('Bore', oilGasBoreLabel(properties?.bore_type));
      add('County', properties?.county_name);
      add('USGS quadrangle', properties?.quadrangle_name);
      add('Purpose', properties?.purpose);
      if (Number(properties?.plugged) === 1 || oilGasValue(properties?.date_plugged)) {
        add('Plugged', formatOilGasDate(properties?.date_plugged) || 'Reported plugged');
      }

      wrapper.append(eyebrow, title, rows);

      const recordNumber = Number(properties?.record_number);
      if (Number.isFinite(recordNumber) && recordNumber > 0) {
        const link = document.createElement('a');
        link.href = oilGasWellReportBase + encodeURIComponent(String(recordNumber));
        link.target = '_blank';
        link.rel = 'noopener';
        link.textContent = 'View full KGS well report →';
        wrapper.append(link);
      }

      const note = document.createElement('p');
      note.className = 'route-oil-gas-note';
      note.textContent = 'Source: Kentucky Geological Survey / University of Kentucky. Live public records transformed for web display. Locations, status, operator and other historical record information may be incomplete, approximate or outdated; this layer does not establish property access or ownership.';
      wrapper.append(note);
      return wrapper;
    };

    const syncOilGasOpacity = (value = opacity(oilGasLayerId)) => {
      for (const marker of oilGasMarkers) marker.setOpacity?.(value);
    };

    const syncOilGasAttribution = () => {
      const enabled = checked(oilGasLayerId);
      if (enabled && !oilGasAttributionVisible) {
        map.attributionControl?.addAttribution(oilGasAttribution);
        oilGasAttributionVisible = true;
      } else if (!enabled && oilGasAttributionVisible) {
        map.attributionControl?.removeAttribution(oilGasAttribution);
        oilGasAttributionVisible = false;
      }
    };

    const oilGasCacheKey = () => {
      const bounds = map.getBounds().pad(0.08);
      const round = (value: number) => value.toFixed(3);
      return [
        map.getZoom(),
        round(bounds.getWest()), round(bounds.getSouth()),
        round(bounds.getEast()), round(bounds.getNorth())
      ].join(':');
    };

    const oilGasQueryUrl = () => {
      const bounds = map.getBounds().pad(0.08);
      const params = new URLSearchParams({
        where: '1=1',
        geometry: JSON.stringify({
          xmin: bounds.getWest(),
          ymin: bounds.getSouth(),
          xmax: bounds.getEast(),
          ymax: bounds.getNorth(),
          spatialReference: { wkid: 4326 }
        }),
        geometryType: 'esriGeometryEnvelope',
        inSR: '4326',
        spatialRel: 'esriSpatialRelIntersects',
        outFields: [
          'OBJECTID','record_number','original_result','original_result_symbol','justified_permit','permit',
          'API_Number','operator','most_recent_operator','well_number','date_completed',
          'surface_elevation','total_depth','tdfm_name','deepest_pay_name','plugged','date_plugged',
          'bore_type','county_name','quadrangle_name','purpose','oil_production','gas_production'
        ].join(','),
        returnGeometry: 'true',
        outSR: '4326',
        geometryPrecision: '6',
        resultRecordCount: String(oilGasMaxRecords),
        orderByFields: 'OBJECTID ASC',
        f: 'json'
      });
      return oilGasServiceUrl + '?' + params.toString();
    };

    const renderOilGasRecords = (data: any, cacheKey = oilGasLastCacheKey) => {
      oilGasLastData = data;
      oilGasLastCacheKey = cacheKey;
      oilGasLayer.clearLayers();
      oilGasMarkers.length = 0;
      const features = Array.isArray(data?.features) ? data.features : [];
      const broad = map.getZoom() < 12;
      const layerOpacity = opacity(oilGasLayerId);
      for (const feature of features) {
        const lat = Number(feature?.geometry?.y);
        const lng = Number(feature?.geometry?.x);
        if (!Number.isFinite(lat) || !Number.isFinite(lng)) continue;
        const properties = feature?.attributes ?? {};
        const kind = oilGasKindFor(properties);
        if (!oilGasKindEnabled(kind)) continue;
        const color = oilGasColor(properties);
        const size = broad ? 7 : 11;
        const marker = L.marker([lat, lng], {
          pane: 'oilGas',
          interactive: true,
          keyboard: true,
          title: oilGasType(properties),
          opacity: layerOpacity,
          icon: L.divIcon({
            className: 'rrgh-oil-gas-marker-host',
            html: '<span class="rrgh-oil-gas-marker ' + (broad ? 'is-broad' : 'is-detail') + '" style="--oil-gas-color:' + color + '"></span>',
            iconSize: [size, size],
            iconAnchor: [size / 2, size / 2],
            popupAnchor: [0, -(size / 2 + 2)]
          })
        });
        marker.bindPopup(createOilGasPopup(properties), { maxWidth: 360, autoPan: false });
        marker.addTo(oilGasLayer);
        oilGasMarkers.push(marker);
      }
      container.dataset.oilGasWellCount = String(oilGasMarkers.length);
      container.dataset.oilGasTruncated = String(Boolean(data?.exceededTransferLimit));
      syncOilGasOpacity();
      if (data?.exceededTransferLimit) {
        setOilGasStatus('Showing ' + oilGasMarkers.length.toLocaleString('en-US') + ' selected wells from the first ' + Math.min(oilGasMaxRecords, features.length).toLocaleString('en-US') + ' KGS records in this broad view. Zoom in for complete detail.', 'warning');
      } else {
        setOilGasStatus(oilGasMarkers.length.toLocaleString('en-US') + ' selected live KGS well record' + (oilGasMarkers.length === 1 ? '' : 's') + ' in this view.');
      }
    };

    const loadVisibleOilGasWells = async () => {
      if (!checked(oilGasLayerId)) return;
      syncOilGasAttribution();
      if (map.getZoom() < oilGasMinZoom) {
        oilGasController?.abort();
        oilGasLayer.clearLayers();
        oilGasMarkers.length = 0;
        container.dataset.oilGasWellCount = '0';
        container.dataset.oilGasLoadState = 'zoom-in';
        setOilGasStatus('Oil & Gas Wells is on. Zoom in to display individual KGS well records.');
        return;
      }

      const revision = ++oilGasRequestRevision;
      const cacheKey = oilGasCacheKey();
      const cached = oilGasQueryCache.get(cacheKey);
      if (cached) {
        if (cacheKey !== oilGasLastCacheKey || cached !== oilGasLastData) renderOilGasRecords(cached, cacheKey);
        container.dataset.oilGasLoadState = 'loaded';
        delete container.dataset.oilGasLoadError;
        return;
      }

      oilGasController?.abort();
      oilGasController = new AbortController();
      container.dataset.oilGasLoadState = 'loading';
      delete container.dataset.oilGasLoadError;
      setOilGasStatus('Loading live KGS oil & gas well records…');

      try {
        const startedAt = performance.now();
        const response = await fetch(oilGasQueryUrl(), {
          signal: oilGasController.signal,
          mode: 'cors',
          credentials: 'omit',
          cache: 'no-store'
        });
        if (!response.ok) throw new Error('KGS oil & gas wells HTTP ' + response.status);
        const data = await response.json();
        if (data?.error) throw new Error('KGS oil & gas wells: ' + (data.error.message || 'query error'));
        if (revision !== oilGasRequestRevision || !checked(oilGasLayerId)) return;

        oilGasQueryCache.set(cacheKey, data);
        while (oilGasQueryCache.size > 10) {
          const firstKey = oilGasQueryCache.keys().next().value;
          if (firstKey === undefined) break;
          oilGasQueryCache.delete(firstKey);
        }
        renderOilGasRecords(data, cacheKey);
        container.dataset.oilGasLoadState = 'loaded';
        container.dataset.oilGasLoadMs = String(Math.round(performance.now() - startedAt));
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return;
        console.error(error);
        oilGasLayer.clearLayers();
        oilGasMarkers.length = 0;
        container.dataset.oilGasWellCount = '0';
        container.dataset.oilGasLoadState = 'error';
        container.dataset.oilGasLoadError = 'true';
        setOilGasStatus('KGS oil & gas well service is temporarily unavailable. The rest of the map is unaffected; move the map or toggle this layer to retry.', 'warning');
      }
    };

    const queueOilGasLoad = (delay = 220) => {
      window.clearTimeout(oilGasMoveTimer);
      oilGasMoveTimer = window.setTimeout(() => { void loadVisibleOilGasWells(); }, delay);
    };

    const syncOilGasLayer = () => {
      const selectedCount = oilGasKinds.filter((kind) => oilGasKindEnabled(kind)).length;
      const any = selectedCount > 0;
      const mixed = selectedCount > 0 && selectedCount < oilGasKinds.length;
      const master = shell.querySelector<HTMLInputElement>('[data-oil-gas-master]');
      const fineToggle = shell.querySelector<HTMLInputElement>('[data-fine-tune-layer="' + oilGasLayerId + '"]');
      const slider = shell.querySelector<HTMLInputElement>('[data-opacity="' + oilGasLayerId + '"]');
      if (master) {
        master.checked = any;
        master.indeterminate = mixed;
      }
      if (fineToggle) {
        fineToggle.checked = any;
        fineToggle.indeterminate = mixed;
      }
      if (slider) {
        slider.disabled = !any;
        slider.title = any ? '' : 'Turn Oil & Gas Wells on to adjust opacity.';
      }
      syncVisibility(oilGasLayerId);
      syncOilGasAttribution();
      if (any) {
        if (oilGasLastData) renderOilGasRecords(oilGasLastData, oilGasLastCacheKey);
        queueOilGasLoad(0);
      } else {
        oilGasController?.abort();
        oilGasLayer.clearLayers();
        oilGasMarkers.length = 0;
        container.dataset.oilGasWellCount = '0';
        container.dataset.oilGasLoadState = 'off';
        setOilGasStatus('Off by default. Enabling loads live statewide well records from Kentucky Geological Survey / University of Kentucky.');
      }
    };

    const setOilGasKinds = (enabled: boolean) => {
      for (const kind of oilGasKinds) {
        const toggle = oilGasKindToggle(kind);
        if (toggle) toggle.checked = enabled;
      }
      syncOilGasLayer();
    };

    mapLayers.set(oilGasLayerId, oilGasLayer);
    opacitySetters.set(oilGasLayerId, (value) => syncOilGasOpacity(value));
    syncOilGasLayer();
    map.on('moveend', () => {
      if (checked(oilGasLayerId)) queueOilGasLoad();
    });

    const localRoadLayerId = 'ky-local-roads';
    const localRoadOsmSourceId = 'osm-local-roads';
    const localRoadMinZoom = 14;
    const localRoadMaxFeatures = 800;
    const localRoadLayer = L.layerGroup();
    const localRoadTigerLayer = L.layerGroup().addTo(localRoadLayer);
    const localRoadOsmLayer = L.layerGroup().addTo(localRoadLayer);
    const localRoadLabelGroup = L.layerGroup().addTo(localRoadLayer);
    const localRoadPaths: any[] = [];
    const localRoadTigerPaths: any[] = [];
    const localRoadOsmPaths: any[] = [];
    const localRoadLabelMarkers: any[] = [];
    const localRoadLabelMinZoom = 15;
    const localRoadLabelMaxCount = 24;
    let localRoadPlanningIndexer: ((tigerFeatures: any[], osmFeatures: any[]) => void) | null = null;
    let localRoadRenderedTigerFeatures: any[] = [];
    let localRoadRenderedOsmFeatures: any[] = [];
    const localRoadStatus = shell.querySelector<HTMLElement>('[data-local-roads-status]');
    const localRoadCache = new Map<string, any>();
    const localRoadOsmTileCache = new Map<string, any>();
    let localRoadOsmManifestPromise: Promise<any> | null = null;
    let localRoadController: AbortController | null = null;
    let localRoadRequestRevision = 0;
    let localRoadMoveTimer = 0;
    let localRoadAttributionVisible = false;
    const localRoadAttribution =
      'Local roads © <a href="https://tigerweb.geo.census.gov/arcgis/rest/services/TIGERweb/tigerWMS_PhysicalFeatures/MapServer/5" target="_blank" rel="noopener">U.S. Census Bureau TIGERweb</a>'
      + ' · supplemental road context © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap contributors</a>';

    const setLocalRoadStatus = (message: string, kind: 'normal' | 'warning' = 'normal') => {
      if (!localRoadStatus) return;
      localRoadStatus.textContent = message;
      localRoadStatus.dataset.kind = kind;
    };

    const syncLocalRoadAttribution = () => {
      const enabled = checked(localRoadLayerId);
      if (enabled && !localRoadAttributionVisible) {
        map.attributionControl?.addAttribution(localRoadAttribution);
        localRoadAttributionVisible = true;
      } else if (!enabled && localRoadAttributionVisible) {
        map.attributionControl?.removeAttribution(localRoadAttribution);
        localRoadAttributionVisible = false;
      }
    };

    const syncLocalRoadOpacity = (value = opacity(localRoadLayerId)) => {
      for (const path of localRoadPaths) path.setStyle?.({ opacity: value });
      for (const marker of localRoadLabelMarkers) marker.setOpacity?.(value);
    };

    const localRoadCacheKey = () => {
      const bounds = map.getBounds().pad(0.06);
      const round = (value: number) => value.toFixed(3);
      return [
        map.getZoom(),
        round(bounds.getWest()), round(bounds.getSouth()),
        round(bounds.getEast()), round(bounds.getNorth())
      ].join(':');
    };

    const localRoadQueryUrl = () => {
      const source = sourceById(localRoadLayerId);
      if (!source?.serviceUrl) throw new Error('Missing Census TIGERweb local-road service URL');
      const bounds = map.getBounds().pad(0.06);
      const params = new URLSearchParams({
        where: '1=1',
        geometry: JSON.stringify({
          xmin: bounds.getWest(),
          ymin: bounds.getSouth(),
          xmax: bounds.getEast(),
          ymax: bounds.getNorth(),
          spatialReference: { wkid: 4326 }
        }),
        geometryType: 'esriGeometryEnvelope',
        inSR: '4326',
        spatialRel: 'esriSpatialRelIntersects',
        outFields: 'OID,NAME,BASENAME',
        returnGeometry: 'true',
        returnZ: 'false',
        returnM: 'false',
        outSR: '4326',
        resultRecordCount: String(localRoadMaxFeatures + 1),
        f: 'geojson'
      });
      return source.serviceUrl + '/query?' + params.toString();
    };

    const localRoadFeatureIntersectsBounds = (feature: any, bounds: any) => {
      const coordinates = feature?.geometry?.coordinates;
      if (!Array.isArray(coordinates) || coordinates.length === 0) return false;
      const points = Array.isArray(coordinates[0]?.[0]) ? coordinates.flat(1) : coordinates;
      let west = Infinity;
      let south = Infinity;
      let east = -Infinity;
      let north = -Infinity;
      for (const point of points) {
        if (!Array.isArray(point) || point.length < 2) continue;
        const lng = Number(point[0]);
        const lat = Number(point[1]);
        if (!Number.isFinite(lng) || !Number.isFinite(lat)) continue;
        west = Math.min(west, lng);
        south = Math.min(south, lat);
        east = Math.max(east, lng);
        north = Math.max(north, lat);
      }
      if (!Number.isFinite(west)) return false;
      return east >= bounds.getWest()
        && west <= bounds.getEast()
        && north >= bounds.getSouth()
        && south <= bounds.getNorth();
    };

    const localRoadFeatureName = (feature: any) =>
      String(featureValue(feature?.properties, ['NAME', 'BASENAME', 'name', 'official_name', 'alt_name']) ?? '');

    const localRoadLabelKey = (name: string) =>
      name.toLowerCase().replace(/\broad\b/g, 'rd').replace(/\s+/g, ' ').trim();

    const localRoadFeatureMidpoint = (feature: any) => {
      let bestLine: number[][] = [];
      let bestLength = -1;
      for (const line of geometryLines(feature?.geometry)) {
        let length = 0;
        for (let i = 1; i < line.length; i += 1) {
          const a = line[i - 1];
          const b = line[i];
          if (!Array.isArray(a) || !Array.isArray(b)) continue;
          length += L.latLng(Number(a[1]), Number(a[0])).distanceTo(L.latLng(Number(b[1]), Number(b[0])));
        }
        if (length > bestLength) {
          bestLength = length;
          bestLine = line;
        }
      }
      if (bestLine.length < 2 || bestLength <= 0) return null;
      const target = bestLength / 2;
      let walked = 0;
      for (let i = 1; i < bestLine.length; i += 1) {
        const a = bestLine[i - 1]!;
        const b = bestLine[i]!;
        const from = L.latLng(Number(a[1]), Number(a[0]));
        const to = L.latLng(Number(b[1]), Number(b[0]));
        const segment = from.distanceTo(to);
        if (walked + segment >= target) {
          const ratio = segment > 0 ? (target - walked) / segment : 0;
          return L.latLng(from.lat + (to.lat - from.lat) * ratio, from.lng + (to.lng - from.lng) * ratio);
        }
        walked += segment;
      }
      const last = bestLine[bestLine.length - 1]!;
      return L.latLng(Number(last[1]), Number(last[0]));
    };

    const renderLocalRoadLabels = (features: any[]) => {
      localRoadLabelGroup.clearLayers();
      localRoadLabelMarkers.length = 0;
      if (map.getZoom() < localRoadLabelMinZoom) {
        container.dataset.localRoadLabelCount = '0';
        return;
      }
      const seen = new Set<string>();
      const occupied: Array<{ left: number; right: number; top: number; bottom: number }> = [];
      const mapSize = map.getSize();
      const padding = 8;
      for (const feature of features) {
        if (localRoadLabelMarkers.length >= localRoadLabelMaxCount) break;
        const name = localRoadFeatureName(feature).trim();
        if (!name) continue;
        const key = localRoadLabelKey(name);
        if (!key || seen.has(key)) continue;
        const midpoint = localRoadFeatureMidpoint(feature);
        if (!midpoint) continue;

        const labelWidth = Math.min(180, Math.max(72, Math.round(name.length * 5.7 + 20)));
        const labelHeight = 22;
        const point = map.latLngToContainerPoint(midpoint);
        const box = {
          left: point.x - labelWidth / 2 - padding,
          right: point.x + labelWidth / 2 + padding,
          top: point.y - labelHeight / 2 - padding,
          bottom: point.y + labelHeight / 2 + padding
        };
        if (box.right < 0 || box.left > mapSize.x || box.bottom < 0 || box.top > mapSize.y) continue;
        const overlaps = occupied.some((other) =>
          box.left < other.right && box.right > other.left && box.top < other.bottom && box.bottom > other.top
        );
        if (overlaps) continue;

        seen.add(key);
        occupied.push(box);
        const safeName = name.replace(/[&<>"']/g, (char: string) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char] as string));
        const marker = L.marker(midpoint, {
          pane: 'localRoadLabels',
          interactive: false,
          keyboard: false,
          opacity: opacity(localRoadLayerId),
          icon: L.divIcon({
            className: 'rrgh-local-road-label',
            html: '<span>' + safeName + '</span>',
            iconSize: [labelWidth, labelHeight],
            iconAnchor: [labelWidth / 2, labelHeight / 2]
          })
        });
        localRoadLabelMarkers.push(marker);
        marker.addTo(localRoadLabelGroup);
      }
      container.dataset.localRoadLabelCount = String(localRoadLabelMarkers.length);
    };

    const localRoadKnownCliftyTigerOids = new Set(['110206092766', '110206092933', '110206092934', '110206092773']);
    const localRoadFeatureTigerOid = (feature: any) => String(featureValue(feature?.properties, ['OID']) ?? '');
    const localRoadFeatureIsClifty = (feature: any) =>
      localRoadKnownCliftyTigerOids.has(localRoadFeatureTigerOid(feature))
      || /(?:old\s+)?clif{1,2}ty\s+school(?:\s+(?:rd|road))?\b/i.test(localRoadFeatureName(feature));
    const localRoadOsmIsNormalSupplement = (feature: any) =>
      ['track', 'service'].includes(String(feature?.properties?.highway ?? '').toLowerCase());

    const loadLocalRoadOsmManifest = async () => {
      if (!localRoadOsmManifestPromise) {
        const url = import.meta.env.BASE_URL + 'data/map/osm-local-roads-manifest.json';
        localRoadOsmManifestPromise = fetch(url, { cache: 'no-store' }).then(async (response) => {
          if (!response.ok) throw new Error('OSM local-road manifest HTTP ' + response.status);
          const manifest = await response.json();
          if (!Array.isArray(manifest?.tiles)) throw new Error('Invalid OSM local-road manifest');
          return manifest;
        }).catch((error) => {
          localRoadOsmManifestPromise = null;
          throw error;
        });
      }
      return localRoadOsmManifestPromise;
    };

    const loadVisibleOsmLocalRoads = async (signal: AbortSignal) => {
      const manifest = await loadLocalRoadOsmManifest();
      const bounds = map.getBounds().pad(0.06);
      const tiles = manifest.tiles.filter((tile: any) => {
        const [south, west, north, east] = Array.isArray(tile?.bounds) ? tile.bounds : [];
        return Number.isFinite(south) && Number.isFinite(west) && Number.isFinite(north) && Number.isFinite(east)
          && east >= bounds.getWest()
          && west <= bounds.getEast()
          && north >= bounds.getSouth()
          && south <= bounds.getNorth();
      });
      const collections = await Promise.all(tiles.map(async (tile: any) => {
        const key = String(tile.file ?? tile.id ?? '');
        if (!key) return { type: 'FeatureCollection', features: [] };
        const cached = localRoadOsmTileCache.get(key);
        if (cached) return cached;
        const url = import.meta.env.BASE_URL + 'data/map/osm-local-roads/' + encodeURIComponent(key);
        const response = await fetch(url, { signal, cache: 'force-cache' });
        if (!response.ok) throw new Error('OSM local-road cache HTTP ' + response.status);
        const data = await response.json();
        localRoadOsmTileCache.set(key, data);
        while (localRoadOsmTileCache.size > 16) {
          const firstKey = localRoadOsmTileCache.keys().next().value;
          if (firstKey === undefined) break;
          localRoadOsmTileCache.delete(firstKey);
        }
        return data;
      }));
      const features = collections.flatMap((data: any) =>
        Array.isArray(data?.features) ? data.features.filter((feature: any) => localRoadFeatureIntersectsBounds(feature, bounds)) : []
      );
      return { type: 'FeatureCollection', features };
    };

    const renderLocalRoadCollection = (targetLayer: any, targetPaths: any[], features: any[]) => {
      targetLayer.clearLayers();
      targetPaths.length = 0;
      const layerOpacity = opacity(localRoadLayerId);
      const geoJson = L.geoJSON({ type: 'FeatureCollection', features }, {
        pane: 'localRoads',
        interactive: false,
        style: () => ({
          color: '#776f64',
          weight: map.getZoom() >= 16 ? 2.8 : 2.2,
          opacity: layerOpacity,
          lineCap: 'round',
          lineJoin: 'round'
        }),
        onEachFeature: (_feature: any, featureLayer: any) => {
          targetPaths.push(featureLayer);
          localRoadPaths.push(featureLayer);
        }
      });
      geoJson.eachLayer((layer: any) => layer.addTo(targetLayer));
    };

    const renderLocalRoads = (tigerData: any, osmData: any, sourceWarning: string | null = null, fullOsmFallback = false) => {
      localRoadTigerLayer.clearLayers();
      localRoadOsmLayer.clearLayers();
      localRoadPaths.length = 0;
      localRoadTigerPaths.length = 0;
      localRoadOsmPaths.length = 0;

      const tigerFeatures = Array.isArray(tigerData?.features) ? tigerData.features : [];
      const osmCandidates = Array.isArray(osmData?.features) ? osmData.features : [];
      const osmFeatures = fullOsmFallback ? osmCandidates : osmCandidates.filter(localRoadOsmIsNormalSupplement);
      const totalFeatures = tigerFeatures.length + osmFeatures.length;
      const tooMany = Boolean(tigerData?.exceededTransferLimit) || totalFeatures > localRoadMaxFeatures;

      if (tooMany) {
        localRoadLabelGroup.clearLayers();
        localRoadLabelMarkers.length = 0;
        localRoadRenderedTigerFeatures = [];
        localRoadRenderedOsmFeatures = [];
        container.dataset.localRoadLabelCount = '0';
        container.dataset.localRoadFeatureCount = '0';
        container.dataset.localRoadTigerFeatureCount = '0';
        container.dataset.localRoadOsmFeatureCount = '0';
        delete container.dataset.localRoadOsmMode;
        container.dataset.localRoadLoadState = 'zoom-in';
        container.dataset.localRoadTruncated = 'true';
        setLocalRoadStatus('This view contains too many local / old roads for the lightweight display layer. Zoom in to see them.', 'warning');
        return;
      }

      delete container.dataset.localRoadTruncated;
      renderLocalRoadCollection(localRoadTigerLayer, localRoadTigerPaths, tigerFeatures);
      renderLocalRoadCollection(localRoadOsmLayer, localRoadOsmPaths, osmFeatures);
      localRoadRenderedTigerFeatures = tigerFeatures;
      localRoadRenderedOsmFeatures = osmFeatures;
      renderLocalRoadLabels([...tigerFeatures, ...osmFeatures]);
      localRoadPlanningIndexer?.(tigerFeatures, osmFeatures);

      const tigerClifty = tigerFeatures.some(localRoadFeatureIsClifty);
      const osmClifty = osmFeatures.some(localRoadFeatureIsClifty);
      container.dataset.localRoadFeatureCount = String(localRoadPaths.length);
      container.dataset.localRoadTigerFeatureCount = String(localRoadTigerPaths.length);
      container.dataset.localRoadOsmFeatureCount = String(localRoadOsmPaths.length);
      container.dataset.localRoadTigerCliftyFound = String(tigerClifty);
      container.dataset.localRoadOsmCliftyFound = String(osmClifty);
      container.dataset.localRoadCliftyFound = String(tigerClifty || osmClifty);
      container.dataset.localRoadOsmMode = fullOsmFallback ? 'fallback' : 'track-service-supplement';
      container.dataset.localRoadLoadState = 'loaded';
      const sourceText = fullOsmFallback
        ? ' from cached OpenStreetMap fallback road context.'
        : ' from Census TIGERweb plus cached OpenStreetMap track/service context.';
      setLocalRoadStatus(
        localRoadPaths.length.toLocaleString('en-US') + ' local / old road segment'
        + (localRoadPaths.length === 1 ? '' : 's')
        + ' in this view' + sourceText
        + ' Status uncertain; these are roads, not trails, and may be abandoned, gated, closed, or no longer passable. Appearance does not establish public access, maintenance, legal travel, or current drivability.'
        + (sourceWarning ? ' ' + sourceWarning : ''),
        sourceWarning ? 'warning' : 'normal'
      );
    };

    const loadVisibleLocalRoads = async () => {
      if (!checked(localRoadLayerId)) return;
      syncLocalRoadAttribution();

      if (map.getZoom() < localRoadMinZoom) {
        localRoadController?.abort();
        localRoadTigerLayer.clearLayers();
        localRoadOsmLayer.clearLayers();
        localRoadLabelGroup.clearLayers();
        localRoadPaths.length = 0;
        localRoadTigerPaths.length = 0;
        localRoadOsmPaths.length = 0;
        localRoadLabelMarkers.length = 0;
        localRoadRenderedTigerFeatures = [];
        localRoadRenderedOsmFeatures = [];
        container.dataset.localRoadLabelCount = '0';
        container.dataset.localRoadFeatureCount = '0';
        container.dataset.localRoadTigerFeatureCount = '0';
        container.dataset.localRoadOsmFeatureCount = '0';
        delete container.dataset.localRoadOsmMode;
        container.dataset.localRoadLoadState = 'zoom-in';
        setLocalRoadStatus('Local / old roads is on. Zoom in to display Census TIGERweb and cached OpenStreetMap road context.');
        return;
      }

      const revision = ++localRoadRequestRevision;
      const cacheKey = localRoadCacheKey();
      const cached = localRoadCache.get(cacheKey);
      if (cached) {
        renderLocalRoads(cached.tigerData, cached.osmData, cached.sourceWarning ?? null, Boolean(cached.fullOsmFallback));
        delete container.dataset.localRoadLoadError;
        return;
      }

      localRoadController?.abort();
      localRoadController = new AbortController();
      const signal = localRoadController.signal;
      container.dataset.localRoadLoadState = 'loading';
      delete container.dataset.localRoadLoadError;
      setLocalRoadStatus('Loading Local / old roads for this view…');

      const startedAt = performance.now();
      const tigerPromise = fetch(localRoadQueryUrl(), {
        signal,
        mode: 'cors',
        credentials: 'omit',
        cache: 'no-store'
      }).then(async (response) => {
        if (!response.ok) throw new Error('Census TIGERweb local roads HTTP ' + response.status);
        const data = await response.json();
        if (data?.error) throw new Error('Census TIGERweb local roads: ' + (data.error.message || 'query error'));
        return data;
      });
      const osmPromise = loadVisibleOsmLocalRoads(signal);

      try {
        const [tigerResult, osmResult] = await Promise.allSettled([tigerPromise, osmPromise]);
        if (signal.aborted || revision !== localRoadRequestRevision || !checked(localRoadLayerId)) return;

        const tigerData = tigerResult.status === 'fulfilled'
          ? tigerResult.value
          : { type: 'FeatureCollection', features: [] };
        const osmData = osmResult.status === 'fulfilled'
          ? osmResult.value
          : { type: 'FeatureCollection', features: [] };

        if (tigerResult.status === 'rejected' && osmResult.status === 'rejected') {
          throw new Error('Both Census TIGERweb and cached OpenStreetMap local-road sources failed');
        }

        const fullOsmFallback = tigerResult.status === 'rejected' && osmResult.status === 'fulfilled';
        const sourceWarning = tigerResult.status === 'rejected'
          ? 'Census TIGERweb is temporarily unavailable; the broader cached OpenStreetMap road fallback is shown.'
          : osmResult.status === 'rejected'
            ? 'Cached OpenStreetMap track/service context is temporarily unavailable; Census TIGERweb roads are still shown.'
            : null;

        localRoadCache.set(cacheKey, { tigerData, osmData, sourceWarning, fullOsmFallback });
        while (localRoadCache.size > 8) {
          const firstKey = localRoadCache.keys().next().value;
          if (firstKey === undefined) break;
          localRoadCache.delete(firstKey);
        }
        renderLocalRoads(tigerData, osmData, sourceWarning, fullOsmFallback);
        container.dataset.localRoadLoadMs = String(Math.round(performance.now() - startedAt));
        delete container.dataset.localRoadLoadError;
      } catch (error) {
        if (signal.aborted || (error instanceof DOMException && error.name === 'AbortError')) return;
        console.error(error);
        localRoadTigerLayer.clearLayers();
        localRoadOsmLayer.clearLayers();
        localRoadLabelGroup.clearLayers();
        localRoadPaths.length = 0;
        localRoadTigerPaths.length = 0;
        localRoadOsmPaths.length = 0;
        localRoadLabelMarkers.length = 0;
        localRoadRenderedTigerFeatures = [];
        localRoadRenderedOsmFeatures = [];
        container.dataset.localRoadLabelCount = '0';
        container.dataset.localRoadFeatureCount = '0';
        container.dataset.localRoadTigerFeatureCount = '0';
        container.dataset.localRoadOsmFeatureCount = '0';
        delete container.dataset.localRoadOsmMode;
        container.dataset.localRoadLoadState = 'error';
        container.dataset.localRoadLoadError = 'true';
        setLocalRoadStatus('Local / old roads are temporarily unavailable. The rest of the map is unaffected; move the map or toggle this layer to retry.', 'warning');
      }
    };

    const queueLocalRoadLoad = (delay = 240) => {
      window.clearTimeout(localRoadMoveTimer);
      localRoadMoveTimer = window.setTimeout(() => { void loadVisibleLocalRoads(); }, delay);
    };

    const syncLocalRoadLayer = () => {
      syncVisibility(localRoadLayerId);
      syncLocalRoadAttribution();
      if (checked(localRoadLayerId)) {
        queueLocalRoadLoad(0);
      } else {
        localRoadController?.abort();
        localRoadTigerLayer.clearLayers();
        localRoadOsmLayer.clearLayers();
        localRoadLabelGroup.clearLayers();
        localRoadPaths.length = 0;
        localRoadTigerPaths.length = 0;
        localRoadOsmPaths.length = 0;
        localRoadLabelMarkers.length = 0;
        localRoadRenderedTigerFeatures = [];
        localRoadRenderedOsmFeatures = [];
        container.dataset.localRoadLabelCount = '0';
        container.dataset.localRoadFeatureCount = '0';
        container.dataset.localRoadTigerFeatureCount = '0';
        container.dataset.localRoadOsmFeatureCount = '0';
        delete container.dataset.localRoadOsmMode;
        container.dataset.localRoadLoadState = 'off';
        setLocalRoadStatus('Local / old roads is off. Enable it to show Census TIGERweb and cached OpenStreetMap road context at close zoom.');
      }
    };

    mapLayers.set(localRoadLayerId, localRoadLayer);
    opacitySetters.set(localRoadLayerId, (value) => syncLocalRoadOpacity(value));
    syncVisibility(localRoadLayerId);
    map.on('moveend', () => {
      if (checked(localRoadLayerId)) queueLocalRoadLoad();
    });

    const routeGroup = L.layerGroup();
    const routeStartGroup = L.layerGroup();
    const landmarkGroup = L.layerGroup();
    const recreationGroup = L.layerGroup();
    const trailLabelGroup = L.layerGroup();
    const stateParkTrailLabelGroup = L.layerGroup();
    const countyLabelGroup = L.layerGroup();
    const routePaths: any[] = [];
    const routeStartMarkers: any[] = [];
    const landmarkMarkers: any[] = [];
    const recreationMarkers: any[] = [];
    const routeRecords: Array<{ layer: any; routeCategory: string }> = [];
    const routeStartRecords: Array<{ layer: any; routeCategory: string }> = [];
    const landmarkRecords: Array<{ layer: any; routeCategory: string }> = [];
    const routeCategoryLabel = (category: string) => ({
      'day-hike': 'Day hike',
      backpacking: 'Backpacking',
      'off-trail': 'Off-trail'
    }[category] ?? category);
    const trailPaths: any[] = [];
    const trailCasingPaths: any[] = [];
    const stateParkTrailPaths: any[] = [];
    const stateParkTrailCasingPaths: any[] = [];
    const stateParkTrailLabelMarkers: any[] = [];
    const roadPaths: any[] = [];
    const roadCasingPaths: any[] = [];
    const countyPaths: any[] = [];
    const informalPaths: any[] = [];
    const informalCasingPaths: any[] = [];
    const wildernessPaths: any[] = [];
    const specialManagementPaths: any[] = [];
    const landUnitPaths: any[] = [];
    const trailLabelMarkers: any[] = [];
    const countyLabelMarkers: any[] = [];

    const normalContextStyles: Record<string, Record<string, unknown>> = {
      'usfs-wilderness': { color: '#356b4a', weight: 2.2, fillColor: '#75a86d', fillOpacity: 0.06, dashArray: '5 4' },
      'usfs-special-management': { color: '#a57c34', weight: 2, fillColor: '#d8b86c', fillOpacity: 0.05, dashArray: '8 4 2 4' },
      'usfs-land-units': { color: '#55715b', weight: 1.5, fillColor: '#94ad8d', fillOpacity: 0.04 }
    };
    const aerialContextStyles: Record<string, Record<string, unknown>> = {
      'usfs-wilderness': { color: '#ff4fd8', weight: 3.2, fillColor: '#ff4fd8', fillOpacity: 0.08, dashArray: '7 4' },
      'usfs-special-management': { color: '#ffe14a', weight: 3, fillColor: '#ffe14a', fillOpacity: 0.07, dashArray: '10 4 2 4' },
      'usfs-land-units': { color: '#62ff9d', weight: 2.8, fillColor: '#62ff9d', fillOpacity: 0.06 }
    };

    const syncLandContextStyles = () => {
      const aerialModeActive = aerialActive();
      shell.dataset.aerialActive = String(aerialModeActive);
      const styles = aerialModeActive ? aerialContextStyles : normalContextStyles;
      const apply = (id: string, paths: any[]) => {
        const style = styles[id];
        if (!style) return;
        const displayOpacity = id === 'usfs-wilderness' ? 1 : opacity(id);
        for (const path of paths) path.setStyle({ ...style, opacity: displayOpacity });
      };
      apply('usfs-wilderness', wildernessPaths);
      apply('usfs-special-management', specialManagementPaths);
      apply('usfs-land-units', landUnitPaths);
    };

    const syncAerialControlState = () => {
      for (const id of ['kytopo', 'usgs-topo', 'ky-hillshade', 'kyaerial-phase3', 'kyaerial-phase2-leafoff']) syncFineTuneControl(id);
      syncLandContextStyles();
    };

    mapLayers.set('routes', routeGroup);
    mapLayers.set('route-starts', routeStartGroup);
    mapLayers.set('landmarks', landmarkGroup);
    mapLayers.set('usfs-recreation-sites', recreationGroup);
    routeGroup.addTo(map);
    routeStartGroup.addTo(map);
    landmarkGroup.addTo(map);
    recreationGroup.addTo(map);

    const graph = new Map<string, Map<string, number>>();
    const nodeCoords = new Map<string, any>();
    const snapEndpointsByTag = new Map<string, Set<string>>();
    const nodeKey = (lat: number, lng: number) => lat.toFixed(5) + ',' + lng.toFixed(5);

    const ensureNode = (lat: number, lng: number) => {
      const key = nodeKey(lat, lng);
      if (!graph.has(key)) graph.set(key, new Map());
      if (!nodeCoords.has(key)) nodeCoords.set(key, L.latLng(lat, lng));
      return key;
    };

    const connect = (a: string, b: string) => {
      if (a === b) return;
      const pointA = nodeCoords.get(a);
      const pointB = nodeCoords.get(b);
      if (!pointA || !pointB) return;
      const distance = pointA.distanceTo(pointB);
      const fromA = graph.get(a);
      const fromB = graph.get(b);
      if (!fromA || !fromB) return;
      if (!fromA.has(b) || distance < (fromA.get(b) ?? Infinity)) fromA.set(b, distance);
      if (!fromB.has(a) || distance < (fromB.get(a) ?? Infinity)) fromB.set(a, distance);
    };

    const addSnapLine = (coordinates: number[][], endpointTag = '') => {
      if (coordinates.length < 2) return [] as string[];
      const valid = coordinates
        .map((pair) => ({ lng: Number(pair[0]), lat: Number(pair[1]) }))
        .filter((point) => Number.isFinite(point.lat) && Number.isFinite(point.lng));
      if (valid.length < 2) return [] as string[];

      const keys: string[] = [ensureNode(valid[0]!.lat, valid[0]!.lng)];
      for (let i = 1; i < valid.length; i += 1) {
        const a = valid[i - 1]!;
        const b = valid[i]!;
        const from = L.latLng(a.lat, a.lng);
        const to = L.latLng(b.lat, b.lng);
        const steps = Math.max(1, Math.ceil(from.distanceTo(to) / 15));
        for (let step = 1; step <= steps; step += 1) {
          const ratio = step / steps;
          const lat = a.lat + (b.lat - a.lat) * ratio;
          const lng = a.lng + (b.lng - a.lng) * ratio;
          keys.push(ensureNode(lat, lng));
        }
      }

      for (let i = 1; i < keys.length; i += 1) connect(keys[i - 1]!, keys[i]!);
      if (endpointTag && keys.length > 1) {
        const endpoints = snapEndpointsByTag.get(endpointTag) ?? new Set<string>();
        endpoints.add(keys[0]!);
        endpoints.add(keys[keys.length - 1]!);
        snapEndpointsByTag.set(endpointTag, endpoints);
      }
      return keys;
    };

    const indexGeometry = (geojson: any) => {
      for (const feature of geojson?.features ?? []) {
        for (const line of geometryLines(feature.geometry)) addSnapLine(line);
      }
    };

    const bridgeNearbyNetworkNodes = () => {
      const keys = Array.from(nodeCoords.keys());
      const buckets = new Map<string, string[]>();
      const bucketSize = 0.00012;
      for (const key of keys) {
        const point = nodeCoords.get(key);
        if (!point) continue;
        const bx = Math.floor(point.lng / bucketSize);
        const by = Math.floor(point.lat / bucketSize);
        const bucket = bx + ':' + by;
        const list = buckets.get(bucket) ?? [];
        list.push(key);
        buckets.set(bucket, list);
      }
      for (const key of keys) {
        const point = nodeCoords.get(key);
        if (!point) continue;
        const bx = Math.floor(point.lng / bucketSize);
        const by = Math.floor(point.lat / bucketSize);
        for (let x = bx - 1; x <= bx + 1; x += 1) {
          for (let y = by - 1; y <= by + 1; y += 1) {
            for (const candidate of buckets.get(x + ':' + y) ?? []) {
              if (candidate <= key) continue;
              const other = nodeCoords.get(candidate);
              if (other && point.distanceTo(other) <= 12) connect(key, candidate);
            }
          }
        }
      }
    };

    const normalizeKentuckyRoadTag = (roadName: string, roadClass: string) => {
      const raw = (roadName + ' ' + roadClass).toUpperCase();
      const routeNumber = raw.match(/(?:KY|KENTUCKY|STATE(?:\s+ROUTE|\s+HIGHWAY)?)[\s-]*(\d{1,4}[A-Z]?)/)?.[1]
        ?? (/(?:STATE\s+ROUTE|STATE\s+HIGHWAY)/.test(raw) ? roadName.match(/\b(\d{1,4}[A-Za-z]?)\b/)?.[1] : undefined);
      if (routeNumber) return 'ky-route:' + routeNumber.toLowerCase();
      const normalized = roadName.toLowerCase().replace(/\b(kentucky|state|route|highway|hwy|road|rd)\b/g, '').replace(/[^a-z0-9]+/g, '');
      return normalized ? 'ky-road:' + normalized : '';
    };

    const connectNamedRoadEndpointGaps = (maxGapMeters = 160) => {
      let connected = 0;
      for (const endpoints of snapEndpointsByTag.values()) {
        const keys = Array.from(endpoints);
        for (let i = 0; i < keys.length; i += 1) {
          const a = keys[i]!;
          const pointA = nodeCoords.get(a);
          if (!pointA) continue;
          for (let j = i + 1; j < keys.length; j += 1) {
            const b = keys[j]!;
            const pointB = nodeCoords.get(b);
            if (!pointB) continue;
            const distance = pointA.distanceTo(pointB);
            if (distance <= maxGapMeters && !(graph.get(a)?.has(b))) {
              connect(a, b);
              connected += 1;
            }
          }
        }
      }
      container.dataset.namedRoadGapBridgeCount = String(connected);
      return connected;
    };

    const localRoadPlanningKeys = new Set<string>();
    const localRoadPlanningIndexLimit = 6000;
    let localRoadPlanningFeatureCount = 0;
    const localRoadRestrictedForPlanning = (feature: any) => {
      const access = String(feature?.properties?.access ?? '').toLowerCase();
      const foot = String(feature?.properties?.foot ?? '').toLowerCase();
      return access === 'no' || access === 'private' || foot === 'no' || foot === 'private';
    };
    const localRoadPlanningLineKey = (source: 'tiger' | 'osm', feature: any, lineIndex: number, line: number[][]) => {
      const props = feature?.properties ?? {};
      const sourceId = source === 'tiger'
        ? featureValue(props, ['OID', 'OBJECTID'])
        : featureValue(props, ['osm_id']);
      const first = line[0] ?? [];
      const last = line[line.length - 1] ?? [];
      return [source, sourceId || 'unnamed', lineIndex,
        Number(first[1]).toFixed(5), Number(first[0]).toFixed(5),
        Number(last[1]).toFixed(5), Number(last[0]).toFixed(5), line.length].join(':');
    };
    localRoadPlanningIndexer = (tigerFeatures: any[], osmFeatures: any[]) => {
      let addedAny = false;
      const index = (source: 'tiger' | 'osm', feature: any) => {
        if (source === 'osm' && localRoadRestrictedForPlanning(feature)) return;
        let featureAdded = false;
        const roadName = localRoadFeatureName(feature);
        const roadClass = source === 'osm' ? String(feature?.properties?.highway ?? '') : 'local road';
        const roadTag = normalizeKentuckyRoadTag(roadName, roadClass);
        const lines = geometryLines(feature?.geometry);
        for (let lineIndex = 0; lineIndex < lines.length; lineIndex += 1) {
          if (localRoadPlanningKeys.size >= localRoadPlanningIndexLimit) break;
          const line = lines[lineIndex]!;
          if (line.length < 2) continue;
          const key = localRoadPlanningLineKey(source, feature, lineIndex, line);
          if (localRoadPlanningKeys.has(key)) continue;
          const nodes = addSnapLine(line, roadTag);
          if (nodes.length > 1) {
            localRoadPlanningKeys.add(key);
            featureAdded = true;
            addedAny = true;
          }
        }
        if (featureAdded) localRoadPlanningFeatureCount += 1;
      };
      tigerFeatures.forEach((feature) => index('tiger', feature));
      osmFeatures.forEach((feature) => index('osm', feature));
      container.dataset.localRoadPlanningFeatureCount = String(localRoadPlanningFeatureCount);
      container.dataset.localRoadPlanningIndexLimited = String(localRoadPlanningKeys.size >= localRoadPlanningIndexLimit);
      if (addedAny) {
        bridgeNearbyNetworkNodes();
        connectNamedRoadEndpointGaps();
        container.dataset.plannerNodeCount = String(graph.size);
      }
    };
    if (localRoadRenderedTigerFeatures.length || localRoadRenderedOsmFeatures.length) {
      localRoadPlanningIndexer(localRoadRenderedTigerFeatures, localRoadRenderedOsmFeatures);
    }

    const planSnapToleranceMeters = 90;

    const nearestNode = (latlng: any) => {
      let bestKey = '';
      let bestDistance = Infinity;
      for (const [key, point] of nodeCoords.entries()) {
        const distance = latlng.distanceTo(point);
        if (distance < bestDistance) {
          bestDistance = distance;
          bestKey = key;
        }
      }
      return bestKey && bestDistance <= planSnapToleranceMeters ? { key: bestKey, distance: bestDistance } : null;
    };

    const shortestTrailPath = (start: string, end: string) => {
      if (start === end) return [start];
      const distances = new Map<string, number>();
      const previous = new Map<string, string>();
      const heap = new MinHeap();
      distances.set(start, 0);
      heap.push({ key: start, distance: 0 });

      while (heap.items.length) {
        const current = heap.pop();
        if (!current) break;
        if (current.distance !== distances.get(current.key)) continue;
        if (current.key === end) break;

        for (const [neighbor, weight] of graph.get(current.key) ?? []) {
          const nextDistance = current.distance + weight;
          if (nextDistance < (distances.get(neighbor) ?? Infinity)) {
            distances.set(neighbor, nextDistance);
            previous.set(neighbor, current.key);
            heap.push({ key: neighbor, distance: nextDistance });
          }
        }
      }

      if (!distances.has(end)) return null;
      const path = [end];
      let cursor = end;
      while (cursor !== start) {
        const prior = previous.get(cursor);
        if (!prior) return null;
        path.push(prior);
        cursor = prior;
      }
      return path.reverse();
    };

    const routeBounds = L.latLngBounds([]);
    const routePalette = ['#0d6654', '#d66a3a', '#5962a8', '#a54a72', '#3479a4', '#9a7829', '#744e98', '#c24e32'];
    const routeColorFor = (routeId: string) => {
      let hash = 0;
      for (const char of routeId) hash = ((hash * 31) + char.charCodeAt(0)) >>> 0;
      return routePalette[hash % routePalette.length]!;
    };
    const routeExploreEntries = new Map<string, { route: any; color: string; layers: any[]; bounds: any }>();
    let selectedRouteId: string | null = null;

    const routePopup = (route: any) => {
      const popup = document.createElement('div');
      popup.className = 'route-map-route-card';

      const heading = document.createElement('strong');
      heading.className = 'route-map-route-card-title';
      heading.textContent = route.title;
      popup.append(heading);

      const meta = document.createElement('p');
      meta.className = 'route-map-route-card-meta';
      meta.textContent = route.distanceMi.toFixed(2) + ' mi · ' + routeCategoryLabel(route.routeCategory) + ' · ' + route.physicalDifficulty;
      popup.append(meta);

      const actions = document.createElement('div');
      actions.className = 'route-map-route-card-actions';
      const guide = document.createElement('a');
      guide.href = route.guideUrl;
      guide.textContent = 'View route guide';
      const gpx = document.createElement('a');
      gpx.href = route.gpxUrl;
      gpx.textContent = 'Download GPX';
      gpx.setAttribute('download', '');
      actions.append(guide, gpx);
      popup.append(actions);
      return popup;
    };

    for (const route of routeConfigs) {
      try {
        const response = await fetch(route.geometryUrl, { credentials: 'same-origin' });
        if (!response.ok) throw new Error('Route geometry request failed');
        const geojson = await response.json();
        indexGeometry(geojson);
        let routeStartAdded = false;

        for (const feature of geojson.features ?? []) {
          if (feature.geometry?.type === 'LineString' || feature.geometry?.type === 'MultiLineString') {
            const routeColor = routeColorFor(route.routeId);
            const line = L.geoJSON(feature, {
              pane: 'routes',
              style: {
                color: routeColor,
                weight: 7.5,
                opacity: 1,
                lineCap: 'round',
                lineJoin: 'round'
              }
            });
            line.bindTooltip(route.title, { sticky: true, className: 'rrgh-map-tooltip rrgh-route-tooltip' });
            line.bindPopup(routePopup(route), { maxWidth: 330 });
            line.on('click', () => { selectedRouteId = route.routeId; });
            line.addTo(routeGroup);
            routePaths.push(line);
            routeRecords.push({ layer: line, routeCategory: route.routeCategory });
            const exploreEntry = routeExploreEntries.get(route.routeId) ?? {
              route,
              color: routeColor,
              layers: [],
              bounds: L.latLngBounds([])
            };
            exploreEntry.layers.push(line);
            routeExploreEntries.set(route.routeId, exploreEntry);

            const lineBounds = line.getBounds();
            if (lineBounds.isValid()) {
              routeBounds.extend(lineBounds);
              exploreEntry.bounds.extend(lineBounds);
              searchItems.push({
                label: route.title,
                detail: route.distanceMi.toFixed(2) + ' mi · ' + route.physicalDifficulty + ' · RRGH route',
                bounds: lineBounds,
                open: () => {
                  selectedRouteId = route.routeId;
                  line.openPopup();
                }
              });
            }

            if (!routeStartAdded) {
              const firstLine = geometryLines(feature.geometry)[0] ?? [];
              const first = firstLine[0];
              if (first) {
                const [lng, lat] = first;
                const icon = L.divIcon({
                  className: 'route-start-icon',
                  html: '<span aria-hidden="true"></span>',
                  iconSize: [24, 24],
                  iconAnchor: [12, 12]
                });
                const marker = L.marker([lat, lng], {
                  title: route.title + ' route start',
                  alt: route.title + ' route start',
                  keyboard: true,
                  icon,
                  pane: 'routeStarts',
                  opacity: 1
                });
                const startPopup = document.createElement('div');
                const startHeading = document.createElement('strong');
                startHeading.textContent = 'Route start · ' + route.title;
                startPopup.append(startHeading);
                if (route.accessParking) {
                  const parking = document.createElement('p');
                  parking.textContent = route.accessParking;
                  startPopup.append(parking);
                }
                const routeLink = document.createElement('a');
                routeLink.href = route.guideUrl;
                routeLink.textContent = 'View route guide';
                startPopup.append(routeLink);
                marker.bindPopup(startPopup, { maxWidth: 330 });
                marker.on('click', () => { selectedRouteId = route.routeId; });
                marker.addTo(routeStartGroup);
                routeStartMarkers.push(marker);
                routeStartRecords.push({ layer: marker, routeCategory: route.routeCategory });
                searchItems.push({
                  label: route.title + ' route start',
                  detail: 'RRGH route start',
                  latlng: L.latLng(lat, lng),
                  open: () => marker.openPopup()
                });

                if (route.accessParking) {
                  const parkingIcon = L.divIcon({
                    className: 'route-parking-icon',
                    html: '<span aria-hidden="true">P</span>',
                    iconSize: [24, 24],
                    iconAnchor: [30, 12]
                  });
                  const parkingMarker = L.marker([lat, lng], {
                    title: route.title + ' parking / trailhead',
                    alt: route.title + ' parking / trailhead',
                    keyboard: true,
                    icon: parkingIcon,
                    pane: 'recreation',
                    opacity: 1
                  });
                  const parkingPopup = document.createElement('div');
                  const parkingHeading = document.createElement('strong');
                  parkingHeading.textContent = 'Parking / trailhead · ' + route.title;
                  parkingPopup.append(parkingHeading);
                  const parkingBody = document.createElement('p');
                  parkingBody.textContent = route.accessParking;
                  parkingPopup.append(parkingBody);
                  parkingMarker.bindPopup(parkingPopup, { maxWidth: 330 });
                  parkingMarker.addTo(recreationGroup);
                  recreationMarkers.push(parkingMarker);
                  searchItems.push({
                    label: route.title + ' parking / trailhead',
                    detail: 'RRGH access note',
                    latlng: L.latLng(lat, lng),
                    open: () => parkingMarker.openPopup()
                  });
                }

                routeStartAdded = true;
              }
            }
          } else if (feature.geometry?.type === 'Point') {
            const [lng, lat] = feature.geometry.coordinates;
            const name = featureValue(feature.properties, ['name']);
            const type = featureValue(feature.properties, ['type']);
            const description = featureValue(feature.properties, ['description']);
            const kindClass = /view/i.test(type) ? 'is-viewpoint' : /arch|landmark/i.test(type) ? 'is-landmark' : 'is-landmark';
            const icon = L.divIcon({
              className: 'route-waypoint-icon ' + kindClass,
              html: '<span aria-hidden="true"></span>',
              iconSize: [22, 22],
              iconAnchor: [11, 11]
            });
            const marker = L.marker([lat, lng], {
              title: name,
              alt: name,
              keyboard: true,
              icon,
              pane: 'landmarks',
              opacity: 1
            });
            const popup = document.createElement('div');
            const heading = document.createElement('strong');
            heading.textContent = name;
            popup.append(heading);
            if (type) {
              const meta = document.createElement('p');
              meta.className = 'route-map-popup-meta';
              meta.textContent = type;
              popup.append(meta);
            }
            if (description) {
              const body = document.createElement('p');
              body.textContent = description;
              popup.append(body);
            }
            marker.bindPopup(popup);
            marker.addTo(landmarkGroup);
            landmarkMarkers.push(marker);
            landmarkRecords.push({ layer: marker, routeCategory: route.routeCategory });
            routeBounds.extend([lat, lng]);
            searchItems.push({
              label: name,
              detail: (type || 'Landmark') + ' · ' + route.title,
              latlng: L.latLng(lat, lng),
              open: () => marker.openPopup()
            });
          }
        }
      } catch (error) {
        console.error(error);
        setStatus('The route line could not be loaded. Other map layers are still available.', 'warning');
      }
    }
    setReadiness('routes', routeConfigs.length === 0 || routeExploreEntries.size > 0);
    container.dataset.routeDataReady = String(readiness.routes);
    setLoadProgress(35, 'Loading official trail network…');

    if (mode !== 'full' && routeBounds.isValid()) {
      map.fitBounds(routeBounds.pad(0.28), { maxZoom: 16 });
    }

    const fetchGeoJson = async (id: string) => {
      const source = sourceById(id);
      if (!source?.url) throw new Error('Missing map source URL for ' + id);
      const response = await fetch(source.url, {
        credentials: 'omit',
        mode: 'cors',
        referrerPolicy: 'strict-origin-when-cross-origin'
      });
      if (!response.ok) throw new Error(source.label + ' request failed with ' + response.status);
      const data = await response.json();
      if (data?.error) throw new Error(source.label + ' returned an ArcGIS error');
      return data;
    };

    const fetchPagedGeoJson = async (id: string, pageSize = 1000, maxPages = 8) => {
      const source = sourceById(id);
      if (!source?.url) throw new Error('Missing map source URL for ' + id);
      const features: any[] = [];

      for (let pageIndex = 0; pageIndex < maxPages; pageIndex += 1) {
        const url = new URL(source.url);
        url.searchParams.set('resultOffset', String(pageIndex * pageSize));
        url.searchParams.set('resultRecordCount', String(pageSize));
        url.searchParams.set('orderByFields', 'OBJECTID');

        const response = await fetch(url.toString(), {
          credentials: 'omit',
          mode: 'cors',
          referrerPolicy: 'strict-origin-when-cross-origin'
        });
        if (!response.ok) throw new Error(source.label + ' request failed with ' + response.status);
        const data = await response.json();
        if (data?.error) throw new Error(source.label + ' returned an ArcGIS error');
        const pageFeatures = Array.isArray(data?.features) ? data.features : [];
        features.push(...pageFeatures);
        if (pageFeatures.length < pageSize) break;
      }

      return { type: 'FeatureCollection', features };
    };

    const vectorFailures: string[] = [];

    try {
      const response = await fetch(import.meta.env.BASE_URL + 'data/map/ky-state-park-trails.geojson', {
        credentials: 'same-origin',
        cache: 'no-cache'
      });
      if (!response.ok) throw new Error('State Park trail cache HTTP ' + response.status);
      const stateParkTrails = await response.json();
      if (stateParkTrails?.type !== 'FeatureCollection' || !Array.isArray(stateParkTrails?.features)) {
        throw new Error('State Park trail cache is invalid.');
      }
      indexGeometry(stateParkTrails);
      const seenStateParkLabels = new Set<string>();
      const casing = L.geoJSON(stateParkTrails, {
        pane: 'stateParkTrails',
        interactive: false,
        style: {
          color: '#22313a',
          weight: 5.8,
          opacity: opacity('ky-state-park-trails'),
          dashArray: '8 5',
          lineCap: 'round',
          lineJoin: 'round'
        },
        onEachFeature: (_feature: any, layer: any) => stateParkTrailCasingPaths.push(layer)
      });
      const visible = L.geoJSON(stateParkTrails, {
        pane: 'stateParkTrails',
        style: {
          color: '#e56ad7',
          weight: 3.2,
          opacity: opacity('ky-state-park-trails'),
          dashArray: '8 5',
          lineCap: 'round',
          lineJoin: 'round'
        },
        onEachFeature: (feature: any, layer: any) => {
          const name = featureValue(feature.properties, ['TRAIL_NAME', 'trail_name']) || 'State Park trail';
          const trailId = featureValue(feature.properties, ['TRAIL_ID', 'trail_id']);
          const park = featureValue(feature.properties, ['PUBLIC_NAME', 'public_name']);
          const hiking = featureValue(feature.properties, ['HIKING', 'hiking']);
          const horse = featureValue(feature.properties, ['HORSE', 'horse']);
          const surface = featureValue(feature.properties, ['SURFACE', 'surface']);
          const miles = featureValue(feature.properties, ['TRAIL_MILE', 'trail_mile']);
          const detail = trailId && !name.includes(trailId) ? name + ' · Trail ' + trailId : name;
          layer.bindTooltip(detail, { sticky: true, className: 'rrgh-map-tooltip' });

          const popup = document.createElement('div');
          const heading = document.createElement('strong');
          heading.textContent = detail;
          popup.append(heading);
          const meta = document.createElement('p');
          meta.className = 'route-map-popup-meta';
          meta.textContent = [
            'Kentucky State Park trail',
            park,
            hiking && ('Hiking: ' + hiking),
            horse && ('Horse: ' + horse),
            miles && ('Length: ' + Number(miles).toFixed(2) + ' mi'),
            surface && ('Surface: ' + surface)
          ].filter(Boolean).join(' · ');
          popup.append(meta);
          const source = document.createElement('p');
          source.textContent = 'Source: Kentucky State Parks / Kentucky Division of Geographic Information';
          popup.append(source);
          layer.bindPopup(popup, { maxWidth: 340 });
          stateParkTrailPaths.push(layer);
          if (layer.getBounds) {
            searchItems.push({
              label: detail,
              detail: 'Kentucky State Park trail' + (park ? ' · ' + park : ''),
              bounds: layer.getBounds(),
              open: () => layer.openPopup()
            });
          }

          if (name && !seenStateParkLabels.has(name) && seenStateParkLabels.size < 80 && layer.getBounds) {
            seenStateParkLabels.add(name);
            const center = layer.getBounds().getCenter();
            const marker = L.marker(center, {
              interactive: false,
              pane: 'stateParkTrails',
              icon: L.divIcon({
                className: 'rrgh-trail-label rrgh-state-park-trail-label',
                html: '<span>' + name.replace(/[&<>"']/g, (char: string) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char] as string)) + '</span>',
                iconSize: [170, 24],
                iconAnchor: [85, 12]
              })
            });
            stateParkTrailLabelMarkers.push(marker);
            stateParkTrailLabelGroup.addLayer(marker);
          }
        }
      });
      mapLayers.set('ky-state-park-trails', L.layerGroup([casing, visible]));
      opacitySetters.set('ky-state-park-trails', (value) => {
        stateParkTrailCasingPaths.forEach((layer) => layer.setStyle({ opacity: value }));
        stateParkTrailPaths.forEach((layer) => layer.setStyle({ opacity: value }));
        stateParkTrailLabelMarkers.forEach((marker) => marker.setOpacity(value));
      });
      container.dataset.stateParkTrailFeatureCount = String(stateParkTrails.features.length);
      syncVisibility('ky-state-park-trails');
    } catch (error) {
      console.error(error);
      container.dataset.stateParkTrailFeatureCount = '0';
      vectorFailures.push('State Park trails');
    }
    setLoadProgress(47, 'Official State Park trails ready…');

    try {
      const trails = await fetchGeoJson('usfs-trails');
      indexGeometry(trails);
      const seenLabels = new Set<string>();
      const trailCasingLayer = L.geoJSON(trails, {
        pane: 'trails',
        interactive: false,
        style: {
          color: '#22313a',
          weight: 5.4,
          opacity: opacity('usfs-trails'),
          dashArray: '8 5',
          lineCap: 'round',
          lineJoin: 'round'
        },
        onEachFeature: (_feature: any, layer: any) => trailCasingPaths.push(layer)
      });
      const trailLayer = L.geoJSON(trails, {
        pane: 'trails',
        style: {
          color: '#00c8ff',
          weight: 2.6,
          opacity: opacity('usfs-trails'),
          dashArray: '8 5',
          lineCap: 'round',
          lineJoin: 'round'
        },
        onEachFeature: (feature: any, layer: any) => {
          const name = featureValue(feature.properties, ['trail_name', 'TRAIL_NAME']);
          const number = featureValue(feature.properties, ['trail_no', 'TRAIL_NO']);
          const trailClass = featureValue(feature.properties, ['trail_class', 'TRAIL_CLASS']);
          const status = featureValue(feature.properties, ['attributesubset', 'ATTRIBUTE_SUBSET']);
          const label = name || (number ? 'Trail ' + number : 'Forest Service trail');
          const detail = name && number ? name + ' · Trail ' + number : label;
          layer.bindTooltip(detail, { sticky: true, className: 'rrgh-map-tooltip' });

          const popup = document.createElement('div');
          const heading = document.createElement('strong');
          heading.textContent = detail;
          popup.append(heading);
          const meta = document.createElement('p');
          meta.className = 'route-map-popup-meta';
          meta.textContent = ['USDA Forest Service trail', trailClass, status].filter(Boolean).join(' · ');
          popup.append(meta);
          const source = document.createElement('p');
          source.textContent = 'Source: USDA Forest Service Enterprise Data Warehouse';
          popup.append(source);
          layer.bindPopup(popup, { maxWidth: 320 });
          trailPaths.push(layer);

          if (layer.getBounds) {
            searchItems.push({
              label: detail,
              detail: 'Forest Service trail',
              bounds: layer.getBounds(),
              open: () => layer.openPopup()
            });
          }

          if (name && !seenLabels.has(name) && seenLabels.size < 80 && layer.getBounds) {
            seenLabels.add(name);
            const center = layer.getBounds().getCenter();
            const marker = L.marker(center, {
              interactive: false,
              pane: 'trails',
              icon: L.divIcon({
                className: 'rrgh-trail-label',
                html: '<span>' + name.replace(/[&<>"']/g, (char: string) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char] as string)) + '</span>',
                iconSize: [160, 24],
                iconAnchor: [80, 12]
              })
            });
            trailLabelMarkers.push(marker);
            trailLabelGroup.addLayer(marker);
          }
        }
      });
      container.dataset.trailFeatureCount = String(trailPaths.length);
      mapLayers.set('usfs-trails', L.layerGroup([trailCasingLayer, trailLayer]));
      opacitySetters.set('usfs-trails', (value) => {
        trailCasingPaths.forEach((layer) => layer.setStyle({ opacity: value }));
        trailPaths.forEach((layer) => layer.setStyle({ opacity: value }));
        trailLabelMarkers.forEach((marker) => marker.setOpacity(value));
      });
      syncVisibility('usfs-trails');
    } catch (error) {
      console.error(error);
      vectorFailures.push('Forest Service trails');
    }
    setLoadProgress(58, 'Official trail network ready…');

    try {
      const roads = await fetchGeoJson('usfs-roads');
      const roadCasingLayer = L.geoJSON(roads, {
        pane: 'roads',
        interactive: false,
        style: {
          color: '#22313a',
          weight: 6,
          opacity: opacity('usfs-roads'),
          dashArray: '12 6',
          lineCap: 'round',
          lineJoin: 'round'
        },
        onEachFeature: (_feature: any, layer: any) => roadCasingPaths.push(layer)
      });
      const roadLayer = L.geoJSON(roads, {
        pane: 'roads',
        style: {
          color: '#ffcf33',
          weight: 3,
          opacity: opacity('usfs-roads'),
          dashArray: '12 6',
          lineCap: 'round',
          lineJoin: 'round'
        },
        onEachFeature: (feature: any, layer: any) => {
          const name = featureValue(feature.properties, ['name', 'NAME']);
          const id = featureValue(feature.properties, ['id', 'ID']);
          const routeStatus = featureValue(feature.properties, ['route_status', 'ROUTE_STATUS']);
          const maintenance = featureValue(feature.properties, ['oper_maint_level', 'OPER_MAINT_LEVEL']);
          const label = name || (id ? 'Forest Road ' + id : 'Forest Service road');
          layer.bindTooltip(label, { sticky: true, className: 'rrgh-map-tooltip' });

          const popup = document.createElement('div');
          const heading = document.createElement('strong');
          heading.textContent = label;
          popup.append(heading);
          const meta = document.createElement('p');
          meta.className = 'route-map-popup-meta';
          meta.textContent = ['USDA Forest Service road', routeStatus && ('Status: ' + routeStatus), maintenance && ('Maintenance level: ' + maintenance)].filter(Boolean).join(' · ');
          popup.append(meta);
          layer.bindPopup(popup, { maxWidth: 320 });
          roadPaths.push(layer);
          for (const line of geometryLines(feature.geometry)) addSnapLine(line);

          if (layer.getBounds) {
            searchItems.push({
              label,
              detail: 'Forest Service road',
              bounds: layer.getBounds(),
              open: () => layer.openPopup()
            });
          }
        }
      });
      container.dataset.roadFeatureCount = String(roadPaths.length);
      mapLayers.set('usfs-roads', L.layerGroup([roadCasingLayer, roadLayer]));
      opacitySetters.set('usfs-roads', (value) => {
        roadCasingPaths.forEach((layer) => layer.setStyle({ opacity: value }));
        roadPaths.forEach((layer) => layer.setStyle({ opacity: value }));
      });
      syncVisibility('usfs-roads');
    } catch (error) {
      console.error(error);
      vectorFailures.push('Forest Service roads');
    }

    try {
      const kentuckyRoads = await fetchPagedGeoJson('ky-road-centerlines');
      let planningRoadFeatures = 0;
      const excludedRoadClass = /interstate|freeway|expressway|limited\s*access|ramp|parkway/i;

      for (const feature of kentuckyRoads.features ?? []) {
        const roadClass = featureValue(feature.properties, ['RoadClass', 'ROADCLASS']);
        const roadName = featureValue(feature.properties, ['LSt_Name', 'St_Name', 'LST_NAME', 'ST_NAME']);
        if (excludedRoadClass.test(roadClass) || /parkway/i.test(roadName)) continue;

        let indexed = false;
        for (const line of geometryLines(feature.geometry)) {
          if (line.length < 2) continue;
          const roadTag = normalizeKentuckyRoadTag(roadName, roadClass);
          const keys = addSnapLine(line, roadTag);
          if (keys.length > 1) indexed = true;
        }
        if (indexed) planningRoadFeatures += 1;
      }

      container.dataset.planningRoadFeatureCount = String(planningRoadFeatures);
      connectNamedRoadEndpointGaps();
    } catch (error) {
      console.error(error);
      container.dataset.planningRoadFeatureCount = '0';
      vectorFailures.push('Kentucky road-planning network');
    }

    try {
      const sites = await fetchGeoJson('usfs-recreation-sites');
      const allowedSiteTypes = new Set([
        'TRAILHEAD',
        'DAY USE AREA',
        'PICNIC SITE',
        'INFO SITE/FEE STATION',
        'INTERPRETIVE VISITOR CENTER (MAJOR)',
        'INTERPRETIVE VISITOR CENTER (MINOR)',
        'OBSERVATION SITE'
      ]);
      const recreationFeatures = (sites.features ?? []).filter((feature: any) => {
        const type = featureValue(feature.properties, ['site_type', 'SITE_TYPE']).toUpperCase();
        return allowedSiteTypes.has(type);
      });

      for (const feature of recreationFeatures) {
        if (feature.geometry?.type !== 'Point') continue;
        const [lng, lat] = feature.geometry.coordinates;
        const name = featureValue(feature.properties, ['public_site_name', 'site_name', 'SITE_NAME']) || 'Forest Service recreation site';
        const type = featureValue(feature.properties, ['site_type', 'SITE_TYPE']);
        const seasonalStatus = featureValue(feature.properties, ['seasonal_operational_status', 'SEASONAL_OPERATIONAL_STATUS']);
        const portalUrl = featureValue(feature.properties, ['usda_portal_url', 'USDA_PORTAL_URL']);
        const isTrailhead = /TRAILHEAD/i.test(type);
        const icon = L.divIcon({
          className: isTrailhead ? 'route-trailhead-icon' : 'route-facility-icon',
          html: isTrailhead ? '<span aria-hidden="true">▲</span>' : '<span aria-hidden="true">i</span>',
          iconSize: [24, 24],
          iconAnchor: [12, 12]
        });
        const marker = L.marker([lat, lng], {
          title: name,
          alt: name,
          keyboard: true,
          icon,
          pane: 'recreation',
          opacity: 1
        });
        const popup = document.createElement('div');
        const heading = document.createElement('strong');
        heading.textContent = name;
        popup.append(heading);
        const meta = document.createElement('p');
        meta.className = 'route-map-popup-meta';
        meta.textContent = [type, seasonalStatus && ('Status: ' + seasonalStatus)].filter(Boolean).join(' · ');
        popup.append(meta);
        const source = document.createElement('p');
        source.textContent = 'Source: USDA Forest Service recreation-site data';
        popup.append(source);
        if (portalUrl) {
          const link = document.createElement('a');
          link.href = portalUrl;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.textContent = 'Open Forest Service site information';
          popup.append(link);
        }
        marker.bindPopup(popup, { maxWidth: 320 });
        marker.addTo(recreationGroup);
        recreationMarkers.push(marker);
        searchItems.push({
          label: name,
          detail: type || 'Forest Service recreation site',
          latlng: L.latLng(lat, lng),
          open: () => marker.openPopup()
        });
      }
      container.dataset.recreationSiteCount = String(recreationMarkers.length);
      if (!map.hasLayer(recreationGroup)) recreationGroup.addTo(map);
    } catch (error) {
      console.error(error);
      vectorFailures.push('Trailheads & facilities');
    }

    try {
      const counties = await fetchGeoJson('ky-counties');
      const gorgeCountyNames = new Set(['Wolfe', 'Powell', 'Menifee', 'Lee']);
      const gorgeCounties = {
        ...counties,
        features: (counties.features ?? []).filter((feature: any) => {
          const name = featureValue(feature.properties, ['NAME', 'name']);
          return gorgeCountyNames.has(name);
        })
      };
      const seenCounties = new Set<string>();
      const countyLayer = L.geoJSON(gorgeCounties, {
        pane: 'counties',
        style: {
          color: '#665d4f',
          weight: 2.2,
          opacity: 0.86,
          fillOpacity: 0,
          dashArray: '8 5'
        },
        onEachFeature: (feature: any, layer: any) => {
          const name = featureValue(feature.properties, ['NAME', 'name']);
          if (name) layer.bindTooltip(name + ' County', { sticky: true, className: 'rrgh-map-tooltip' });
          countyPaths.push(layer);
          if (name && !seenCounties.has(name) && layer.getBounds) {
            seenCounties.add(name);
            const center = layer.getBounds().getCenter();
            const marker = L.marker(center, {
              interactive: false,
              pane: 'counties',
              icon: L.divIcon({
                className: 'rrgh-county-label',
                html: '<span>' + name.replace(/[&<>"']/g, (char: string) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char] as string)) + ' County</span>',
                iconSize: [150, 24],
                iconAnchor: [75, 12]
              })
            });
            countyLabelMarkers.push(marker);
            countyLabelGroup.addLayer(marker);
          }
        }
      });
      container.dataset.gorgeCountyCount = String(gorgeCounties.features.length);
      mapLayers.set('ky-counties', countyLayer);
      countyLayer.addTo(map);

      if (mode === 'full') {
        const gorgeBounds = countyLayer.getBounds();
        if (gorgeBounds.isValid()) {
          const paddedBounds = gorgeBounds.pad(0.035);
          homeBounds = paddedBounds;
          map.setMaxBounds(paddedBounds);
          container.dataset.gorgeOverviewZoom = String(map.getZoom());
        }
      }
    } catch (error) {
      console.error(error);
      vectorFailures.push('County boundaries');
    }
    setLoadProgress(78, 'Map context ready…');

    const loadPolygonLayer = async (
      id: string,
      pane: string,
      style: Record<string, unknown>,
      nameFields: string[],
      detailLabel: string,
      pathStore: any[]
    ) => {
      if (mapLayers.has(id)) {
        syncVisibility(id);
        return;
      }
      const data = await fetchGeoJson(id);
      const layer = L.geoJSON(data, {
        pane,
        style: { ...style, opacity: opacity(id) },
        onEachFeature: (feature: any, featureLayer: any) => {
          const name = featureValue(feature.properties, nameFields) || detailLabel;
          featureLayer.bindTooltip(name, { sticky: true, className: 'rrgh-map-tooltip' });
          const popup = document.createElement('div');
          const heading = document.createElement('strong');
          heading.textContent = name;
          popup.append(heading);
          const body = document.createElement('p');
          body.textContent = detailLabel + ' · USDA Forest Service';
          popup.append(body);
          featureLayer.bindPopup(popup);
          pathStore.push(featureLayer);
          if (featureLayer.getBounds) {
            searchItems.push({
              label: name,
              detail: detailLabel,
              bounds: featureLayer.getBounds(),
              open: () => featureLayer.openPopup()
            });
          }
        }
      });
      mapLayers.set(id, layer);
      opacitySetters.set(id, (value) => pathStore.forEach((path) => path.setStyle({ opacity: value })));
      syncVisibility(id);
    };

    const loadLandContext = async (id: string) => {
      try {
        if (id === 'usfs-wilderness') {
          await loadPolygonLayer(
            id,
            'wilderness',
            normalContextStyles['usfs-wilderness']!,
            ['wildernessname', 'WILDERNESSNAME'],
            'National Forest Wilderness boundary',
            wildernessPaths
          );
        } else if (id === 'usfs-special-management') {
          await loadPolygonLayer(
            id,
            'specialManagement',
            normalContextStyles['usfs-special-management']!,
            ['areaname', 'casename', 'AREANAME', 'CASENAME'],
            'Forest Service special management area',
            specialManagementPaths
          );
        } else if (id === 'usfs-land-units') {
          await loadPolygonLayer(
            id,
            'landUnits',
            normalContextStyles['usfs-land-units']!,
            ['nfslandunitname', 'NFSLANDUNITNAME'],
            'National Forest land unit',
            landUnitPaths
          );
        }
        syncLandContextStyles();
      } catch (error) {
        console.error(error);
        setStatus('That land-management layer is unavailable right now.', 'warning');
        const checkbox = shell.querySelector<HTMLInputElement>('[data-map-layer="' + id + '"]');
        if (checkbox) checkbox.checked = false;
      }
    };

    const loadInformalTrails = async () => {
      if (mapLayers.has('osm-informal-trails')) {
        syncVisibility('osm-informal-trails');
        setPlanningGraphReady(true);
        return;
      }

      const checkbox = shell.querySelector<HTMLInputElement>('[data-map-layer="osm-informal-trails"]');
      if (checkbox) checkbox.disabled = true;
      setPlanningGraphReady(false);
      setStatus('Loading Community / Informal trails… Build trail route will unlock when the planning graph is ready.');

      const cachedUrl = import.meta.env.BASE_URL + 'data/map/osm-informal-trails.geojson';
      const usgsCachedUrl = import.meta.env.BASE_URL + 'data/map/usgs-aggregated-trails.geojson';
      const query = '[out:json][timeout:45];way["highway"="path"]["informal"="yes"](37.45,-83.93,38.05,-83.25);out tags geom qt;';
      const overpassEndpoints = [
        'https://overpass.maprva.org/api/interpreter',
        'https://overpass.private.coffee/api/interpreter',
        'https://overpass-api.de/api/interpreter',
        'https://maps.mail.ru/osm/tools/overpass/api/interpreter'
      ];

      const fetchLiveFallback = async () => {
        const controllers = overpassEndpoints.map(() => new AbortController());
        const timeoutIds = controllers.map((controller) => window.setTimeout(() => controller.abort(), 15000));

        const requestEndpoint = async (base: string, index: number) => {
          const response = await fetch(base, {
            method: 'POST',
            credentials: 'omit',
            mode: 'cors',
            referrerPolicy: 'strict-origin-when-cross-origin',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
            body: 'data=' + encodeURIComponent(query),
            signal: controllers[index]!.signal
          });
          if (!response.ok) throw new Error(base + ': HTTP ' + response.status);
          const json = await response.json();
          if (!json || !Array.isArray(json.elements)) throw new Error(base + ': invalid Overpass JSON');
          return { base, json };
        };

        try {
          const winner = await Promise.any(
            overpassEndpoints.map((base, index) => requestEndpoint(base, index))
          );
          for (const controller of controllers) controller.abort();

          const features = (winner.json.elements ?? [])
            .filter((element: any) => Array.isArray(element.geometry) && element.geometry.length > 1)
            .map((element: any) => ({
              type: 'Feature',
              properties: { ...(element.tags ?? {}), osm_id: element.id },
              geometry: {
                type: 'LineString',
                coordinates: element.geometry.map((point: any) => [point.lon, point.lat])
              }
            }));

          container.dataset.informalTrailSource = new URL(winner.base).hostname;
          return { type: 'FeatureCollection', features };
        } finally {
          for (const controller of controllers) controller.abort();
          for (const timeoutId of timeoutIds) window.clearTimeout(timeoutId);
        }
      };

      try {
        let featureCollection: any = null;

        try {
          const cacheResponse = await fetch(cachedUrl, { credentials: 'same-origin', cache: 'no-cache' });
          if (!cacheResponse.ok) throw new Error('Cached OSM GeoJSON HTTP ' + cacheResponse.status);
          const cached = await cacheResponse.json();
          if (cached?.type !== 'FeatureCollection' || !Array.isArray(cached.features)) {
            throw new Error('Cached OSM GeoJSON is invalid');
          }
          featureCollection = cached;
          container.dataset.informalTrailSource = 'rrgh-cache';
        } catch (cacheError) {
          console.warn('RRGH OSM cache unavailable; trying live public Overpass services.', cacheError);
          featureCollection = await fetchLiveFallback();
        }

        let usgsFeatureCollection: any = { type: 'FeatureCollection', features: [] };
        try {
          const usgsResponse = await fetch(usgsCachedUrl, { credentials: 'same-origin', cache: 'no-cache' });
          if (!usgsResponse.ok) throw new Error('Cached USGS Aggregated Trails GeoJSON HTTP ' + usgsResponse.status);
          const cachedUsgs = await usgsResponse.json();
          if (cachedUsgs?.type !== 'FeatureCollection' || !Array.isArray(cachedUsgs.features)) {
            throw new Error('Cached USGS Aggregated Trails GeoJSON is invalid');
          }
          usgsFeatureCollection = cachedUsgs;
        } catch (usgsCacheError) {
          console.warn('RRGH USGS Aggregated Trails cache unavailable; continuing with the existing Community / Informal source only.', usgsCacheError);
        }

        const combinedFeatureCollection = {
          type: 'FeatureCollection',
          features: [
            ...(featureCollection?.features ?? []),
            ...(usgsFeatureCollection?.features ?? [])
          ]
        };
        container.dataset.informalTrailOsmCount = String(featureCollection?.features?.length ?? 0);
        container.dataset.informalTrailUsgsCount = String(usgsFeatureCollection?.features?.length ?? 0);

        const casingLayer = L.geoJSON(combinedFeatureCollection as any, {
          pane: 'informalTrails',
          interactive: false,
          style: {
            color: '#22313a',
            weight: 5.2,
            opacity: opacity('osm-informal-trails'),
            dashArray: '6 5',
            lineCap: 'round',
            lineJoin: 'round'
          },
          onEachFeature: (_feature: any, featureLayer: any) => {
            informalCasingPaths.push(featureLayer);
          }
        });

        const layer = L.geoJSON(combinedFeatureCollection as any, {
          pane: 'informalTrails',
          style: (feature: any) => {
            const access = String(feature?.properties?.access ?? feature?.properties?.foot ?? '').toLowerCase();
            const hikerPedestrian = String(feature?.properties?.hikerpedestrian ?? '').toLowerCase();
            const restricted = access === 'no' || access === 'private'
              || hikerPedestrian === 'n' || hikerPedestrian === 'no'
              || feature?.properties?.rrgh_planner_eligible === false;
            return {
              color: restricted ? '#b9b9b9' : '#f7f2e7',
              weight: restricted ? 2.2 : 2.4,
              opacity: opacity('osm-informal-trails'),
              dashArray: '6 5',
              lineCap: 'round',
              lineJoin: 'round'
            };
          },
          onEachFeature: (feature: any, featureLayer: any) => {
            const props = feature.properties ?? {};
            const isUsgs = String(props.rrgh_source ?? '') === 'usgs-aggregated-trails';
            const classification = String(props.rrgh_classification ?? (props.informal === 'yes' ? 'informal' : 'community-candidate'));
            const label = isUsgs
              ? 'USGS aggregated trail'
              : (classification === 'informal' ? 'Informal trail' : 'Community trail candidate');
            const name = String(props.name ?? props.maplabel ?? label);
            const access = String(props.access ?? props.foot ?? 'not specified');
            const visibility = String(props.trail_visibility ?? 'not specified');
            const hikerPedestrian = String(props.hikerpedestrian ?? 'not specified');
            const packSaddle = String(props.packsaddle ?? 'not specified');
            const sourceOriginator = String(props.sourceoriginator ?? 'not specified');
            const accessLower = access.toLowerCase();
            const hikerLower = hikerPedestrian.toLowerCase();
            const restricted = accessLower === 'no' || accessLower === 'private'
              || hikerLower === 'n' || hikerLower === 'no'
              || props.rrgh_planner_eligible === false;

            const popup = document.createElement('div');
            const heading = document.createElement('strong');
            heading.textContent = name;
            popup.append(heading);

            const warning = document.createElement('p');
            warning.className = 'route-map-popup-warning';
            warning.textContent = isUsgs
              ? 'USGS National Digital Trails / National Transportation Dataset feature that adds coverage beyond the current Forest Service trail layer and existing RRGH OpenStreetMap community cache. Source data may lag current access, maintenance, closures, or on-the-ground conditions.'
              : (classification === 'informal'
                  ? 'Mapped by OpenStreetMap as an informal trail. Not an official Forest Service trail; mapping does not establish legal access or current conditions.'
                  : 'OpenStreetMap trail-like path that does not substantially match the authoritative Forest Service trail geometry. Treat it as a community/unofficial candidate, not proof of legal access or current conditions.');
            popup.append(warning);

            const meta = document.createElement('p');
            meta.className = 'route-map-popup-meta';
            meta.textContent = isUsgs
              ? 'Hiker/Pedestrian: ' + hikerPedestrian + ' · Pack and Saddle: ' + packSaddle + ' · Source originator: ' + sourceOriginator + (restricted ? ' · Not used for route snapping' : ' · Available for route snapping')
              : 'Access: ' + access + ' · Trail visibility: ' + visibility + (restricted ? ' · Not used for route snapping' : ' · Available for route snapping');
            popup.append(meta);

            const source = document.createElement('a');
            source.href = isUsgs
              ? 'https://partnerships.nationalmap.gov/arcgis/rest/services/USGSTrails/MapServer/0'
              : 'https://www.openstreetmap.org/copyright';
            source.target = '_blank';
            source.rel = 'noopener noreferrer';
            source.textContent = isUsgs
              ? 'Source: USGS The National Map — National Digital Trails'
              : 'Map data © OpenStreetMap contributors';
            popup.append(source);

            featureLayer.bindPopup(popup, { maxWidth: 360 });
            featureLayer.bindTooltip(name, { sticky: true, className: 'rrgh-map-tooltip' });
            informalPaths.push(featureLayer);

            if (!restricted) {
              for (const line of geometryLines(feature.geometry)) addSnapLine(line);
            }

            if (featureLayer.getBounds) {
              searchItems.push({
                label: name,
                detail: label + ' · ' + (isUsgs ? 'USGS National Digital Trails' : 'OpenStreetMap'),
                bounds: featureLayer.getBounds(),
                open: () => featureLayer.openPopup()
              });
            }
          }
        });

        const informalComposite = L.layerGroup([casingLayer, layer]);
        mapLayers.set('osm-informal-trails', informalComposite);
        opacitySetters.set('osm-informal-trails', (value) => {
          informalCasingPaths.forEach((path) => path.setStyle({ opacity: value }));
          informalPaths.forEach((path) => path.setStyle({ opacity: value }));
        });
        map.attributionControl.addAttribution('<a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">© OpenStreetMap contributors</a>');
        if ((usgsFeatureCollection?.features?.length ?? 0) > 0) {
          map.attributionControl.addAttribution('<a href="https://partnerships.nationalmap.gov/arcgis/rest/services/USGSTrails/MapServer/0" target="_blank" rel="noopener noreferrer">USGS The National Map trails</a>');
        }
        container.dataset.informalTrailCount = String(informalPaths.length);
        syncVisibility('osm-informal-trails');

        bridgeNearbyNetworkNodes();
        container.dataset.plannerNodeCount = String(graph.size);
        setPlanningGraphReady(true);

        setStatus(
          informalPaths.length
            ? 'Trail and road planning network loaded.'
            : 'OpenStreetMap trail data loaded. Build trail route is ready.'
        );
        window.setTimeout(() => {
          if (readiness.core && activeTool === null) {
            setStatus('Drag to pan, use +/− or pinch to zoom. Right-click on desktop or press and hold on mobile for Map Point coordinates and sunlight. Use Explore to browse routes or Plan to measure and build a route.');
          }
        }, 1600);
      } catch (error) {
        console.error(error);
        if (checkbox) checkbox.checked = false;
        setPlanningGraphReady(false);
        setStatus('Community / Informal trails are temporarily unavailable. Measure remains available; Build trail route stays disabled until the planning graph loads.', 'warning');
      } finally {
        if (checkbox) checkbox.disabled = false;
      }
    };

    bridgeNearbyNetworkNodes();
    container.dataset.plannerNodeCount = String(graph.size);

    const routeCategoryEnabled = (routeCategory: string) =>
      shell.querySelector<HTMLInputElement>('[data-route-category-filter="' + routeCategory + '"]')?.checked ?? true;

    const routeRecordEnabled = (record: { routeCategory: string }) =>
      routeCategoryEnabled(record.routeCategory);

    const syncRouteFilters = () => {
      let visibleRoutes = 0;
      let visibleLandmarks = 0;
      let visibleStarts = 0;

      for (const record of routeRecords) {
        if (routeRecordEnabled(record)) {
          routeGroup.addLayer(record.layer);
          visibleRoutes += 1;
        } else {
          routeGroup.removeLayer(record.layer);
        }
      }
      for (const record of routeStartRecords) {
        if (routeRecordEnabled(record)) {
          routeStartGroup.addLayer(record.layer);
          visibleStarts += 1;
        } else {
          routeStartGroup.removeLayer(record.layer);
        }
      }
      for (const record of landmarkRecords) {
        if (routeRecordEnabled(record)) {
          landmarkGroup.addLayer(record.layer);
          visibleLandmarks += 1;
        } else {
          landmarkGroup.removeLayer(record.layer);
        }
      }

      container.dataset.visibleRouteCount = String(visibleRoutes);
      container.dataset.visibleRouteStartCount = String(visibleStarts);
      container.dataset.visibleLandmarkCount = String(visibleLandmarks);
      renderExploreRoutes();
    };

    const resetRouteHighlight = (entry: any) => {
      const weight = map.getZoom() < 11 ? 4.5 : 7.5;
      for (const layer of entry.layers) layer.setStyle({ color: entry.color, weight, opacity: 1 });
    };

    const renderExploreRoutes = () => {
      if (!exploreList) return;
      exploreList.replaceChildren();
      const entries = Array.from(routeExploreEntries.values())
        .filter((entry) => routeCategoryEnabled(entry.route.routeCategory))
        .sort((a, b) => a.route.title.localeCompare(b.route.title));

      for (const entry of entries) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'route-explore-card';

        const swatch = document.createElement('span');
        swatch.className = 'route-explore-color';
        swatch.style.background = entry.color;
        swatch.setAttribute('aria-hidden', 'true');

        const copy = document.createElement('span');
        const title = document.createElement('strong');
        title.textContent = entry.route.title;
        const meta = document.createElement('small');
        meta.textContent = entry.route.distanceMi.toFixed(2) + ' mi · ' + routeCategoryLabel(entry.route.routeCategory) + ' · ' + entry.route.physicalDifficulty;
        copy.append(title, meta);
        button.append(swatch, copy);

        button.addEventListener('pointerenter', () => {
          for (const layer of entry.layers) {
            layer.setStyle({ color: entry.color, weight: 11, opacity: 1 });
            layer.bringToFront?.();
          }
        });
        button.addEventListener('pointerleave', () => resetRouteHighlight(entry));
        button.addEventListener('click', () => {
          selectedRouteId = entry.route.routeId;
          if (entry.bounds?.isValid?.()) map.fitBounds(entry.bounds.pad(0.35), { maxZoom: 15 });
          entry.layers[0]?.openPopup?.();
        });
        exploreList.append(button);
      }

      if (!entries.length) {
        const empty = document.createElement('p');
        empty.className = 'route-search-empty';
        empty.textContent = 'No RRGH routes match the current route filters.';
        exploreList.append(empty);
      }
    };

    const setLayerControl = (id: string, enabled: boolean, opacityValue?: number) => {
      const checkbox = shell.querySelector<HTMLInputElement>('[data-map-layer="' + id + '"]');
      const slider = shell.querySelector<HTMLInputElement>('[data-opacity="' + id + '"]');
      if (id === gorgeLayerId) {
        if (checkbox) {
          checkbox.checked = enabled;
          checkbox.indeterminate = false;
        }
        if (slider && opacityValue !== undefined) slider.value = String(opacityValue);
        setSunKinds(enabled);
        if (opacityValue !== undefined) syncOpacity(id);
        return;
      }
      if (checkbox) checkbox.checked = enabled;
      if (slider && opacityValue !== undefined) slider.value = String(opacityValue);
      if (id === 'ky-hillshade' && enabled && opacityValue === undefined && slider && Number(slider.value) < 75) slider.value = '75';
      if (id === oilGasLayerId) {
        setOilGasKinds(enabled);
      } else if (id === weatherLayerId) {
        syncVisibility(id);
        syncFineTuneControl(id);
        if (enabled) void loadWeatherOverlay();
      } else if (id === localRoadLayerId) {
        syncLocalRoadLayer();
        syncFineTuneControl(id);
      } else {
        syncVisibility(id);
        syncFineTuneControl(id);
      }
      if (opacityValue !== undefined || (id === 'ky-hillshade' && enabled)) syncOpacity(id);
    };

    const clearPresetState = () => {
      for (const button of shell.querySelectorAll<HTMLButtonElement>('[data-map-preset]')) {
        button.setAttribute('aria-pressed', 'false');
      }
      if (mobilePresetSelect) mobilePresetSelect.selectedIndex = -1;
      if (stage) delete stage.dataset.sunlightMode;
    };

    const applyPreset = (name: string) => {
      clearPresetState();
      shell.querySelector<HTMLButtonElement>('[data-map-preset="' + name + '"]')?.setAttribute('aria-pressed', 'true');
      if (mobilePresetSelect && ['hiking', 'terrain', 'aerial', 'sunlight'].includes(name)) mobilePresetSelect.value = name;
      if (stage && name === 'sunlight') stage.dataset.sunlightMode = 'true';

      if (name === 'hiking') {
        setLayerControl('kytopo', false, 88);
        setLayerControl('usgs-topo', true, 100);
        setLayerControl('ky-hillshade', false, 75);
        setLayerControl('kyaerial-phase3', false, 100);
        setLayerControl('kyaerial-phase2-leafoff', false, 100);
        setLayerControl('usfs-wilderness', true);
        setLayerControl(localRoadLayerId, false);
        setLayerControl(weatherLayerId, false, 35);
        setSunKinds(false);
      } else if (name === 'terrain') {
        setLayerControl('kytopo', true, 25);
        setLayerControl('usgs-topo', true, 75);
        setLayerControl('ky-hillshade', true, 100);
        setLayerControl('kyaerial-phase3', false, 100);
        setLayerControl('kyaerial-phase2-leafoff', false, 100);
        setLayerControl('usfs-wilderness', true);
        setLayerControl(localRoadLayerId, true);
        if (weatherSelect) weatherSelect.value = 'precip-10d';
        setLayerControl(weatherLayerId, false, 35);
        setSunKinds(false);
      } else if (name === 'aerial') {
        setLayerControl('kytopo', false, 70);
        setLayerControl('usgs-topo', false, 70);
        setLayerControl('ky-hillshade', false, 75);
        setLayerControl('kyaerial-phase2-leafoff', false, 100);
        setLayerControl('kyaerial-phase3', true, 100);
        setLayerControl(localRoadLayerId, true);
        setLayerControl(weatherLayerId, false, 35);
        setSunKinds(false);
      } else if (name === 'sunlight') {
        setLayerControl('kytopo', false, 0);
        setLayerControl('usgs-topo', true, 100);
        setLayerControl('ky-hillshade', true, 25);
        setLayerControl('kyaerial-phase3', false, 100);
        setLayerControl('kyaerial-phase2-leafoff', false, 100);
        setLayerControl('usfs-wilderness', true);
        const sunOpacity = shell.querySelector<HTMLInputElement>('[data-opacity="' + gorgeLayerId + '"]');
        if (sunOpacity) sunOpacity.value = '100';
        setLayerControl(localRoadLayerId, false);
        setLayerControl(weatherLayerId, false, 35);
        setSunKinds(true);
      }
      syncAerialControlState();
      syncContextLabels();
    };

    const syncContextLabels = () => {
      const forestTrailsVisible = checked('usfs-trails') && map.getZoom() >= 13;
      if (forestTrailsVisible && !map.hasLayer(trailLabelGroup)) trailLabelGroup.addTo(map);
      if (!forestTrailsVisible && map.hasLayer(trailLabelGroup)) map.removeLayer(trailLabelGroup);
      const stateParkTrailsVisible = checked('ky-state-park-trails') && map.getZoom() >= (isMobileFullMap() ? 16 : 15);
      if (stateParkTrailsVisible && !map.hasLayer(stateParkTrailLabelGroup)) stateParkTrailLabelGroup.addTo(map);
      if (!stateParkTrailsVisible && map.hasLayer(stateParkTrailLabelGroup)) map.removeLayer(stateParkTrailLabelGroup);

      const countiesVisible = map.getZoom() <= 13;
      if (countiesVisible && !map.hasLayer(countyLabelGroup)) countyLabelGroup.addTo(map);
      if (!countiesVisible && map.hasLayer(countyLabelGroup)) map.removeLayer(countyLabelGroup);
    };

    const presetLayerIds = new Set(['kytopo', 'usgs-topo', 'ky-hillshade', 'kyaerial-phase3', 'kyaerial-phase2-leafoff', weatherLayerId]);
    const optionalLandLayerIds = new Set(['usfs-wilderness', 'usfs-special-management', 'usfs-land-units']);

    for (const checkbox of shell.querySelectorAll<HTMLInputElement>('[data-map-layer]')) {
      checkbox.addEventListener('change', async () => {
        const id = checkbox.dataset.mapLayer;
        if (!id) return;
        if (presetLayerIds.has(id)) clearPresetState();

        if (aerialLayerIds.has(id) && checkbox.checked) {
          for (const otherAerialId of aerialLayerIds) {
            if (otherAerialId !== id) setLayerControl(otherAerialId, false);
          }
          setLayerControl('kytopo', false);
          setLayerControl('usgs-topo', false);
          setLayerControl('ky-hillshade', false);
        } else if (aerialExclusiveIds.has(id) && checkbox.checked) {
          for (const aerialId of aerialLayerIds) setLayerControl(aerialId, false);
        }

        if (id === 'ky-hillshade' && checkbox.checked) {
          const terrainSlider = shell.querySelector<HTMLInputElement>('[data-opacity="ky-hillshade"]');
          if (terrainSlider && Number(terrainSlider.value) < 75) terrainSlider.value = '75';
          syncOpacity('ky-hillshade');
        }

        if (id === gorgeLayerId) {
          setSunKinds(checkbox.checked);
        } else if (id === oilGasLayerId) {
          setOilGasKinds(checkbox.checked);
        } else if (id === localRoadLayerId) {
          syncLocalRoadLayer();
        } else if (id === weatherLayerId) {
          syncVisibility(id);
          if (checkbox.checked) await loadWeatherOverlay();
        } else if (checkbox.checked && id === 'osm-informal-trails') {
          await loadInformalTrails();
        } else if (checkbox.checked && optionalLandLayerIds.has(id)) {
          await loadLandContext(id);
        } else {
          syncVisibility(id);
        }
        syncFineTuneControl(id);
        syncAerialControlState();
        syncContextLabels();
      });
    }

    for (const kindToggle of shell.querySelectorAll<HTMLInputElement>('[data-sun-kind-toggle]')) {
      kindToggle.addEventListener('change', () => {
        clearPresetState();
        syncSunPotentialControls();
      });
    }

    const oilGasOptionsToggle = shell.querySelector<HTMLButtonElement>('[data-oil-gas-options-toggle]');
    const oilGasOptions = shell.querySelector<HTMLElement>('[data-oil-gas-options]');
    oilGasOptionsToggle?.addEventListener('click', () => {
      if (!oilGasOptions) return;
      const expanded = oilGasOptionsToggle.getAttribute('aria-expanded') === 'true';
      oilGasOptions.hidden = expanded;
      oilGasOptionsToggle.setAttribute('aria-expanded', String(!expanded));
      oilGasOptionsToggle.setAttribute('aria-label', (expanded ? 'Expand' : 'Collapse') + ' Oil & Gas well types');
      oilGasOptionsToggle.textContent = expanded ? '⌄' : '⌃';
    });

    for (const kindToggle of shell.querySelectorAll<HTMLInputElement>('[data-oil-gas-kind]')) {
      kindToggle.addEventListener('change', () => {
        syncOilGasLayer();
      });
    }

    for (const fineToggle of shell.querySelectorAll<HTMLInputElement>('[data-fine-tune-layer]')) {
      fineToggle.addEventListener('change', () => {
        const id = fineToggle.dataset.fineTuneLayer;
        if (!id) return;
        const mainToggle = shell.querySelector<HTMLInputElement>('[data-map-layer="' + id + '"]');
        if ((id === gorgeLayerId || id === oilGasLayerId) && mainToggle) {
          mainToggle.checked = fineToggle.checked;
          mainToggle.indeterminate = false;
          mainToggle.dispatchEvent(new Event('change', { bubbles: true }));
          return;
        }
        if (!mainToggle || mainToggle.checked === fineToggle.checked) {
          syncFineTuneControl(id);
          return;
        }
        mainToggle.checked = fineToggle.checked;
        mainToggle.dispatchEvent(new Event('change', { bubbles: true }));
      });
    }

    for (const slider of shell.querySelectorAll<HTMLInputElement>('[data-opacity]')) {
      slider.addEventListener('input', () => {
        const id = slider.dataset.opacity;
        if (!id || slider.disabled) return;
        if (presetLayerIds.has(id)) clearPresetState();
        syncOpacity(id);
        if (optionalLandLayerIds.has(id)) syncLandContextStyles();
      });
    }

    for (const button of shell.querySelectorAll<HTMLButtonElement>('[data-map-preset]')) {
      button.addEventListener('click', () => {
        const name = button.dataset.mapPreset;
        if (name) applyPreset(name);
      });
    }
    mobilePresetSelect?.addEventListener('change', () => {
      const name = mobilePresetSelect.value;
      if (['hiking', 'terrain', 'aerial', 'sunlight'].includes(name)) applyPreset(name);
    });

    for (const checkbox of shell.querySelectorAll<HTMLInputElement>('[data-route-category-filter]')) {
      checkbox.addEventListener('change', syncRouteFilters);
    }
    syncRouteFilters();

    const shareParamNames = ['rrghMap', 'rrghPreset', 'rrghLayers', 'rrghSun', 'rrghOil', 'rrghCategories', 'rrghRoute'];
    const buildShareUrl = () => {
      const url = new URL(window.location.href);
      for (const key of Array.from(url.searchParams.keys())) {
        if (key.startsWith('utm_') || key === 'gclid' || key === 'fbclid' || key.startsWith('rrgh')) {
          url.searchParams.delete(key);
        }
      }

      const center = map.getCenter();
      url.searchParams.set('rrghMap', [center.lat.toFixed(7), center.lng.toFixed(7), String(map.getZoom())].join(','));

      const activePreset = shell.querySelector<HTMLButtonElement>('[data-map-preset][aria-pressed="true"]')?.dataset.mapPreset;
      url.searchParams.set('rrghPreset', activePreset ?? 'custom');

      const layerState = Array.from(shell.querySelectorAll<HTMLInputElement>('[data-map-layer]'))
        .map((input) => {
          const id = input.dataset.mapLayer;
          if (!id) return null;
          const slider = shell.querySelector<HTMLInputElement>('[data-opacity="' + id + '"]');
          return [id, input.checked ? '1' : '0', slider?.value ?? ''].join(':');
        })
        .filter(Boolean)
        .join(',');
      url.searchParams.set('rrghLayers', layerState);
      const sunKinds = (['sunrise', 'sunset'] as const).filter((kind) => sunKindEnabled(kind)).join(',');
      url.searchParams.set('rrghSun', sunKinds);
      const oilKinds = oilGasKinds.filter((kind) => oilGasKindEnabled(kind)).join(',');
      url.searchParams.set('rrghOil', oilKinds);

      const categories = Array.from(shell.querySelectorAll<HTMLInputElement>('[data-route-category-filter]'))
        .filter((input) => input.checked)
        .map((input) => input.dataset.routeCategoryFilter)
        .filter(Boolean)
        .join(',');
      url.searchParams.set('rrghCategories', categories);

      if (selectedRouteId) url.searchParams.set('rrghRoute', selectedRouteId);
      url.hash = '';
      return url.toString();
    };

    const showShareFallback = (url: string) => {
      for (const item of shell.querySelectorAll<HTMLElement>('[data-map-sheet="search"], [data-map-sheet="explore"], [data-map-sheet="plan"], [data-map-sheet="share"]')) {
        item.hidden = item !== sharePanel;
      }
      if (layerPanel) {
        layerPanel.open = false;
        delete layerPanel.dataset.mobileOpen;
      }
      if (shareUrlInput) shareUrlInput.value = url;
      if (shareStatus) shareStatus.textContent = '';
      if (sharePanel) sharePanel.hidden = false;
    };

    const copyShareUrl = async () => {
      const url = shareUrlInput?.value || buildShareUrl();
      try {
        await navigator.clipboard.writeText(url);
        if (shareStatus) shareStatus.textContent = 'Link copied.';
      } catch {
        if (shareUrlInput) {
          shareUrlInput.focus();
          shareUrlInput.select();
          const copied = document.execCommand('copy');
          if (shareStatus) shareStatus.textContent = copied ? 'Link copied.' : 'Select and copy the link above.';
        }
      }
    };

    const shareCurrentMap = async () => {
      const url = buildShareUrl();
      const selectedEntry = selectedRouteId ? routeExploreEntries.get(selectedRouteId) : null;
      const title = selectedEntry ? selectedEntry.route.title + ' — Red River Gorge Hiker' : 'Red River Gorge Hiker Interactive Map';
      const text = selectedEntry
        ? selectedEntry.route.title + ' · ' + routeCategoryLabel(selectedEntry.route.routeCategory) + ' · ' + selectedEntry.route.distanceMi.toFixed(2) + ' mi · ' + selectedEntry.route.physicalDifficulty
        : 'Shared map view from Red River Gorge Hiker';

      if (shareDescription) {
        shareDescription.textContent = selectedEntry
          ? 'Share this map view with ' + selectedEntry.route.title + ' selected.'
          : 'Copy this link to share the current map view and settings.';
      }

      if (typeof navigator.share === 'function') {
        try {
          await navigator.share({ title, text, url });
          return;
        } catch (error) {
          if (error instanceof DOMException && error.name === 'AbortError') return;
        }
      }
      showShareFallback(url);
    };

    for (const button of shell.querySelectorAll<HTMLButtonElement>('[data-map-action="share"]')) {
      button.addEventListener('click', () => { void shareCurrentMap(); });
    }
    shareCopy?.addEventListener('click', () => { void copyShareUrl(); });

    const applySharedMapState = () => {
      const params = new URL(window.location.href).searchParams;
      const sharedMap = params.get('rrghMap');
      const sharedPreset = params.get('rrghPreset');

      if (sharedPreset && sharedPreset !== 'custom' && ['hiking', 'terrain', 'aerial', 'sunlight'].includes(sharedPreset)) {
        applyPreset(sharedPreset);
      } else if (sharedPreset === 'custom' && mobilePresetSelect) {
        mobilePresetSelect.selectedIndex = -1;
      }

      const layerState = params.get('rrghLayers');
      if (layerState !== null) {
        for (const record of layerState.split(',')) {
          const [id, enabledValue, opacityValue] = record.split(':');
          if (!id) continue;
          const checkbox = shell.querySelector<HTMLInputElement>('[data-map-layer="' + id + '"]');
          if (!checkbox) continue;
          const parsedOpacity = opacityValue === '' || opacityValue === undefined ? undefined : Number(opacityValue);
          const safeOpacity = parsedOpacity !== undefined && Number.isFinite(parsedOpacity) ? parsedOpacity : undefined;
          setLayerControl(id, enabledValue === '1', safeOpacity);
        }
      }
      const sunParam = params.get('rrghSun');
      if (sunParam !== null) {
        const selectedSunKinds = new Set(sunParam.split(',').filter(Boolean));
        const sunrise = sunKindToggle('sunrise');
        const sunset = sunKindToggle('sunset');
        if (sunrise) sunrise.checked = selectedSunKinds.has('sunrise');
        if (sunset) sunset.checked = selectedSunKinds.has('sunset');
        syncSunPotentialControls();
      }

      const oilParam = params.get('rrghOil');
      if (oilParam !== null) {
        const selectedOilKinds = new Set(oilParam.split(',').filter(Boolean));
        for (const kind of oilGasKinds) {
          const toggle = oilGasKindToggle(kind);
          if (toggle) toggle.checked = selectedOilKinds.has(kind);
        }
        syncOilGasLayer();
      }

      const categoryParam = params.get('rrghCategories');
      if (categoryParam !== null) {
        const selectedCategories = new Set(categoryParam.split(',').filter(Boolean));
        for (const input of shell.querySelectorAll<HTMLInputElement>('[data-route-category-filter]')) {
          input.checked = Boolean(input.dataset.routeCategoryFilter && selectedCategories.has(input.dataset.routeCategoryFilter));
        }
      }
      syncRouteFilters();

      let sharedCenter: any = null;
      let sharedZoom: number | null = null;
      if (sharedMap) {
        const [latValue, lngValue, zoomValue] = sharedMap.split(',');
        const lat = Number(latValue);
        const lng = Number(lngValue);
        const zoom = Number(zoomValue);
        if (Number.isFinite(lat) && Number.isFinite(lng) && Number.isFinite(zoom) && Math.abs(lat) <= 90 && Math.abs(lng) <= 180 && zoom >= 8 && zoom <= 20) {
          sharedCenter = L.latLng(lat, lng);
          sharedZoom = zoom;
          sharedViewApplied = true;
          map.setView(sharedCenter, sharedZoom, { animate: false });
        }
      }

      const sharedRouteId = params.get('rrghRoute');
      if (sharedRouteId && routeExploreEntries.has(sharedRouteId)) {
        selectedRouteId = sharedRouteId;
        const entry = routeExploreEntries.get(sharedRouteId);
        window.setTimeout(() => {
          const popup = entry?.layers[0]?.getPopup?.();
          const priorAutoPan = popup?.options?.autoPan;
          if (popup?.options) popup.options.autoPan = false;
          entry?.layers[0]?.openPopup?.();
          if (popup?.options) popup.options.autoPan = priorAutoPan;
          if (sharedCenter && sharedZoom !== null) map.setView(sharedCenter, sharedZoom, { animate: false });
        }, 80);
      }

      syncAllFineTuneControls();
      syncSunPotentialControls();
      syncAerialControlState();
      syncContextLabels();
      syncViewportDiagnostics();
    };
    applySharedMapState();
    syncLocalRoadLayer();
    setReadiness('core', true);
    setReadiness('share', true);
    setLoadProgress(94, 'Restoring map controls…');
    container.dataset.mapCoreReady = 'true';
    container.dataset.shareReady = 'true';

    const syncSheetButtons = () => {
      for (const button of shell.querySelectorAll<HTMLButtonElement>('[data-sheet-open]')) {
        const target = button.dataset.sheetOpen;
        if (!target || target === 'layers') continue;
        const panel = shell.querySelector<HTMLElement>('[data-map-sheet="' + target + '"]');
        button.setAttribute('aria-pressed', String(Boolean(panel && !panel.hidden)));
      }
    };

    const syncPlanMinimizeUi = () => {
      if (!planPanel || !planMinimize) return;
      const minimized = planPanel.dataset.minimized === 'true';
      planMinimize.textContent = minimized ? '+' : '−';
      planMinimize.setAttribute('aria-label', minimized ? 'Expand map tools' : 'Minimize map tools');
      if (planPanelTitle) {
        planPanelTitle.textContent = minimized
          ? ''
          : activeTool === 'plan'
            ? 'Build trail route'
            : activeTool === 'measure'
              ? 'Measure distance'
              : activeTool === 'area'
                ? 'Measure area'
                : activeTool === 'bearing'
                  ? 'Bearing / slope'
                  : activeTool === 'watershed'
                    ? 'Watershed'
                    : 'Tools';
      }
      if (planMobileHistory) {
        planMobileHistory.hidden = !(minimized && activeTool !== null && !planPanel.hidden);
      }
    };

    const minimizePlanPanel = () => {
      if (!planPanel) return;
      planPanel.hidden = false;
      planPanel.dataset.minimized = 'true';
      if (planLiveStats) planLiveStats.hidden = activeTool === null;
      syncPlanMinimizeUi();
      syncSheetButtons();
    };

    const expandPlanPanel = () => {
      if (!planPanel) return;
      planPanel.hidden = false;
      delete planPanel.dataset.minimized;
      syncPlanMinimizeUi();
      syncSheetButtons();
    };

    const openSheet = (name: string) => {
      if (name === 'layers') {
        if (layerPanel) {
          layerPanel.open = !layerPanel.open;
          if (layerPanel.open) layerPanel.dataset.mobileOpen = 'true';
          else delete layerPanel.dataset.mobileOpen;
        }
        return;
      }

      const panel = shell.querySelector<HTMLElement>('[data-map-sheet="' + name + '"]');
      const shouldClose = Boolean(panel && !panel.hidden);

      if (name === 'plan' && planPanel && !planPanel.hidden) {
        if (planPanel.dataset.minimized === 'true') {
          expandPlanPanel();
        } else if (activeTool !== null) {
          minimizePlanPanel();
        } else {
          planPanel.hidden = true;
          syncSheetButtons();
        }
        return;
      }

      for (const item of shell.querySelectorAll<HTMLElement>('[data-map-sheet="search"], [data-map-sheet="explore"], [data-map-sheet="plan"], [data-map-sheet="share"]')) {
        item.hidden = true;
      }

      if (shouldClose) {
        if (name === 'explore') setTool(null);
        syncSheetButtons();
        return;
      }

      if (panel) {
        panel.hidden = false;
        if (name === 'plan') delete panel.dataset.minimized;
      }
      if (name === 'explore') {
        setTool(null);
        renderExploreRoutes();
      }
      if (name === 'search') window.setTimeout(() => searchInput?.focus(), 0);
      syncSheetButtons();
    };

    for (const button of shell.querySelectorAll<HTMLButtonElement>('[data-sheet-open]')) {
      button.addEventListener('click', () => {
        const target = button.dataset.sheetOpen;
        if (target) openSheet(target);
      });
    }

    for (const button of shell.querySelectorAll<HTMLButtonElement>('[data-sheet-close]')) {
      button.addEventListener('click', () => {
        const panel = button.closest<HTMLElement>('[data-map-sheet]');
        if (panel) panel.hidden = true;
        syncSheetButtons();
      });
    }

    planMinimize?.addEventListener('click', () => {
      if (!planPanel) return;
      if (planPanel.dataset.minimized === 'true') expandPlanPanel();
      else minimizePlanPanel();
    });
    syncPlanMinimizeUi();

    layerPanel?.addEventListener('toggle', () => {
      if (!readiness.core && layerPanel.open) {
        layerPanel.open = false;
        return;
      }
      if (!layerPanel.open) delete layerPanel.dataset.mobileOpen;
    });

    const goHome = () => {
      setHomeView();
      setStatus(isMobileFullMap() ? 'Red River Gorge overview restored.' : 'Core Red River Gorge hiking view restored.');
    };

    const showMyLocation = () => {
      if (!('geolocation' in navigator)) {
        setStatus('This browser does not provide device location.', 'warning');
        return;
      }
      setStatus('Requesting your device location…');
      navigator.geolocation.getCurrentPosition(
        (position) => {
          const latlng = L.latLng(position.coords.latitude, position.coords.longitude);
          if (homeBounds?.isValid?.() && !homeBounds.contains(latlng)) {
            setStatus('Your reported device location is outside this Wolfe / Powell / Menifee / Lee planning map. The map will remain in the Gorge.', 'warning');
            return;
          }
          if (locationLayer) map.removeLayer(locationLayer);
          const accuracy = Math.max(1, position.coords.accuracy || 1);
          const group = L.layerGroup();
          L.circle(latlng, {
            radius: accuracy,
            color: '#2f6e99',
            weight: 1.5,
            opacity: 0.8,
            fillColor: '#2f6e99',
            fillOpacity: 0.12,
            pane: 'landmarks'
          }).addTo(group);
          L.circleMarker(latlng, {
            radius: 7,
            color: '#ffffff',
            weight: 3,
            fillColor: '#2f6e99',
            fillOpacity: 1,
            pane: 'landmarks'
          }).bindPopup('Your device location · accuracy about ' + Math.round(accuracy) + ' m. Device GPS can be inaccurate and is not a substitute for dedicated backcountry navigation.').addTo(group);
          group.addTo(map);
          locationLayer = group;
          map.setView(latlng, Math.max(map.getZoom(), 15));
          setStatus('Device location shown with its reported accuracy. GPS accuracy can vary.');
        },
        (error) => {
          const message = error.code === 1
            ? 'Location permission was not granted.'
            : 'Your device location could not be determined.';
          setStatus(message, 'warning');
        },
        { enableHighAccuracy: true, timeout: 12000, maximumAge: 60000 }
      );
    };

    const panMapByDirection = (direction: string) => {
      const size = map.getSize();
      const step = Math.max(100, Math.min(220, Math.round(Math.min(size.x, size.y) * 0.22)));
      const offsets: Record<string, [number, number]> = {
        up: [0, -step],
        down: [0, step],
        left: [-step, 0],
        right: [step, 0]
      };
      const offset = offsets[direction];
      if (!offset) return;
      map.panBy(L.point(offset[0], offset[1]), { animate: true, duration: 0.22 });
      if (activeTool === 'plan') {
        setStatus('Map panned. Route building remains active; click the next point when ready.');
      }
    };

    for (const button of shell.querySelectorAll<HTMLButtonElement>('[data-plan-pan-direction]')) {
      button.addEventListener('click', () => {
        panMapByDirection(button.dataset.planPanDirection ?? '');
      });
    }

    for (const button of shell.querySelectorAll<HTMLButtonElement>('[data-map-action]')) {
      button.addEventListener('click', () => {
        const action = button.dataset.mapAction;
        if (action === 'home') goHome();
        else if (action === 'locate') showMyLocation();
        else if (action === 'zoom-in') {
          map.setView(map.getCenter(), Math.min(map.getMaxZoom(), map.getZoom() + 1), { animate: false });
        } else if (action === 'zoom-out') {
          map.setView(map.getCenter(), Math.max(map.getMinZoom(), map.getZoom() - 1), { animate: false });
        }
      });
    }

    const renderSearchResults = () => {
      if (!searchResults || !searchInput) return;
      const query = searchInput.value.trim().toLowerCase();
      searchResults.replaceChildren();
      if (!query) return;

      const matches = searchItems
        .filter((item) => (item.label + ' ' + item.detail).toLowerCase().includes(query))
        .slice(0, 10);

      if (!matches.length) {
        const empty = document.createElement('p');
        empty.className = 'route-search-empty';
        empty.textContent = 'No loaded map feature matches that search.';
        searchResults.append(empty);
        return;
      }

      for (const item of matches) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'route-search-result';
        const label = document.createElement('strong');
        label.textContent = item.label;
        const detail = document.createElement('span');
        detail.textContent = item.detail;
        button.append(label, detail);
        button.addEventListener('click', () => {
          if (item.bounds?.isValid?.()) map.fitBounds(item.bounds.pad ? item.bounds.pad(0.35) : item.bounds, { maxZoom: 16 });
          else if (item.latlng) map.setView(item.latlng, 16);
          item.open?.();
          if (searchPanel) searchPanel.hidden = true;
        });
        searchResults.append(button);
      }
    };
    searchInput?.addEventListener('input', renderSearchResults);

    const fetchTerrainElevations = async (
      sourceId: string,
      points: Array<{ lat: number; lng: number }>,
      signal: AbortSignal
    ) => {
      const source = sourceById(sourceId);
      if (!source?.serviceUrl) throw new Error('Terrain elevation source is unavailable: ' + sourceId);
      const values: Array<number | null> = [];
      const chunkSize = 180;
      for (let offset = 0; offset < points.length; offset += chunkSize) {
        const chunk = points.slice(offset, offset + chunkSize);
        const params = new URLSearchParams({
          f: 'json',
          geometry: JSON.stringify({
            points: chunk.map((point) => [point.lng, point.lat]),
            spatialReference: { wkid: 4326 }
          }),
          geometryType: 'esriGeometryMultipoint',
          returnFirstValueOnly: 'true',
          interpolation: 'RSP_BilinearInterpolation',
          outSR: '4326'
        });
        const response = await fetch(source.serviceUrl + '/getSamples', {
          method: 'POST',
          credentials: 'omit',
          mode: 'cors',
          referrerPolicy: 'strict-origin-when-cross-origin',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
          body: params.toString(),
          signal
        });
        if (!response.ok) throw new Error(source.label + ' terrain request failed with ' + response.status);
        const payload = await response.json();
        if (payload?.error || !Array.isArray(payload?.samples) || payload.samples.length !== chunk.length) {
          throw new Error(source.label + ' returned incomplete terrain samples.');
        }
        for (const sample of payload.samples) {
          const raw = Array.isArray(sample?.value) ? sample.value[0] : String(sample?.value ?? '').trim().split(/\s+/)[0];
          const meters = Number(raw);
          values.push(Number.isFinite(meters) ? meters : null);
        }
      }
      return values;
    };

    const terrainHorizonForPoint = async (lat: number, lng: number, signal: AbortSignal) => {
      const cacheKey = lat.toFixed(5) + ',' + lng.toFixed(5);
      const cached = sunlightHorizonCache.get(cacheKey);
      if (cached) return cached;

      const samples = buildTerrainSamplePoints(lat, lng);
      const points = [{ lat, lng }, ...samples.map((sample) => ({ lat: sample.lat, lng: sample.lng }))];
      const sourceIds = ['kyaped-phase2-dem', 'usgs-3dep-bare-earth-dem'];
      let lastError: unknown = null;

      for (const sourceId of sourceIds) {
        try {
          const elevations = await fetchTerrainElevations(sourceId, points, signal);
          const profile = buildTerrainHorizonProfile(samples, elevations);
          const originElevationMeters = Number(elevations[0]);
          if (!Number.isFinite(originElevationMeters)) throw new Error('Map Point elevation is unavailable.');
          const sourceLabel = sourceById(sourceId)?.label ?? sourceId;
          const result = { profile, sourceLabel, originElevationMeters };
          sunlightHorizonCache.set(cacheKey, result);
          container.dataset.sunlightTerrainSource = sourceId;
          return result;
        } catch (error) {
          if (signal.aborted) throw error;
          lastError = error;
          console.error(error);
        }
      }
      throw lastError ?? new Error('Terrain-aware sunlight data is unavailable.');
    };

    const renderSunlightRows = (
      days: any[],
      directTimes: Array<{ firstDirectSun: Date | null; lastDirectSun: Date | null }> | null
    ) => {
      if (!coordinateSunTable) return;
      coordinateSunTable.replaceChildren();
      const table = document.createElement('table');
      table.className = 'route-coordinate-sun-table';
      const thead = document.createElement('thead');
      const header = document.createElement('tr');
      const headerLabels = [
        { label: 'Date' },
        { label: 'Sunrise' },
        { label: 'First direct sun', stack: ['First', 'direct', 'sun'] },
        { label: 'Last direct sun', stack: ['Last', 'direct', 'sun'] },
        { label: 'Sunset' }
      ];
      for (const label of headerLabels) {
        const th = document.createElement('th');
        th.scope = 'col';
        if (label.stack) {
          th.setAttribute('aria-label', label.label);
          const stack = document.createElement('span');
          stack.className = 'route-sun-header-stack';
          for (const word of label.stack) {
            const line = document.createElement('span');
            line.setAttribute('aria-hidden', 'true');
            line.textContent = word;
            stack.append(line);
          }
          th.append(stack);
        } else {
          th.textContent = label.label;
        }
        header.append(th);
      }
      thead.append(header);
      table.append(thead);
      const tbody = document.createElement('tbody');
      days.forEach((day, index) => {
        const row = document.createElement('tr');
        const dateCell = document.createElement('th');
        dateCell.scope = 'row';
        dateCell.append(document.createTextNode(formatRrgDate(day.start)));
        if (index === 0) {
          const todayTag = document.createElement('span');
          todayTag.className = 'route-coordinate-today-tag';
          todayTag.textContent = 'Today';
          dateCell.append(document.createTextNode(' · '), todayTag);
        }
        row.append(dateCell);
        const values = [
          formatRrgTime(day.sunrise),
          directTimes ? formatRrgTime(directTimes[index]?.firstDirectSun ?? null) : '…',
          directTimes ? formatRrgTime(directTimes[index]?.lastDirectSun ?? null) : '…',
          formatRrgTime(day.sunset)
        ];
        for (const value of values) {
          const td = document.createElement('td');
          td.textContent = value;
          row.append(td);
        }
        tbody.append(row);
      });
      table.append(tbody);
      coordinateSunTable.append(table);
    };

    const setTodaySunlight = (
      sunrise: string,
      firstDirect: string,
      lastDirect: string,
      sunset: string
    ) => {
      if (coordinateSunriseToday) coordinateSunriseToday.textContent = sunrise;
      if (coordinateFirstDirectToday) coordinateFirstDirectToday.textContent = firstDirect;
      if (coordinateLastDirectToday) coordinateLastDirectToday.textContent = lastDirect;
      if (coordinateSunsetToday) coordinateSunsetToday.textContent = sunset;
    };

    const positionCoordinatePoint = (latlng: any) => {
      if (coordinatePointLayer) map.removeLayer(coordinatePointLayer);
      coordinatePointLayer = L.marker(latlng, {
        pane: 'mapPoint',
        interactive: false,
        keyboard: false,
        icon: L.divIcon({
          className: 'route-map-point-icon',
          html: '<span class="route-map-point-symbol"><span></span></span>',
          iconSize: [24, 24],
          iconAnchor: [12, 12]
        })
      }).addTo(map);
      container.dataset.coordinatePointVisible = 'true';

      const detailZoom = isMobileFullMap() ? 14 : 15;
      if (map.getZoom() <= detailZoom - 2) {
        map.setView(latlng, detailZoom, { animate: true });
        container.dataset.coordinatePointAutoPan = 'zoom';
        return;
      }

      window.requestAnimationFrame(() => {
        const mapRect = container.getBoundingClientRect();
        const current = map.latLngToContainerPoint(latlng);
        const clientX = mapRect.left + current.x;
        const clientY = mapRect.top + current.y;
        const edge = 28;
        const outsideSafeArea =
          clientX < mapRect.left + edge ||
          clientX > mapRect.right - edge ||
          clientY < mapRect.top + edge ||
          clientY > mapRect.bottom - edge;
        const cardRect = coordinateCard && !coordinateCard.hidden ? coordinateCard.getBoundingClientRect() : null;
        const underCard = Boolean(cardRect
          && clientX >= cardRect.left - 16
          && clientX <= cardRect.right + 16
          && clientY >= cardRect.top - 16
          && clientY <= cardRect.bottom + 16);

        if (!outsideSafeArea && !underCard) {
          container.dataset.coordinatePointAutoPan = 'false';
          return;
        }

        const size = map.getSize();
        const cardTopInMap = cardRect ? Math.max(80, cardRect.top - mapRect.top - 22) : size.y - edge;
        const desired = underCard
          ? L.point(
              isMobileFullMap() ? size.x * 0.5 : Math.min(size.x * 0.62, Math.max(edge, current.x)),
              Math.max(90, Math.min(size.y * 0.45, cardTopInMap))
            )
          : L.point(
              Math.max(edge, Math.min(size.x - edge, current.x)),
              Math.max(edge, Math.min(size.y - edge, current.y))
            );
        const offset = current.subtract(desired);
        if (Math.abs(offset.x) > 4 || Math.abs(offset.y) > 4) {
          map.panBy([offset.x, offset.y], { animate: true, duration: 0.2 });
          container.dataset.coordinatePointAutoPan = 'visibility';
        } else {
          container.dataset.coordinatePointAutoPan = 'false';
        }
      });
    };

    const showCoordinate = (latlng: any) => {
      const lat = Number(latlng.lat);
      const lng = Number(latlng.lng);
      const utm = toUtm(lat, lng);
      coordinatePoint = { lat, lng, utm };
      if (coordinateDd) coordinateDd.textContent = lat.toFixed(6) + ', ' + lng.toFixed(6);
      if (coordinateUtm) coordinateUtm.textContent = 'UTM ' + utm;
      if (coordinateElevation) coordinateElevation.textContent = 'Elevation calculating…';

      const today = redRiverDateParts();
      const days = Array.from({ length: 10 }, (_, index) =>
        getAstronomicalSunDay(lat, lng, addLocalDays(today, index))
      );
      setTodaySunlight(
        formatRrgTime(days[0]?.sunrise ?? null),
        'Calculating…',
        'Calculating…',
        formatRrgTime(days[0]?.sunset ?? null)
      );
      if (coordinateSunSource) coordinateSunSource.textContent = 'Calculating terrain-adjusted first and last direct sun…';
      if (coordinateSunDetails) {
        coordinateSunDetails.open = stage?.dataset.sunlightMode === 'true';
      }
      renderSunlightRows(days, null);
      if (coordinateCard) coordinateCard.hidden = false;
      positionCoordinatePoint(L.latLng(lat, lng));

      const revision = ++sunlightRequestRevision;
      sunlightController?.abort();
      const controller = new AbortController();
      sunlightController = controller;
      void terrainHorizonForPoint(lat, lng, controller.signal).then(({ profile, sourceLabel, originElevationMeters }) => {
        if (controller.signal.aborted || revision !== sunlightRequestRevision) return;
        const directTimes = days.map((day) => getTerrainDirectTimes(lat, lng, day, profile));
        renderSunlightRows(days, directTimes);
        const todayDirect = directTimes[0];
        setTodaySunlight(
          formatRrgTime(days[0]?.sunrise ?? null),
          formatRrgTime(todayDirect?.firstDirectSun ?? null),
          formatRrgTime(todayDirect?.lastDirectSun ?? null),
          formatRrgTime(days[0]?.sunset ?? null)
        );
        if (coordinateElevation) {
          const feet = Math.round(originElevationMeters * 3.280839895);
          coordinateElevation.textContent = 'Elevation ' + feet.toLocaleString() + ' ft · ' + Math.round(originElevationMeters).toLocaleString() + ' m';
        }
        if (coordinateSunSource) {
          coordinateSunSource.textContent = 'Terrain / elevation source: ' + sourceLabel + '.';
        }
        container.dataset.sunlightDayCount = '10';
        container.dataset.sunlightTerrainReady = 'true';
      }).catch((error) => {
        if (controller.signal.aborted || revision !== sunlightRequestRevision) return;
        console.error(error);
        if (coordinateElevation) coordinateElevation.textContent = 'Elevation temporarily unavailable.';
        if (coordinateFirstDirectToday) coordinateFirstDirectToday.textContent = 'Unavailable';
        if (coordinateLastDirectToday) coordinateLastDirectToday.textContent = 'Unavailable';
        if (coordinateSunSource) {
          coordinateSunSource.textContent = 'Astronomical times shown; terrain-adjusted timing is temporarily unavailable.';
        }
        container.dataset.sunlightTerrainReady = 'false';
      });
    };

    coordinateClose?.addEventListener('click', () => {
      if (coordinateCard) coordinateCard.hidden = true;
      if (coordinatePointLayer) {
        map.removeLayer(coordinatePointLayer);
        coordinatePointLayer = null;
      }
      delete container.dataset.coordinatePointVisible;
      delete container.dataset.coordinatePointAutoPan;
      coordinatePoint = null;
      sunlightRequestRevision += 1;
      sunlightController?.abort();
      sunlightController = null;
    });

    coordinateCopy?.addEventListener('click', async () => {
      if (!coordinatePoint) return;
      const textValue = coordinatePoint.lat.toFixed(6) + ', ' + coordinatePoint.lng.toFixed(6) + ' · UTM ' + coordinatePoint.utm;
      try {
        await navigator.clipboard.writeText(textValue);
        setStatus('Coordinates copied.');
      } catch {
        setStatus('Copy was blocked by the browser. Select the displayed coordinates instead.', 'warning');
      }
    });

    let lastTapAt = 0;
    let longPressTimer = 0;
    let longPressStart: { x: number; y: number } | null = null;
    let longPressTriggered = false;

    const clearLongPress = () => {
      window.clearTimeout(longPressTimer);
      longPressTimer = 0;
      longPressStart = null;
    };

    const scheduleLongPress = (clientX: number, clientY: number) => {
      if (activeTool !== null) {
        clearLongPress();
        return;
      }
      longPressStart = { x: clientX, y: clientY };
      longPressTriggered = false;
      window.clearTimeout(longPressTimer);
      longPressTimer = window.setTimeout(() => {
        if (!longPressStart || activeTool !== null) return;
        const rect = container.getBoundingClientRect();
        const point = L.point(longPressStart.x - rect.left, longPressStart.y - rect.top);
        window.getSelection()?.removeAllRanges();
        showCoordinate(map.containerPointToLatLng(point));
        setStatus('Map coordinates shown. Close the coordinate card when finished.');
        longPressTriggered = true;
        lastTapAt = 0;
        container.dataset.longPressActivated = 'true';
      }, 500);
    };

    container.addEventListener('touchstart', (event) => {
      if (activeTool !== null || event.touches.length !== 1) {
        clearLongPress();
        return;
      }
      const touch = event.touches[0]!;
      scheduleLongPress(touch.clientX, touch.clientY);
    }, { passive: true, capture: true });

    container.addEventListener('touchmove', (event) => {
      if (!longPressStart || event.touches.length !== 1) return;
      const touch = event.touches[0]!;
      if (Math.hypot(touch.clientX - longPressStart.x, touch.clientY - longPressStart.y) > 14) {
        clearLongPress();
        delete container.dataset.longPressActivated;
      }
    }, { passive: true, capture: true });

    // Some mobile browsers emit touchcancel during a stationary long hold while
    // deciding whether to show native selection/callout UI. The map explicitly
    // suppresses that UI in CSS, so do not cancel a still-stationary hold here.
    // Movement and multi-touch already cancel the timer above.
    container.addEventListener('touchcancel', () => {
      if (longPressTriggered) {
        longPressTriggered = false;
        clearLongPress();
      }
    }, { passive: true, capture: true });

    container.addEventListener('selectstart', (event) => {
      event.preventDefault();
    }, { capture: true });

    container.addEventListener('contextmenu', (event) => {
      event.preventDefault();
    }, { capture: true });

    container.addEventListener('touchend', (event) => {
      window.clearTimeout(longPressTimer);
      longPressTimer = 0;
      longPressStart = null;

      if (longPressTriggered) {
        longPressTriggered = false;
        lastTapAt = 0;
        event.preventDefault();
        return;
      }

      delete container.dataset.longPressActivated;
      if (activeTool !== null || event.changedTouches.length !== 1 || event.touches.length !== 0) return;
      const now = Date.now();
      if (now - lastTapAt < 320) {
        const touch = event.changedTouches[0]!;
        const rect = container.getBoundingClientRect();
        const point = L.point(touch.clientX - rect.left, touch.clientY - rect.top);
        const latlng = map.containerPointToLatLng(point);
        map.setView(latlng, Math.min(map.getZoom() + 1, map.getMaxZoom()), { animate: true });
        lastTapAt = 0;
        event.preventDefault();
      } else {
        lastTapAt = now;
      }
    }, { passive: false, capture: true });

    const planningRenderer = L.svg({ pane: 'planning' });
    const measureLayer = L.layerGroup([], { pane: 'planning' }).addTo(map);
    const areaLayer = L.layerGroup([], { pane: 'planning' }).addTo(map);
    const bearingLayer = L.layerGroup([], { pane: 'planning' }).addTo(map);
    const watershedLayer = L.layerGroup([], { pane: 'planning' }).addTo(map);
    const planLayer = L.layerGroup([], { pane: 'planning' }).addTo(map);
    let measurePoints: any[] = [];
    let areaPoints: any[] = [];
    let bearingPoints: any[] = [];
    let bearingElevationController: AbortController | null = null;
    let bearingRevision = 0;
    let watershedController: AbortController | null = null;
    let watershedRevision = 0;
    type MeasurePointSnapshot = { lat: number; lng: number };
    type MeasureSnapshot = MeasurePointSnapshot[];
    let measureHistory: MeasureSnapshot[] = [[]];
    let measureHistoryIndex = 0;
    let areaHistory: MeasureSnapshot[] = [[]];
    let areaHistoryIndex = 0;
    let bearingHistory: MeasureSnapshot[] = [[]];
    let bearingHistoryIndex = 0;
    type WatershedSnapshot = MeasurePointSnapshot | null;
    let watershedHistory: WatershedSnapshot[] = [null];
    let watershedHistoryIndex = 0;

    type PlanPoint = { lat: number; lng: number; nodeKey?: string };
    type PlanSegment = { mode: 'snap' | 'straight'; points: PlanPoint[] };
    type PlanSnapshot = { stops: PlanPoint[]; segments: PlanSegment[] };

    let planStops: PlanPoint[] = [];
    let planSegments: PlanSegment[] = [];
    let planHistory: PlanSnapshot[] = [{ stops: [], segments: [] }];
    let planHistoryIndex = 0;
    let suppressPlanClickUntil = 0;
    let segmentDragActive = false;

    type ElevationSummary = {
      elevationsFt: number[];
      gainFt: number;
      lossFt: number;
      minFt: number;
      maxFt: number;
      startFt: number;
      endFt: number;
    };

    let measureElevationsFt: number[] | null = null;
    let planElevationSummary: ElevationSummary | null = null;
    let measureElevationTimer = 0;
    let planElevationTimer = 0;
    let measureElevationController: AbortController | null = null;
    let planElevationController: AbortController | null = null;
    let measureElevationRevision = 0;
    let planElevationRevision = 0;

    const formatFeet = (value: number) => Math.round(value).toLocaleString() + ' ft';
    const formatElevationDelta = (value: number) => {
      const rounded = Math.round(value);
      if (rounded === 0) return '0 ft';
      return (rounded > 0 ? '+' : '−') + Math.abs(rounded).toLocaleString() + ' ft';
    };

    const pathDistanceMeters = (points: any[]) => {
      let total = 0;
      for (let i = 1; i < points.length; i += 1) total += points[i - 1].distanceTo(points[i]);
      return total;
    };

    const pathMidpoint = (points: any[]) => {
      if (!points.length) return null;
      if (points.length === 1) return points[0];
      const total = pathDistanceMeters(points);
      if (!total) return points[0];
      const target = total / 2;
      let walked = 0;
      for (let i = 1; i < points.length; i += 1) {
        const from = points[i - 1];
        const to = points[i];
        const segment = from.distanceTo(to);
        if (walked + segment >= target) {
          const ratio = segment ? (target - walked) / segment : 0;
          return L.latLng(
            from.lat + (to.lat - from.lat) * ratio,
            from.lng + (to.lng - from.lng) * ratio
          );
        }
        walked += segment;
      }
      return points[points.length - 1];
    };

    const resampleElevationPath = (points: any[], maxSamples = 64) => {
      if (points.length <= 2) return points.slice();
      const cumulative = [0];
      for (let i = 1; i < points.length; i += 1) {
        cumulative.push(cumulative[i - 1]! + points[i - 1].distanceTo(points[i]));
      }
      const total = cumulative[cumulative.length - 1] ?? 0;
      if (!total) return [points[0], points[points.length - 1]];
      const desired = Math.max(2, Math.min(maxSamples, Math.ceil(total / 60) + 1));
      const sampled: any[] = [];
      for (let sampleIndex = 0; sampleIndex < desired; sampleIndex += 1) {
        const target = total * sampleIndex / (desired - 1);
        let segmentIndex = 1;
        while (segmentIndex < cumulative.length && cumulative[segmentIndex]! < target) segmentIndex += 1;
        if (segmentIndex >= cumulative.length) {
          sampled.push(points[points.length - 1]);
          continue;
        }
        const startDistance = cumulative[segmentIndex - 1]!;
        const endDistance = cumulative[segmentIndex]!;
        const ratio = endDistance === startDistance ? 0 : (target - startDistance) / (endDistance - startDistance);
        const from = points[segmentIndex - 1];
        const to = points[segmentIndex];
        sampled.push(L.latLng(
          from.lat + (to.lat - from.lat) * ratio,
          from.lng + (to.lng - from.lng) * ratio
        ));
      }
      return sampled;
    };

    const summarizeElevations = (elevationsFt: number[]): ElevationSummary => {
      let gainFt = 0;
      let lossFt = 0;
      for (let i = 1; i < elevationsFt.length; i += 1) {
        const delta = elevationsFt[i]! - elevationsFt[i - 1]!;
        if (delta > 0) gainFt += delta;
        else lossFt += Math.abs(delta);
      }
      return {
        elevationsFt,
        gainFt,
        lossFt,
        minFt: Math.min(...elevationsFt),
        maxFt: Math.max(...elevationsFt),
        startFt: elevationsFt[0]!,
        endFt: elevationsFt[elevationsFt.length - 1]!
      };
    };

    const fetchElevations = async (points: any[], signal: AbortSignal) => {
      const source = sourceById('usgs-3dep-bare-earth-dem');
      if (!source?.serviceUrl) throw new Error('USGS 3DEP elevation source is unavailable.');
      const elevationsFt: number[] = [];
      for (let offset = 0; offset < points.length; offset += 20) {
        const chunk = points.slice(offset, offset + 20);
        const geometry = JSON.stringify({
          points: chunk.map((point: any) => [point.lng, point.lat]),
          spatialReference: { wkid: 4326 }
        });
        const params = new URLSearchParams({
          f: 'json',
          geometry,
          geometryType: 'esriGeometryMultipoint',
          returnFirstValueOnly: 'true',
          interpolation: 'RSP_BilinearInterpolation',
          outSR: '4326'
        });
        const response = await fetch(source.serviceUrl + '/getSamples?' + params.toString(), {
          credentials: 'omit',
          mode: 'cors',
          referrerPolicy: 'strict-origin-when-cross-origin',
          signal
        });
        if (!response.ok) throw new Error('USGS 3DEP elevation request failed with ' + response.status);
        const payload = await response.json();
        if (payload?.error || !Array.isArray(payload?.samples) || payload.samples.length !== chunk.length) {
          throw new Error('USGS 3DEP returned incomplete elevation samples.');
        }
        for (const sample of payload.samples) {
          const raw = Array.isArray(sample.value) ? sample.value[0] : String(sample.value).trim().split(/\s+/)[0];
          const meters = Number(raw);
          if (!Number.isFinite(meters)) throw new Error('USGS 3DEP returned an invalid elevation value.');
          elevationsFt.push(meters * 3.280839895013123);
        }
      }
      return elevationsFt;
    };

    const setStatLabels = (a: string, b: string, c: string, d: string) => {
      if (planStatLabelA) planStatLabelA.textContent = a;
      if (planStatLabelB) planStatLabelB.textContent = b;
      if (planStatLabelC) planStatLabelC.textContent = c;
      if (planStatLabelD) planStatLabelD.textContent = d;
    };
    const updateAnalysisStats = (
      title: string,
      labels: [string, string, string, string],
      values: [string, string, string, string],
      note: string
    ) => {
      if (planLiveStats) planLiveStats.hidden = false;
      if (planStatsTitle) planStatsTitle.textContent = title;
      setStatLabels(...labels);
      if (planStatsDistance) planStatsDistance.textContent = values[0];
      if (planStatsGain) planStatsGain.textContent = values[1];
      if (planStatsLoss) planStatsLoss.textContent = values[2];
      if (planStatsRange) planStatsRange.textContent = values[3];
      if (planStatsNote) planStatsNote.textContent = note;
    };
    const updateLiveStats = (
      title: string,
      totalMeters: number,
      summary: ElevationSummary | null,
      note: string
    ) => {
      setStatLabels('Distance', 'Gain', 'Loss', 'Elevation');
      if (planLiveStats) planLiveStats.hidden = false;
      if (planStatsTitle) planStatsTitle.textContent = title;
      if (planStatsDistance) planStatsDistance.textContent = formatDistance(totalMeters);
      if (planStatsGain) planStatsGain.textContent = summary ? '+' + formatFeet(summary.gainFt) : '—';
      if (planStatsLoss) planStatsLoss.textContent = summary ? '−' + formatFeet(summary.lossFt) : '—';
      if (planStatsRange) planStatsRange.textContent = summary ? formatFeet(summary.minFt) + '–' + formatFeet(summary.maxFt) : '—';
      if (planStatsNote) planStatsNote.textContent = note;
    };

    const polygonAreaSqMeters = (points: any[]) => {
      if (points.length < 3) return 0;
      const meanLat = points.reduce((sum, point) => sum + point.lat, 0) / points.length;
      const cosLat = Math.cos(meanLat * Math.PI / 180);
      const origin = points[0];
      const projected = points.map((point) => ({
        x: (point.lng - origin.lng) * 111320 * cosLat,
        y: (point.lat - origin.lat) * 110540
      }));
      let twiceArea = 0;
      for (let i = 0; i < projected.length; i += 1) {
        const a = projected[i]!;
        const b = projected[(i + 1) % projected.length]!;
        twiceArea += a.x * b.y - b.x * a.y;
      }
      return Math.abs(twiceArea) / 2;
    };
    const formatArea = (squareMeters: number) => {
      const acres = squareMeters / 4046.8564224;
      const squareMiles = squareMeters / 2589988.110336;
      if (acres < 100) return acres.toFixed(acres < 10 ? 2 : 1) + ' ac';
      return acres.toFixed(0) + ' ac · ' + squareMiles.toFixed(2) + ' sq mi';
    };
    const trueBearingDegrees = (from: any, to: any) => {
      const lat1 = from.lat * Math.PI / 180;
      const lat2 = to.lat * Math.PI / 180;
      const dLon = (to.lng - from.lng) * Math.PI / 180;
      const y = Math.sin(dLon) * Math.cos(lat2);
      const x = Math.cos(lat1) * Math.sin(lat2) - Math.sin(lat1) * Math.cos(lat2) * Math.cos(dLon);
      return (Math.atan2(y, x) * 180 / Math.PI + 360) % 360;
    };
    const bearingCardinal = (degrees: number) => {
      const dirs = ['N','NE','E','SE','S','SW','W','NW'];
      return dirs[Math.round(degrees / 45) % 8]!;
    };
    const geoJsonPolygonAreaSqMeters = (geometry: any) => {
      if (!geometry) return 0;
      const ringArea = (ring: any[]) => polygonAreaSqMeters((ring || []).map((coord) => L.latLng(Number(coord[1]), Number(coord[0]))));
      const polygonArea = (rings: any[]) => {
        if (!Array.isArray(rings) || !rings.length) return 0;
        let total = ringArea(rings[0]);
        for (let i = 1; i < rings.length; i += 1) total -= ringArea(rings[i]);
        return Math.max(0, total);
      };
      if (geometry.type === 'Polygon') return polygonArea(geometry.coordinates);
      if (geometry.type === 'MultiPolygon') return (geometry.coordinates || []).reduce((sum: number, polygon: any[]) => sum + polygonArea(polygon), 0);
      return 0;
    };

    const addPlanningLabel = (latlng: any, text: string, className: string, targetLayer: any) => {
      if (!latlng || !text) return;
      L.marker(latlng, {
        pane: 'planning',
        interactive: false,
        icon: L.divIcon({
          className: 'rrgh-planning-distance-label ' + className,
          html: '<span>' + text + '</span>',
          iconSize: [1, 1],
          iconAnchor: [0, 0]
        })
      }).addTo(targetLayer);
    };

    const toolButtons = Array.from(shell.querySelectorAll<HTMLButtonElement>('[data-map-tool]'));

    const clonePoints = (points: any[]): MeasureSnapshot =>
      points.map((point) => ({ lat: point.lat, lng: point.lng }));
    const cloneMeasure = (): MeasureSnapshot => clonePoints(measurePoints);
    const cloneArea = (): MeasureSnapshot => clonePoints(areaPoints);
    const cloneBearing = (): MeasureSnapshot => clonePoints(bearingPoints);

    const clonePlan = (): PlanSnapshot => ({
      stops: planStops.map((point) => ({ ...point })),
      segments: planSegments.map((segment) => ({
        mode: segment.mode,
        points: segment.points.map((point) => ({ ...point }))
      }))
    });

    const canUndoCurrentTool = () =>
      activeTool === 'measure'
        ? measureHistoryIndex > 0
        : activeTool === 'area'
          ? areaHistoryIndex > 0
          : activeTool === 'bearing'
            ? bearingHistoryIndex > 0
            : activeTool === 'watershed'
              ? watershedHistoryIndex > 0
              : activeTool === 'plan'
                ? planHistoryIndex > 0
                : false;

    const canRedoCurrentTool = () =>
      activeTool === 'measure'
        ? measureHistoryIndex < measureHistory.length - 1
        : activeTool === 'area'
          ? areaHistoryIndex < areaHistory.length - 1
          : activeTool === 'bearing'
            ? bearingHistoryIndex < bearingHistory.length - 1
            : activeTool === 'watershed'
              ? watershedHistoryIndex < watershedHistory.length - 1
              : activeTool === 'plan'
                ? planHistoryIndex < planHistory.length - 1
                : false;

    const updateHistoryButtons = () => {
      const canUndo = canUndoCurrentTool();
      const canRedo = canRedoCurrentTool();
      if (undoButton) undoButton.disabled = !canUndo;
      if (redoButton) redoButton.disabled = !canRedo;
      if (planMobileUndo) planMobileUndo.disabled = !canUndo;
      if (planMobileRedo) planMobileRedo.disabled = !canRedo;
    };

    const commitMeasureHistory = () => {
      measureHistory = measureHistory.slice(0, measureHistoryIndex + 1);
      measureHistory.push(cloneMeasure());
      measureHistoryIndex = measureHistory.length - 1;
      updateHistoryButtons();
    };

    const restoreMeasureHistory = (index: number) => {
      const snapshot = measureHistory[index];
      if (!snapshot) return;
      measurePoints = snapshot.map((point) => L.latLng(point.lat, point.lng));
      measureHistoryIndex = index;
      redrawMeasure();
      updateHistoryButtons();
    };

    const commitAreaHistory = () => {
      areaHistory = areaHistory.slice(0, areaHistoryIndex + 1);
      areaHistory.push(cloneArea());
      areaHistoryIndex = areaHistory.length - 1;
      updateHistoryButtons();
    };

    const restoreAreaHistory = (index: number) => {
      const snapshot = areaHistory[index];
      if (!snapshot) return;
      areaPoints = snapshot.map((point) => L.latLng(point.lat, point.lng));
      areaHistoryIndex = index;
      redrawArea();
      updateHistoryButtons();
    };

    const commitBearingHistory = () => {
      bearingHistory = bearingHistory.slice(0, bearingHistoryIndex + 1);
      bearingHistory.push(cloneBearing());
      bearingHistoryIndex = bearingHistory.length - 1;
      updateHistoryButtons();
    };

    const restoreBearingHistory = (index: number) => {
      const snapshot = bearingHistory[index];
      if (!snapshot) return;
      bearingPoints = snapshot.map((point) => L.latLng(point.lat, point.lng));
      bearingHistoryIndex = index;
      void redrawBearing();
      updateHistoryButtons();
    };

    const commitWatershedHistory = (outlet: any) => {
      watershedHistory = watershedHistory.slice(0, watershedHistoryIndex + 1);
      watershedHistory.push({ lat: outlet.lat, lng: outlet.lng });
      watershedHistoryIndex = watershedHistory.length - 1;
      updateHistoryButtons();
    };

    const restoreWatershedHistory = (index: number) => {
      const snapshot = watershedHistory[index];
      if (snapshot === undefined) return;
      watershedHistoryIndex = index;
      watershedRevision += 1;
      watershedController?.abort();
      watershedController = null;
      setMapActivity('watershed', false);
      watershedLayer.clearLayers();
      delete container.dataset.watershedFeatureCount;
      delete container.dataset.watershedAreaSqMi;
      if (snapshot === null) {
        container.dataset.watershedLoadState = 'idle';
        updateAnalysisStats('Watershed', ['Area','Outlet','Source','Status'], ['—','—','USGS','Choose point'], 'Choose a stream/outlet point.');
        setStatus('Watershed: choose an outlet point.');
      } else {
        void loadWatershed(L.latLng(snapshot.lat, snapshot.lng));
      }
      updateHistoryButtons();
    };

    const commitPlanHistory = () => {
      planHistory = planHistory.slice(0, planHistoryIndex + 1);
      planHistory.push(clonePlan());
      planHistoryIndex = planHistory.length - 1;
      updateHistoryButtons();
    };

    const restorePlanHistory = (index: number) => {
      const snapshot = planHistory[index];
      if (!snapshot) return;
      planStops = snapshot.stops.map((point) => ({ ...point }));
      planSegments = snapshot.segments.map((segment) => ({
        mode: segment.mode,
        points: segment.points.map((point) => ({ ...point }))
      }));
      planHistoryIndex = index;
      redrawPlan();
      updateHistoryButtons();
    };

    const undoCurrentTool = () => {
      if (activeTool === 'measure' && measureHistoryIndex > 0) {
        restoreMeasureHistory(measureHistoryIndex - 1);
      } else if (activeTool === 'area' && areaHistoryIndex > 0) {
        restoreAreaHistory(areaHistoryIndex - 1);
      } else if (activeTool === 'bearing' && bearingHistoryIndex > 0) {
        restoreBearingHistory(bearingHistoryIndex - 1);
      } else if (activeTool === 'watershed' && watershedHistoryIndex > 0) {
        restoreWatershedHistory(watershedHistoryIndex - 1);
      } else if (activeTool === 'plan' && planHistoryIndex > 0) {
        restorePlanHistory(planHistoryIndex - 1);
      }
    };

    const redoCurrentTool = () => {
      if (activeTool === 'measure' && measureHistoryIndex < measureHistory.length - 1) {
        restoreMeasureHistory(measureHistoryIndex + 1);
      } else if (activeTool === 'area' && areaHistoryIndex < areaHistory.length - 1) {
        restoreAreaHistory(areaHistoryIndex + 1);
      } else if (activeTool === 'bearing' && bearingHistoryIndex < bearingHistory.length - 1) {
        restoreBearingHistory(bearingHistoryIndex + 1);
      } else if (activeTool === 'watershed' && watershedHistoryIndex < watershedHistory.length - 1) {
        restoreWatershedHistory(watershedHistoryIndex + 1);
      } else if (activeTool === 'plan' && planHistoryIndex < planHistory.length - 1) {
        restorePlanHistory(planHistoryIndex + 1);
      }
    };

    const snappedPlanPoint = (latlng: any): PlanPoint => {
      const snapped = graph.size ? nearestNode(latlng) : null;
      if (!snapped) return { lat: latlng.lat, lng: latlng.lng };
      const point = nodeCoords.get(snapped.key);
      if (!point) return { lat: latlng.lat, lng: latlng.lng };
      return { lat: point.lat, lng: point.lng, nodeKey: snapped.key };
    };

    const buildAutoPlanSegment = (previous: PlanPoint, targetLatLng: any): { segment: PlanSegment; target: PlanPoint } | null => {
      const snappedTarget = snappedPlanPoint(targetLatLng);
      if (previous.lat === snappedTarget.lat && previous.lng === snappedTarget.lng) return null;

      if (previous.nodeKey && snappedTarget.nodeKey) {
        const path = shortestTrailPath(previous.nodeKey, snappedTarget.nodeKey);
        if (path && path.length > 1) {
          const points: PlanPoint[] = [];
          for (const key of path) {
            const point = nodeCoords.get(key);
            if (point) points.push({ lat: point.lat, lng: point.lng, nodeKey: key });
          }
          if (points.length > 1) {
            const directMeters = L.latLng(previous.lat, previous.lng).distanceTo(L.latLng(snappedTarget.lat, snappedTarget.lng));
            const snappedMeters = pathDistanceMeters(points.map((point) => L.latLng(point.lat, point.lng)));
            const unreasonableShortDetour = directMeters <= 600 && snappedMeters > Math.max(900, directMeters * 6);
            if (!unreasonableShortDetour) return { segment: { mode: 'snap', points }, target: snappedTarget };
            container.dataset.planDetourGuardCount = String(Number(container.dataset.planDetourGuardCount || '0') + 1);
          }
        }
      }

      return {
        segment: { mode: 'straight', points: [{ ...previous }, { ...snappedTarget }] },
        target: snappedTarget
      };
    };

    const rebuildPlanFromStops = () => {
      if (planStops.length < 2) {
        planSegments = [];
        return;
      }
      const intendedStops = planStops.map((point) => ({ ...point }));
      const rebuiltStops: PlanPoint[] = [{ ...intendedStops[0]! }];
      const rebuiltSegments: PlanSegment[] = [];

      for (let index = 1; index < intendedStops.length; index += 1) {
        const previous = rebuiltStops[rebuiltStops.length - 1]!;
        const intended = intendedStops[index]!;
        const built = buildAutoPlanSegment(previous, L.latLng(intended.lat, intended.lng));
        if (!built) continue;
        rebuiltSegments.push(built.segment);
        rebuiltStops.push(built.target);
      }

      planStops = rebuiltStops;
      planSegments = rebuiltSegments;
    };

    const renderPlanHelp = (tool: ActiveMapTool) => {
      if (!planHelp) return;
      planHelp.replaceChildren();
      const messages: Record<string, string[]> = {
        overview: [
          'Measure distance: click or tap points to measure a straight-line distance.',
          'Measure area: outline a polygon for area and perimeter.',
          'Bearing / slope: choose two points for true bearing, grade and slope angle.',
          'Watershed: choose an outlet point for a USGS StreamStats drainage-basin estimate.',
          'Build trail route: click near mapped trails or roads to snap automatically; click away from the network for a straight segment.',
          'Use Undo / Redo as you edit, or Clear to start over.'
        ],
        measure: [
          'Click or tap points to measure straight-line distance.',
          'Elevation change updates from USGS 3DEP after two points.'
        ],
        area: ['Click or tap three or more boundary points. Area and perimeter update with every point.'],
        bearing: ['Choose a start point and end point. A third click starts a new bearing measurement.'],
        watershed: ['Click a stream/outlet point. RRGH sends only that clicked coordinate to USGS StreamStats and displays its approximate basin delineation.'],
        plan: [
          'Click near a mapped trail or road to snap to the network; click away from it for a straight segment.',
          'Drag a planned segment to adjust or resnap it.',
          'Right-click or press and hold a planned segment to delete it.'
        ]
      };
      const items = messages[tool ?? 'overview'] ?? messages.overview ?? [];
      const list = document.createElement(items.length === 1 ? 'p' : 'ul');
      for (const item of items) {
        if (list instanceof HTMLUListElement) {
          const li = document.createElement('li');
          li.textContent = item;
          list.append(li);
        } else {
          list.textContent = item;
        }
      }
      planHelp.append(list);
    };

    const setTool = (tool: ActiveMapTool) => {
      activeTool = tool;
      renderPlanHelp(tool);
      updateHistoryButtons();
      syncPlanMinimizeUi();
      stage?.setAttribute('data-active-tool', tool ?? 'explore');
      if (planPanPad) planPanPad.hidden = tool !== 'plan';

      for (const button of toolButtons) {
        const buttonTool = button.dataset.mapTool;
        if (['measure','area','bearing','watershed','plan'].includes(buttonTool || '')) {
          button.setAttribute('aria-pressed', String(buttonTool === tool));
        }
      }
      for (const button of saveButtons) button.disabled = tool !== 'plan' || planTrackPoints().length < 2;

      if (tool === 'measure') {
        if (planPanel) planPanel.hidden = false;
        redrawMeasure(false);
        setStatus('Measure distance: click points anywhere on the map. Segment distances appear on the map; elevation updates from USGS 3DEP after two points.');
        minimizePlanPanel();
      } else if (tool === 'area') {
        if (planPanel) planPanel.hidden = false;
        redrawArea();
        setStatus('Measure area: click at least three boundary points. Keep clicking to refine the polygon.');
        minimizePlanPanel();
      } else if (tool === 'bearing') {
        if (planPanel) planPanel.hidden = false;
        redrawBearing();
        setStatus('Bearing / slope: choose a start point and end point.');
        minimizePlanPanel();
      } else if (tool === 'watershed') {
        if (planPanel) planPanel.hidden = false;
        updateAnalysisStats('Watershed', ['Area','Outlet','Source','Status'], ['—','—','USGS','Choose point'], 'Click a stream/outlet point to request an approximate USGS StreamStats delineation.');
        setStatus('Watershed: click the outlet point you want to analyze. StreamStats works best when the point is on its mapped stream grid.');
        minimizePlanPanel();
      } else if (tool === 'plan') {
        if (planPanel) planPanel.hidden = false;
        redrawPlan(false);
        setStatus('Build route: click near an official trail, community/informal trail, or mapped road to snap automatically; click clearly away from the mapped network for a dashed straight segment. Distances appear on each segment and route elevation updates as you edit.');
        minimizePlanPanel();
      } else if (!vectorFailures.length && readiness.core) {
        if (planLiveStats) planLiveStats.hidden = true;
        setStatus('Drag to pan, use +/− or pinch to zoom. Right-click on desktop or press and hold on mobile for coordinates. Use Explore to browse routes or Tools for measurements, terrain analysis, and route building.');
      }
    };

    const clearTools = () => {
      measureLayer.clearLayers();
      areaLayer.clearLayers();
      bearingLayer.clearLayers();
      watershedLayer.clearLayers();
      planLayer.clearLayers();
      measurePoints = [];
      areaPoints = [];
      bearingPoints = [];
      bearingRevision += 1;
      watershedRevision += 1;
      bearingElevationController?.abort();
      watershedController?.abort();
      bearingElevationController = null;
      watershedController = null;
      setMapActivity('watershed', false);
      planStops = [];
      planSegments = [];
      measureElevationsFt = null;
      planElevationSummary = null;
      measureElevationRevision += 1;
      planElevationRevision += 1;
      window.clearTimeout(measureElevationTimer);
      window.clearTimeout(planElevationTimer);
      measureElevationController?.abort();
      planElevationController?.abort();
      measureElevationController = null;
      planElevationController = null;
      measureHistory = [[]];
      measureHistoryIndex = 0;
      areaHistory = [[]];
      areaHistoryIndex = 0;
      bearingHistory = [[]];
      bearingHistoryIndex = 0;
      watershedHistory = [null];
      watershedHistoryIndex = 0;
      planHistory = [{ stops: [], segments: [] }];
      planHistoryIndex = 0;
      for (const button of saveButtons) button.disabled = true;
      updateHistoryButtons();
      if (planLiveStats) planLiveStats.hidden = activeTool === null;
      if (activeTool === 'measure') {
        updateLiveStats('Measured line', 0, null, 'Add two points for elevation.');
        setStatus('Measure distance: click points anywhere on the map.');
      } else if (activeTool === 'area') {
        updateAnalysisStats('Measured area', ['Area','Perimeter','Vertices','Surface'], ['—','—','0','Map'], 'Add at least three boundary points.');
        setStatus('Measure area: click at least three boundary points.');
      } else if (activeTool === 'bearing') {
        updateAnalysisStats('Bearing / slope', ['Bearing','Distance','Grade','Slope'], ['—','—','—','—'], 'Choose two points.');
        setStatus('Bearing / slope: choose a start point and end point.');
      } else if (activeTool === 'watershed') {
        updateAnalysisStats('Watershed', ['Area','Outlet','Source','Status'], ['—','—','USGS','Choose point'], 'Choose a stream/outlet point.');
        setStatus('Watershed: choose an outlet point.');
      } else if (activeTool === 'plan') {
        updateLiveStats('Planned route', 0, null, 'Add two points for elevation.');
        setStatus('Build route: place a first point near the mapped trail/road network, or clearly away from it to start off trail.');
      } else {
        setStatus('Map cleared.');
      }
    };

    type PlanConfirmAction = 'clear' | 'exit';
    let pendingPlanConfirmAction: PlanConfirmAction | null = null;

    const hasPlanningWork = () =>
      measurePoints.length > 0 || areaPoints.length > 0 || bearingPoints.length > 0 || watershedLayer.getLayers().length > 0 || planStops.length > 0 || planSegments.length > 0;

    const planningDeleteMessage = () => {
      const hasDistanceMeasurement = measurePoints.length > 0;
      const hasAnalysis = areaPoints.length > 0 || bearingPoints.length > 0 || watershedLayer.getLayers().length > 0;
      const hasRoute = planStops.length > 0 || planSegments.length > 0;
      if (hasDistanceMeasurement && hasRoute && !hasAnalysis) return 'Are you sure you want to delete your measurement and built path?';
      if (hasDistanceMeasurement && !hasRoute && !hasAnalysis) return 'Are you sure you want to delete your measurement?';
      if (!hasDistanceMeasurement && hasRoute && !hasAnalysis) return 'Are you sure you want to delete your built path?';
      if ((hasDistanceMeasurement || hasAnalysis) && hasRoute) return 'Are you sure you want to delete your measurements, analysis, and built path?';
      return 'Are you sure you want to delete your measurements and analysis?';
    };

    const closePlanPanel = () => {
      setTool(null);
      if (planPanel) {
        planPanel.hidden = true;
        delete planPanel.dataset.minimized;
      }
      syncPlanMinimizeUi();
      syncSheetButtons();
    };

    const performPlanConfirmAction = (action: PlanConfirmAction) => {
      clearTools();
      if (action === 'exit') closePlanPanel();
    };

    const requestPlanConfirmAction = (action: PlanConfirmAction) => {
      if (!hasPlanningWork()) {
        if (action === 'clear') clearTools();
        else closePlanPanel();
        return;
      }

      const message = planningDeleteMessage();
      if (!planConfirm || typeof planConfirm.showModal !== 'function') {
        if (window.confirm(message)) performPlanConfirmAction(action);
        return;
      }

      pendingPlanConfirmAction = action;
      planConfirm.returnValue = '';
      if (planConfirmMessage) planConfirmMessage.textContent = message;
      planConfirm.showModal();
      window.setTimeout(() => planConfirmOk?.focus(), 0);
    };

    planConfirm?.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' || event.ctrlKey || event.metaKey || event.altKey) return;
      event.preventDefault();
      planConfirmOk?.click();
    });

    planConfirm?.addEventListener('close', () => {
      const action = pendingPlanConfirmAction;
      const confirmed = planConfirm.returnValue === 'confirm';
      pendingPlanConfirmAction = null;
      if (confirmed && action) performPlanConfirmAction(action);
    });

    planClose?.addEventListener('click', () => requestPlanConfirmAction('exit'));

    const isEditablePlanShortcutTarget = (target: EventTarget | null) => {
      if (!(target instanceof Element)) return false;
      return Boolean(target.closest('input, textarea, select, [contenteditable="true"]'));
    };

    window.addEventListener('keydown', (event) => {
      if (!planPanel || planPanel.hidden || planConfirm?.open || isEditablePlanShortcutTarget(event.target)) return;

      const modifier = event.ctrlKey || event.metaKey;
      const key = event.key.toLowerCase();
      if (activeTool !== null && modifier && !event.altKey && key === 'z') {
        event.preventDefault();
        if (event.shiftKey) redoCurrentTool();
        else undoCurrentTool();
        return;
      }
      if (activeTool !== null && modifier && !event.altKey && !event.shiftKey && key === 'y') {
        event.preventDefault();
        redoCurrentTool();
        return;
      }
      if (event.key === 'Escape' && !event.ctrlKey && !event.metaKey && !event.altKey) {
        event.preventDefault();
        requestPlanConfirmAction('exit');
      }
    });

    const xmlEscape = (value: string) =>
      value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&apos;');

    const planTrackPoints = () => {
      const points: PlanPoint[] = [];
      for (const segment of planSegments) {
        for (const point of segment.points) {
          const prior = points[points.length - 1];
          if (!prior || prior.lat !== point.lat || prior.lng !== point.lng) points.push(point);
        }
      }
      if (!points.length && planStops.length) points.push(...planStops);
      return points;
    };

    const savePlanGpx = () => {
      const points = planTrackPoints();
      if (points.length < 2) {
        setStatus('Build a route before exporting it.', 'warning');
        return;
      }

      const trackPoints = points
        .map((point) => '      <trkpt lat="' + point.lat.toFixed(6) + '" lon="' + point.lng.toFixed(6) + '"></trkpt>')
        .join('\n');
      const gpx = '<?xml version="1.0" encoding="UTF-8"?>\n'
        + '<gpx version="1.1" creator="Red River Gorge Hiker" xmlns="http://www.topografix.com/GPX/1/1">\n'
        + '  <metadata><name>' + xmlEscape('RRGH planned route') + '</name></metadata>\n'
        + '  <trk><name>' + xmlEscape('RRGH planned route') + '</name><trkseg>\n'
        + trackPoints + '\n'
        + '  </trkseg></trk>\n'
        + '</gpx>\n';

      const blob = new Blob([gpx], { type: 'application/gpx+xml;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'RRGH-planned-route-' + new Date().toISOString().slice(0, 10) + '.gpx';
      document.body.append(link);
      link.click();
      link.remove();
      setTimeout(() => URL.revokeObjectURL(url), 0);
      setStatus('Planned route exported as a GPX file.');
    };

    for (const button of toolButtons) {
      button.addEventListener('click', () => {
        const tool = button.dataset.mapTool;
        if (tool === 'clear') {
          requestPlanConfirmAction('clear');
          return;
        }
        if (tool === 'save') {
          savePlanGpx();
          return;
        }
        if (tool === 'measure' || tool === 'area' || tool === 'bearing' || tool === 'watershed' || tool === 'plan') {
          setTool(activeTool === tool ? null : tool);
        }
      });
    }

    undoButton?.addEventListener('click', undoCurrentTool);
    redoButton?.addEventListener('click', redoCurrentTool);
    planMobileUndo?.addEventListener('click', undoCurrentTool);
    planMobileRedo?.addEventListener('click', redoCurrentTool);

    const scheduleMeasureElevation = () => {
      const revision = ++measureElevationRevision;
      window.clearTimeout(measureElevationTimer);
      measureElevationController?.abort();
      measureElevationController = null;
      measureElevationsFt = null;
      if (measurePoints.length < 2) return;

      measureElevationTimer = window.setTimeout(async () => {
        const controller = new AbortController();
        measureElevationController = controller;
        try {
          const elevations = await fetchElevations(measurePoints, controller.signal);
          if (revision !== measureElevationRevision) return;
          measureElevationsFt = elevations;
          redrawMeasure(false);
        } catch (error) {
          if (controller.signal.aborted || revision !== measureElevationRevision) return;
          console.error(error);
          measureElevationsFt = null;
          const total = pathDistanceMeters(measurePoints);
          updateLiveStats('Measured line', total, null, 'Distance is available; USGS elevation is temporarily unavailable.');
        }
      }, 220);
    };

    const schedulePlanElevation = (points: any[]) => {
      const revision = ++planElevationRevision;
      window.clearTimeout(planElevationTimer);
      planElevationController?.abort();
      planElevationController = null;
      planElevationSummary = null;
      if (points.length < 2) return;

      const samples = resampleElevationPath(points, 64);
      planElevationTimer = window.setTimeout(async () => {
        const controller = new AbortController();
        planElevationController = controller;
        try {
          const elevations = await fetchElevations(samples, controller.signal);
          if (revision !== planElevationRevision) return;
          planElevationSummary = summarizeElevations(elevations);
          redrawPlan(false);
        } catch (error) {
          if (controller.signal.aborted || revision !== planElevationRevision) return;
          console.error(error);
          planElevationSummary = null;
          const total = pathDistanceMeters(points);
          updateLiveStats('Planned route', total, null, 'Distance is available; USGS elevation is temporarily unavailable.');
        }
      }, 260);
    };

    const redrawArea = () => {
      areaLayer.clearLayers();
      for (const point of areaPoints) {
        L.circleMarker(point, {
          pane: 'planning', renderer: planningRenderer, radius: 5, color: '#fff', weight: 2,
          fillColor: '#2b7f78', fillOpacity: 1, interactive: false
        }).addTo(areaLayer);
      }
      if (areaPoints.length >= 2) {
        L.polyline(areaPoints, {
          pane: 'planning', renderer: planningRenderer, color: '#2b7f78', weight: 4,
          opacity: 1, dashArray: '7 5', interactive: false
        }).addTo(areaLayer);
      }
      const perimeterOpen = pathDistanceMeters(areaPoints);
      const perimeter = areaPoints.length >= 3 ? perimeterOpen + areaPoints[areaPoints.length - 1]!.distanceTo(areaPoints[0]) : perimeterOpen;
      const squareMeters = polygonAreaSqMeters(areaPoints);
      if (areaPoints.length >= 3) {
        L.polygon(areaPoints, {
          pane: 'planning', renderer: planningRenderer, color: '#147268', weight: 3,
          opacity: 1, fillColor: '#4ab3a6', fillOpacity: 0.18, interactive: false
        }).addTo(areaLayer);
        const center = L.latLngBounds(areaPoints).getCenter();
        addPlanningLabel(center, formatArea(squareMeters), 'is-area-total', areaLayer);
      }
      updateAnalysisStats(
        'Measured area',
        ['Area','Perimeter','Vertices','Surface'],
        [areaPoints.length >= 3 ? formatArea(squareMeters) : '—', areaPoints.length >= 2 ? formatDistance(perimeter) : '—', String(areaPoints.length), 'Planar'],
        areaPoints.length >= 3 ? 'Approximate map-plane area; add more vertices to refine the boundary.' : 'Add at least three boundary points.'
      );
      setStatus(areaPoints.length >= 3
        ? 'Measured area: ' + formatArea(squareMeters) + ' · perimeter ' + formatDistance(perimeter) + '.'
        : 'Measure area: ' + areaPoints.length + ' point(s) set; add at least three.');
    };

    const redrawBearing = async () => {
      const revision = ++bearingRevision;
      bearingElevationController?.abort();
      bearingElevationController = null;
      bearingLayer.clearLayers();
      for (const point of bearingPoints) {
        L.circleMarker(point, {
          pane: 'planning', renderer: planningRenderer, radius: 6, color: '#fff', weight: 2,
          fillColor: '#7a4d9f', fillOpacity: 1, interactive: false
        }).addTo(bearingLayer);
      }
      if (bearingPoints.length < 2) {
        updateAnalysisStats('Bearing / slope', ['Bearing','Distance','Grade','Slope'], ['—','—','—','—'], 'Choose a start point and end point.');
        return;
      }
      const [from,to] = bearingPoints;
      const distanceMeters = from.distanceTo(to);
      const bearing = trueBearingDegrees(from,to);
      L.polyline([from,to], {
        pane: 'planning', renderer: planningRenderer, color: '#7a4d9f', weight: 4, opacity: 1,
        dashArray: '10 5', interactive: false
      }).addTo(bearingLayer);
      addPlanningLabel(pathMidpoint([from,to]), Math.round(bearing) + '° ' + bearingCardinal(bearing) + ' · ' + formatDistance(distanceMeters), 'is-bearing', bearingLayer);
      updateAnalysisStats(
        'Bearing / slope',
        ['Bearing','Distance','Grade','Slope'],
        [Math.round(bearing) + '° ' + bearingCardinal(bearing), formatDistance(distanceMeters), '…', '…'],
        'Calculating endpoint elevations from USGS 3DEP…'
      );
      const controller = new AbortController();
      bearingElevationController = controller;
      try {
        const elevations = await fetchElevations([from,to],controller.signal);
        if (revision !== bearingRevision) return;
        const riseFt = elevations[1]! - elevations[0]!;
        const horizontalFt = distanceMeters * 3.280839895013123;
        const grade = horizontalFt > 0 ? riseFt / horizontalFt * 100 : 0;
        const slope = Math.atan2(riseFt,horizontalFt) * 180 / Math.PI;
        updateAnalysisStats(
          'Bearing / slope',
          ['Bearing','Distance','Grade','Slope'],
          [Math.round(bearing) + '° ' + bearingCardinal(bearing), formatDistance(distanceMeters), (grade >= 0 ? '+' : '') + grade.toFixed(1) + '%', (slope >= 0 ? '+' : '') + slope.toFixed(1) + '°'],
          'USGS 3DEP endpoints: ' + formatFeet(elevations[0]!) + ' → ' + formatFeet(elevations[1]!) + ' (' + formatElevationDelta(riseFt) + ').'
        );
        container.dataset.bearingDegrees = bearing.toFixed(2);
        container.dataset.bearingGradePercent = grade.toFixed(2);
      } catch (error) {
        if (controller.signal.aborted || revision !== bearingRevision) return;
        console.error(error);
        updateAnalysisStats(
          'Bearing / slope',
          ['Bearing','Distance','Grade','Slope'],
          [Math.round(bearing) + '° ' + bearingCardinal(bearing), formatDistance(distanceMeters), '—', '—'],
          'Bearing and distance are available; USGS elevation is temporarily unavailable.'
        );
      }
    };

    const loadWatershed = async (outlet: any) => {
      const revision = ++watershedRevision;
      watershedController?.abort();
      watershedController = new AbortController();
      watershedLayer.clearLayers();
      L.circleMarker(outlet, {
        pane: 'planning', renderer: planningRenderer, radius: 7, color: '#fff', weight: 2,
        fillColor: '#2863a6', fillOpacity: 1
      }).bindTooltip('Watershed outlet', { direction: 'top' }).addTo(watershedLayer);
      container.dataset.watershedLoadState = 'loading';
      setMapActivity('watershed', true);
      updateAnalysisStats(
        'Watershed',
        ['Area','Outlet','Source','Status'],
        ['…', outlet.lat.toFixed(5) + ', ' + outlet.lng.toFixed(5), 'USGS', 'Loading'],
        'USGS StreamStats is delineating the drainage basin. This can take several seconds.'
      );
      setStatus('Watershed: asking USGS StreamStats to delineate the basin…');
      const params = new URLSearchParams({ lat: outlet.lat.toFixed(7), lon: outlet.lng.toFixed(7) });
      try {
        const source = sourceById('usgs-streamstats-delineate');
        if (!source?.serviceUrl) throw new Error('USGS StreamStats source is unavailable.');
        const response = await fetch(source.serviceUrl + '/v1/delineate/features/KY?' + params.toString(), {
          signal: watershedController.signal,
          mode: 'cors',
          credentials: 'omit',
          referrerPolicy: 'strict-origin-when-cross-origin'
        });
        if (!response.ok) throw new Error('USGS StreamStats returned HTTP ' + response.status);
        const data = await response.json();
        if (revision !== watershedRevision) return;
        if (data?.type !== 'FeatureCollection' || !Array.isArray(data?.features)) throw new Error('USGS StreamStats returned an unexpected response.');
        const polygonFeatures = data.features.filter((feature: any) => feature?.geometry?.type === 'Polygon' || feature?.geometry?.type === 'MultiPolygon');
        if (!polygonFeatures.length) throw new Error('USGS StreamStats returned no basin polygon.');
        let areaSqMeters = 0;
        for (const feature of polygonFeatures) areaSqMeters += geoJsonPolygonAreaSqMeters(feature.geometry);
        const basin = { type: 'FeatureCollection', features: polygonFeatures };
        L.geoJSON(basin as any, {
          pane: 'planning',
          style: {
            color: '#2863a6', weight: 3, opacity: 0.95, dashArray: '8 4',
            fillColor: '#4e93d1', fillOpacity: 0.18
          }
        }).addTo(watershedLayer);
        container.dataset.watershedLoadState = 'loaded';
        container.dataset.watershedFeatureCount = String(polygonFeatures.length);
        container.dataset.watershedAreaSqMi = (areaSqMeters / 2589988.110336).toFixed(4);
        updateAnalysisStats(
          'Watershed',
          ['Area','Outlet','Source','Status'],
          [formatArea(areaSqMeters), outlet.lat.toFixed(5) + ', ' + outlet.lng.toFixed(5), 'USGS', 'Delineated'],
          'Automated USGS StreamStats delineation. Verify against terrain; not a property, flood, access, or legal boundary.'
        );
        setStatus('Watershed delineated: ' + formatArea(areaSqMeters) + '. StreamStats boundaries are approximate and should be checked against terrain.');
        if (revision === watershedRevision) setMapActivity('watershed', false);
      } catch (error) {
        if (watershedController.signal.aborted || revision !== watershedRevision) return;
        console.error(error);
        container.dataset.watershedLoadState = 'error';
        setMapActivity('watershed', false);
        updateAnalysisStats(
          'Watershed',
          ['Area','Outlet','Source','Status'],
          ['—', outlet.lat.toFixed(5) + ', ' + outlet.lng.toFixed(5), 'USGS', 'Unavailable'],
          'StreamStats could not delineate this point. Try clicking directly on a mapped stream/grid location.'
        );
        setStatus('USGS StreamStats could not delineate that point. Try a nearby point directly on the stream.', 'warning');
      }
    };

    const redrawMeasure = (refreshElevation = true) => {
      measureLayer.clearLayers();
      if (refreshElevation) {
        measureElevationsFt = null;
        scheduleMeasureElevation();
      }

      for (const point of measurePoints) {
        L.circleMarker(point, {
          pane: 'planning',
          renderer: planningRenderer,
          radius: 5,
          color: '#fff',
          weight: 2,
          fillColor: '#d9892b',
          fillOpacity: 1,
          interactive: false
        }).addTo(measureLayer);
      }

      let total = 0;
      for (let i = 1; i < measurePoints.length; i += 1) {
        const from = measurePoints[i - 1];
        const to = measurePoints[i];
        const segmentDistance = from.distanceTo(to);
        total += segmentDistance;
        L.polyline([from, to], {
          pane: 'planning',
          renderer: planningRenderer,
          color: '#d9892b',
          weight: 4,
          opacity: 1,
          dashArray: '8 5',
          interactive: false
        }).addTo(measureLayer);

        const delta = measureElevationsFt?.[i] !== undefined && measureElevationsFt?.[i - 1] !== undefined
          ? measureElevationsFt[i]! - measureElevationsFt[i - 1]!
          : null;
        const label = formatDistance(segmentDistance) + (delta === null ? '' : ' · ' + formatElevationDelta(delta));
        addPlanningLabel(pathMidpoint([from, to]), label, 'is-measure-segment', measureLayer);
      }

      const measureSummary = measureElevationsFt?.length === measurePoints.length
        ? summarizeElevations(measureElevationsFt)
        : null;
      const note = measurePoints.length < 2
        ? 'Add two points for elevation.'
        : measureSummary
          ? 'USGS 3DEP elevation at each measurement point.'
          : 'Calculating USGS 3DEP elevation…';
      updateLiveStats('Measured line', total, measureSummary, note);

      if (measurePoints.length > 1) {
        const finalLabel = 'Total ' + formatDistance(total)
          + (measureSummary ? ' · ' + formatElevationDelta(measureSummary.endFt - measureSummary.startFt) : '');
        addPlanningLabel(measurePoints[measurePoints.length - 1], finalLabel, 'is-total', measureLayer);
      }

      setStatus(measurePoints.length > 1
        ? 'Measured distance: ' + formatDistance(total) + ' · segment labels show point-to-point distance' + (measureSummary ? ' and elevation change.' : '; elevation is updating.')
        : measurePoints.length === 1
          ? 'Measure distance: first point set · click another point.'
          : 'Measure distance: click a first point.');
    };

    const deletePlanSegment = (segmentIndex: number) => {
      if (segmentIndex < 0 || segmentIndex >= planSegments.length) return;
      planStops.splice(segmentIndex + 1, 1);
      rebuildPlanFromStops();
      commitPlanHistory();
      redrawPlan();
      setStatus('Planned segment deleted. Continue clicking to extend the route, drag another segment to adjust it, or right-click another segment to delete it.');
    };

    const movePlanSegmentTarget = (segmentIndex: number, latlng: any) => {
      if (segmentIndex < 0 || segmentIndex >= planSegments.length || !planStops[segmentIndex + 1]) return;
      planStops[segmentIndex + 1] = { lat: latlng.lat, lng: latlng.lng };
      rebuildPlanFromStops();
      commitPlanHistory();
      redrawPlan();
    };

    const attachPlanSegmentInteraction = (hitLine: any, visibleLine: any, segmentIndex: number) => {
      hitLine.on('contextmenu', (event: any) => {
        if (activeTool !== 'plan') return;
        const original = event.originalEvent;
        original?.preventDefault?.();
        original?.stopPropagation?.();
        suppressPlanClickUntil = Date.now() + 300;
        deletePlanSegment(segmentIndex);
      });

      const hitElement = hitLine.getElement?.() as SVGPathElement | null;
      if (!hitElement) return;
      hitElement.style.cursor = 'grab';
      hitElement.style.touchAction = 'none';

      const toMapLatLng = (clientX: number, clientY: number) => {
        const rect = container.getBoundingClientRect();
        return map.containerPointToLatLng(L.point(clientX - rect.left, clientY - rect.top));
      };

      const beginSegmentDrag = (clientX: number, clientY: number) => {
        if (segmentDragActive || activeTool !== 'plan') return;

        const startStop = planStops[segmentIndex];
        if (!startStop) return;

        segmentDragActive = true;
        suppressPlanClickUntil = Date.now() + 500;
        map.dragging.disable();
        hitElement.style.cursor = 'grabbing';
        container.dataset.planDragSegment = String(segmentIndex);
        container.dataset.planDragMoved = 'false';
        delete container.dataset.planDragPreviewMode;

        let moved = false;
        let lastClientX = clientX;
        let lastClientY = clientY;
        let lastResolvedTarget: PlanPoint | null = null;

        const previewTarget = (target: any) => {
          const built = buildAutoPlanSegment(startStop, target);
          const previewPoints = built?.segment.points?.length
            ? built.segment.points.map((point) => L.latLng(point.lat, point.lng))
            : [L.latLng(startStop.lat, startStop.lng), target];
          const snapped = built?.segment.mode === 'snap';
          lastResolvedTarget = built?.target ? { ...built.target } : { lat: target.lat, lng: target.lng };
          container.dataset.planDragPreviewMode = snapped ? 'snap' : 'straight';

          visibleLine.setLatLngs(previewPoints);
          visibleLine.setStyle({
            color: snapped ? '#e17a35' : '#8b4e9e',
            dashArray: snapped ? undefined : '9 6'
          });
        };

        const cleanup = () => {
          window.removeEventListener('mousemove', onMove, true);
          window.removeEventListener('pointermove', onMove, true);
          window.removeEventListener('mouseup', onEnd, true);
          window.removeEventListener('pointerup', onEnd, true);
          window.removeEventListener('pointercancel', onCancel, true);
          window.removeEventListener('blur', onCancel, true);
          hitElement.style.cursor = 'grab';
          map.dragging.enable();
          segmentDragActive = false;
          delete container.dataset.planDragSegment;
        };

        const onMove = (moveEvent: MouseEvent | PointerEvent) => {
          if (!segmentDragActive) return;
          moved = true;
          container.dataset.planDragMoved = 'true';
          lastClientX = moveEvent.clientX;
          lastClientY = moveEvent.clientY;
          previewTarget(toMapLatLng(lastClientX, lastClientY));
        };

        const onEnd = (endEvent: MouseEvent | PointerEvent) => {
          if (!segmentDragActive) return;
          lastClientX = endEvent.clientX ?? lastClientX;
          lastClientY = endEvent.clientY ?? lastClientY;
          const rawDrop = toMapLatLng(lastClientX, lastClientY);
          const resolvedDrop = lastResolvedTarget
            ? L.latLng(lastResolvedTarget.lat, lastResolvedTarget.lng)
            : rawDrop;
          cleanup();
          suppressPlanClickUntil = Date.now() + 350;
          if (!moved) {
            redrawPlan();
            return;
          }
          movePlanSegmentTarget(segmentIndex, resolvedDrop);
        };

        const onCancel = () => {
          if (!segmentDragActive) return;
          cleanup();
          redrawPlan();
        };

        window.addEventListener('mousemove', onMove, true);
        window.addEventListener('pointermove', onMove, true);
        window.addEventListener('mouseup', onEnd, true);
        window.addEventListener('pointerup', onEnd, true);
        window.addEventListener('pointercancel', onCancel, true);
        window.addEventListener('blur', onCancel, true);
      };

      hitLine.on('mousedown', (event: any) => {
        if (activeTool !== 'plan') return;
        const original = event.originalEvent as MouseEvent | undefined;
        if (!original || original.button !== 0) return;
        original.preventDefault();
        original.stopPropagation();
        beginSegmentDrag(original.clientX, original.clientY);
      });

      hitElement.addEventListener('mousedown', (event: MouseEvent) => {
        if (activeTool !== 'plan' || event.button !== 0) return;
        event.preventDefault();
        event.stopPropagation();
        beginSegmentDrag(event.clientX, event.clientY);
      });

      hitElement.addEventListener('pointerdown', (event: PointerEvent) => {
        if (activeTool !== 'plan' || event.button !== 0) return;
        event.preventDefault();
        event.stopPropagation();
        try {
          hitElement.setPointerCapture(event.pointerId);
        } catch {}
        beginSegmentDrag(event.clientX, event.clientY);
      });
    };

    const redrawPlan = (refreshElevation = true) => {
      planLayer.clearLayers();

      if (refreshElevation) planElevationSummary = null;

      planSegments.forEach((segment, segmentIndex) => {
        const points = segment.points.map((point) => L.latLng(point.lat, point.lng));
        if (points.length < 2) return;

        const visibleLine = L.polyline(points, {
          pane: 'planning',
          renderer: planningRenderer,
          color: segment.mode === 'snap' ? '#e17a35' : '#8b4e9e',
          weight: segment.mode === 'snap' ? 6 : 5,
          opacity: 0.96,
          dashArray: segment.mode === 'snap' ? undefined : '9 6',
          lineCap: 'round',
          lineJoin: 'round',
          interactive: false
        }).addTo(planLayer);

        const hitLine = L.polyline(points, {
          pane: 'planning',
          renderer: planningRenderer,
          color: '#000',
          weight: 18,
          opacity: 0.001,
          lineCap: 'round',
          lineJoin: 'round',
          className: 'rrgh-plan-segment-hit',
          interactive: true,
          bubblingMouseEvents: false
        }).addTo(planLayer);
        const hitElement = hitLine.getElement?.() as SVGPathElement | null;
        if (hitElement) hitElement.dataset.planSegmentIndex = String(segmentIndex);
        attachPlanSegmentInteraction(hitLine, visibleLine, segmentIndex);

        const segmentDistance = pathDistanceMeters(points);
        addPlanningLabel(pathMidpoint(points), formatDistance(segmentDistance), 'is-plan-segment', planLayer);
      });

      for (const stop of planStops) {
        L.circleMarker([stop.lat, stop.lng], {
          pane: 'planning',
          renderer: planningRenderer,
          radius: 6,
          color: '#fff',
          weight: 2,
          fillColor: stop.nodeKey ? '#e17a35' : '#8b4e9e',
          fillOpacity: 1,
          interactive: false
        }).addTo(planLayer);
      }

      const points = planTrackPoints().map((point) => L.latLng(point.lat, point.lng));
      const total = pathDistanceMeters(points);

      if (refreshElevation && points.length >= 2) schedulePlanElevation(points);

      const statsNote = points.length < 2
        ? 'Add two points for elevation.'
        : planElevationSummary
          ? 'USGS 3DEP sampled along the planned route.'
          : 'Calculating USGS 3DEP elevation…';
      updateLiveStats('Planned route', total, planElevationSummary, statsNote);

      if (planStops.length > 1) {
        const finalStop = planStops[planStops.length - 1]!;
        const totalLabel = 'Total ' + formatDistance(total)
          + (planElevationSummary
            ? ' · +' + formatFeet(planElevationSummary.gainFt) + ' / −' + formatFeet(planElevationSummary.lossFt)
            : '');
        addPlanningLabel(L.latLng(finalStop.lat, finalStop.lng), totalLabel, 'is-total', planLayer);
      }

      for (const button of saveButtons) button.disabled = points.length < 2;
      if (!planStops.length) {
        setStatus('Build route: place a first point near an official trail, community/informal trail, or mapped road, or clearly away from the network to start off trail.');
      } else if (planStops.length === 1) {
        setStatus('First point set. Click near the mapped trail/road network for an automatic snapped segment, or clearly away from it for a dashed straight segment.');
      } else {
        setStatus('Planned route: ' + formatDistance(total)
          + (planElevationSummary ? ' · +' + formatFeet(planElevationSummary.gainFt) + ' gain · −' + formatFeet(planElevationSummary.lossFt) + ' loss' : ' · elevation updating')
          + ' · ' + planSegments.filter((segment) => segment.mode === 'snap').length + ' snapped segment(s), '
          + planSegments.filter((segment) => segment.mode === 'straight').length + ' off-trail segment(s). Drag a segment to adjust it; right-click to delete.');
      }
    };

    map.on('contextmenu', (event: any) => {
      if (activeTool !== null) return;
      event.originalEvent?.preventDefault?.();
      showCoordinate(event.latlng);
      setStatus('Map coordinates shown. Close the coordinate card when finished.');
    });

    map.on('click', (event: any) => {
      if (Date.now() < suppressPlanClickUntil) return;

      if (activeTool === null) return;
      if (activeTool === 'measure') {
        measurePoints.push(event.latlng);
        commitMeasureHistory();
        redrawMeasure();
        return;
      }
      if (activeTool === 'area') {
        areaPoints.push(event.latlng);
        commitAreaHistory();
        redrawArea();
        return;
      }
      if (activeTool === 'bearing') {
        if (bearingPoints.length >= 2) bearingPoints = [];
        bearingPoints.push(event.latlng);
        commitBearingHistory();
        void redrawBearing();
        setStatus(bearingPoints.length === 1 ? 'Bearing / slope: start point set; choose the end point.' : 'Bearing / slope: calculating direction and grade…');
        return;
      }
      if (activeTool === 'watershed') {
        commitWatershedHistory(event.latlng);
        void loadWatershed(event.latlng);
        return;
      }
      if (activeTool !== 'plan') return;
      if (!planStops.length) {
        planStops = [snappedPlanPoint(event.latlng)];
        commitPlanHistory();
        redrawPlan();
        return;
      }

      const previous = planStops[planStops.length - 1]!;
      const built = buildAutoPlanSegment(previous, event.latlng);
      if (!built) {
        setStatus('That point is effectively the same as the current route endpoint. Choose another point.', 'warning');
        return;
      }

      planSegments.push(built.segment);
      planStops.push(built.target);
      commitPlanHistory();
      redrawPlan();
    });

    map.on('moveend', syncViewportDiagnostics);
    map.on('zoomend', syncContextLabels);
    map.on('zoomend', () => {
      const zoom = map.getZoom();
      container.dataset.currentZoom = String(zoom);
      routePaths.forEach((layer) => layer.setStyle({ weight: zoom < 11 ? 4.5 : 7.5, opacity: 1 }));
      trailPaths.forEach((layer) => layer.setStyle({ weight: zoom < 11 ? 2 : zoom >= 15 ? 3 : 2.5, opacity: opacity('usfs-trails') }));
      stateParkTrailPaths.forEach((layer) => layer.setStyle({ weight: zoom < 11 ? 2.6 : zoom >= 15 ? 3.6 : 3.2, opacity: opacity('ky-state-park-trails') }));
      roadPaths.forEach((layer) => layer.setStyle({ weight: zoom >= 15 ? 3.6 : 2.8, opacity: opacity('usfs-roads') }));
      localRoadPaths.forEach((layer) => layer.setStyle({ weight: zoom >= 16 ? 2.8 : 2.2, opacity: opacity(localRoadLayerId) }));
      informalPaths.forEach((layer) => layer.setStyle({ weight: zoom >= 15 ? 2.8 : 2.2, opacity: opacity('osm-informal-trails') }));
    });

    syncAllFineTuneControls();
    syncAerialControlState();
    syncContextLabels();
    container.dataset.currentZoom = String(map.getZoom());
    setTimeout(() => {
      map.invalidateSize({ pan: false });
      if (mode === 'full' && !sharedViewApplied) setHomeView();
      syncViewportDiagnostics();
    }, 50);
    setLoadProgress(100, 'Map ready');

    if (vectorFailures.length) {
      setStatus('Map ready. Unavailable right now: ' + vectorFailures.join(', ') + '.', 'warning');
    } else {
      setTool(null);
    }

    // Optional land context can load in the background. Search/Explore are already route-ready,
    // core controls are enabled only after initial map context/state restoration, and Community /
    // Informal trail data is the separate Build trail route readiness gate.
    window.setTimeout(() => {
      void loadLandContext('usfs-wilderness');
      void loadLandContext('usfs-special-management');
      void loadLandContext('usfs-land-units');
      void loadInformalTrails();
    }, 0);
  };

  for (const shell of document.querySelectorAll<HTMLElement>('[data-route-map-shell]')) {
    void initializeMap(shell);
  }
</script>
