---
import 'leaflet/dist/leaflet.css';
import '../styles/routes.css';
import { enabledBrowserMapSources, mapSources } from '../data/map/layers';

interface PublicRouteMapItem {
  routeId: string;
  slug: string;
  title: string;
  tripType: 'day-hike' | 'backpacking' | 'multi-day';
  trailStatus: 'official' | 'mixed' | 'off-trail';
  publicationClass: 'A' | 'B' | 'C';
  geometryUrl: string;
}

interface Props {
  routes: PublicRouteMapItem[];
  mode?: 'embedded' | 'full';
  initialPreset?: 'simple' | 'terrain' | 'routePlanning' | 'landAccess' | 'allLayers';
}

const { routes, mode = 'embedded', initialPreset = 'simple' } = Astro.props;
const mapId = `route-map-${Math.random().toString(36).slice(2, 9)}`;
const enabledSources = enabledBrowserMapSources;
const usfs = mapSources.find((source) => source.id === 'usfs-reference-snapshots');
const parcel = mapSources.find((source) => source.id === 'parcel-private-property');
---
<section class:list={['route-map-shell', { 'route-map-shell-full': mode === 'full' }]} aria-labelledby={`${mapId}-heading`}>
  <div class="route-map-heading">
    <div>
      <p class="eyebrow">Interactive planning map</p>
      <h2 id={`${mapId}-heading`}>{mode === 'full' ? 'RRGH Hikes & Routes map' : 'Route map'}</h2>
    </div>
    <p class="route-map-disclosure">Loading the map makes direct browser requests to the active map providers listed below. Those requests are separate from RRGH Analytics.</p>
  </div>

  <div class="route-map-toolbar" aria-label="Map controls">
    <div class="route-map-presets" role="group" aria-label="Map presets">
      <button type="button" data-preset="simple">Simple</button>
      <button type="button" data-preset="terrain">Terrain</button>
      <button type="button" data-preset="routePlanning">Route Planning</button>
      <button type="button" data-preset="landAccess">Land &amp; Access</button>
      <button type="button" data-preset="allLayers">All Layers</button>
    </div>
    <label>Base map
      <select data-base-map>
        <option value="kytopo">Kentucky Topo</option>
        <option value="kyaerial-phase3">Aerial</option>
        <option value="usgs-topo">USGS Topo</option>
      </select>
    </label>
    <label><input type="checkbox" data-overlay="ky-hillshade" /> LiDAR / hillshade</label>
    <label><input type="checkbox" data-overlay="routes" checked /> RRGH routes</label>
    <label><input type="checkbox" data-overlay="waypoints" checked /> Approved waypoints</label>
  </div>

  {mode === 'full' && (
    <fieldset class="route-map-filters">
      <legend>RRGH route overlays</legend>
      <label><input type="checkbox" data-route-filter="day-hike" checked /> Day hikes</label>
      <label><input type="checkbox" data-route-filter="backpacking" checked /> Backpacking</label>
      <label><input type="checkbox" data-route-filter="multi-day" checked /> Multi-day</label>
      <label><input type="checkbox" data-route-filter="official" checked /> Official / on-trail</label>
      <label><input type="checkbox" data-route-filter="mixed" checked /> Mixed</label>
      <label><input type="checkbox" data-route-filter="off-trail" checked /> Selected off-trail</label>
    </fieldset>
  )}

  <div
    id={mapId}
    class:list={['route-map', { 'route-map-full': mode === 'full' }]}
    data-rrgh-route-map
    data-routes={JSON.stringify(routes)}
    data-mode={mode}
    data-initial-preset={initialPreset}
    tabindex="0"
    aria-label={mode === 'full' ? 'Interactive Red River Gorge Hiker routes map' : 'Interactive route map'}
  >
    <div class="route-map-placeholder">
      <p>No external map tiles are requested until you load the interactive map.</p>
      <button type="button" class="route-action" data-load-map>Load interactive map</button>
    </div>
  </div>

  <details class="route-map-sources">
    <summary>Map sources, attribution &amp; privacy</summary>
    <ul>
      {enabledSources.map((source) => (
        <li>
          <strong>{source.label}:</strong> <a href={source.serviceUrl} target="_blank" rel="noopener noreferrer">{source.attribution}</a>. {source.privacyNote}
        </li>
      ))}
      {usfs && <li><strong>{usfs.label}:</strong> {usfs.privacyNote}</li>}
      {parcel && <li><strong>{parcel.label}:</strong> {parcel.privacyNote}</li>}
    </ul>
  </details>
</section>

<script>
  import L from 'leaflet';
  import { mapSources } from '../data/map/layers';
  import { mapPresets } from '../data/map/presets';

  const escapeText = (value: unknown) => String(value ?? '');

  for (const container of document.querySelectorAll<HTMLElement>('[data-rrgh-route-map]')) {
    const loadButton = container.querySelector<HTMLButtonElement>('[data-load-map]');
    if (!loadButton) continue;

    loadButton.addEventListener('click', async () => {
      if (container.dataset.loaded === 'true') return;
      container.dataset.loaded = 'true';
      container.innerHTML = '';

      const routeConfigs = JSON.parse(container.dataset.routes ?? '[]');
      const mode = container.dataset.mode ?? 'embedded';
      const map = L.map(container, {
        scrollWheelZoom: mode === 'full',
        zoomControl: true,
        attributionControl: true
      });
      if (mode !== 'full') {
        container.addEventListener('click', () => container.focus());
        container.addEventListener('focus', () => map.scrollWheelZoom.enable());
        container.addEventListener('blur', () => map.scrollWheelZoom.disable());
      }

      const tileLayers = new Map();
      for (const source of mapSources.filter((item) => item.enabled && item.browserLoaded && item.url)) {
        tileLayers.set(source.id, L.tileLayer(source.url!, {
          attribution: source.attribution,
          minZoom: source.minZoom,
          maxZoom: source.maxZoom,
          opacity: source.opacity ?? 1
        }));
      }

      let activeBaseId = 'kytopo';
      let activeBase = tileLayers.get(activeBaseId);
      activeBase?.addTo(map);

      const hillshade = tileLayers.get('ky-hillshade');
      const routesLayer = L.layerGroup().addTo(map);
      const waypointLayer = L.layerGroup().addTo(map);
      const routeGroups = new Map();
      const bounds = L.latLngBounds([]);

      for (const route of routeConfigs) {
        const response = await fetch(route.geometryUrl, { credentials: 'same-origin' });
        if (!response.ok) throw new Error(`Could not load approved geometry for ${route.title}`);
        const geojson = await response.json();
        const group = L.layerGroup();
        const routeTag = { tripType: route.tripType, trailStatus: route.trailStatus };

        for (const feature of geojson.features ?? []) {
          if (feature.geometry?.type === 'LineString') {
            const line = L.geoJSON(feature, {
              style: {
                color: route.publicationClass === 'C' ? '#7b3f00' : '#163f34',
                weight: 5,
                opacity: 0.9
              }
            });
            line.addTo(group);
            line.eachLayer((layer: any) => {
              if (layer.getBounds) bounds.extend(layer.getBounds());
            });
          } else if (feature.geometry?.type === 'Point') {
            const [lon, lat] = feature.geometry.coordinates;
            const name = escapeText(feature.properties?.name);
            const type = escapeText(feature.properties?.type);
            const description = escapeText(feature.properties?.description);
            const icon = L.divIcon({
              className: 'route-waypoint-icon',
              html: '<span aria-hidden="true"></span>',
              iconSize: [20, 20],
              iconAnchor: [10, 10]
            });
            const marker = L.marker([lat, lon], {
              title: name,
              alt: name,
              keyboard: true,
              icon
            });
            const popup = document.createElement('div');
            const strong = document.createElement('strong');
            strong.textContent = name;
            const meta = document.createElement('p');
            meta.textContent = type;
            const body = document.createElement('p');
            body.textContent = description;
            popup.append(strong, meta, body);
            marker.bindPopup(popup);
            marker.addTo(waypointLayer);
            bounds.extend([lat, lon]);
          }
        }
        routeGroups.set(route.routeId, { group, routeTag });
        group.addTo(routesLayer);
      }

      const overlayState: Record<string, boolean> = { routes: true, waypoints: true, 'ky-hillshade': false };

      const applyWaypointZoom = () => {
        const shouldShow = overlayState.waypoints && map.getZoom() >= 14;
        if (shouldShow && !map.hasLayer(waypointLayer)) waypointLayer.addTo(map);
        if (!shouldShow && map.hasLayer(waypointLayer)) map.removeLayer(waypointLayer);
      };

      const setBase = (id: string) => {
        if (activeBase && map.hasLayer(activeBase)) map.removeLayer(activeBase);
        activeBaseId = id;
        activeBase = tileLayers.get(id);
        activeBase?.addTo(map);
        const select = container.closest('.route-map-shell')?.querySelector<HTMLSelectElement>('[data-base-map]');
        if (select) select.value = id;
      };

      const setOverlay = (id: string | undefined, enabled: boolean) => {
        if (!id) return;
        overlayState[id] = enabled;
        const checkbox = container.closest('.route-map-shell')?.querySelector<HTMLInputElement>(`[data-overlay="${id}"]`);
        if (checkbox) checkbox.checked = enabled;
        if (id === 'ky-hillshade') {
          if (enabled && hillshade && !map.hasLayer(hillshade)) hillshade.addTo(map);
          if (!enabled && hillshade && map.hasLayer(hillshade)) map.removeLayer(hillshade);
        }
        if (id === 'routes') {
          if (enabled && !map.hasLayer(routesLayer)) routesLayer.addTo(map);
          if (!enabled && map.hasLayer(routesLayer)) map.removeLayer(routesLayer);
        }
        if (id === 'waypoints') applyWaypointZoom();
      };

      const shell = container.closest('.route-map-shell');
      shell?.querySelector<HTMLSelectElement>('[data-base-map]')?.addEventListener('change', (event) => {
        setBase((event.currentTarget as HTMLSelectElement).value);
      });
      for (const checkbox of shell?.querySelectorAll<HTMLInputElement>('[data-overlay]') ?? []) {
        checkbox.addEventListener('change', () => setOverlay(checkbox.dataset.overlay, checkbox.checked));
      }

      const applyPreset = (id: string | undefined) => {
        if (!id) return;
        const preset = mapPresets[id as keyof typeof mapPresets];
        if (!preset) return;
        setBase(preset.base);
        for (const overlayId of ['ky-hillshade', 'routes', 'waypoints']) {
          setOverlay(overlayId, (preset.overlays as readonly string[]).includes(overlayId));
        }
      };
      for (const button of shell?.querySelectorAll<HTMLButtonElement>('[data-preset]') ?? []) {
        button.addEventListener('click', () => applyPreset(button.dataset.preset));
      }

      const filterRoutes = () => {
        const selected = new Set(
          Array.from(shell?.querySelectorAll<HTMLInputElement>('[data-route-filter]:checked') ?? []).map((input) => input.dataset.routeFilter)
        );
        for (const { group, routeTag } of routeGroups.values()) {
          const visible = selected.has(routeTag.tripType) && selected.has(routeTag.trailStatus);
          if (visible && !routesLayer.hasLayer(group)) routesLayer.addLayer(group);
          if (!visible && routesLayer.hasLayer(group)) routesLayer.removeLayer(group);
        }
      };
      for (const checkbox of shell?.querySelectorAll<HTMLInputElement>('[data-route-filter]') ?? []) {
        checkbox.addEventListener('change', filterRoutes);
      }

      map.on('zoomend', () => {
        applyWaypointZoom();
        const zoom = map.getZoom();
        for (const { group } of routeGroups.values()) {
          group.eachLayer((layer: any) => {
            if (layer.setStyle) layer.setStyle({ weight: zoom < 11 ? 2.5 : 5, opacity: zoom < 10 ? 0.68 : 0.9 });
          });
        }
      });

      if (bounds.isValid()) map.fitBounds(bounds.pad(mode === 'full' ? 0.35 : 0.2), { maxZoom: mode === 'full' ? 14 : 15 });
      else map.setView([37.82, -83.58], 12);

      applyPreset(container.dataset.initialPreset ?? 'simple');
      applyWaypointZoom();
      setTimeout(() => map.invalidateSize(), 50);
    }, { once: true });
  }
</script>
