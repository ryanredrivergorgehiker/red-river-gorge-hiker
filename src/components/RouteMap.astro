---
import 'leaflet/dist/leaflet.css';
import '../styles/routes.css';
import { enabledBrowserMapSources } from '../data/map/layers';

interface PublicRouteMapItem {
  routeId: string;
  slug: string;
  title: string;
  routeCategory: 'day-hike' | 'backpacking' | 'off-trail';
  internalTrailContext: string;
  publicationClass: 'A' | 'B' | 'C';
  distanceMi: number;
  physicalDifficulty: string;
  accessParking: string;
  geometryUrl: string;
  guideUrl: string;
  gpxUrl: string;
}

interface Props {
  routes: PublicRouteMapItem[];
  mode?: 'embedded' | 'full';
}

const { routes, mode = 'embedded' } = Astro.props;
const mapId = 'route-map-' + Math.random().toString(36).slice(2, 9);
const enabledSources = enabledBrowserMapSources;
---
<section
  class:list={['route-map-shell', { 'route-map-shell-full': mode === 'full' }]}
  aria-labelledby={mode === 'embedded' ? mapId + '-heading' : undefined}
  aria-label={mode === 'full' ? 'Interactive Red River Gorge map controls and map' : undefined}
  data-route-map-shell
>
  {mode === 'embedded' ? (
    <div class="route-map-heading">
      <div>
        <p class="eyebrow">Interactive map</p>
        <h2 id={mapId + '-heading'}>Map &amp; route</h2>
      </div>
      <p class="route-map-intro">
        Explore the route, read landmarks and trail context, measure distance, or build a trail-following plan.
      </p>
    </div>
  ) : (
    <div class="route-map-commandbar" aria-label="Map setup">
      <fieldset class="route-map-preset-group">
        <legend>Map view</legend>
        <div class="route-map-preset-buttons">
          <button type="button" data-map-preset="hiking" data-ready-group="core" aria-pressed="true" disabled>
            <strong>Hiking</strong><span>USGS topo · hiking context</span>
          </button>
          <button type="button" data-map-preset="terrain" data-ready-group="core" aria-pressed="false" disabled>
            <strong>Terrain</strong><span>Kentucky + USGS topo · stronger terrain relief</span>
          </button>
          <button type="button" data-map-preset="aerial" data-ready-group="core" aria-pressed="false" disabled>
            <strong>Aerial</strong><span>Imagery + hiking context</span>
          </button>
          <button type="button" data-map-preset="sunlight" data-ready-group="core" aria-pressed="false" disabled>
            <strong>Sunlight</strong><span data-sunlight-preset-times>Today · calculating sunrise / sunset…</span>
          </button>
        </div>
      </fieldset>

      <fieldset class="route-map-trip-group">
        <legend>Show RRGH routes</legend>
        <div class="route-map-trip-options" aria-label="Public route categories">
          <label><input type="checkbox" data-route-category-filter="day-hike" data-ready-group="routes" checked disabled /> Day hikes</label>
          <label><input type="checkbox" data-route-category-filter="backpacking" data-ready-group="routes" checked disabled /> Backpacking</label>
          <label><input type="checkbox" data-route-category-filter="off-trail" data-ready-group="routes" checked disabled /> Off-trail</label>
        </div>
      </fieldset>
    </div>
  )}

  <div class="route-map-mobile-topbar" role="toolbar" aria-label="Mobile map utilities">
    <button type="button" data-map-action="locate" data-ready-group="core" aria-label="Show my location" disabled>My location</button>
    <button type="button" data-map-action="home" data-ready-group="core" aria-label="Reset map view" disabled>Home</button>
    <button type="button" data-sheet-open="layers" data-ready-group="core" aria-label="Open map layers" disabled>Layers</button>
  </div>

  <div class="route-map-stage">
    <div class="route-map-mobile-fullscreen-entry">
      <button type="button" class="route-map-fullscreen-icon" data-map-action="fullscreen" data-ready-group="core" aria-label="Enter full screen map" aria-pressed="false" disabled>
      <span class="route-fullscreen-arrows route-fullscreen-arrows-expand" aria-hidden="true">
        <span class="route-fullscreen-arrow route-fullscreen-arrow-ne">↗</span>
        <span class="route-fullscreen-arrow route-fullscreen-arrow-sw">↙</span>
      </span>
      <span class="route-fullscreen-arrows route-fullscreen-arrows-collapse" aria-hidden="true">
        <span class="route-fullscreen-arrow route-fullscreen-arrow-ne">↙</span>
        <span class="route-fullscreen-arrow route-fullscreen-arrow-sw">↗</span>
      </span>
      <span class="sr-only" data-fullscreen-label>Full screen</span>
    </button>
    </div>

    <div class="route-map-mobile-fullscreen-cluster" aria-label="Full screen map controls">
      <label class="route-map-mobile-fullscreen-view">
        <span class="sr-only">Map view</span>
        <select data-mobile-map-preset data-ready-group="core" aria-label="Map view while in full screen" disabled>
          <option value="hiking" selected>Hiking view</option>
          <option value="terrain">Terrain view</option>
          <option value="aerial">Aerial view</option>
          <option value="sunlight">Sunlight view</option>
        </select>
      </label>

      <div class="route-map-mobile-fullscreen-actions">
        <button type="button" class="route-map-fullscreen-icon" data-map-action="fullscreen" data-ready-group="core" aria-label="Enter full screen map" aria-pressed="false" disabled>
      <span class="route-fullscreen-arrows route-fullscreen-arrows-expand" aria-hidden="true">
        <span class="route-fullscreen-arrow route-fullscreen-arrow-ne">↗</span>
        <span class="route-fullscreen-arrow route-fullscreen-arrow-sw">↙</span>
      </span>
      <span class="route-fullscreen-arrows route-fullscreen-arrows-collapse" aria-hidden="true">
        <span class="route-fullscreen-arrow route-fullscreen-arrow-ne">↙</span>
        <span class="route-fullscreen-arrow route-fullscreen-arrow-sw">↗</span>
      </span>
      <span class="sr-only" data-fullscreen-label>Full screen</span>
    </button>
        <details class="route-map-mobile-quickref">
          <summary aria-label="Open full screen map quick reference"><span aria-hidden="true">i</span></summary>
          <div class="route-map-mobile-quickref-card" role="note">
            <strong>Full-screen quick reference</strong>
            <p><b>View</b> switches Hiking, Terrain, Aerial, or Sunlight. <b>Layers</b> fine-tunes what is shown.</p>
            <p>Drag to pan and pinch to zoom. <b>Search</b> finds places and routes; <b>Explore</b> browses RRGH routes; <b>Tools</b> measures, analyzes, or builds a route; <b>Share</b> sends the current map view.</p>
            <p><b>My location</b> centers on you. <b>Home</b> returns to the Gorge overview.</p>
          </div>
        </details>
      </div>
    </div>

    <div class="route-map-loading" data-map-loading role="status" aria-live="polite">
      <svg class="route-map-loading-trees" viewBox="0 0 220 80" aria-hidden="true">
        <path class="tree tree-a" d="M22 72V40M8 50L22 19l14 31H8Zm5 8h18L22 30 13 58Z"></path>
        <path class="tree tree-b" d="M82 72V34M65 46L82 9l17 37H65Zm5 11h24L82 22 70 57Z"></path>
        <path class="tree tree-c" d="M145 72V42M132 51l13-28 13 28h-26Zm4 8h18l-9-25-9 25Z"></path>
        <path class="tree tree-d" d="M196 72V38M181 49l15-33 15 33h-30Zm5 9h20l-10-29-10 29Z"></path>
        <path class="route-map-loading-ground" d="M0 73h220"></path>
      </svg>
      <strong data-map-loading-label>Please wait while map loads…</strong>
      <div class="route-map-loading-progress" aria-hidden="true"><span data-map-loading-progress></span></div>
      <span class="route-map-loading-percent" data-map-loading-percent>0%</span>
    </div>

    <div class="route-map-activity-stack" data-map-activity-stack aria-live="polite" aria-atomic="true">
      <div class="route-map-activity route-map-activity-watershed" data-map-activity="watershed" hidden>
        <svg class="route-map-activity-art route-map-water-flow" viewBox="0 0 112 58" aria-hidden="true">
          <path class="route-map-water-bank" d="M5 15c17-8 29 4 43 0s29-11 59-2"></path>
          <path class="route-map-water-wave route-map-water-wave-a" d="M4 28c12-7 20 7 32 0s20-7 32 0 20 7 40 0"></path>
          <path class="route-map-water-wave route-map-water-wave-b" d="M4 39c12-7 20 7 32 0s20-7 32 0 20 7 40 0"></path>
          <path class="route-map-water-wave route-map-water-wave-c" d="M4 50c12-7 20 7 32 0s20-7 32 0 20 7 40 0"></path>
          <circle class="route-map-water-drop route-map-water-drop-a" cx="35" cy="10" r="2.6"></circle>
          <circle class="route-map-water-drop route-map-water-drop-b" cx="77" cy="7" r="2.1"></circle>
        </svg>
        <div>
          <strong>Delineating watershed…</strong>
          <span>Following the drainage basin from your outlet point.</span>
        </div>
      </div>

      <div class="route-map-activity route-map-activity-sunlight" data-map-activity="sunlight" hidden>
        <svg class="route-map-activity-art route-map-sunrise-load" viewBox="0 0 112 58" aria-hidden="true">
          <path class="route-map-sun-horizon" d="M8 45h96"></path>
          <g class="route-map-sun-rays">
            <path d="M56 7v9"></path>
            <path d="M31 17l7 7"></path>
            <path d="M81 17l-7 7"></path>
            <path d="M19 37h10"></path>
            <path d="M83 37h10"></path>
          </g>
          <circle class="route-map-sun-disc" cx="56" cy="45" r="14"></circle>
          <path class="route-map-sun-mask" d="M0 45h112v14H0z"></path>
        </svg>
        <div>
          <strong>Loading sunlight…</strong>
          <span>Painting the visible sunrise and sunset terrain.</span>
        </div>
      </div>
    </div>

    <div
      id={mapId}
      class:list={['route-map', { 'route-map-full': mode === 'full' }]}
      data-rrgh-route-map
      data-routes={JSON.stringify(routes)}
      data-mode={mode}
      tabindex="0"
      aria-label={mode === 'full' ? 'Interactive Red River Gorge planning map' : 'Interactive route map'}
    ></div>

    <div class="route-map-mobile-scroll-gutter route-map-mobile-scroll-gutter-left" data-map-scroll-gutter="left" aria-hidden="true"></div>
    <div class="route-map-mobile-scroll-gutter route-map-mobile-scroll-gutter-right" data-map-scroll-gutter="right" aria-hidden="true"></div>

    <div class="route-map-utility-tools" role="toolbar" aria-label="Map utilities">
      <button type="button" data-sheet-open="search" data-ready-group="core" aria-label="Search map" disabled>Search</button>
      <button type="button" data-map-action="locate" data-ready-group="core" aria-label="Show my location" disabled>My location</button>
      <button type="button" data-map-action="home" data-ready-group="core" aria-label="Reset map view" disabled>Home</button>
      <button type="button" class="route-map-desktop-zoom" data-map-action="zoom-out" data-ready-group="core" aria-label="Zoom out" disabled>−</button>
      <button type="button" class="route-map-desktop-zoom" data-map-action="zoom-in" data-ready-group="core" aria-label="Zoom in" disabled>+</button>
    </div>

    <div class="route-map-left-stack">
      <div class="route-plan-pan-pad" data-plan-pan-pad hidden role="group" aria-label="Pan map while building route">
        <button type="button" class="route-pan-up" data-plan-pan-direction="up" aria-label="Pan map up">↑</button>
        <button type="button" class="route-pan-left" data-plan-pan-direction="left" aria-label="Pan map left">←</button>
        <span class="route-pan-center" aria-hidden="true">✥</span>
        <button type="button" class="route-pan-right" data-plan-pan-direction="right" aria-label="Pan map right">→</button>
        <button type="button" class="route-pan-down" data-plan-pan-direction="down" aria-label="Pan map down">↓</button>
      </div>
    </div>

    <div class="route-plan-mobile-history" data-plan-mobile-history hidden role="group" aria-label="Undo or redo planning changes">
      <button type="button" data-plan-mobile-action="undo" aria-label="Undo" disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
      </button>
      <button type="button" data-plan-mobile-action="redo" aria-label="Redo" disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.13-9.36L23 10"></path></svg>
      </button>
    </div>

    <div class="route-map-tools route-map-tools-desktop" role="toolbar" aria-label="Map tools">
      <button type="button" data-sheet-open="explore" data-ready-group="core" disabled>Explore</button>
      <button type="button" data-sheet-open="plan" data-ready-group="core" disabled>Tools</button>
      <button type="button" data-map-action="share" data-ready-group="share" disabled>Share</button>
    </div>

    <div class="route-search-panel route-map-sheet" data-map-sheet="search" hidden>
      <div class="route-map-sheet-header">
        <strong>Search this map</strong>
        <button type="button" data-sheet-close aria-label="Close search">×</button>
      </div>
      <label class="route-search-label">
        <span class="sr-only">Search routes, landmarks, trails, roads, and places</span>
        <input type="search" data-map-search placeholder="Search Sky Bridge, Trail 214, landmarks…" autocomplete="off" />
      </label>
      <p class="route-map-sheet-help">Searches RRGH routes and landmarks, official trails, Forest Service roads and recreation sites, plus loaded community/informal trails.</p>
      <div class="route-search-results" data-map-search-results aria-live="polite"></div>
    </div>

    <details class="route-layer-panel route-map-sheet" data-map-sheet="layers" data-ready-group="core" data-ready="false">
      <summary>Layers</summary>
      <div class="route-layer-panel-body">
        <p class="route-layer-help">Symbols in this panel match the map. Turn layers on or off first; open <strong>Fine tune layers</strong> only when you want opacity controls.</p>

        <div class="route-layer-group" aria-label="Primary hiking layers">
          <p class="route-layer-group-title">Hiking</p>
          <div class="route-static-legend-grid" aria-label="Always-visible map symbols">
            <div class="route-layer-static-row">
              <span class="route-layer-swatch swatch-route" aria-hidden="true"></span>
              <span>RRGH routes</span>
            </div>
            <div class="route-layer-static-row">
              <span class="route-layer-swatch swatch-start" aria-hidden="true"></span>
              <span>Route starts</span>
            </div>
            <div class="route-layer-static-row">
              <span class="route-layer-swatch swatch-trailhead" aria-hidden="true"></span>
              <span>Trailheads &amp; facilities</span>
            </div>
            <div class="route-layer-static-row">
              <span class="route-layer-swatch swatch-landmark" aria-hidden="true"></span>
              <span>Landmarks &amp; viewpoints</span>
            </div>
            <div class="route-layer-static-row">
              <span class="route-layer-swatch swatch-county" aria-hidden="true"></span>
              <span>County boundaries</span>
            </div>
          </div>
          <label class="route-layer-toggle-row">
            <input type="checkbox" data-map-layer="usfs-trails" checked />
            <span class="route-layer-swatch swatch-usfs-trail" aria-hidden="true"></span>
            <span>Forest Service trails</span>
          </label>
          <label class="route-layer-toggle-row">
            <input type="checkbox" data-map-layer="ky-state-park-trails" checked />
            <span class="route-layer-swatch swatch-state-park-trail" aria-hidden="true"></span>
            <span>State Park trails</span>
          </label>
          <label class="route-layer-toggle-row">
            <input type="checkbox" data-map-layer="osm-informal-trails" checked />
            <span class="route-layer-swatch swatch-informal" aria-hidden="true"></span>
            <span>Community / Informal trails</span>
          </label>
          <label class="route-layer-toggle-row">
            <input type="checkbox" data-map-layer="usfs-roads" checked />
            <span class="route-layer-swatch swatch-usfs-road" aria-hidden="true"></span>
            <span>Forest Service roads</span>
          </label>
          <label class="route-layer-toggle-row">
            <input type="checkbox" data-map-layer="ky-local-roads" title="Available in every Map View." />
            <span class="route-layer-swatch swatch-local-road" aria-hidden="true"></span>
            <span>Local / old roads</span>
          </label>
          <p class="route-layer-source-note" data-local-roads-status>
            Available in every Map View. Off by default in Hiking and Sunlight; Terrain and Aerial turn it on by default. Status uncertain: may include active local roads, old or abandoned roadbeds, gated or closed segments, or roads no longer passable. These are roads, not trails.
          </p>
        </div>

        <div class="route-layer-group" aria-label="Base and imagery layers">
          <p class="route-layer-group-title">Base &amp; Imagery</p>
          <label class="route-layer-toggle-row">
            <input type="checkbox" data-map-layer="kytopo" />
            <span class="route-layer-swatch swatch-topo" aria-hidden="true"></span>
            <span>Kentucky Topo</span>
          </label>
          <label class="route-layer-toggle-row">
            <input type="checkbox" data-map-layer="usgs-topo" checked />
            <span class="route-layer-swatch swatch-topo-usgs" aria-hidden="true"></span>
            <span>USGS Topo</span>
          </label>
          <label class="route-layer-toggle-row">
            <input type="checkbox" data-map-layer="ky-hillshade" />
            <span class="route-layer-swatch swatch-relief" aria-hidden="true"></span>
            <span>Terrain relief (LiDAR)</span>
          </label>
          <label class="route-layer-toggle-row">
            <input type="checkbox" data-map-layer="kyaerial-phase3" />
            <span class="route-layer-swatch swatch-aerial" aria-hidden="true"></span>
            <span>Leaf-on aerial imagery</span>
          </label>
          <label class="route-layer-toggle-row">
            <input type="checkbox" data-map-layer="kyaerial-phase2-leafoff" />
            <span class="route-layer-swatch swatch-aerial-leafoff" aria-hidden="true"></span>
            <span>Leaf-off aerial imagery</span>
          </label>
        </div>

        <div class="route-layer-group" aria-label="Conditions and analysis layers">
          <p class="route-layer-group-title">Conditions &amp; Analysis</p>
          <label class="route-layer-toggle-row route-layer-toggle-master">
            <input type="checkbox" data-map-layer="rrgh-weather" />
            <span class="route-layer-swatch swatch-weather" aria-hidden="true"></span>
            <span>Snow / recent precipitation</span>
          </label>
          <div class="route-weather-options">
            <label>
              <span>Weather view</span>
              <select data-weather-product aria-label="Snow or recent precipitation view">
                <option value="precip-10d" selected>Precipitation — last 10 days (in)</option>
                <option value="precip-30d">Precipitation — last 30 days (in)</option>
                <option value="snow-depth">Current snow depth (in)</option>
              </select>
            </label>
            <p class="route-layer-source-note" data-weather-status>Off by default in every Map View. Choose a weather view, then turn this layer on.</p>
            <div class="route-weather-legend" data-weather-legend hidden aria-label="NOAA weather color legend"></div>
          </div>
          <label class="route-layer-toggle-row route-layer-toggle-master">
            <input type="checkbox" data-map-layer="rrg-lidar-sun" data-sun-potential-master />
            <span class="route-layer-swatch swatch-sun-potential" aria-hidden="true"></span>
            <span>Sunrise / Sunset Potential</span>
          </label>
          <label class="route-layer-toggle-row route-layer-toggle-child">
            <input type="checkbox" data-sun-kind-toggle="sunrise" />
            <span class="route-layer-swatch swatch-sunrise-potential" aria-hidden="true"></span>
            <span>Sunrise Potential</span>
          </label>
          <label class="route-layer-toggle-row route-layer-toggle-child">
            <input type="checkbox" data-sun-kind-toggle="sunset" />
            <span class="route-layer-swatch swatch-sunset-potential" aria-hidden="true"></span>
            <span>Sunset Potential</span>
          </label>
        </div>

        <div class="route-layer-group" aria-label="Oil and gas layers">
          <p class="route-layer-group-title">Oil &amp; gas</p>
          <div class="route-oil-gas-master-row">
            <label class="route-layer-toggle-row route-layer-toggle-master">
              <input type="checkbox" data-map-layer="kgs-oil-gas-wells" data-oil-gas-master />
              <span class="route-layer-swatch swatch-oil-gas" aria-hidden="true"></span>
              <span>Oil &amp; Gas Wells</span>
            </label>
            <button
              type="button"
              class="route-oil-gas-options-toggle"
              data-oil-gas-options-toggle
              aria-expanded="false"
              aria-controls="route-oil-gas-options"
              aria-label="Expand Oil & Gas well types"
            >⌄</button>
          </div>
          <div class="route-oil-gas-options" id="route-oil-gas-options" data-oil-gas-options hidden>
            <label class="route-layer-toggle-row route-layer-toggle-child">
              <input type="checkbox" data-oil-gas-kind="oil" />
              <span class="route-layer-swatch swatch-oil-gas-oil" aria-hidden="true"></span>
              <span>Oil wells</span>
            </label>
            <label class="route-layer-toggle-row route-layer-toggle-child">
              <input type="checkbox" data-oil-gas-kind="gas" />
              <span class="route-layer-swatch swatch-oil-gas-gas" aria-hidden="true"></span>
              <span>Gas wells</span>
            </label>
            <label class="route-layer-toggle-row route-layer-toggle-child">
              <input type="checkbox" data-oil-gas-kind="oil-gas" />
              <span class="route-layer-swatch swatch-oil-gas-combined" aria-hidden="true"></span>
              <span>Oil &amp; gas wells</span>
            </label>
            <label class="route-layer-toggle-row route-layer-toggle-child">
              <input type="checkbox" data-oil-gas-kind="dry" />
              <span class="route-layer-swatch swatch-oil-gas-dry" aria-hidden="true"></span>
              <span>Dry &amp; abandoned</span>
            </label>
            <label class="route-layer-toggle-row route-layer-toggle-child">
              <input type="checkbox" data-oil-gas-kind="service" />
              <span class="route-layer-swatch swatch-oil-gas-service" aria-hidden="true"></span>
              <span>Service / recovery</span>
            </label>
            <label class="route-layer-toggle-row route-layer-toggle-child">
              <input type="checkbox" data-oil-gas-kind="cbm" />
              <span class="route-layer-swatch swatch-oil-gas-cbm" aria-hidden="true"></span>
              <span>Coal-bed methane</span>
            </label>
            <label class="route-layer-toggle-row route-layer-toggle-child">
              <input type="checkbox" data-oil-gas-kind="other" />
              <span class="route-layer-swatch swatch-oil-gas-other" aria-hidden="true"></span>
              <span>Locations / other wells</span>
            </label>
          </div>
          <p class="route-layer-source-note" data-oil-gas-status>
            Off by default. Enabling loads live statewide well records from Kentucky Geological Survey / University of Kentucky.
          </p>
        </div>

        <div class="route-layer-group" aria-label="Land management and context">
          <p class="route-layer-group-title">Land management &amp; context</p>
          <label class="route-layer-toggle-row">
            <input type="checkbox" data-map-layer="usfs-wilderness" checked />
            <span class="route-layer-swatch swatch-wilderness" aria-hidden="true"></span>
            <span>National Forest Wilderness</span>
          </label>
          <label class="route-layer-toggle-row">
            <input type="checkbox" data-map-layer="usfs-special-management" checked />
            <span class="route-layer-swatch swatch-management" aria-hidden="true"></span>
            <span>Special management areas</span>
          </label>
          <label class="route-layer-toggle-row">
            <input type="checkbox" data-map-layer="usfs-land-units" checked />
            <span class="route-layer-swatch swatch-land-unit" aria-hidden="true"></span>
            <span>National Forest land units</span>
          </label>
        </div>

        <details class="route-layer-fine-tune">
          <summary>Fine tune layers</summary>
          <p>Use each checkbox to turn that layer on or off; its slider is enabled only while the layer is visible. These controls stay synced with the matching layer above.</p>
