---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
---
<div
  class="share-controls"
  data-share-controls
  data-share-title={title}
  data-share-url={url}
  aria-label="Share this page"
  hidden
>
  <button type="button" data-native-share>Share ↗</button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-share-controls]').forEach((controls) => {
    if (controls.dataset.shareBound === 'true') return;
    controls.dataset.shareBound = 'true';

    const shareButton = controls.querySelector<HTMLButtonElement>('[data-native-share]');
    if (!shareButton || !navigator.share) {
      controls.hidden = true;
      return;
    }

    controls.hidden = false;
    shareButton.addEventListener('click', async () => {
      const title = controls.dataset.shareTitle ?? document.title;
      const url = controls.dataset.shareUrl ?? window.location.href;

      try {
        await navigator.share({ title, url });
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return;
      }
    });
  });
</script>

<style>
  .share-controls[hidden] { display: none; }
  .share-controls {
    display: inline-flex;
    align-items: center;
    margin: .35rem 0 .65rem;
    padding: .3rem .55rem;
    border: 1px solid rgba(23,55,45,.2);
    border-radius: .35rem;
    background: rgba(196,164,119,.24);
    color: var(--gorge);
    font-size: .88rem;
    font-weight: 750;
    line-height: 1.2;
  }
  .share-controls button {
    min-height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: .18rem .1rem;
    border: 0;
    background: transparent;
    color: var(--gorge);
    cursor: pointer;
    font: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: .2em;
  }
  .share-controls button:hover { color: var(--pine); }
  .share-controls button:focus-visible {
    outline: 2px solid var(--sunrise);
    outline-offset: 2px;
    border-radius: 3px;
  }
  @media (max-width: 520px) {
    .share-controls {
      margin-block: .3rem .55rem;
      padding: .32rem .5rem;
      font-size: .9rem;
    }
    .share-controls button { min-height: 2.15rem; }
  }
</style>
