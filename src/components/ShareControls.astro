---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
---
<div
  class="share-controls"
  data-share-controls
  data-share-title={title}
  data-share-url={url}
  aria-label="Share this page"
  hidden
>
  <button type="button" data-native-share>Share ↗</button>
</div>

<script>
  const findShareImage = (controls: HTMLElement) => {
    const scope = controls.closest('article, dialog, .photo-page, .gear-product-page, .puzzle-detail-page') ?? document;
    const image = scope.querySelector<HTMLImageElement>('img');
    if (image?.currentSrc) return image.currentSrc;
    if (image?.src) return image.src;
    return document.querySelector<HTMLMetaElement>('meta[property="og:image"]')?.content ?? '';
  };

  const buildShareFile = async (imageUrl: string, title: string) => {
    if (!imageUrl || !navigator.canShare) return null;

    try {
      const response = await fetch(imageUrl, { cache: 'force-cache' });
      if (!response.ok) return null;

      const blob = await response.blob();
      if (!blob.type.startsWith('image/')) return null;

      const extensionByType: Record<string, string> = {
        'image/avif': 'avif',
        'image/jpeg': 'jpg',
        'image/png': 'png',
        'image/webp': 'webp'
      };
      const extension = extensionByType[blob.type] ?? 'jpg';
      const safeTitle = title
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '')
        .slice(0, 60) || 'red-river-gorge-hiker';
      const file = new File([blob], `${safeTitle}.${extension}`, { type: blob.type });

      return navigator.canShare({ files: [file] }) ? file : null;
    } catch {
      return null;
    }
  };

  document.querySelectorAll<HTMLElement>('[data-share-controls]').forEach((controls) => {
    if (controls.dataset.shareBound === 'true') return;
    controls.dataset.shareBound = 'true';

    const shareButton = controls.querySelector<HTMLButtonElement>('[data-native-share]');
    if (!shareButton || !navigator.share) {
      controls.hidden = true;
      return;
    }

    controls.hidden = false;
    shareButton.addEventListener('click', async () => {
      const title = controls.dataset.shareTitle ?? document.title;
      const url = controls.dataset.shareUrl ?? window.location.href;
      const text = `${title} — Red River Gorge Hiker`;
      const basicShare = { title, text, url };
      const imageUrl = findShareImage(controls);
      const imageFile = await buildShareFile(imageUrl, title);

      try {
        if (imageFile) {
          await navigator.share({ ...basicShare, files: [imageFile] });
        } else {
          await navigator.share(basicShare);
        }
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return;

        // Some receiving apps reject a combined file + link payload. If that happens,
        // retry with the direct page link, title, and editable text only.
        if (imageFile) {
          try {
            await navigator.share(basicShare);
          } catch (fallbackError) {
            if (fallbackError instanceof DOMException && fallbackError.name === 'AbortError') return;
          }
        }
      }
    });
  });
</script>

<style>
  .share-controls[hidden] { display: none; }
  .share-controls {
    display: inline-flex;
    align-items: center;
    margin: .35rem 0 .65rem;
    padding: .3rem .55rem;
    border: 1px solid rgba(23,55,45,.2);
    border-radius: .35rem;
    background: rgba(196,164,119,.24);
    color: var(--gorge);
    font-size: .88rem;
    font-weight: 750;
    line-height: 1.2;
  }
  .share-controls button {
    min-height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: .18rem .1rem;
    border: 0;
    background: transparent;
    color: var(--gorge);
    cursor: pointer;
    font: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: .2em;
  }
  .share-controls button:hover { color: var(--pine); }
  .share-controls button:focus-visible {
    outline: 2px solid var(--sunrise);
    outline-offset: 2px;
    border-radius: 3px;
  }
  @media (max-width: 520px) {
    .share-controls {
      margin-block: .3rem .55rem;
      padding: .32rem .5rem;
      font-size: .9rem;
    }
    .share-controls button { min-height: 2.15rem; }
  }
</style>
