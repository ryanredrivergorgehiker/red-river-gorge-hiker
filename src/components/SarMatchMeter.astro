---
import { sar, SAR_PUBLIC_CSV_URL, SAR_PUBLIC_FIELDS } from '../data/sar';
import '../styles/sar-polish.css';

interface Props {
  variant?: 'header' | 'full';
  href?: string;
}

const { variant = 'header', href } = Astro.props;
const base = import.meta.env.BASE_URL;
const targetHref = href ?? `${base}search-and-rescue/`;
const progress = Math.min(Math.max(sar.commitmentFulfillmentPercentage, 0), 100);
const currency = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD',
  maximumFractionDigits: 0
});
const transferred = currency.format(sar.rrghTotalTransferred);
const committed = currency.format(sar.rrghTotalCommitment);
const fulfilled = sar.commitmentFulfillmentPercentage;
const exceeded = fulfilled > 100;
const achieved = fulfilled >= 100;
const stateLabel = `${transferred} transferred of ${committed} committed, ${fulfilled.toFixed(1)}% fulfilled`;
const headerPrimary = 'Walk the path with us.';
const headerDetail = 'Support the people who answer the call.';
const displayStateLabel = variant === 'header' ? `${headerPrimary} ${headerDetail}` : stateLabel;
const accessibleStateLabel = displayStateLabel.replace(/[.!?]\s*$/, '');
const nodeLabels = ['0%', '20%', '40%', '60%', '80%', '100%'];
const mobileHero = `${base}assets/images/RRGH-0004-winter-red-byrd-1600-7caed0141d.webp`;
---

<a
  class:list={['sar-meter', `sar-meter--${variant}`, { 'is-achieved': achieved, 'is-exceeded': exceeded }]}
  href={targetHref}
  data-sar-meter
  data-sar-meter-variant={variant}
  aria-label={`Search and Rescue: ${accessibleStateLabel}. View Search and Rescue resources.`}
>
  <span class="sar-meter-copy">
    <span class="sar-meter-kicker">Search &amp; Rescue</span>
    <span class="sar-meter-status">
      {variant === 'header' ? (
        <><strong data-sar-meter-primary>{headerPrimary}</strong><span data-sar-meter-detail>{headerDetail}</span></>
      ) : (
        <><strong data-sar-meter-primary>RRGH transferred: {transferred} / {committed}</strong><span data-sar-meter-detail>{fulfilled.toFixed(1)}% fulfilled</span></>
      )}
    </span>
  </span>

  <span class="sar-meter-visual" aria-hidden="true">
    <svg viewBox="0 0 560 86" role="presentation" focusable="false">
      <path class="sar-contour sar-contour-one" d="M8 18 C78 -3 119 35 180 16 S299 4 349 21 S455 29 552 7" />
      <path class="sar-contour sar-contour-two" d="M18 74 C86 49 137 82 205 60 S317 53 382 66 S471 74 548 50" />
      <path class="sar-trail-base" pathLength="100" d="M28 49 C82 15 112 70 167 43 S252 20 309 47 S402 72 457 40 S514 32 536 43" />
      <path
        class="sar-trail-progress"
        data-sar-meter-progress
        pathLength="100"
        d="M28 49 C82 15 112 70 167 43 S252 20 309 47 S402 72 457 40 S514 32 536 43"
        style={`stroke-dasharray:${progress} ${100 - progress}`}
      />
      <circle class="sar-trail-start" cx="28" cy="49" r="8" />
      <g class="sar-beacon" transform="translate(524 24)">
        <path d="M5 29h18v6H5z" />
        <path d="M8 27v-9a6 6 0 0 1 12 0v9z" />
        <path class="sar-beacon-ray" d="M14 8V1M4 12l-5-5M24 12l5-5" />
      </g>
    </svg>
    {variant === 'full' && (
      <span class="sar-meter-nodes" data-sar-meter-nodes>
        {nodeLabels.map((label) => <span>{label}</span>)}
      </span>
    )}
  </span>

  <span class="sar-meter-action">{variant === 'full' ? 'View the SAR commitment' : 'SAR details'} <span aria-hidden="true">→</span></span>
</a>

<script is:inline define:vars={{ sarFeedUrl: SAR_PUBLIC_CSV_URL, sarFallback: sar, requiredSarFields: SAR_PUBLIC_FIELDS, mobileHero }}>
  (() => {
    if (window.__rrghSarFeedInstalled) return;
    window.__rrghSarFeedInstalled = true;

    const cacheKey = 'rrgh-sar-public-data-v2';
    const moneyFields = new Set([
      'rrghAnnualBaseCommitment',
      'rrghProfitAllocationGenerated',
      'rrghTotalCommitment',
      'rrghBaseCommitmentTransferred',
      'rrghProfitAllocationTransferred',
      'rrghTotalTransferred',
      'outstandingBaseCommitment',
      'outstandingProfitAllocation',
      'outstandingRrghCommitment',
      'historicalPersonalSupport',
      'lifetimePersonalSupport',
      'lifetimeRrghCommitted',
      'lifetimeRrghTransferred',
      'combinedLifetimeSupport'
    ]);

    const formatCurrency = (value) => new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
      maximumFractionDigits: 0
    }).format(value);

    const formatPublicTimestamp = (value) => new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'America/New_York'
    }).format(new Date(value));

    function parseCsvRows(text) {
      const rows = [];
      let row = [];
      let field = '';
      let quoted = false;
      for (let i = 0; i < text.length; i += 1) {
        const char = text[i];
        if (quoted) {
          if (char === '"' && text[i + 1] === '"') {
            field += '"';
            i += 1;
          } else if (char === '"') {
            quoted = false;
          } else {
            field += char;
          }
        } else if (char === '"') {
          quoted = true;
        } else if (char === ',') {
          row.push(field);
          field = '';
        } else if (char === '\n') {
          row.push(field.replace(/\r$/, ''));
          rows.push(row);
          row = [];
          field = '';
        } else {
          field += char;
        }
      }
      if (field.length || row.length) {
        row.push(field.replace(/\r$/, ''));
        rows.push(row);
      }
      return rows;
    }

    function numberFromPublicValue(value) {
      const number = Number(String(value ?? '').replace(/[$,%\s,]/g, ''));
      return Number.isFinite(number) ? number : NaN;
    }

    function normalizePublicData(raw) {
      const normalized = {};
      for (const field of requiredSarFields) {
        if (!(field in raw)) throw new Error(`Missing SAR field: ${field}`);
      }
      normalized.reportingYear = Number.parseInt(String(raw.reportingYear), 10);
      normalized.lastUpdated = String(raw.lastUpdated).trim();
      normalized.commitmentFulfillmentPercentage = numberFromPublicValue(raw.commitmentFulfillmentPercentage);
      for (const field of moneyFields) normalized[field] = numberFromPublicValue(raw[field]);

      if (!Number.isInteger(normalized.reportingYear) || normalized.reportingYear < 2000) throw new Error('Invalid reportingYear');
      if (!normalized.lastUpdated || Number.isNaN(Date.parse(normalized.lastUpdated))) throw new Error('Invalid lastUpdated');
      if (!Number.isFinite(normalized.commitmentFulfillmentPercentage) || normalized.commitmentFulfillmentPercentage < 0) throw new Error('Invalid commitmentFulfillmentPercentage');
      for (const field of moneyFields) {
        if (!Number.isFinite(normalized[field]) || normalized[field] < 0) throw new Error(`Invalid SAR value: ${field}`);
      }
      return normalized;
    }

    function parsePublicCsv(text) {
      const rows = parseCsvRows(text).filter((row) => row.some((cell) => String(cell).trim() !== ''));
      if (!rows.length || rows[0][0]?.trim() !== 'field' || rows[0][1]?.trim() !== 'value') {
        throw new Error('Unexpected SAR CSV header');
      }
      const raw = {};
      for (const row of rows.slice(1)) {
        const key = String(row[0] ?? '').trim();
        if (key) raw[key] = String(row[1] ?? '').trim();
      }
      return normalizePublicData(raw);
    }

    function updateMeter(meter, data) {
      const transferred = formatCurrency(data.rrghTotalTransferred);
      const committed = formatCurrency(data.rrghTotalCommitment);
      const fulfilled = data.commitmentFulfillmentPercentage;
      const progress = Math.min(Math.max(fulfilled, 0), 100);
      const achieved = fulfilled >= 100;
      const exceeded = fulfilled > 100;
      const primary = meter.querySelector('[data-sar-meter-primary]');
      const detail = meter.querySelector('[data-sar-meter-detail]');
      const progressPath = meter.querySelector('[data-sar-meter-progress]');
      const variant = meter.dataset.sarMeterVariant;

      meter.classList.toggle('is-achieved', achieved);
      meter.classList.toggle('is-exceeded', exceeded);
      if (progressPath) progressPath.style.strokeDasharray = `${progress} ${100 - progress}`;

      let stateLabel;
      if (variant === 'header') {
        primary.textContent = 'Walk the path with us.';
        detail.textContent = 'Support the people who answer the call.';
        stateLabel = 'Walk the path with us. Support the people who answer the call.';
      } else {
        primary.textContent = `RRGH transferred: ${transferred} / ${committed}`;
        detail.textContent = `${fulfilled.toFixed(1)}% fulfilled`;
        stateLabel = `${transferred} transferred of ${committed} committed, ${fulfilled.toFixed(1)}% fulfilled`;
      }
      const accessibleStateLabel = stateLabel.replace(/[.!?]\s*$/, '');
      meter.setAttribute('aria-label', variant === 'header'
        ? `Search and Rescue: ${accessibleStateLabel}. View Search and Rescue resources.`
        : `Search and Rescue commitment tracker: ${accessibleStateLabel}. View Search and Rescue resources.`);
    }

    function updateSarPage(data) {
      const page = document.querySelector('.sar-page');
      if (!page) return;

      const hero = page.querySelector('.sar-hero');
      if (hero) {
        hero.style.setProperty('--sar-mobile-hero', `url("${mobileHero}")`);
        hero.classList.add('sar-mobile-hero-ready');
      }

      page.querySelectorAll('.sar-path-number').forEach((node) => node.remove());
      const section = page.querySelector('#sar-match');
      if (!section) return;
      const kicker = section.querySelector('.sar-section-heading .sar-section-kicker');
      if (kicker) kicker.textContent = `${data.reportingYear} public reporting`;

      section.querySelectorAll('[data-sar-value-field]').forEach((node) => {
        const field = node.dataset.sarValueField;
        if (field && Number.isFinite(data[field])) node.textContent = formatCurrency(data[field]);
      });
      section.querySelectorAll('[data-sar-percent-field]').forEach((node) => {
        const field = node.dataset.sarPercentField;
        if (field && Number.isFinite(data[field])) node.textContent = `${data[field].toFixed(1)}%`;
      });
      const updated = section.querySelector('[data-sar-last-updated]');
      if (updated) {
        updated.textContent = formatPublicTimestamp(data.lastUpdated);
        updated.setAttribute('datetime', data.lastUpdated);
      }
    }

    function applyPublicData(data, source) {
      document.querySelectorAll('[data-sar-meter]').forEach((meter) => updateMeter(meter, data));
      updateSarPage(data);
      document.documentElement.dataset.sarDataSource = source;
    }

    document.addEventListener('DOMContentLoaded', async () => {
      let fallback = normalizePublicData(sarFallback);
      try {
        const cached = JSON.parse(localStorage.getItem(cacheKey) || 'null');
        if (cached) fallback = normalizePublicData(cached);
      } catch (_) {
        // Ignore unavailable or invalid local storage and use the embedded last-known-good snapshot.
      }
      applyPublicData(fallback, 'fallback');

      try {
        const response = await fetch(sarFeedUrl, { cache: 'no-store', credentials: 'omit' });
        if (!response.ok) throw new Error(`SAR feed request failed: ${response.status}`);
        const fresh = parsePublicCsv(await response.text());
        applyPublicData(fresh, 'live');
        try { localStorage.setItem(cacheKey, JSON.stringify(fresh)); } catch (_) {}
      } catch (error) {
        console.warn('RRGH SAR public feed unavailable; retaining last-known-good values.', error);
      }
    }, { once: true });
  })();
</script>

<style>
  .sar-meter {
    --sar-orange: #c96432;
    --sar-cream: #f2e8d6;
    display: grid;
    color: var(--sar-cream);
    background: linear-gradient(110deg, #17372d, #24483a 62%, #17372d);
    border: 1px solid rgba(196,164,119,.75);
    text-decoration: none;
    box-shadow: 0 5px 18px rgba(23,55,45,.12);
    overflow: hidden;
  }
  .sar-meter:hover { color: #fff; border-color: var(--sar-orange); }
  .sar-meter:focus-visible { outline: 3px solid var(--sar-orange); outline-offset: 3px; }
  .sar-meter-copy { min-width: 0; }
  .sar-meter-kicker {
    color: #e8c99d;
    font-size: .66rem;
    font-weight: 850;
    letter-spacing: .13em;
    line-height: 1.1;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .sar-meter-status { min-width: 0; line-height: 1.1; }
  .sar-meter-status strong { color: #fff; font-size: .82rem; }
  .sar-meter-status span { color: #eadfcf; font-size: .68rem; }
  .sar-meter-visual { position: relative; min-width: 0; }
  .sar-meter-visual svg { display: block; width: 100%; height: auto; }
  .sar-contour { fill: none; stroke: rgba(232,220,200,.12); stroke-width: 1.2; }
  .sar-trail-base,
  .sar-trail-progress { fill: none; stroke-linecap: round; stroke-width: 7; }
  .sar-trail-base { stroke: rgba(232,220,200,.26); stroke-dasharray: 1 3; }
  .sar-trail-progress { stroke: var(--sar-orange); }
  .sar-trail-start { fill: var(--sar-orange); stroke: #f2e8d6; stroke-width: 4; }
  .sar-beacon path { fill: var(--sar-orange); }
  .sar-beacon .sar-beacon-ray { fill: none; stroke: var(--sar-orange); stroke-linecap: round; stroke-width: 2.5; }
  .sar-meter-action { color: #f1d3a9; font-size: .73rem; font-weight: 800; white-space: nowrap; }
  .sar-meter:hover .sar-meter-action { color: #fff; }

  .sar-meter--header {
    grid-template-columns: auto minmax(10rem, .8fr) minmax(11rem, 1fr) auto;
    align-items: center;
    gap: .55rem .8rem;
    width: min(var(--content), calc(100% - 3rem));
    margin: 0 auto .42rem;
    padding: .34rem .66rem;
    border-radius: .35rem;
  }
  .sar-meter--header .sar-meter-copy { display: contents; }
  .sar-meter--header .sar-meter-status { display: flex; align-items: baseline; gap: .42rem; white-space: nowrap; }
  .sar-meter--header .sar-meter-status span::before { content: '· '; }
  .sar-meter--header .sar-meter-visual svg { max-height: 1.85rem; }
  .sar-meter--header .sar-meter-action { font-size: 0; }
  .sar-meter--header .sar-meter-action span { font-size: .95rem; }

  .sar-meter--full {
    grid-template-columns: minmax(15rem, .75fr) minmax(20rem, 1.6fr);
    gap: 1rem 2rem;
    align-items: center;
    padding: 1.35rem 1.5rem 1.15rem;
    border-radius: .5rem;
  }
  .sar-meter--full .sar-meter-kicker { display: block; font-size: .8rem; margin-bottom: .25rem; }
  .sar-meter--full .sar-meter-status { display: flex; flex-direction: column; gap: .08rem; }
  .sar-meter--full .sar-meter-status strong { font-family: var(--serif); font-size: clamp(1.35rem, 2.5vw, 2rem); }
  .sar-meter--full .sar-meter-status span { font-size: .92rem; }
  .sar-meter--full .sar-meter-action { grid-column: 1 / -1; justify-self: end; font-size: .86rem; }
  .sar-meter-nodes { display: grid; grid-template-columns: repeat(6, 1fr); color: #eadfcf; font-size: .67rem; font-weight: 750; margin: -.15rem 1.2rem 0; }
  .sar-meter-nodes span { text-align: center; }
  .sar-meter-nodes span:first-child { text-align: left; }
  .sar-meter-nodes span:last-child { text-align: right; color: #f19a67; }

  .is-achieved .sar-trail-progress { stroke: #e18b53; }
  .is-exceeded { box-shadow: 0 0 0 1px rgba(201,100,50,.25), 0 8px 24px rgba(23,55,45,.16); }

  @media (max-width: 850px) {
    .sar-meter--header {
      grid-template-columns: auto 1fr auto;
      width: min(var(--content), calc(100% - 1.5rem));
      margin-bottom: .38rem;
      padding: .32rem .58rem;
    }
    .sar-meter--header .sar-meter-copy { display: contents; }
    .sar-meter--header .sar-meter-kicker { font-size: .6rem; }
    .sar-meter--header .sar-meter-status { gap: 0; }
    .sar-meter--header .sar-meter-status strong { font-size: .75rem; }
    .sar-meter--header .sar-meter-status span { display: none; }
    .sar-meter--header .sar-meter-visual { display: none; }
  }

  @media (max-width: 620px) {
    .sar-meter--header { grid-template-columns: auto 1fr auto; gap: .45rem; }
    .sar-meter--header .sar-meter-kicker { font-size: .57rem; letter-spacing: .1em; }
    .sar-meter--header .sar-meter-status strong { font-size: .72rem; }
    .sar-meter--full { grid-template-columns: 1fr; padding: 1rem; }
    .sar-meter--full .sar-meter-action { grid-column: auto; justify-self: start; }
    .sar-meter-nodes { font-size: .58rem; margin-inline: .35rem; }
  }
</style>