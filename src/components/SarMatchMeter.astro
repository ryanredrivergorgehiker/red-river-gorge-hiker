---
import { sar } from '../data/sar';

interface Props {
  variant?: 'header' | 'full';
  href?: string;
}

const { variant = 'header', href } = Astro.props;
const base = import.meta.env.BASE_URL;
const targetHref = href ?? `${base}search-and-rescue/`;
const progress = Math.min(Math.max(sar.matchPercentage, 0), 100);
const currency = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD',
  maximumFractionDigits: 0
});
const generated = currency.format(sar.rrghSarGenerated);
const target = currency.format(sar.personalAnnualCommitment);
const exceeded = sar.matchPercentage > 100;
const achieved = sar.matchPercentage >= 100;
const stateLabel = exceeded
  ? `${generated} generated · match goal surpassed`
  : achieved
    ? `Match achieved · ${generated} generated for SAR`
    : `${generated} of ${target} matched · ${sar.matchPercentage.toFixed(0)}%`;
const nodeAmounts = [0, 100, 200, 300, 400, 500];
---

<a
  class:list={['sar-meter', `sar-meter--${variant}`, { 'is-achieved': achieved, 'is-exceeded': exceeded }]}
  href={targetHref}
  aria-label={`Search and Rescue Match-O-Meter: ${stateLabel}. View Search and Rescue resources.`}
>
  <span class="sar-meter-copy">
    <span class="sar-meter-kicker">Search &amp; Rescue</span>
    <span class="sar-meter-status">
      {exceeded ? (
        <><strong>{generated} generated</strong><span>Match goal surpassed</span></>
      ) : achieved ? (
        <><strong>Match achieved</strong><span>{generated} generated for SAR</span></>
      ) : (
        <><strong>RRGH Match: {generated} / {target}</strong><span>{sar.matchPercentage.toFixed(0)}% of annual milestone</span></>
      )}
    </span>
  </span>

  <span class="sar-meter-visual" aria-hidden="true">
    <svg viewBox="0 0 560 86" role="presentation" focusable="false">
      <path class="sar-contour sar-contour-one" d="M8 18 C78 -3 119 35 180 16 S299 4 349 21 S455 29 552 7" />
      <path class="sar-contour sar-contour-two" d="M18 74 C86 49 137 82 205 60 S317 53 382 66 S471 74 548 50" />
      <path class="sar-trail-base" pathLength="100" d="M28 49 C82 15 112 70 167 43 S252 20 309 47 S402 72 457 40 S514 32 536 43" />
      <path
        class="sar-trail-progress"
        pathLength="100"
        d="M28 49 C82 15 112 70 167 43 S252 20 309 47 S402 72 457 40 S514 32 536 43"
        style={`stroke-dasharray:${progress} ${100 - progress}`}
      />
      <circle class="sar-trail-start" cx="28" cy="49" r="8" />
      <g class="sar-beacon" transform="translate(524 24)">
        <path d="M5 29h18v6H5z" />
        <path d="M8 27v-9a6 6 0 0 1 12 0v9z" />
        <path class="sar-beacon-ray" d="M14 8V1M4 12l-5-5M24 12l5-5" />
      </g>
    </svg>
    {variant === 'full' && (
      <span class="sar-meter-nodes">
        {nodeAmounts.map((amount) => <span>{currency.format(amount)}</span>)}
      </span>
    )}
  </span>

  <span class="sar-meter-action">{variant === 'full' ? 'Explore the SAR commitment' : 'SAR details'} <span aria-hidden="true">→</span></span>
</a>

<style>
  .sar-meter {
    --sar-orange: #c96432;
    --sar-cream: #f2e8d6;
    display: grid;
    color: var(--sar-cream);
    background:
      radial-gradient(circle at 12% 20%, rgba(196,164,119,.2), transparent 30%),
      linear-gradient(110deg, #17372d, #24483a 62%, #17372d);
    border: 1px solid rgba(196,164,119,.75);
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(23,55,45,.14);
    overflow: hidden;
  }
  .sar-meter:hover { color: #fff; border-color: var(--sar-orange); }
  .sar-meter:focus-visible { outline: 3px solid var(--sar-orange); outline-offset: 3px; }
  .sar-meter-copy { min-width: 0; }
  .sar-meter-kicker {
    display: block;
    color: #e8c99d;
    font-size: .69rem;
    font-weight: 850;
    letter-spacing: .13em;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .sar-meter-status { display: flex; flex-direction: column; gap: .08rem; margin-top: .24rem; line-height: 1.18; }
  .sar-meter-status strong { color: #fff; font-size: .88rem; }
  .sar-meter-status span { color: #eadfcf; font-size: .72rem; }
  .sar-meter-visual { position: relative; min-width: 0; }
  .sar-meter-visual svg { display: block; width: 100%; height: auto; }
  .sar-contour { fill: none; stroke: rgba(232,220,200,.14); stroke-width: 1.2; }
  .sar-trail-base,
  .sar-trail-progress { fill: none; stroke-linecap: round; stroke-width: 7; }
  .sar-trail-base { stroke: rgba(232,220,200,.28); stroke-dasharray: 1 3; }
  .sar-trail-progress { stroke: var(--sar-orange); }
  .sar-trail-start { fill: var(--sar-orange); stroke: #f2e8d6; stroke-width: 4; }
  .sar-beacon path { fill: var(--sar-orange); }
  .sar-beacon .sar-beacon-ray { fill: none; stroke: var(--sar-orange); stroke-linecap: round; stroke-width: 2.5; }
  .sar-meter-action { color: #f1d3a9; font-size: .76rem; font-weight: 800; white-space: nowrap; }
  .sar-meter:hover .sar-meter-action { color: #fff; }

  .sar-meter--header {
    grid-template-columns: minmax(12rem, .9fr) minmax(15rem, 1.25fr) auto;
    align-items: center;
    gap: .85rem 1.25rem;
    width: min(var(--content), calc(100% - 3rem));
    margin: 0 auto .6rem;
    padding: .58rem .8rem;
    border-radius: .35rem;
  }
  .sar-meter--header .sar-meter-visual svg { max-height: 3.4rem; }

  .sar-meter--full {
    grid-template-columns: minmax(15rem, .75fr) minmax(20rem, 1.6fr);
    gap: 1rem 2rem;
    align-items: center;
    padding: 1.35rem 1.5rem 1.15rem;
    border-radius: .5rem;
  }
  .sar-meter--full .sar-meter-kicker { font-size: .8rem; }
  .sar-meter--full .sar-meter-status strong { font-family: var(--serif); font-size: clamp(1.35rem, 2.5vw, 2rem); }
  .sar-meter--full .sar-meter-status span { font-size: .92rem; }
  .sar-meter--full .sar-meter-action { grid-column: 1 / -1; justify-self: end; font-size: .86rem; }
  .sar-meter-nodes { display: grid; grid-template-columns: repeat(6, 1fr); color: #eadfcf; font-size: .67rem; font-weight: 750; margin: -.15rem 1.2rem 0; }
  .sar-meter-nodes span { text-align: center; }
  .sar-meter-nodes span:first-child { text-align: left; }
  .sar-meter-nodes span:last-child { text-align: right; color: #f19a67; }

  .is-achieved .sar-trail-progress { stroke: #e18b53; }
  .is-exceeded { box-shadow: 0 0 0 1px rgba(201,100,50,.25), 0 10px 28px rgba(23,55,45,.18); }

  @media (max-width: 850px) {
    .sar-meter--header {
      grid-template-columns: auto 1fr auto;
      width: min(var(--content), calc(100% - 1.5rem));
      margin-bottom: .5rem;
      padding: .48rem .65rem;
    }
    .sar-meter--header .sar-meter-kicker { font-size: .62rem; }
    .sar-meter--header .sar-meter-status strong { font-size: .78rem; }
    .sar-meter--header .sar-meter-status span { display: none; }
    .sar-meter--header .sar-meter-visual svg { max-height: 2.45rem; }
    .sar-meter--header .sar-meter-action { font-size: 0; }
    .sar-meter--header .sar-meter-action span { font-size: 1rem; }
  }

  @media (max-width: 620px) {
    .sar-meter--header { grid-template-columns: 1fr auto; gap: .5rem; }
    .sar-meter--header .sar-meter-copy { display: flex; align-items: center; gap: .55rem; }
    .sar-meter--header .sar-meter-kicker { flex: 0 0 auto; }
    .sar-meter--header .sar-meter-status { margin: 0; }
    .sar-meter--header .sar-meter-visual { display: none; }
    .sar-meter--header .sar-meter-status strong { font-size: .75rem; }
    .sar-meter--full { grid-template-columns: 1fr; padding: 1rem; }
    .sar-meter--full .sar-meter-action { grid-column: auto; justify-self: start; }
    .sar-meter-nodes { font-size: .58rem; margin-inline: .35rem; }
  }
</style>
