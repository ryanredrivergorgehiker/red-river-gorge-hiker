---
import SarMatchMeter from './SarMatchMeter.astro';

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const circleLogoFilename = 'rrgh-circle-logo-512-539a2fd23c.png';
const bannerAvifFilename = 'rrgh-banner-logo-profile-transparent-v3.avif';
const bannerWebpFilename = 'rrgh-banner-logo-profile-transparent-v3.webp';

const wallArtLinks = [
  ['Art Prints', 'https://store.redrivergorgehiker.com/shop/prints'],
  ['Canvas Prints', 'https://store.redrivergorgehiker.com/shop/canvas+prints'],
  ['Framed Prints', 'https://store.redrivergorgehiker.com/shop/framed+prints'],
  ['Metal Prints', 'https://store.redrivergorgehiker.com/shop/metal+prints'],
  ['Acrylic Prints', 'https://store.redrivergorgehiker.com/shop/acrylic+prints'],
  ['Wood Prints', 'https://store.redrivergorgehiker.com/shop/wood+prints'],
  ['Posters', 'https://store.redrivergorgehiker.com/shop/posters'],
  ['Photographs', 'https://store.redrivergorgehiker.com/art/photographs']
] as const;

const shopSections = [
  {
    title: 'Home Decor',
    links: [
      ['Throw Pillows', 'https://store.redrivergorgehiker.com/shop/throw+pillows'],
      ['Fleece Blankets', 'https://store.redrivergorgehiker.com/shop/fleece+blankets']
    ]
  },
  {
    title: 'Stationery',
    links: [
      ['Greeting Cards', 'https://store.redrivergorgehiker.com/shop/greeting+cards'],
      ['Spiral Notebooks', 'https://store.redrivergorgehiker.com/shop/spiral+notebooks'],
      ['Stickers', 'https://store.redrivergorgehiker.com/shop/stickers']
    ]
  },
  {
    title: 'Lifestyle',
    links: [
      ['Tote Bags', 'https://store.redrivergorgehiker.com/shop/tote+bags'],
      ["Men's Apparel", 'https://store.redrivergorgehiker.com/shop/tshirts'],
      ["Women's Apparel", 'https://store.redrivergorgehiker.com/shop/womens+tshirts'],
      ['Jigsaw Puzzles', 'https://store.redrivergorgehiker.com/shop/puzzles']
    ]
  },
  {
    title: 'Apparel',
    links: [
      ["Men's T-Shirts", 'https://store.redrivergorgehiker.com/shop/tshirts'],
      ["Men's Tank Tops", 'https://store.redrivergorgehiker.com/shop/tank+tops'],
      ["Women's T-Shirts", 'https://store.redrivergorgehiker.com/shop/womens+tshirts'],
      ["Women's Tank Tops", 'https://store.redrivergorgehiker.com/shop/womens+tank+tops'],
      ['Long Sleeve T-Shirts', 'https://store.redrivergorgehiker.com/shop/long+sleeve+tshirts'],
      ['Sweatshirts', 'https://store.redrivergorgehiker.com/shop/sweatshirts'],
      ["Kid's T-Shirts", 'https://store.redrivergorgehiker.com/shop/kids+tshirts'],
      ['Toddler T-Shirts', 'https://store.redrivergorgehiker.com/shop/toddler+tshirts'],
      ['Baby One-Pieces', 'https://store.redrivergorgehiker.com/shop/baby+one+pieces']
    ]
  }
] as const;

const primaryLinks = [
  ['Stories', '/exploring-the-gorge/'],
  ['About', '/about/']
] as const;

const relativePath = base !== '/' && path.startsWith(base)
  ? `/${path.slice(base.length)}`
  : path;
const isIn = (prefix: string) => relativePath === prefix || relativePath.startsWith(prefix);
const wallArtActive = isIn('/photography/') || isIn('/photographs/');
const shopActive = isIn('/gear/') || isIn('/puzzles/');
---
<header class="site-header">
  <a class="skip" href="#main">Skip to content</a>
  <div class="header-inner">
    <a class="wordmark brand-lockup" href={base} aria-label="Red River Gorge Hiker home">
      <img
        class="brand-emblem"
        src={`${base}assets/brand/${circleLogoFilename}`}
        width="512"
        height="512"
        alt=""
        aria-hidden="true"
      />
      <picture class="brand-wordmark">
        <source srcset={`${base}assets/brand/${bannerAvifFilename}`} type="image/avif" />
        <img
          class="brand-banner"
          src={`${base}assets/brand/${bannerWebpFilename}`}
          width="2048"
          height="682"
          alt="Red River Gorge Hiker"
        />
      </picture>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <ul class="primary-nav-list">
        <li class="nav-dropdown-item">
          <details class="nav-details nav-details-wall-art">
            <summary class:list={['nav-trigger', { 'is-active': wallArtActive }]} aria-current={wallArtActive ? 'page' : undefined}>
              Wall Art <span class="nav-caret" aria-hidden="true"></span>
            </summary>
            <div class="nav-panel nav-panel-wall-art">
              <ul class="nav-submenu nav-wall-art-links">
                {wallArtLinks.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
              </ul>
              <a class="nav-view-all nav-view-all-wall-art" href={`${base}photography/`}>View All Wall Art</a>
            </div>
          </details>
        </li>
        <li class="nav-dropdown-item">
          <details class="nav-details nav-details-shop">
            <summary class:list={['nav-trigger', { 'is-active': shopActive }]} aria-current={shopActive ? 'page' : undefined}>
              Shop <span class="nav-caret" aria-hidden="true"></span>
            </summary>
            <div class="nav-panel nav-panel-shop">
              <div class="nav-shop-grid">
                {shopSections.map((section) => (
                  <section class="nav-shop-section" aria-labelledby={`desktop-shop-${section.title.toLowerCase().replace(/[^a-z]+/g, '-')}`}>
                    <p class="nav-section-title" id={`desktop-shop-${section.title.toLowerCase().replace(/[^a-z]+/g, '-')}`}>{section.title}</p>
                    <ul class="nav-submenu">
                      {section.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
                    </ul>
                    {section.title === 'Home Decor' && (
                      <a class="nav-view-all nav-view-all-gear" href={`${base}gear/`}>View All Gear</a>
                    )}
                  </section>
                ))}
              </div>
            </div>
          </details>
        </li>
        {primaryLinks.map(([label, href]) => (
          <li><a href={`${base}${href.slice(1)}`} aria-current={relativePath === href ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="mobile-primary-nav" aria-label="Primary mobile">
      <ul class="primary-nav-list">
        <li class="nav-dropdown-item">
          <details class="nav-details nav-details-wall-art">
            <summary class:list={['nav-trigger', { 'is-active': wallArtActive }]} aria-current={wallArtActive ? 'page' : undefined}>
              Wall Art <span class="nav-caret" aria-hidden="true"></span>
            </summary>
            <div class="nav-panel nav-panel-wall-art">
              <ul class="nav-submenu nav-wall-art-links">
                {wallArtLinks.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
              </ul>
              <a class="nav-view-all nav-view-all-wall-art" href={`${base}photography/`}>View All Wall Art</a>
            </div>
          </details>
        </li>
        <li class="nav-dropdown-item">
          <details class="nav-details nav-details-shop">
            <summary class:list={['nav-trigger', { 'is-active': shopActive }]} aria-current={shopActive ? 'page' : undefined}>
              Shop <span class="nav-caret" aria-hidden="true"></span>
            </summary>
            <div class="nav-panel nav-panel-shop">
              <div class="nav-shop-grid">
                {shopSections.map((section) => (
                  <section class="nav-shop-section" aria-labelledby={`mobile-shop-${section.title.toLowerCase().replace(/[^a-z]+/g, '-')}`}>
                    <p class="nav-section-title" id={`mobile-shop-${section.title.toLowerCase().replace(/[^a-z]+/g, '-')}`}>{section.title}</p>
                    <ul class="nav-submenu">
                      {section.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
                    </ul>
                    {section.title === 'Lifestyle' && (
                      <a class="nav-view-all nav-view-all-gear" href={`${base}gear/`}>View All Gear</a>
                    )}
                  </section>
                ))}
              </div>
            </div>
          </details>
        </li>
        {primaryLinks.map(([label, href]) => (
          <li><a href={`${base}${href.slice(1)}`} aria-current={relativePath === href ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <SarMatchMeter variant="header" />
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('.site-header .nav-details'));

  menus.forEach((menu) => {
    menu.addEventListener('toggle', () => {
      if (!menu.open) return;
      menus.forEach((other) => {
        if (other !== menu) other.open = false;
      });
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.open = false;
      });
    });
  });

  document.addEventListener('click', (event) => {
    if (header?.contains(event.target as Node)) return;
    menus.forEach((menu) => { menu.open = false; });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    menus.forEach((menu) => { menu.open = false; });
  });
</script>

<style>
  .site-header .brand-lockup {
    align-items: center;
    gap: .72rem;
  }

  .site-header .brand-emblem {
    display: block;
    width: 6.5rem;
    height: 6.5rem;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .site-header .brand-wordmark {
    display: block;
    min-width: 0;
  }

  .site-header .primary-nav-list {
    align-items: center;
  }

  .site-header .nav-dropdown-item,
  .site-header .nav-details {
    position: relative;
  }

  .site-header .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: .42rem;
    color: var(--charcoal);
    cursor: pointer;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.2;
    list-style: none;
    white-space: nowrap;
  }

  .site-header .nav-trigger::-webkit-details-marker { display: none; }
  .site-header .nav-trigger:hover,
  .site-header .nav-details[open] > .nav-trigger { color: var(--gorge); }
  .site-header .nav-trigger.is-active {
    border-bottom: 2px solid var(--sunrise);
  }

  .site-header .nav-caret {
    display: inline-block;
    width: .38rem;
    height: .38rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transform-origin: center;
    transition: transform .16s ease;
  }
  .site-header .nav-details[open] .nav-caret {
    transform: rotate(45deg);
  }

  .site-header .nav-panel {
    position: absolute;
    z-index: 220;
    top: calc(100% + .72rem);
    padding: 1.05rem 1.15rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: .12rem;
    background: rgba(251, 250, 246, .995);
    box-shadow: 0 .45rem 1.2rem rgba(23, 55, 45, .1);
  }

  .site-header .nav-panel-wall-art {
    left: 0;
    display: flex;
    flex-direction: column;
    width: 19rem;
  }

  .site-header .nav-panel-shop {
    right: 0;
    width: min(64rem, calc(100vw - 3rem));
  }

  .site-header .nav-view-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    min-height: 2.45rem;
    padding: .52rem .85rem;
    border: 1px solid var(--gorge);
    border-radius: .2rem;
    background: var(--gorge);
    color: #fff;
    font-size: .88rem;
    font-weight: 750;
    line-height: 1.2;
    text-align: left;
    text-decoration: none;
  }
  .site-header .nav-view-all:hover { background: var(--pine); color: #fff; }

  .site-header .nav-view-all-wall-art {
    margin-top: 1.05rem;
  }

  .site-header .nav-section-title {
    margin: 0 0 .42rem;
    padding-bottom: .36rem;
    border-bottom: 1px solid var(--line);
    color: var(--charcoal);
    font-size: .94rem;
    font-weight: 650;
    letter-spacing: 0;
    line-height: 1.25;
    text-transform: none;
  }

  .site-header .nav-submenu {
    display: grid;
    gap: .06rem;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }
  .site-header .nav-submenu li {
    display: block;
    min-width: 0;
  }
  .site-header .nav-submenu a {
    display: block;
    padding: .2rem 0;
    color: var(--charcoal);
    font-size: .89rem;
    font-weight: 450;
    line-height: 1.28;
    text-align: left;
    text-decoration: none;
    white-space: normal;
  }
  .site-header .nav-submenu a:hover { color: var(--gorge); text-decoration: underline; }

  .site-header .nav-shop-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem 2rem;
    align-items: stretch;
  }
  .site-header .nav-shop-section {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .site-header .nav-shop-section .nav-view-all-gear {
    margin-top: auto;
    padding-top: .52rem;
  }

  @media (max-width: 850px) {
    .site-header .brand-lockup {
      display: grid;
      grid-template-columns: auto minmax(0, 15rem);
      align-items: center;
      justify-content: center;
      column-gap: .6rem;
      width: 100%;
      margin-inline: auto;
    }

    .site-header .brand-emblem {
      width: 4.75rem;
      height: 4.75rem;
    }

    .site-header .brand-wordmark {
      width: 100%;
      max-width: 15rem;
    }

    .site-header .brand-banner {
      width: 100%;
      max-width: 100%;
    }

    .site-header .mobile-primary-nav {
      position: relative;
    }

    .site-header .mobile-primary-nav > .primary-nav-list {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      align-items: center;
      width: 100%;
      gap: 0;
      margin: 0;
      padding: 0;
      list-style: none;
      white-space: nowrap;
    }

    .site-header .mobile-primary-nav > .primary-nav-list > li {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 0;
    }

    .site-header .mobile-primary-nav > .primary-nav-list > .nav-dropdown-item {
      position: static;
    }

    .site-header .mobile-primary-nav .nav-trigger,
    .site-header .mobile-primary-nav > .primary-nav-list > li > a {
      color: var(--charcoal);
      font-size: clamp(.72rem, 3vw, .9rem);
      font-weight: 700;
      line-height: 1.2;
      text-align: center;
      text-decoration: none;
    }

    .site-header .mobile-primary-nav .nav-trigger.is-active,
    .site-header .mobile-primary-nav > .primary-nav-list > li > a[aria-current='page'] {
      color: var(--gorge);
      text-decoration: underline;
      text-decoration-color: var(--sunrise);
      text-decoration-thickness: 2px;
      text-underline-offset: .24em;
      border-bottom: 0;
    }

    .site-header .mobile-primary-nav .nav-details {
      position: static;
    }

    .site-header .mobile-primary-nav .nav-panel {
      top: calc(100% + .35rem);
      left: 50%;
      right: auto;
      width: min(calc(100vw - .75rem), 42rem);
      max-height: min(72dvh, 40rem);
      overflow: auto;
      transform: translateX(-50%);
      padding: .85rem .95rem 1rem;
      text-align: left;
      white-space: normal;
    }

    .site-header .mobile-primary-nav .nav-details-wall-art .nav-panel {
      width: min(calc(100vw - .75rem), 22rem);
    }

    .site-header .mobile-primary-nav .nav-wall-art-links,
    .site-header .mobile-primary-nav .nav-wall-art-links a {
      text-align: left;
    }

    .site-header .mobile-primary-nav .nav-view-all-wall-art {
      margin-top: 1rem;
    }

    .site-header .mobile-primary-nav .nav-shop-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.15rem 1.1rem;
      align-items: stretch;
    }

    .site-header .mobile-primary-nav .nav-section-title {
      margin-bottom: .35rem;
      font-size: .9rem;
    }

    .site-header .mobile-primary-nav .nav-submenu {
      display: grid;
      grid-template-columns: none;
      gap: .02rem;
      width: 100%;
      white-space: normal;
    }

    .site-header .mobile-primary-nav .nav-submenu a {
      padding: .17rem 0;
      font-size: .84rem;
      line-height: 1.25;
    }

    .site-header .mobile-primary-nav .nav-submenu li {
      display: block;
    }
    .site-header .mobile-primary-nav .nav-submenu li::after { content: none; }
  }

  @media (max-width: 560px) {
    .site-header .brand-lockup {
      grid-template-columns: auto minmax(0, 14.25rem);
      column-gap: .5rem;
      padding-inline: .2rem;
    }

    .site-header .brand-emblem {
      width: 4.5rem;
      height: 4.5rem;
    }

    .site-header .brand-wordmark {
      width: min(14.25rem, calc(100vw - 7rem));
      max-width: 100%;
    }

    .site-header .mobile-primary-nav .nav-trigger,
    .site-header .mobile-primary-nav > .primary-nav-list > li > a {
      font-size: clamp(.72rem, 3.15vw, .84rem);
    }

    .site-header .mobile-primary-nav .nav-panel {
      width: calc(100vw - .75rem);
      max-height: 72dvh;
      padding: .8rem .85rem .95rem;
    }

    .site-header .mobile-primary-nav .nav-details-wall-art .nav-panel {
      width: min(calc(100vw - .75rem), 21rem);
    }

    .site-header .mobile-primary-nav .nav-shop-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.05rem .9rem;
    }

    .site-header .mobile-primary-nav .nav-section-title {
      font-size: .86rem;
    }

    .site-header .mobile-primary-nav .nav-submenu a {
      font-size: clamp(.75rem, 3.35vw, .82rem);
    }
  }
</style>