---
import SarMatchMeter from './SarMatchMeter.astro';

const nav = [['Photography','/photography/'],['Puzzles','/puzzles/'],['Gear','/gear/'],['Stories','/exploring-the-gorge/'],['About','/about/']] as const;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const circleLogoFilename = 'rrgh-circle-logo-512-539a2fd23c.png';
const bannerAvifFilename = 'rrgh-banner-logo-profile-transparent-v3.avif';
const bannerWebpFilename = 'rrgh-banner-logo-profile-transparent-v3.webp';
---
<header class="site-header">
  <a class="skip" href="#main">Skip to content</a>
  <div class="header-inner">
    <a class="wordmark brand-lockup" href={base} aria-label="Red River Gorge Hiker home">
      <img
        class="brand-emblem"
        src={`${base}assets/brand/${circleLogoFilename}`}
        width="512"
        height="512"
        alt=""
        aria-hidden="true"
      />
      <picture class="brand-wordmark">
        <source srcset={`${base}assets/brand/${bannerAvifFilename}`} type="image/avif" />
        <img
          class="brand-banner"
          src={`${base}assets/brand/${bannerWebpFilename}`}
          width="2048"
          height="682"
          alt="Red River Gorge Hiker"
        />
      </picture>
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {nav.map(([label,href]) => (
          <li><a href={`${base}${href.slice(1)}`} aria-current={path.endsWith(href) ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
    <nav class="mobile-primary-nav" aria-label="Primary mobile">
      <ul>
        {nav.map(([label,href]) => (
          <li><a href={`${base}${href.slice(1)}`} aria-current={path.endsWith(href) ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <SarMatchMeter variant="header" />
</header>

<style>
  .site-header .brand-lockup {
    align-items: center;
    gap: .72rem;
  }

  .site-header .brand-emblem {
    display: block;
    width: 6.5rem;
    height: 6.5rem;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .site-header .brand-wordmark {
    display: block;
    min-width: 0;
  }

  @media (max-width: 850px) {
    .site-header .brand-lockup {
      display: grid;
      grid-template-columns: auto minmax(0, 15rem);
      align-items: center;
      justify-content: center;
      column-gap: .6rem;
      width: 100%;
      margin-inline: auto;
    }

    .site-header .brand-emblem {
      width: 4.75rem;
      height: 4.75rem;
    }

    .site-header .brand-wordmark {
      width: 100%;
      max-width: 15rem;
    }

    .site-header .brand-banner {
      width: 100%;
      max-width: 100%;
    }

    .site-header .mobile-primary-nav ul {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  /* Portrait phones: three centered items on row one, two centered items on row two. */
  @media (max-width: 560px) {
    .site-header .brand-lockup {
      grid-template-columns: auto minmax(0, 14.25rem);
      column-gap: .5rem;
      padding-inline: .2rem;
    }

    .site-header .brand-emblem {
      width: 4.5rem;
      height: 4.5rem;
    }

    .site-header .brand-wordmark {
      width: min(14.25rem, calc(100vw - 7rem));
      max-width: 100%;
    }

    .site-header .mobile-primary-nav ul {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      row-gap: .42rem;
    }
    .site-header .mobile-primary-nav li:nth-child(1) { grid-column: 1 / span 2; }
    .site-header .mobile-primary-nav li:nth-child(2) { grid-column: 3 / span 2; }
    .site-header .mobile-primary-nav li:nth-child(3) { grid-column: 5 / span 2; }
    .site-header .mobile-primary-nav li:nth-child(4) { grid-column: 2 / span 2; }
    .site-header .mobile-primary-nav li:nth-child(5) { grid-column: 4 / span 2; }

    .site-header .mobile-primary-nav li::after { content: none !important; }
    .site-header .mobile-primary-nav li:nth-child(1)::after,
    .site-header .mobile-primary-nav li:nth-child(2)::after,
    .site-header .mobile-primary-nav li:nth-child(4)::after {
      content: '·' !important;
      position: absolute;
      right: -.08rem;
      color: var(--pine);
      font-weight: 800;
    }
    .site-header .mobile-primary-nav a {
      font-size: clamp(.72rem, 3.15vw, .84rem);
    }
  }
</style>
