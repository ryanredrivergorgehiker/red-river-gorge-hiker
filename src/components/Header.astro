---
import { brandAsset } from '../data/assets';

const nav = [['Collection','/collection/'],['Prints','/prints/'],['Puzzles','/puzzles/'],['Stories','/exploring-the-gorge/'],['About','/about/']] as const;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
---
<header class="site-header">
  <a class="skip" href="#main">Skip to content</a>
  <div class="header-inner">
    <a class="wordmark" href={base} aria-label="Red River Gorge Hiker home">
      <img
        class="brand-mark"
        src={`${base}assets/brand/${brandAsset.publicFilename}`}
        width={brandAsset.width}
        height={brandAsset.height}
        alt=""
        aria-hidden="true"
      />
      <span>Red River Gorge Hiker</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {nav.map(([label,href]) => (
          <li><a href={`${base}${href.slice(1)}`} aria-current={path.endsWith(href) ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
    <nav class="mobile-primary-nav" aria-label="Primary mobile">
      <ul>
        {nav.map(([label,href]) => (
          <li><a href={`${base}${href.slice(1)}`} aria-current={path.endsWith(href) ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
