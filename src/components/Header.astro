---
import SarMatchMeter from './SarMatchMeter.astro';
import { photographs } from '../data/products';

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const circleLogoFilename = 'rrgh-circle-logo-512-539a2fd23c.png';
const bannerAvifFilename = 'rrgh-banner-logo-profile-transparent-v3.avif';
const bannerWebpFilename = 'rrgh-banner-logo-profile-transparent-v3.webp';

const wallArtFormats = [
  ['View All', null],
  ['Art Print', 'art-print'],
  ['Canvas Print', 'canvas-print'],
  ['Framed Print', 'framed-print'],
  ['Metal Print', 'metal-print'],
  ['Acrylic Print', 'acrylic-print'],
  ['Wood Print', 'wood-print'],
  ['Poster', 'poster']
] as const;

const wallArtProductUrl = (artworkUrl: string, product: string | null) =>
  product ? `${artworkUrl}?product=${product}` : artworkUrl;

const puzzlePhotographs = photographs
  .filter((photo) => photo.puzzleAvailable && photo.puzzleUrl)
  .map((photo) => ({ title: photo.title, url: photo.puzzleUrl as string }));

const puzzleCollectionUrl = 'https://store.redrivergorgehiker.com/shop/puzzles';
const doubleRainbowGreetingCardUrl =
  'https://store.redrivergorgehiker.com/featured/double-rainbow-at-eagles-point-ryan-d-lewis.html';

const shopSections = [
  {
    title: 'Home Decor',
    links: [
      ['Throw Pillows', 'https://store.redrivergorgehiker.com/featured/red-river-gorge-hiker-ryan-d-lewis.html?product=throw-pillow'],
      ['Fleece Blankets', 'https://store.redrivergorgehiker.com/featured/red-river-gorge-hiker-ryan-d-lewis.html?product=fleece-blanket']
    ]
  },
  {
    title: 'Stationery',
    links: [
      ['Greeting Cards', 'https://store.redrivergorgehiker.com/shop/greeting+cards'],
      ['Spiral Notebooks', 'https://store.redrivergorgehiker.com/featured/red-river-gorge-hiker-ryan-d-lewis.html?product=spiral-notebook'],
      ['Stickers', 'https://store.redrivergorgehiker.com/featured/red-river-gorge-hiker-ryan-d-lewis.html?product=sticker']
    ]
  },
  {
    title: 'Lifestyle',
    links: [
      ['Tote Bags', 'https://store.redrivergorgehiker.com/featured/red-river-gorge-hiker-ryan-d-lewis.html?product=tote-bag'],
      ["Men's Apparel", 'https://store.redrivergorgehiker.com/shop/tshirts'],
      ["Women's Apparel", 'https://store.redrivergorgehiker.com/shop/womens+tshirts'],
      ['Jigsaw Puzzles', 'https://store.redrivergorgehiker.com/shop/puzzles']
    ]
  },
  {
    title: 'Apparel',
    links: [
      ["Men's T-Shirts", 'https://store.redrivergorgehiker.com/featured/red-river-gorge-hiker-ryan-d-lewis.html?product=adult-tshirt&completeProductSku=artworkid[70456163]-productid[clothing-23]-imagewidth[286]-imageheight[286]-targetx[72]-targety[0]-modelwidth[430]-modelheight[575]-backgroundcolor[5]-orientation[0]-size[3]'],
      ["Men's Tank Tops", 'https://store.redrivergorgehiker.com/featured/red-river-gorge-hiker-ryan-d-lewis.html?product=tank-top-tshirt'],
      ["Women's T-Shirts", 'https://store.redrivergorgehiker.com/featured/red-river-gorge-hiker-ryan-d-lewis.html?product=womens-tshirt'],
      ["Women's Tank Tops", 'https://store.redrivergorgehiker.com/featured/red-river-gorge-hiker-ryan-d-lewis.html?product=womens-tank-top'],
      ['Long Sleeve T-Shirts', 'https://store.redrivergorgehiker.com/featured/red-river-gorge-hiker-ryan-d-lewis.html?product=long-sleeve-tshirt'],
      ['Sweatshirts', 'https://store.redrivergorgehiker.com/featured/red-river-gorge-hiker-ryan-d-lewis.html?product=pull-over-hoodie-sweatshirt'],
      ["Kid's T-Shirts", 'https://store.redrivergorgehiker.com/featured/red-river-gorge-hiker-ryan-d-lewis.html?product=kids-tshirt'],
      ['Toddler T-Shirts', 'https://store.redrivergorgehiker.com/featured/red-river-gorge-hiker-ryan-d-lewis.html?product=toddler-tshirt'],
      ['Baby One-Pieces', 'https://store.redrivergorgehiker.com/featured/red-river-gorge-hiker-ryan-d-lewis.html?product=one-piece']
    ]
  }
] as const;

const primaryLinks = [
  ['Stories', '/exploring-the-gorge/'],
  ['About', '/about/']
] as const;

const relativePath = base !== '/' && path.startsWith(base)
  ? `/${path.slice(base.length)}`
  : path;
const isIn = (prefix: string) => relativePath === prefix || relativePath.startsWith(prefix);
const wallArtActive = isIn('/photography/') || isIn('/photographs/');
const shopActive = isIn('/gear/') || isIn('/puzzles/');
---
<header class="site-header">
  <a class="skip" href="#main">Skip to content</a>
  <div class="header-inner">
    <a class="wordmark brand-lockup" href={base} aria-label="Red River Gorge Hiker home">
      <img
        class="brand-emblem"
        src={`${base}assets/brand/${circleLogoFilename}`}
        width="512"
        height="512"
        alt=""
        aria-hidden="true"
      />
      <picture class="brand-wordmark">
        <source srcset={`${base}assets/brand/${bannerAvifFilename}`} type="image/avif" />
        <img
          class="brand-banner"
          src={`${base}assets/brand/${bannerWebpFilename}`}
          width="2048"
          height="682"
          alt="Red River Gorge Hiker"
        />
      </picture>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <ul class="primary-nav-list">
        <li class="nav-dropdown-item">
          <details class="nav-details nav-details-wall-art">
            <summary class:list={['nav-trigger', { 'is-active': wallArtActive }]} aria-current={wallArtActive ? 'page' : undefined}>
              Wall Art <span class="nav-caret" aria-hidden="true"></span>
            </summary>
            <div class="nav-panel nav-panel-wall-art">
              <p class="nav-section-title nav-wall-art-title">Shop Wall Art</p>
              <ul class="nav-submenu nav-wall-art-links nav-wall-art-choices">
                {photographs.map((photo) => (
                  <li class="nav-wall-art-choice">
                    <details class="nav-wall-art-choice-details">
                      <summary class:list={['nav-wall-art-choice-trigger', { 'nav-wall-art-choice-trigger-long': photo.catalogId === 'RRGH-0001' }]}>
                        <span>{photo.title}</span><span class="nav-wall-art-choice-arrow" aria-hidden="true"></span>
                      </summary>
                      <div class="nav-wall-art-flyout">
                        <ul class="nav-submenu nav-wall-art-format-links">
                          {wallArtFormats.map(([label, product]) => (
                            <li><a class:list={{ 'nav-wall-art-view-all-link': product === null }} href={wallArtProductUrl(photo.wallArtUrl, product)}>{label}</a></li>
                          ))}
                          {photo.catalogId === 'RRGH-0001' && (
                            <li><a class="nav-wall-art-greeting-card-link" href={doubleRainbowGreetingCardUrl}>Greeting Card</a></li>
                          )}
                        </ul>
                      </div>
                    </details>
                  </li>
                ))}
                <li class="nav-wall-art-choice">
                  <details class="nav-wall-art-choice-details">
                    <summary class="nav-wall-art-choice-trigger">
                      <span>Jigsaw Puzzles</span><span class="nav-wall-art-choice-arrow" aria-hidden="true"></span>
                    </summary>
                    <div class="nav-wall-art-flyout nav-wall-art-puzzle-flyout">
                      <ul class="nav-submenu nav-wall-art-puzzle-links">
                        <li><a class="nav-wall-art-view-all-link" href={puzzleCollectionUrl}>View All</a></li>
                        {puzzlePhotographs.map((photo) => <li><a href={photo.url}>{photo.title}</a></li>)}
                      </ul>
                    </div>
                  </details>
                </li>
                <li class="nav-wall-art-choice nav-wall-art-direct-choice">
                  <a href={doubleRainbowGreetingCardUrl}>Double Rainbow Greeting Card</a>
                </li>
              </ul>
              <a class="nav-view-all nav-view-all-wall-art" href="https://store.redrivergorgehiker.com/art">View All Wall Art</a>
            </div>
          </details>
        </li>
        <li class="nav-dropdown-item">
          <details class="nav-details nav-details-shop">
            <summary class:list={['nav-trigger', { 'is-active': shopActive }]} aria-current={shopActive ? 'page' : undefined}>
              Shop <span class="nav-caret" aria-hidden="true"></span>
            </summary>
            <div class="nav-panel nav-panel-shop">
              <div class="nav-shop-grid">
                {shopSections.map((section) => (
                  <section class="nav-shop-section" aria-labelledby={`desktop-shop-${section.title.toLowerCase().replace(/[^a-z]+/g, '-')}`}>
                    <p class="nav-section-title" id={`desktop-shop-${section.title.toLowerCase().replace(/[^a-z]+/g, '-')}`}>{section.title}</p>
                    <ul class="nav-submenu">
                      {section.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
                    </ul>
                    {section.title === 'Home Decor' && (
                      <a class="nav-view-all nav-view-all-gear" href="https://store.redrivergorgehiker.com/featured/red-river-gorge-hiker-ryan-d-lewis.html">View All Gear</a>
                    )}
                  </section>
                ))}
              </div>
            </div>
          </details>
        </li>
        {primaryLinks.map(([label, href]) => (
          <li><a href={`${base}${href.slice(1)}`} aria-current={relativePath === href ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="mobile-primary-nav" aria-label="Primary mobile">
      <ul class="primary-nav-list">
        <li class="nav-dropdown-item">
          <details class="nav-details nav-details-wall-art">
            <summary class:list={['nav-trigger', { 'is-active': wallArtActive }]} aria-current={wallArtActive ? 'page' : undefined}>
              Wall Art <span class="nav-caret" aria-hidden="true"></span>
            </summary>
            <div class="nav-panel nav-panel-wall-art">
              <p class="nav-section-title nav-wall-art-title">Shop Wall Art</p>
              <ul class="nav-submenu nav-wall-art-links nav-wall-art-choices">
                {photographs.map((photo) => (
                  <li class="nav-wall-art-choice">
                    <details class="nav-wall-art-choice-details">
                      <summary class:list={['nav-wall-art-choice-trigger', { 'nav-wall-art-choice-trigger-long': photo.catalogId === 'RRGH-0001' }]}>
                        <span>{photo.title}</span><span class="nav-wall-art-choice-arrow" aria-hidden="true"></span>
                      </summary>
                      <div class="nav-wall-art-flyout">
                        <ul class="nav-submenu nav-wall-art-format-links">
                          {wallArtFormats.map(([label, product]) => (
                            <li><a class:list={{ 'nav-wall-art-view-all-link': product === null }} href={wallArtProductUrl(photo.wallArtUrl, product)}>{label}</a></li>
                          ))}
                          {photo.catalogId === 'RRGH-0001' && (
                            <li><a class="nav-wall-art-greeting-card-link" href={doubleRainbowGreetingCardUrl}>Greeting Card</a></li>
                          )}
                        </ul>
                      </div>
                    </details>
                  </li>
                ))}
                <li class="nav-wall-art-choice">
                  <details class="nav-wall-art-choice-details">
                    <summary class="nav-wall-art-choice-trigger">
                      <span>Jigsaw Puzzles</span><span class="nav-wall-art-choice-arrow" aria-hidden="true"></span>
                    </summary>
                    <div class="nav-wall-art-flyout nav-wall-art-puzzle-flyout">
                      <ul class="nav-submenu nav-wall-art-puzzle-links">
                        <li><a class="nav-wall-art-view-all-link" href={puzzleCollectionUrl}>View All</a></li>
                        {puzzlePhotographs.map((photo) => <li><a href={photo.url}>{photo.title}</a></li>)}
                      </ul>
                    </div>
                  </details>
                </li>
                <li class="nav-wall-art-choice nav-wall-art-direct-choice">
                  <a href={doubleRainbowGreetingCardUrl}>Double Rainbow Greeting Card</a>
                </li>
              </ul>
              <a class="nav-view-all nav-view-all-wall-art" href="https://store.redrivergorgehiker.com/art">View All Wall Art</a>
            </div>
          </details>
        </li>
        <li class="nav-dropdown-item">
          <details class="nav-details nav-details-shop">
            <summary class:list={['nav-trigger', { 'is-active': shopActive }]} aria-current={shopActive ? 'page' : undefined}>
              Shop <span class="nav-caret" aria-hidden="true"></span>
            </summary>
            <div class="nav-panel nav-panel-shop">
              <div class="nav-shop-grid">
                {shopSections.map((section) => (
                  <section class="nav-shop-section" aria-labelledby={`mobile-shop-${section.title.toLowerCase().replace(/[^a-z]+/g, '-')}`}>
                    <p class="nav-section-title" id={`mobile-shop-${section.title.toLowerCase().replace(/[^a-z]+/g, '-')}`}>{section.title}</p>
                    <ul class="nav-submenu">
                      {section.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
                    </ul>
                    {section.title === 'Lifestyle' && (
                      <a class="nav-view-all nav-view-all-gear" href="https://store.redrivergorgehiker.com/featured/red-river-gorge-hiker-ryan-d-lewis.html">View All Gear</a>
                    )}
                  </section>
                ))}
              </div>
            </div>
          </details>
        </li>
        {primaryLinks.map(([label, href]) => (
          <li><a href={`${base}${href.slice(1)}`} aria-current={relativePath === href ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <SarMatchMeter variant="header" />
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('.site-header .nav-details'));
  const wallArtChoices = Array.from(document.querySelectorAll<HTMLDetailsElement>('.site-header .nav-wall-art-choice-details'));
  const desktopWallArtHover = window.matchMedia('(min-width: 851px) and (hover: hover)');

  const closeWallArtChoices = (scope: ParentNode = document) => {
    scope.querySelectorAll<HTMLDetailsElement>('.nav-wall-art-choice-details').forEach((choice) => {
      choice.open = false;
    });
  };

  const openWallArtChoice = (choice: HTMLDetailsElement) => {
    const panel = choice.closest('.nav-panel-wall-art');
    panel?.querySelectorAll<HTMLDetailsElement>('.nav-wall-art-choice-details').forEach((other) => {
      if (other !== choice) other.open = false;
    });
    choice.open = true;
  };

  menus.forEach((menu) => {
    menu.addEventListener('toggle', () => {
      if (!menu.open) {
        closeWallArtChoices(menu);
        return;
      }
      menus.forEach((other) => {
        if (other !== menu) other.open = false;
      });
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.open = false;
      });
    });
  });

  wallArtChoices.forEach((choice) => {
    choice.addEventListener('toggle', () => {
      if (!choice.open) return;
      const panel = choice.closest('.nav-panel-wall-art');
      panel?.querySelectorAll<HTMLDetailsElement>('.nav-wall-art-choice-details').forEach((other) => {
        if (other !== choice) other.open = false;
      });
    });

    choice.addEventListener('mouseenter', () => {
      if (!desktopWallArtHover.matches) return;
      openWallArtChoice(choice);
    });

    choice.addEventListener('mouseleave', () => {
      if (!desktopWallArtHover.matches || choice.matches(':focus-within')) return;
      choice.open = false;
    });

    choice.addEventListener('focusin', () => {
      if (!desktopWallArtHover.matches) return;
      openWallArtChoice(choice);
    });

    choice.addEventListener('focusout', (event) => {
      if (!desktopWallArtHover.matches) return;
      const nextTarget = event.relatedTarget;
      if (!(nextTarget instanceof Node) || !choice.contains(nextTarget)) {
        choice.open = false;
      }
    });
  });

  document.addEventListener('click', (event) => {
    if (header?.contains(event.target as Node)) return;
    menus.forEach((menu) => { menu.open = false; });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    closeWallArtChoices();
    menus.forEach((menu) => { menu.open = false; });
  });
</script>

<style>
  .site-header .brand-lockup {
    align-items: center;
    gap: .72rem;
  }

  .site-header .brand-emblem {
    display: block;
    width: 6.5rem;
    height: 6.5rem;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .site-header .brand-wordmark {
    display: block;
    min-width: 0;
  }

  .site-header .primary-nav-list {
    align-items: center;
  }

  .site-header .nav-dropdown-item,
  .site-header .nav-details {
    position: relative;
  }

  .site-header .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: .42rem;
    color: var(--charcoal);
    cursor: pointer;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.2;
    list-style: none;
    white-space: nowrap;
  }

  .site-header .nav-trigger::-webkit-details-marker { display: none; }
  .site-header .nav-trigger:hover,
  .site-header .nav-details[open] > .nav-trigger { color: var(--gorge); }
  .site-header .nav-trigger.is-active {
    border-bottom: 2px solid var(--sunrise);
  }

  .site-header .nav-caret {
    display: inline-block;
    width: .38rem;
    height: .38rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transform-origin: center;
    transition: transform .16s ease;
  }
  .site-header .nav-details[open] .nav-caret {
    transform: rotate(45deg);
  }

  .site-header .nav-panel {
    position: absolute;
    z-index: 220;
    top: calc(100% + .72rem);
    padding: 1.05rem 1.15rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: .12rem;
    background: rgba(251, 250, 246, .995);
    box-shadow: 0 .45rem 1.2rem rgba(23, 55, 45, .1);
  }

  .site-header .nav-panel-wall-art {
    left: 0;
    display: flex;
    flex-direction: column;
    width: 16rem;
    overflow: visible;
  }

  .site-header .nav-panel-shop {
    right: 0;
    width: min(64rem, calc(100vw - 3rem));
  }

  .site-header .nav-view-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    min-height: 2.45rem;
    padding: .52rem .85rem;
    border: 1px solid var(--gorge);
    border-radius: .2rem;
    background: var(--gorge);
    color: #fff;
    font-size: .88rem;
    font-weight: 750;
    line-height: 1.2;
    text-align: left;
    text-decoration: none;
  }
  .site-header .nav-view-all:hover { background: var(--pine); color: #fff; }

  .site-header .nav-view-all-wall-art {
    margin-top: 1.05rem;
  }

  .site-header .nav-section-title {
    margin: 0 0 .42rem;
    padding-bottom: .36rem;
    border-bottom: 1px solid var(--line);
    color: var(--charcoal);
    font-size: .94rem;
    font-weight: 650;
    letter-spacing: 0;
    line-height: 1.25;
    text-transform: none;
  }

  .site-header .nav-submenu {
    display: grid;
    gap: .06rem;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }
  .site-header .nav-submenu li {
    display: block;
    min-width: 0;
  }
  .site-header .nav-submenu a {
    display: block;
    padding: .2rem 0;
    color: var(--charcoal);
    font-size: .89rem;
    font-weight: 450;
    line-height: 1.28;
    text-align: left;
    text-decoration: none;
    white-space: normal;
  }
  .site-header .nav-submenu a:hover { color: var(--gorge); text-decoration: underline; }

  .site-header .nav-wall-art-choices {
    gap: .03rem;
  }

  .site-header .nav-wall-art-choice,
  .site-header .nav-wall-art-choice-details {
    position: relative;
  }

  .site-header .nav-wall-art-choice-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    width: 100%;
    padding: .2rem 0;
    color: var(--charcoal);
    cursor: pointer;
    font-size: .89rem;
    font-weight: 450;
    line-height: 1.28;
    list-style: none;
    text-align: left;
    white-space: normal;
  }
  .site-header .nav-wall-art-choice-trigger > span:first-child {
    min-width: 0;
  }
  .site-header .nav-wall-art-choice-trigger::-webkit-details-marker { display: none; }
  .site-header .nav-wall-art-choice-trigger:hover,
  .site-header .nav-wall-art-choice-details:focus-within > .nav-wall-art-choice-trigger {
    color: var(--gorge);
    text-decoration: underline;
  }

  .site-header .nav-wall-art-choice-arrow {
    display: inline-block;
    width: .34rem;
    height: .34rem;
    flex: 0 0 auto;
    border-right: 1.4px solid currentColor;
    border-bottom: 1.4px solid currentColor;
    transform: rotate(-45deg);
    transform-origin: center;
  }

  .site-header .nav-wall-art-flyout {
    display: none;
    position: absolute;
    z-index: 230;
    top: -.62rem;
    left: calc(100% + .45rem);
    min-width: 11.4rem;
    padding: .62rem .78rem .68rem;
    border: 1px solid var(--line);
    border-radius: .12rem;
    background: rgba(251, 250, 246, .995);
    box-shadow: 0 .45rem 1.2rem rgba(23, 55, 45, .1);
  }

  .site-header .nav-wall-art-puzzle-flyout {
    min-width: 17.5rem;
  }

  .site-header .nav-wall-art-view-all-link {
    margin-bottom: .18rem;
    padding-bottom: .42rem !important;
    border-bottom: 1px solid var(--line);
    color: var(--gorge) !important;
    font-weight: 700 !important;
  }

  .site-header .nav-wall-art-direct-choice > a {
    padding-right: 1.1rem;
  }

  .site-header .nav-shop-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem 2rem;
    align-items: stretch;
  }
  .site-header .nav-shop-section {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .site-header .nav-shop-section .nav-view-all-gear {
    margin-top: auto;
    padding-top: .52rem;
  }

  @media (min-width: 851px) and (hover: hover) {
    .site-header .desktop-nav .nav-wall-art-choice-details[open] > .nav-wall-art-flyout,
    .site-header .desktop-nav .nav-wall-art-choice-details:hover > .nav-wall-art-flyout,
    .site-header .desktop-nav .nav-wall-art-choice-details:focus-within > .nav-wall-art-flyout {
      display: block;
    }

    .site-header .desktop-nav .nav-wall-art-choice-trigger-long > span:first-child {
      max-width: 11.75rem;
    }

    .site-header .desktop-nav .nav-wall-art-direct-choice > a {
      max-width: 12rem;
    }

    .site-header .desktop-nav .nav-wall-art-flyout::before {
      content: '';
      position: absolute;
      top: 0;
