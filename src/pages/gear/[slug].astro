---
import Base from '../../layouts/Base.astro';
import ShareControls from '../../components/ShareControls.astro';
import { gearProducts, type GearProduct } from '../../data/gearCatalog';
import '../../styles/merchandise.css';
import '../../styles/gear-sharing.css';

export function getStaticPaths() {
  return gearProducts.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

interface Props {
  product: GearProduct;
}

const { product } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const socialImagePath = product.image.avif.replace(/\.avif$/, '-share.jpg');
---
<Base
  title={product.title}
  description={product.description}
  socialImagePath={socialImagePath}
  socialImageType="image/jpeg"
  socialImageAlt={product.image.alt}
  socialImageWidth={product.image.width}
  socialImageHeight={product.image.height}
  ogType="product"
>
  <div class="page gear-product-page">
    <p class="eyebrow">Red River Gorge Hiker gear</p>
    <p class="gear-product-back"><a href={`${base}gear/`}>← All gear</a></p>

    <div class="gear-product-detail">
      <div class="gear-product-media">
        <img
          src={`${base}${product.image.avif}`}
          width={product.image.width}
          height={product.image.height}
          alt={product.image.alt}
          decoding="async"
          draggable="false"
        />
      </div>

      <section class="gear-product-info" aria-labelledby="gear-product-title">
        <h1 id="gear-product-title">{product.title}</h1>
        <p class="gear-product-price">{product.priceLabel}</p>
        <p class="gear-product-spec">{product.specification}</p>
        <p>{product.description}</p>
        {product.optionNote && <p class="gear-product-option">{product.optionNote}</p>}
        {product.detailPricing?.map((line) => <p class="gear-product-option">{line}</p>)}
        {product.detailCustomizationNote && <p class="gear-product-option">{product.detailCustomizationNote}</p>}

        <div class="gear-product-action-row">
          <ShareControls title={product.title} url={canonical} />
          <a
            class="button gear-product-button"
            href={product.storeUrl}
            data-store-item-type="gear"
            data-store-item-slug={product.slug}
          >
            View in Store
          </a>
        </div>
        <p class="gear-product-fulfillment">
          {product.detailFulfillmentNote ?? 'Current product options, checkout, payment, production, fulfillment, shipping, customer service, and returns are handled through the Red River Gorge Hiker Store, powered by Pixels.'}
        </p>
      </section>
    </div>
  </div>
</Base>
