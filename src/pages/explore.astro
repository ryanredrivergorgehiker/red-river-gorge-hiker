---
import Base from '../layouts/Base.astro';
import { exploreSections } from '../data/explore';
const base = import.meta.env.BASE_URL;
const hrefFor = (href: string) => href.startsWith('/') ? `${base}${href.slice(1)}` : href;
---
<Base
  title="Explore the Red River Gorge"
  description="Stories, search-and-rescue resources, camping guidance, landform references, trails, maps, current conditions and hiking safety for Kentucky’s Red River Gorge."
>
  <div class="page explore-page">
    <header class="explore-intro">
      <p class="eyebrow">Explore the Gorge</p>
      <h1>Useful paths into the Red River Gorge</h1>
      <p class="lede">Red River Gorge Hiker brings together original stories and practical starting points for planning, learning, and exploring. Rules, closures, weather, roads, rescue information, and land-management guidance remain governed by the linked authoritative sources.</p>
    </header>
    <div class="explore-grid">
      {exploreSections.map((section) => (
        <section class="explore-card" id={section.slug}>
          <p class="eyebrow">{section.title}</p>
          <h2>{section.title}</h2>
          <p>{section.description}</p>
          <ul>
            {section.links.map((link) => (
              <li>
                <a href={hrefFor(link.href)} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined} download={link.download ? true : undefined}>
                  {link.label}{link.external ? ' ↗' : ''}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <aside class="explore-context">
      <h2>Take the Gorge with you</h2>
      <p>Explore photography and gear inspired by the same places, or see how Red River Gorge Hiker supports Wolfe County Search &amp; Rescue.</p>
      <div class="actions">
        <a class="button" href={`${base}photography/`}>Browse photography</a>
        <a class="button secondary" href={`${base}gear/`}>Browse Gear</a>
        <a class="text-link" href={`${base}search-and-rescue/`}>Search &amp; Rescue →</a>
      </div>
    </aside>
  </div>
</Base>
<style>
  .explore-intro { max-width: 72rem; margin-bottom: 2rem; }
  .explore-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.3rem; }
  .explore-card { border:1px solid var(--line); border-top:3px solid var(--sandstone); padding:1.35rem; background:rgba(255,255,255,.28); }
  .explore-card .eyebrow { margin-bottom:.35rem; }
  .explore-card h2 { margin-bottom:.55rem; }
  .explore-card ul { margin:1rem 0 0; padding-left:1.15rem; }
  .explore-card li { margin:.35rem 0; }
  .explore-card a { font-weight:650; }
  .explore-context { margin-top:2.25rem; padding:1.4rem; border-left:3px solid var(--sunrise); background:rgba(255,255,255,.35); }
  @media(max-width:700px){ .explore-grid{grid-template-columns:1fr;} }
</style>
