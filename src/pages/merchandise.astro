---
import Base from '../layouts/Base.astro';
import { merchandiseProducts } from '../data/merchandise';
import '../styles/merchandise.css';

const base = import.meta.env.BASE_URL;
---
<Base
  title="Red River Gorge Hiker Merchandise"
  description="Red River Gorge Hiker logo merchandise inspired by Kentucky’s Red River Gorge and Clifty Wilderness, produced and fulfilled through Fine Art America."
>
  <div class="page merchandise-page">
    <header class="merch-hero">
      <p class="eyebrow">Red River Gorge Hiker goods</p>
      <h1>Merchandise</h1>
      <p class="lede merch-intro">
        Red River Gorge Hiker logo merchandise inspired by Kentucky’s Red River Gorge and Clifty Wilderness.
      </p>
      <p class="merch-fulfillment">
        Orders are produced and fulfilled through Fine Art America, which handles product options, checkout, payment, production, shipping, and returns.
      </p>
    </header>

    <section class="merchandise-catalog" aria-labelledby="merchandise-catalog-heading">
      <h2 id="merchandise-catalog-heading" class="sr-only">Available merchandise</h2>
      <div class="merch-grid">
        {merchandiseProducts.map((product, index) => (
          <article class="merch-card" data-product={product.slug}>
            <button
              class="merch-image-button"
              type="button"
              data-merch-lightbox-trigger
              data-image-src={`${base}${product.image.avif}`}
              data-image-alt={product.image.alt}
              data-product-title={product.title}
              data-product-url={product.fineArtAmericaUrl}
              aria-label={`View a larger image of ${product.title}`}
            >
              <div class="merch-image-stage">
                <img
                  src={`${base}${product.image.avif}`}
                  width={product.image.width}
                  height={product.image.height}
                  alt={product.image.alt}
                  loading={index < 3 ? 'eager' : 'lazy'}
                  decoding="async"
                  draggable="false"
                />
                <span class="merch-enlarge-hint" aria-hidden="true">View larger</span>
              </div>
            </button>

            <div class="merch-card-body">
              <div class="merch-card-heading">
                <h2>{product.title}</h2>
                <p class="merch-price">{product.priceLabel}</p>
              </div>
              <p class="merch-spec">{product.specification}</p>
              {product.optionNote && <p class="merch-option">{product.optionNote}</p>}
              <a
                class="button merch-button"
                href={product.fineArtAmericaUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                View on Fine Art America
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="merch-ordering" aria-labelledby="merch-ordering-heading">
      <h2 id="merch-ordering-heading">Ordering</h2>
      <p>
        RedRiverGorgeHiker.com presents the collection and sends you to the corresponding Fine Art America product page. Fine Art America controls current product options, availability, checkout, payment, production, fulfillment, shipping, and returns.
      </p>
    </section>
  </div>

  <dialog class="merch-lightbox" id="merch-lightbox" aria-labelledby="merch-lightbox-title">
    <div class="merch-lightbox-shell">
      <header class="merch-lightbox-header">
        <h2 id="merch-lightbox-title">Merchandise</h2>
        <button class="merch-lightbox-close" type="button" aria-label="Close enlarged merchandise image">
          <span aria-hidden="true">×</span>
        </button>
      </header>
      <div class="merch-lightbox-media">
        <img id="merch-lightbox-image" src="" alt="" draggable="false" />
      </div>
      <div class="merch-lightbox-action">
        <a
          id="merch-lightbox-link"
          class="button"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
        >
          View on Fine Art America
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>
    </div>
  </dialog>

  <script>
    const dialog = document.querySelector<HTMLDialogElement>('#merch-lightbox');
    const dialogImage = document.querySelector<HTMLImageElement>('#merch-lightbox-image');
    const dialogTitle = document.querySelector<HTMLElement>('#merch-lightbox-title');
    const dialogLink = document.querySelector<HTMLAnchorElement>('#merch-lightbox-link');
    const closeButton = document.querySelector<HTMLButtonElement>('.merch-lightbox-close');

    document.querySelectorAll<HTMLButtonElement>('[data-merch-lightbox-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        if (!dialog || !dialogImage || !dialogTitle || !dialogLink) return;

        const imageSrc = trigger.dataset.imageSrc;
        const imageAlt = trigger.dataset.imageAlt;
        const productTitle = trigger.dataset.productTitle;
        const productUrl = trigger.dataset.productUrl;

        if (!imageSrc || !imageAlt || !productTitle || !productUrl) return;

        dialogImage.src = imageSrc;
        dialogImage.alt = imageAlt;
        dialogTitle.textContent = productTitle;
        dialogLink.href = productUrl;
        dialog.showModal();
      });
    });

    closeButton?.addEventListener('click', () => dialog?.close());

    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog?.addEventListener('close', () => {
      if (dialogImage) {
        dialogImage.removeAttribute('src');
        dialogImage.alt = '';
      }
      if (dialogLink) dialogLink.href = '#';
    });
  </script>
</Base>
