---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import ShareControls from '../components/ShareControls.astro';
import { photographs } from '../data/products';

const base = import.meta.env.BASE_URL;
const siteOrigin = Astro.site ?? Astro.url.origin;
---
<Base
  title="Prints from the Red River Gorge"
  description="Wall-art options for six Red River Gorge photographs by Ryan D. Lewis, fulfilled by Fine Art America."
>
  <div class="page catalog-page">
    <h1>Prints</h1>
    <div class="prose-wide">
      <p class="lede">All six photographs are available in selected wall-art formats through Fine Art America.</p>
      <div class="notice">
        <strong>Ordering:</strong> Fine Art America shows available sizes and formats, processes payment, produces the order, and handles shipping.
      </div>
    </div>

    <div class="grid collection-mosaic product-mosaic">
      {photographs.map((photo, index) => {
        const artworkShareUrl = new URL(`${base}photographs/${photo.slug}/`, siteOrigin).href;
        return (
          <article class="product-card print-product-card">
            <Card photo={photo} showDescription={false} featured={index === 0} />
            <div class="print-action-row">
              <ShareControls title={photo.title} url={artworkShareUrl} />
              <a class="button print-faa-button" href={photo.wallArtUrl} target="_blank" rel="noopener noreferrer">
                View on Fine Art America
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <section class="section prose-wide">
      <h2>Jigsaw Puzzles</h2>
      <p>Three photographs are also available as 500-piece puzzles.</p>
      <a href={`${base}puzzles/`}>View puzzles</a>
    </section>
  </div>

  <style is:global>
    .print-product-card {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }
    .print-action-row {
      display: flex;
      align-items: stretch;
      gap: .55rem;
      margin-top: .85rem;
    }
    .print-action-row .share-controls {
      flex: 0 0 auto;
      margin: 0;
      padding: 0 .55rem;
    }
    .print-action-row .share-controls button,
    .print-action-row .print-faa-button {
      min-height: 3.15rem;
    }
    .print-action-row .share-controls button { height: 100%; }
    .print-action-row .print-faa-button {
      display: inline-flex;
      flex: 1 1 auto;
      align-items: center;
      justify-content: center;
      margin: 0;
      text-align: center;
    }
    @media (min-width: 761px) {
      .print-product-card:first-child .print-action-row {
        width: min(100%, 40rem);
      }
    }
    @media (max-width: 420px) {
      .print-action-row { gap: .45rem; }
      .print-action-row .share-controls { padding-inline: .45rem; }
      .print-action-row .print-faa-button { padding-inline: .7rem; }
    }
  </style>
</Base>
