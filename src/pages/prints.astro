---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { photographs } from '../data/products';

const base = import.meta.env.BASE_URL;
---
<Base
  title="Prints from the Red River Gorge"
  description="Wall-art options for the six Red River Gorge Hiker launch photographs, fulfilled by Fine Art America."
>
  <div class="page">
    <p class="eyebrow">Fine-art prints</p>
    <h1>Prints from the Red River Gorge</h1>
    <div class="prose-wide">
      <p class="lede">All six photographs in the launch collection are available in selected wall-art formats through Fine Art America.</p>
      <div class="notice">
        <strong>Ordering:</strong> Fine Art America shows the available sizes and formats, processes payment, produces the order, and handles shipping.
      </div>
    </div>

    <div class="grid collection-grid">
      {photographs.map((photo) => (
        <article class="product-card">
          <Card photo={photo} />
          <a class="button" href={photo.wallArtUrl} target="_blank" rel="noopener noreferrer">
            View print options
            <span class="sr-only"> on Fine Art America (opens in a new tab)</span>
          </a>
        </article>
      ))}
    </div>

    <section class="section prose-wide">
      <h2>Selected photographs are also available as puzzles</h2>
      <p>Three photographs are offered as 500-piece puzzles.</p>
      <a href={`${base}puzzles/`}>View the puzzles</a>
    </section>
  </div>
</Base>
