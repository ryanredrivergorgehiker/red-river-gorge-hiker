---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { photographs } from '../data/products';
---
<Base
  title="Photography"
  description="Selected photography from Kentucky’s Red River Gorge, Clifty Wilderness, and surrounding wild country."
>
  <div class="page catalog-page">
    <h1>Photography</h1>
    <div class="prose-wide">
      <p class="lede">Selected photography from Kentucky’s Red River Gorge, Clifty Wilderness, and surrounding wild country.</p>
      <p>Open any work to see its story, capture details, and available wall-art or puzzle options.</p>
    </div>
    <div class="grid collection-mosaic">
      {photographs.map((photo, index) => <Card photo={photo} featured={index === 0} />)}
    </div>
  </div>
</Base>

<style>
  .catalog-page .prose-wide p:last-child { margin-bottom: 0; }
  .catalog-page .collection-mosaic { margin-top: 1.25rem; }
  :global(.catalog-page .card .artwork) { margin-bottom: .55rem; }
  :global(.catalog-page .card h3) { margin-bottom: .3rem; }
</style>
