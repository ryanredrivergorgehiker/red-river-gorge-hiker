---
import Base from '../layouts/Base.astro';
import ShareControls from '../components/ShareControls.astro';
import { gearProducts } from '../data/gearCatalog';
import '../styles/merchandise.css';
import '../styles/gear-sharing.css';

const base = import.meta.env.BASE_URL;
const siteOrigin = Astro.site ?? Astro.url.origin;
const featuredProduct = gearProducts[0]!;
const featuredProductShareUrl = new URL(`${base}gear/${featuredProduct.slug}/`, siteOrigin).href;
---
<Base
  title="Red River Gorge Hiker Gear"
  description="Curated Red River Gorge Hiker gear inspired by Kentucky’s Red River Gorge and Clifty Wilderness, available in the Red River Gorge Hiker Store."
  socialImagePath={featuredProduct.image.avif}
  socialImageType="image/avif"
  socialImageAlt={featuredProduct.image.alt}
>
  <div class="page merchandise-page">
    <header class="merch-hero">
      <h1>Gear</h1>
    </header>

    <section class="merchandise-catalog" aria-labelledby="gear-catalog-heading">
      <h2 id="gear-catalog-heading" class="sr-only">Available gear</h2>
      <div class="merch-grid">
        {gearProducts.map((product, index) => {
          const productShareUrl = new URL(`${base}gear/${product.slug}/`, siteOrigin).href;
          return (
            <article class="merch-card" data-product={product.slug}>
              <button
                class="merch-image-button"
                type="button"
                data-merch-lightbox-trigger
                data-image-src={`${base}${product.image.avif}`}
                data-image-alt={product.image.alt}
                data-product-title={product.title}
                data-product-slug={product.slug}
                data-product-url={product.storeUrl}
                data-product-share-url={productShareUrl}
                aria-label={`View a larger image of ${product.title}`}
              >
                <div class="merch-image-stage">
                  <img
                    src={`${base}${product.image.avif}`}
                    width={product.image.width}
                    height={product.image.height}
                    alt={product.image.alt}
                    loading={index < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                    draggable="false"
                  />
                  <span class="merch-enlarge-hint" aria-hidden="true">View larger</span>
                </div>
              </button>

              <div class="merch-card-body">
                <div class="merch-card-heading">
                  <h2><a href={`${base}gear/${product.slug}/`}>{product.title}</a></h2>
                  <p class="merch-price">{product.priceLabel}</p>
                </div>
                <p class="merch-spec">{product.storefrontSubtitle}</p>
                {product.storefrontNote && <p class="merch-option">{product.storefrontNote}</p>}
                <div class="merch-card-actions">
                  <ShareControls title={product.title} url={productShareUrl} />
                  <a
                    class="button merch-button"
                    href={product.storeUrl}
                    data-store-item-type="gear"
                    data-store-item-slug={product.slug}
                  >
                    View in Store
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="merch-ordering" aria-labelledby="gear-ordering-heading">
      <h2 id="gear-ordering-heading">Ordering</h2>
      <p class="merch-fulfillment">
        Current product options, checkout, payment, production, fulfillment, shipping, customer service, and returns are handled through the Red River Gorge Hiker Store, powered by Pixels.
      </p>

      <div class="notice merch-pricing-notice" role="note">
        <strong>Pricing Notice:</strong> Prices shown on RedRiverGorgeHiker.com are provided for reference and may change. The product configuration and final price displayed in the Red River Gorge Hiker Store at the time of purchase control the transaction.
      </div>
    </section>
  </div>

  <dialog class="merch-lightbox" id="merch-lightbox" aria-labelledby="merch-lightbox-title">
    <div class="merch-lightbox-shell">
      <header class="merch-lightbox-header">
        <h2 id="merch-lightbox-title">Gear</h2>
        <button class="merch-lightbox-close" type="button" aria-label="Close enlarged gear image">
          <span aria-hidden="true">×</span>
        </button>
      </header>
      <div class="merch-lightbox-media">
        <img id="merch-lightbox-image" src="" alt="" draggable="false" />
      </div>
      <div class="merch-lightbox-action">
        <ShareControls title={featuredProduct.title} url={featuredProductShareUrl} />
        <a
          id="merch-lightbox-link"
          class="button"
          href="#"
          data-store-item-type="gear"
        >
          View in Store
        </a>
      </div>
    </div>
  </dialog>

  <script>
    const dialog = document.querySelector<HTMLDialogElement>('#merch-lightbox');
    const dialogImage = document.querySelector<HTMLImageElement>('#merch-lightbox-image');
    const dialogTitle = document.querySelector<HTMLElement>('#merch-lightbox-title');
    const dialogLink = document.querySelector<HTMLAnchorElement>('#merch-lightbox-link');
    const dialogShareControls = dialog?.querySelector<HTMLElement>('[data-share-controls]');
    const closeButton = document.querySelector<HTMLButtonElement>('.merch-lightbox-close');

    document.querySelectorAll<HTMLButtonElement>('[data-merch-lightbox-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        if (!dialog || !dialogImage || !dialogTitle || !dialogLink || !dialogShareControls) return;

        const imageSrc = trigger.dataset.imageSrc;
        const imageAlt = trigger.dataset.imageAlt;
        const productTitle = trigger.dataset.productTitle;
        const productSlug = trigger.dataset.productSlug;
        const productUrl = trigger.dataset.productUrl;
        const productShareUrl = trigger.dataset.productShareUrl;

        if (!imageSrc || !imageAlt || !productTitle || !productSlug || !productUrl || !productShareUrl) return;

        dialogImage.src = imageSrc;
        dialogImage.alt = imageAlt;
        dialogTitle.textContent = productTitle;
        dialogLink.href = productUrl;
        dialogLink.dataset.storeItemSlug = productSlug;
        dialogShareControls.dataset.shareTitle = productTitle;
        dialogShareControls.dataset.shareUrl = productShareUrl;
        dialog.showModal();
      });
    });

    closeButton?.addEventListener('click', () => dialog?.close());

    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog?.addEventListener('close', () => {
      if (dialogImage) {
        dialogImage.removeAttribute('src');
        dialogImage.alt = '';
      }
      if (dialogLink) dialogLink.href = '#';
    });
  </script>
</Base>
