---
import Base from '../layouts/Base.astro';
import ShareControls from '../components/ShareControls.astro';
import { photographs } from '../data/products';

const base = import.meta.env.BASE_URL;
const siteOrigin = Astro.site ?? Astro.url.origin;
const puzzles = photographs.filter((photo) => photo.puzzleAvailable);
const puzzleImages = {
  'winter-at-red-byrd-arch': {
    src: 'assets/puzzles/overview/winter-at-red-byrd-arch-puzzle-overview.webp',
    width: 1200,
    height: 900,
    alt: '500-piece jigsaw puzzle showing Winter at Red-byrd Arch with the photographed ice formation and Red River Gorge Hiker artist mark.'
  },
  'sunrise-at-eagles-nest': {
    src: 'assets/puzzles/overview/sunrise-at-eagles-nest-puzzle-overview.webp',
    width: 1200,
    height: 900,
    alt: '500-piece jigsaw puzzle showing Sunrise at Eagle’s Nest with a vivid winter sunrise and Red River Gorge Hiker artist mark.'
  },
  'ice-at-west-of-copperas-pillar': {
    src: 'assets/puzzles/overview/ice-at-west-of-copperas-pillar-puzzle-overview.webp',
    width: 1200,
    height: 900,
    alt: '500-piece jigsaw puzzle showing Ice at West of Copperas Pillar with long icicles and the Red River Gorge Hiker artist mark.'
  }
} as const;
---
<Base
  title="Red River Gorge Jigsaw Puzzles"
  description="Three Red River Gorge photographs offered as 500-piece jigsaw puzzles through Fine Art America."
>
  <div class="page catalog-page">
    <h1>Jigsaw Puzzles</h1>
    <div class="prose-wide">
      <p class="lede">Three photographs are available as 500-piece puzzles through Fine Art America.</p>
      <div class="notice">
        <strong>Each puzzle:</strong> 18 × 24 inches · 500 pieces · horizontal · $59.99 before shipping and tax.
      </div>
    </div>

    <div class="grid puzzle-grid">
      {puzzles.map((photo) => {
        const puzzleDetailPath = `${base}puzzles/${photo.slug}/`;
        const puzzleShareUrl = new URL(puzzleDetailPath, siteOrigin).href;
        const puzzleImage = puzzleImages[photo.slug as keyof typeof puzzleImages];
        return (
          <article class="product-card puzzle-product-card">
            <a
              class="puzzle-product-image"
              href={puzzleDetailPath}
              aria-label={`View ${photo.title} puzzle details`}
            >
              <img
                src={`${base}${puzzleImage.src}`}
                width={puzzleImage.width}
                height={puzzleImage.height}
                alt={puzzleImage.alt}
                loading="lazy"
                decoding="async"
              />
            </a>
            <h3><a href={puzzleDetailPath}>{photo.title}</a></h3>
            <p class="puzzle-spec">18 × 24 inches · 500 pieces</p>
            <div class="puzzle-action-row">
              <ShareControls title={`${photo.title} jigsaw puzzle`} url={puzzleShareUrl} />
              <a class="button puzzle-primary-action" href={photo.puzzleUrl} target="_blank" rel="noopener noreferrer">
                View puzzle
                <span class="sr-only"> on Fine Art America (opens in a new tab)</span>
              </a>
              <a class="button secondary puzzle-print-action" href={photo.wallArtUrl} target="_blank" rel="noopener noreferrer">
                Print options
                <span class="sr-only"> on Fine Art America (opens in a new tab)</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <style is:global>
    .puzzle-grid { align-items: stretch; }
    .puzzle-product-card {
      display: flex;
      flex-direction: column;
      min-width: 0;
      height: 100%;
    }
    .puzzle-product-image {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      margin-bottom: .85rem;
    }
    .puzzle-product-image img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 50%;
    }
    .puzzle-product-card h3 { margin-bottom: .35rem; }
    .puzzle-product-card h3 a { color: inherit; text-decoration: none; }
    .puzzle-product-card h3 a:hover { text-decoration: underline; }
    .puzzle-product-card .puzzle-spec { margin: 0 0 .85rem; }
    .puzzle-action-row {
      display: flex;
      align-items: stretch;
      gap: .5rem;
      margin-top: auto;
    }
    .puzzle-action-row .share-controls {
      flex: 0 0 auto;
      margin: 0;
      padding: 0 .5rem;
    }
    .puzzle-action-row .share-controls button,
    .puzzle-action-row .button {
      min-height: 3.15rem;
    }
    .puzzle-action-row .share-controls button { height: 100%; }
    .puzzle-action-row .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin: 0;
      text-align: center;
      white-space: nowrap;
    }
    .puzzle-action-row .puzzle-primary-action {
      flex: 1 1 auto;
      padding-inline: .8rem;
    }
    .puzzle-action-row .puzzle-print-action {
      flex: 0 0 auto;
      padding-inline: .75rem;
    }
    @media (max-width: 430px) {
      .puzzle-action-row { gap: .38rem; }
      .puzzle-action-row .share-controls { padding-inline: .38rem; }
      .puzzle-action-row .puzzle-primary-action { padding-inline: .55rem; }
      .puzzle-action-row .puzzle-print-action { padding-inline: .5rem; }
      .puzzle-action-row .button { font-size: .86rem; }
    }
  </style>
</Base>