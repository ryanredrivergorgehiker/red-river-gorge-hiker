---
import Base from '../layouts/Base.astro';
import ShareControls from '../components/ShareControls.astro';
import { photographs } from '../data/products';

const base = import.meta.env.BASE_URL;
const siteOrigin = Astro.site ?? Astro.url.origin;
const puzzles = photographs.filter((photo) => photo.puzzleAvailable);
const puzzleImages = {
  'winter-at-red-byrd-arch': {
    src: 'assets/puzzles/winter-at-red-byrd-arch-puzzle.avif',
    width: 1200,
    height: 800,
    alt: '500-piece jigsaw puzzle showing Winter at Red-byrd Arch with the photographed ice formation and Red River Gorge Hiker artist mark.'
  },
  'sunrise-at-eagles-nest': {
    src: 'assets/puzzles/sunrise-at-eagles-nest-puzzle.avif',
    width: 1200,
    height: 800,
    alt: '500-piece jigsaw puzzle showing Sunrise at Eagle’s Nest with a vivid winter sunrise and Red River Gorge Hiker artist mark.'
  },
  'ice-at-west-of-copperas-pillar': {
    src: 'assets/puzzles/ice-at-west-of-copperas-pillar-puzzle.avif',
    width: 1200,
    height: 1200,
    alt: '500-piece jigsaw puzzle showing Ice at West of Copperas Pillar with long icicles and the Red River Gorge Hiker artist mark.'
  }
} as const;
---
<Base
  title="Red River Gorge Jigsaw Puzzles"
  description="Three Red River Gorge photographs offered as 500-piece jigsaw puzzles through Fine Art America."
>
  <div class="page catalog-page">
    <h1>Jigsaw Puzzles</h1>
    <div class="prose-wide">
      <p class="lede">Three photographs are available as 500-piece puzzles through Fine Art America.</p>
      <div class="notice">
        <strong>Each puzzle:</strong> 18 × 24 inches · 500 pieces · horizontal · $59.99 before shipping and tax.
      </div>
    </div>

    <div class="grid puzzle-grid">
      {puzzles.map((photo) => {
        const artworkShareUrl = new URL(`${base}photographs/${photo.slug}/`, siteOrigin).href;
        const puzzleImage = puzzleImages[photo.slug as keyof typeof puzzleImages];
        return (
          <article class="product-card puzzle-product-card">
            <a class="puzzle-product-image" href={`${base}photographs/${photo.slug}/`} aria-label={`View the story behind ${photo.title}`}>
              <img
                src={`${base}${puzzleImage.src}`}
                width={puzzleImage.width}
                height={puzzleImage.height}
                alt={puzzleImage.alt}
                loading="lazy"
                decoding="async"
              />
            </a>
            <h3><a href={`${base}photographs/${photo.slug}/`}>{photo.title}</a></h3>
            <p class="puzzle-spec">18 × 24 inches · 500 pieces</p>
            <ShareControls title={photo.title} url={artworkShareUrl} />
            <p class="actions">
              <a class="button" href={photo.puzzleUrl} target="_blank" rel="noopener noreferrer">
                View puzzle
                <span class="sr-only"> on Fine Art America (opens in a new tab)</span>
              </a>
              <a class="text-link" href={photo.wallArtUrl} target="_blank" rel="noopener noreferrer">
                Print options
                <span class="sr-only"> on Fine Art America (opens in a new tab)</span>
              </a>
            </p>
          </article>
        );
      })}
    </div>
  </div>

  <style>
    .puzzle-product-image {
      aspect-ratio: 3 / 2;
      display: grid;
      place-items: center;
      overflow: hidden;
      margin-bottom: .85rem;
      border: 1px solid var(--line);
      background: rgba(255,255,255,.3);
    }
    .puzzle-product-image img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .puzzle-product-card h3 { margin-bottom: .35rem; }
    .puzzle-product-card h3 a { color: inherit; text-decoration: none; }
    .puzzle-product-card h3 a:hover { text-decoration: underline; }
  </style>
</Base>
