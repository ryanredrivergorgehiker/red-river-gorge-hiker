---
import Base from '../layouts/Base.astro';

const pixelsCartUrl = 'https://fineartamerica.com/widgetshoppingcart/shoppingcart.html?memberidtype=artistid&memberid=1618459&domainid=0&showheader=0&flagwidget=true&widgettype=standard&height=6000';
---

<Base
  title="Cart"
  description="Review your Red River Gorge Hiker cart and continue to checkout through the Red River Gorge Hiker Store."
>
  <article class="page cart-page">
    <header class="cart-page-intro">
      <div>
        <p class="eyebrow">Red River Gorge Hiker Store</p>
        <h1>Your Cart</h1>
        <p class="lede">Review what you’ve selected and continue to checkout through our Pixels fulfillment partner.</p>
      </div>
      <a class="button secondary cart-continue-shopping" href="https://store.redrivergorgehiker.com/">Continue shopping</a>
    </header>

    <section class="cart-widget-shell" aria-label="Shopping cart">
      <script is:inline type="text/javascript" src="https://fineartamerica.com/widgetshoppingcart/widgetscripts.php"></script>
      <iframe
        id="pixelsshoppingcartiframe"
        title="Red River Gorge Hiker shopping cart"
        src={pixelsCartUrl}
        style="display: inline-block; width: 100%; height: 820px; border: none; overflow: hidden;"
      ></iframe>
    </section>

    <p class="cart-widget-note">
      Cart, payment, production, fulfillment, and shipping are provided through the Red River Gorge Hiker Store on Pixels.
    </p>
  </article>
</Base>

<style>
  .cart-page {
    padding-top: 2.25rem;
  }

  .cart-page-intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-bottom: 1.5rem;
  }

  .cart-page-intro .eyebrow {
    margin-bottom: .55rem;
  }

  .cart-page-intro h1 {
    margin-bottom: .7rem;
  }

  .cart-page-intro .lede {
    margin-bottom: 0;
    max-width: 54rem;
  }

  .cart-continue-shopping {
    flex: 0 0 auto;
    margin-bottom: .2rem;
  }

  .cart-widget-shell {
    overflow: hidden;
    width: 100%;
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: 0 .45rem 1.3rem rgba(23, 55, 45, .08);
  }

  .cart-widget-shell iframe {
    display: block !important;
    width: 100% !important;
    max-width: 100%;
    min-height: 680px;
    background: #fff;
  }

  .cart-widget-note {
    margin: .85rem 0 0;
    color: var(--muted);
    font-size: .82rem;
    line-height: 1.5;
  }

  @media (max-width: 700px) {
    .cart-page {
      width: min(100% - 1rem, var(--content));
      padding-top: 1.5rem;
    }

    .cart-page-intro {
      display: grid;
      align-items: start;
      gap: 1rem;
      margin-bottom: 1.1rem;
    }

    .cart-continue-shopping {
      justify-self: start;
      margin: 0;
    }

    .cart-widget-shell {
      margin-inline: 0;
    }

    .cart-widget-shell iframe {
      min-height: 620px;
    }

    .cart-widget-note {
      padding-inline: .15rem;
    }
  }
</style>
