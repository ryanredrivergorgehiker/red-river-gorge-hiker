---
import Base from '../layouts/Base.astro';

// Exact Pixels Pro Stand Alone Shopping Cart embed destination supplied by Ryan on 2026-09-02.
const pixelsCartWidgetUrl = 'https://fineartamerica.com/widgetshoppingcart/artwork.html?memberidtype=artistid&memberid=1618459&domainid=0&showheader=0&height=600&autoheight=true';
---

<Base
  title="Cart"
  description="Review your Red River Gorge Hiker shopping selections and continue through the Red River Gorge Hiker Store on Pixels."
>
  <article class="page cart-page">
    <header class="cart-page-intro">
      <div>
        <p class="eyebrow">Red River Gorge Hiker Store</p>
        <h1>Cart &amp; Store</h1>
        <p class="lede">Your Pixels shopping experience is embedded here so you can return to Red River Gorge Hiker without losing the path back to your cart.</p>
      </div>
      <a class="button secondary cart-continue-shopping" href="https://store.redrivergorgehiker.com/">Open Store</a>
    </header>

    <section class="cart-widget-shell" aria-label="Red River Gorge Hiker Store shopping cart">
      <script is:inline type="text/javascript" src="https://fineartamerica.com/widgetshoppingcart/widgetscripts.php"></script>
      <iframe
        id="pixelsshoppingcartiframe"
        title="Red River Gorge Hiker Store and shopping cart"
        src={pixelsCartWidgetUrl}
        style="display: inline-block; width: 100%; height: 820px; border: none; overflow: hidden;"
      ></iframe>
    </section>

    <p class="cart-widget-note">
      Product selection, cart, checkout, payment, production, fulfillment, shipping, customer service, and returns are provided through Pixels / Fine Art America.
    </p>
  </article>
</Base>

<style>
  .cart-page {
    padding-top: 1.5rem;
    padding-bottom: 3rem;
  }

  .cart-page-intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-bottom: 1.25rem;
  }

  .cart-page-intro .eyebrow {
    margin-bottom: .4rem;
  }

  .cart-page-intro h1 {
    margin-bottom: .55rem;
  }

  .cart-page-intro .lede {
    margin-bottom: 0;
    max-width: 58rem;
  }

  .cart-continue-shopping {
    flex: 0 0 auto;
    margin-bottom: .15rem;
  }

  .cart-widget-shell {
    overflow: hidden;
    width: 100%;
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: 0 .45rem 1.3rem rgba(23, 55, 45, .08);
  }

  .cart-widget-shell iframe {
    display: block !important;
    width: 100% !important;
    max-width: 100%;
    min-height: 680px;
    background: #fff;
  }

  .cart-widget-note {
    margin: .8rem 0 0;
    color: var(--muted);
    font-size: .82rem;
    line-height: 1.5;
  }

  @media (max-width: 700px) {
    .cart-page {
      width: min(100% - 1rem, var(--content));
      padding-top: 1rem;
      padding-bottom: 2.5rem;
    }

    .cart-page-intro {
      display: grid;
      align-items: start;
      gap: .85rem;
      margin-bottom: 1rem;
    }

    .cart-page-intro .lede {
      font-size: 1rem;
      line-height: 1.45;
    }

    .cart-continue-shopping {
      justify-self: start;
      margin: 0;
    }

    .cart-widget-shell {
      margin-inline: 0;
    }

    .cart-widget-shell iframe {
      min-height: 620px;
    }

    .cart-widget-note {
      padding-inline: .1rem;
      font-size: .78rem;
    }
  }
</style>
