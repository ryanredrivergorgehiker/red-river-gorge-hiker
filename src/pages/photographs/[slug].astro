---
import Base from '../../layouts/Base.astro';
import Artwork from '../../components/Artwork.astro';
import ShareControls from '../../components/ShareControls.astro';
import { photographs, type Photograph } from '../../data/products';

export function getStaticPaths() {
  return photographs.map((photo, index) => ({
    params: { slug: photo.slug },
    props: { photo, index }
  }));
}

interface Props {
  photo: Photograph;
  index: number;
}

const { photo, index } = Astro.props;
const base = import.meta.env.BASE_URL;
const prev = photographs[(index - 1 + photographs.length) % photographs.length]!;
const next = photographs[(index + 1) % photographs.length]!;
const orientationClass = photo.orientation.toLowerCase();
const imageSizes = photo.orientation === 'Panorama'
  ? '(max-width: 1180px) calc(100vw - 3rem), 1180px'
  : photo.orientation === 'Portrait'
    ? '(max-width: 700px) calc(100vw - 2rem), 720px'
    : photo.orientation === 'Square'
      ? '(max-width: 700px) calc(100vw - 2rem), 860px'
      : '(max-width: 700px) calc(100vw - 2rem), 1040px';
const socialImage = photo.sourceFilename.replace('-WEB-WM.webp', '-SOCIAL-WM.jpg');
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;

const splatterReference = photo.slug === 'splatter-falls'
  ? {
      label: 'Splatter Falls',
      url: 'https://kywaterfalls.com/cumberland-plateau/splatter-falls'
    }
  : null;

const splatterStoryParts = splatterReference
  ? photo.story.split(splatterReference.label)
  : [];

const artworkSchema = {
  '@context': 'https://schema.org',
  '@type': 'VisualArtwork',
  name: photo.title,
  identifier: photo.catalogId,
  description: photo.shortDescription,
  dateCreated: photo.captureDate,
  creator: { '@type': 'Person', name: 'Ryan D. Lewis' },
  locationCreated: photo.location,
  copyrightHolder: { '@type': 'Person', name: 'Ryan D. Lewis' }
};
---
<Base
  title={photo.title}
  description={photo.shortDescription}
  socialImage={socialImage}
  socialImageAlt={photo.altText}
>
  <div class="page photo-page">
    <h1>{photo.title}</h1>
    <p class="lede">{photo.shortDescription}</p>
    <div class="photo-context-share-row">
      <ShareControls title={photo.title} url={canonical} />
      <div class="photo-top-actions" aria-label="Purchase options">
        <div class="top-wall-art-action">
          <a class="button top-wall-art-trigger" href={photo.wallArtUrl} data-store-item-type="wall_art" data-store-item-slug={photo.slug}>
            Shop Wall Art
          </a>
          <div class="top-wall-art-popover" role="note">
            <div class="top-wall-art-popover-inner">
              <p><strong>Before Ordering:</strong> Please review the selected size, print material, frame, mat, finish, and other options carefully in the Store before checkout. Wall art is made to order, and <strong>return shipping for a non-defective return is generally the buyer’s responsibility and can be significant for larger or framed pieces.</strong> The final configuration and price shown in the Store control the transaction.</p>
              <p class="wall-art-ordering-link"><a class="text-link" href={`${base}shipping-and-returns/`}>See Shipping & Returns →</a></p>
            </div>
          </div>
        </div>
        {photo.puzzleAvailable && photo.puzzleUrl && (
          <a class="button secondary" href={`${base}puzzles/${photo.slug}/`}>
            View this puzzle
          </a>
        )}
      </div>
      <p class="mobile-ordering-reminder" role="note">
        <strong>Before Ordering</strong> · <a class="text-link" href={`${base}shipping-and-returns/`}>Review Shipping & Returns →</a>
      </p>
      <p class="photo-context-line">{photo.contextLine}</p>
    </div>

    <div class:list={['photo-artwork-stage', `photo-artwork-${orientationClass}`]}>
      <a
        class="photo-artwork-link"
        href={photo.wallArtUrl}
        data-store-item-type="wall_art"
        data-store-item-slug={photo.slug}
        aria-label={`Shop wall art for ${photo.title} in the Red River Gorge Hiker Store`}
      >
        <Artwork
          title={photo.title}
          catalogId={photo.catalogId}
          alt={photo.altText}
          sizes={imageSizes}
          showCaption={false}
        />
      </a>
    </div>

    <section class="prose photo-story">
      <h2>The story behind the photograph</h2>
      {splatterReference && splatterStoryParts.length > 1 ? (
        <p>
          {splatterStoryParts[0]}
          <a
            class="reference-link"
            href={splatterReference.url}
            target="_blank"
            rel="noopener noreferrer"
          >{splatterReference.label}</a>
          {splatterStoryParts.slice(1).join(splatterReference.label)}
        </p>
      ) : (
        <p>{photo.story}</p>
      )}
      <dl class="details">
        <div><dt>Photographed</dt><dd>{photo.captureDate}</dd></div>
        <div><dt>Location</dt><dd>{photo.location}</dd></div>
      </dl>
      <p>Photographs © Ryan D. Lewis. All rights reserved.</p>
    </section>

    <aside
      class:list={['purchase-panel', 'photo-purchase-grid', photo.puzzleAvailable && photo.puzzleUrl ? 'has-puzzle' : 'wall-art-only']}
      aria-label="Available products"
    >
      <section>
        <h2>Available as wall art</h2>
        <p>View available sizes and wall-art formats in the Red River Gorge Hiker Store. Store orders are produced and fulfilled by Pixels.</p>
        <div class="notice wall-art-ordering-notice" role="note">
          <p><strong>Before Ordering:</strong> Please review the selected size, print material, frame, mat, finish, and other options carefully in the Store before checkout. Wall art is made to order, and <strong>return shipping for a non-defective return is generally the buyer’s responsibility and can be significant for larger or framed pieces.</strong> The final configuration and price shown in the Store control the transaction.</p>
          <p class="wall-art-ordering-link"><a class="text-link" href={`${base}shipping-and-returns/`}>See Shipping & Returns →</a></p>
        </div>
        <a class="button photo-card-action" href={photo.wallArtUrl} data-store-item-type="wall_art" data-store-item-slug={photo.slug}>
          Shop Wall Art
        </a>
      </section>

      {photo.puzzleAvailable && photo.puzzleUrl && (
        <section class="puzzle-panel">
          <h2>Available as a 500-piece puzzle</h2>
          <p>This photograph is available as an 18 × 24-inch horizontal puzzle with 500 pieces. The current customer price is $59.99 before shipping and tax.</p>
          <a class="button secondary photo-card-action" href={`${base}puzzles/${photo.slug}/`}>
            View this puzzle
          </a>
        </section>
      )}
    </aside>

    <nav class="photo-nav" aria-label="Photograph navigation">
      <a href={`${base}photographs/${prev.slug}/`}>← {prev.title}</a>
      <a href={`${base}photographs/${next.slug}/`}>{next.title} →</a>
    </nav>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(artworkSchema)} />
  </div>
</Base>

<style>
  .photo-story {
    width: 100%;
    max-width: var(--reading);
    margin-top: 2.5rem;
  }

  .photo-context-share-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .5rem;
    position: relative;
    margin-bottom: .4rem;
  }

  .photo-context-share-row :global(.share-controls) {
    order: 1;
    flex: 0 0 auto;
    height: 3rem;
    min-height: 3rem;
    margin: 0;
    padding: 0 .65rem;
  }

  .photo-context-share-row :global(.share-controls button) {
    height: 100%;
    min-height: 0;
    padding: 0;
  }

  .photo-top-actions {
    display: flex;
    order: 2;
    flex: 0 0 auto;
    align-items: center;
    gap: .5rem;
    margin: 0;
  }

  .photo-top-actions .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 3rem;
    margin: 0;
    padding-block: 0;
    white-space: nowrap;
  }

  .mobile-ordering-reminder {
    display: none;
    order: 3;
    flex: 1 0 100%;
    width: 100%;
    margin: 0;
  }

  .photo-context-line {
    order: 4;
    flex: 1 1 20rem;
    min-width: 0;
    margin: 0;
  }

  .top-wall-art-action {
    display: inline-flex;
  }

  .top-wall-art-popover {
    display: none;
    position: absolute;
    z-index: 30;
    top: 100%;
    left: 0;
    width: min(38rem, 100%);
    padding-top: .45rem;
  }

  .top-wall-art-popover-inner {
    border: 1px solid var(--line);
    border-left: 3px solid var(--sunrise);
    background: var(--parchment);
    box-shadow: 0 .6rem 1.4rem rgba(23,55,45,.18);
    padding: 1rem 1.1rem;
  }

  .top-wall-art-popover-inner p:last-child {
    margin-bottom: 0;
  }

  .top-wall-art-action:hover .top-wall-art-popover,
  .top-wall-art-action:focus-within .top-wall-art-popover {
    display: block;
  }

  .photo-purchase-grid {
    display: grid;
    gap: 1.5rem;
    align-items: stretch;
    margin-top: 1.75rem;
  }

  .photo-purchase-grid.has-puzzle {
    grid-template-columns: minmax(0, 1.8fr) minmax(17rem, .8fr);
  }

  .photo-purchase-grid.wall-art-only {
    grid-template-columns: 1fr;
  }

  .photo-purchase-grid > section {
    min-width: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .photo-card-action {
    align-self: flex-start;
    margin-top: 1rem;
  }

  .photo-purchase-grid.has-puzzle .puzzle-panel .photo-card-action {
    margin-top: auto;
  }

  .wall-art-ordering-notice p:last-child {
    margin-bottom: 0;
  }

  .wall-art-ordering-link {
    margin-top: .75rem;
  }

  @media (max-width: 800px) {
    .photo-context-share-row {
      align-items: center;
    }

    .photo-top-actions {
      gap: .4rem;
    }

    .photo-top-actions .button {
      padding-inline: .7rem;
      font-size: .9rem;
    }

    .photo-context-share-row :global(.share-controls) {
      padding-inline: .5rem;
    }

    .mobile-ordering-reminder {
      display: block;
      margin-top: .05rem;
      font-size: .78rem;
      line-height: 1.25;
    }

    .mobile-ordering-reminder strong {
      font-weight: 700;
    }

    .mobile-ordering-reminder a {
      font-weight: 650;
      text-decoration: underline;
      text-underline-offset: .13em;
    }

    .photo-context-line {
      flex: 1 0 100%;
      width: 100%;
      margin-top: .05rem;
    }

    .top-wall-art-action:hover .top-wall-art-popover,
    .top-wall-art-action:focus-within .top-wall-art-popover {
      display: none;
    }

    .photo-purchase-grid,
    .photo-purchase-grid.has-puzzle,
    .photo-purchase-grid.wall-art-only {
      grid-template-columns: 1fr;
    }

    .photo-purchase-grid > section {
      height: auto;
    }

    .photo-purchase-grid.has-puzzle .puzzle-panel .photo-card-action {
      margin-top: 1rem;
    }
  }
</style>
