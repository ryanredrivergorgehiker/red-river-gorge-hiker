---
import Base from '../../layouts/Base.astro';
import Artwork from '../../components/Artwork.astro';
import ShareControls from '../../components/ShareControls.astro';
import { photographs, type Photograph } from '../../data/products';

export function getStaticPaths() {
  return photographs.map((photo, index) => ({
    params: { slug: photo.slug },
    props: { photo, index }
  }));
}

interface Props {
  photo: Photograph;
  index: number;
}

const { photo, index } = Astro.props;
const base = import.meta.env.BASE_URL;
const prev = photographs[(index - 1 + photographs.length) % photographs.length]!;
const next = photographs[(index + 1) % photographs.length]!;
const orientationClass = photo.orientation.toLowerCase();
const imageSizes = photo.orientation === 'Panorama'
  ? '(max-width: 1180px) calc(100vw - 3rem), 1180px'
  : photo.orientation === 'Portrait'
    ? '(max-width: 700px) calc(100vw - 2rem), 720px'
    : photo.orientation === 'Square'
      ? '(max-width: 700px) calc(100vw - 2rem), 860px'
      : '(max-width: 700px) calc(100vw - 2rem), 1040px';
const socialImage = photo.sourceFilename.replace('-WEB-WM.webp', '-SOCIAL-WM.jpg');
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;

const splatterReference = photo.slug === 'splatter-falls'
  ? {
      label: 'Splatter Falls',
      url: 'https://kywaterfalls.com/cumberland-plateau/splatter-falls'
    }
  : null;

const splatterStoryParts = splatterReference
  ? photo.story.split(splatterReference.label)
  : [];

const artworkSchema = {
  '@context': 'https://schema.org',
  '@type': 'VisualArtwork',
  name: photo.title,
  identifier: photo.catalogId,
  description: photo.shortDescription,
  dateCreated: photo.captureDate,
  creator: { '@type': 'Person', name: 'Ryan D. Lewis' },
  locationCreated: photo.location,
  copyrightHolder: { '@type': 'Person', name: 'Ryan D. Lewis' }
};
---
<Base
  title={photo.title}
  description={photo.shortDescription}
  socialImage={socialImage}
  socialImageAlt={photo.altText}
>
  <div class="page photo-page">
    <h1>{photo.title}</h1>
    <p class="lede">{photo.shortDescription}</p>
    <div class="photo-context-share-row">
      <p class="photo-context-line">{photo.contextLine}</p>
      <ShareControls title={photo.title} url={canonical} />
    </div>

    <div class:list={['photo-artwork-stage', `photo-artwork-${orientationClass}`]}>
      <a
        class="photo-artwork-link"
        href={photo.wallArtUrl}
        data-store-item-type="wall_art"
        data-store-item-slug={photo.slug}
        aria-label={`Shop wall art for ${photo.title} in the Red River Gorge Hiker Store`}
      >
        <Artwork
          title={photo.title}
          catalogId={photo.catalogId}
          alt={photo.altText}
          sizes={imageSizes}
          showCaption={false}
        />
      </a>
    </div>

    <div class="split content-split">
      <section class="prose">
        <h2>The story behind the photograph</h2>
        {splatterReference && splatterStoryParts.length > 1 ? (
          <p>
            {splatterStoryParts[0]}
            <a
              class="reference-link"
              href={splatterReference.url}
              target="_blank"
              rel="noopener noreferrer"
            >{splatterReference.label}</a>
            {splatterStoryParts.slice(1).join(splatterReference.label)}
          </p>
        ) : (
          <p>{photo.story}</p>
        )}
        <dl class="details">
          <div><dt>Photographed</dt><dd>{photo.captureDate}</dd></div>
          <div><dt>Location</dt><dd>{photo.location}</dd></div>
        </dl>
        <p>Photographs © Ryan D. Lewis. All rights reserved.</p>
      </section>

      <aside class="purchase-panel" aria-label="Available products">
        <section>
          <h2>Available as wall art</h2>
          <p>View available sizes and wall-art formats in the Red River Gorge Hiker Store. Store orders are produced and fulfilled by Pixels.</p>
          <a class="button" href={photo.wallArtUrl} data-store-item-type="wall_art" data-store-item-slug={photo.slug}>
            Shop Wall Art
          </a>
        </section>

        {photo.puzzleAvailable && photo.puzzleUrl && (
          <section class="puzzle-panel">
            <h2>Available as a 500-piece puzzle</h2>
            <p>This photograph is available as an 18 × 24-inch horizontal puzzle with 500 pieces. The current customer price is $59.99 before shipping and tax.</p>
            <a class="button secondary" href={`${base}puzzles/${photo.slug}/`}>
              View this puzzle
            </a>
          </section>
        )}
      </aside>
    </div>

    <nav class="photo-nav" aria-label="Photograph navigation">
      <a href={`${base}photographs/${prev.slug}/`}>← {prev.title}</a>
      <a href={`${base}photographs/${next.slug}/`}>{next.title} →</a>
    </nav>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(artworkSchema)} />
  </div>
</Base>
