---
import Base from '../../layouts/Base.astro'; import Artwork from '../../components/Artwork.astro'; import {photographs,type Photograph} from '../../data/products';
export function getStaticPaths(){return photographs.map((photo,index)=>({params:{slug:photo.slug},props:{photo,index}}));}
interface Props{photo:Photograph;index:number} const {photo,index}=Astro.props; const base=import.meta.env.BASE_URL; const prev=photographs[(index-1+photographs.length)%photographs.length]!; const next=photographs[(index+1)%photographs.length]!;
const artworkSchema={'@context':'https://schema.org','@type':'VisualArtwork',name:photo.title,identifier:photo.catalogId,creator:{'@type':'Person',name:'Ryan D. Lewis'},locationCreated:photo.location,copyrightHolder:{'@type':'Person',name:'Ryan D. Lewis'}};
---
<Base title={photo.title} description={`${photo.title}, ${photo.catalogId}, photographed by Ryan D. Lewis in the Red River Gorge.`}><div class="page"><p class="eyebrow">{photo.catalogId}</p><h1>{photo.title}</h1><p>{photo.location}</p><Artwork title={photo.title} catalogId={photo.catalogId}/><div class="split"><section><h2>The photograph</h2><div class="notice"><strong>Approved story and alt text pending.</strong> The Google Drive content master and Photography Catalog were unavailable, so no story or descriptive details have been invented.</div><p>Photography by Ryan D. Lewis</p><p>Photographs © Ryan D. Lewis. All rights reserved. Red River Gorge Hiker is the public photography brand.</p></section><aside><a class="button" href={photo.wallArtUrl} target="_blank" rel="noopener noreferrer">View Wall Art Options <span class="sr-only">on Fine Art America (opens in a new tab)</span></a>{photo.puzzleAvailable&&<a class="button secondary" href={photo.puzzleUrl} target="_blank" rel="noopener noreferrer">View This Puzzle <span class="sr-only">on Fine Art America (opens in a new tab)</span></a>}</aside></div><nav class="photo-nav" aria-label="Photograph navigation"><a href={`${base}photographs/${prev.slug}/`}>← {prev.title}</a><a href={`${base}photographs/${next.slug}/`}>{next.title} →</a></nav><script type="application/ld+json" set:html={JSON.stringify(artworkSchema)}/></div></Base>
