---
import Base from '../layouts/Base.astro';
import Artwork from '../components/Artwork.astro';
import Card from '../components/Card.astro';
import { photographs } from '../data/products';

const base = import.meta.env.BASE_URL;
const featuredPhotograph = photographs[0];

if (!featuredPhotograph) {
  throw new Error('The launch collection requires at least one photograph.');
}
---
<Base
  title="Photography from Kentucky’s Red River Gorge"
  description="Landscape photography and stories from Kentucky’s Red River Gorge and Clifty Wilderness by Ryan D. Lewis."
>
  <section class="home-hero">
    <div class="home-hero-media">
      <Artwork
        title={featuredPhotograph.title}
        catalogId={featuredPhotograph.catalogId}
        alt={featuredPhotograph.altText}
        sizes="(max-width: 1180px) calc(100vw - 3rem), 1180px"
        eager
      />
    </div>
    <div class="home-hero-copy">
      <p class="eyebrow">Red River Gorge Hiker</p>
      <h1>Photography from Kentucky’s Red River Gorge</h1>
      <p class="lede">Landscape photographs by Ryan D. Lewis, made while hiking, backpacking, camping, and exploring the Red River Gorge and Clifty Wilderness.</p>
      <div class="actions">
        <a class="button" href={`${base}collection/`}>View the collection</a>
        <a class="text-link" href={`${base}photographs/double-rainbow-at-eagles-point-buttress/`}>Read the story behind the rainbow</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-intro">
      <p class="eyebrow">The launch collection</p>
      <h2>Six photographs from the Gorge</h2>
      <p>Rainbows, winter arches, sunrise, waterfalls, and ice—six photographs, each with the story and circumstances behind it.</p>
    </div>
    <div class="grid collection-grid">
      {photographs.map((photo) => <Card photo={photo} />)}
    </div>
  </section>

  <section class="section feature-grid">
    <article>
      <p class="eyebrow">Prints</p>
      <h2>Fine-art prints</h2>
      <p>All six launch photographs are available in selected wall-art formats through Fine Art America, which handles ordering, production, and shipping.</p>
      <a href={`${base}prints/`}>View prints</a>
    </article>
    <article>
      <p class="eyebrow">Puzzles</p>
      <h2>Three selected puzzles</h2>
      <p>Winter at Red-byrd Arch, Sunrise at Eagle’s Nest, and Ice at West of Copperas Pillar are available as 18 × 24-inch, 500-piece puzzles.</p>
      <a href={`${base}puzzles/`}>View puzzles</a>
    </article>
    <article>
      <p class="eyebrow">Stories</p>
      <h2>More than the photograph</h2>
      <p>The collection is rooted in the days that produced the images—storms clearing, winter travel, remote waterfall exploration, and changing light.</p>
      <a href={`${base}exploring-the-gorge/`}>Read the stories</a>
    </article>
    <article>
      <p class="eyebrow">About</p>
      <h2>Ryan D. Lewis</h2>
      <p>Ryan is an explorer and photographer whose work centers on Kentucky’s Red River Gorge and Clifty Wilderness.</p>
      <a href={`${base}about/`}>About Ryan</a>
    </article>
  </section>
</Base>
