---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { photographs } from '../data/products';
import { merchandiseProducts } from '../data/merchandise';
import '../styles/home-brand.css';

const base = import.meta.env.BASE_URL;
const featuredGear = merchandiseProducts.find((product) => product.slug === 'sticker');
if (!featuredGear) throw new Error('Featured Gear product is missing from the controlled merchandise data.');
---
<Base
  title="Red River Gorge Hiker"
  titleTag="Red River Gorge Hiker | Photography, Gear & Stories from Kentucky’s Red River Gorge"
  description="Photography, gear, and stories rooted in Kentucky’s Red River Gorge — created by Ryan D. Lewis and proudly supporting Wolfe County Search & Rescue."
>
  <section class="home-brand-hero">
    <div class="home-brand-copy">
      <p class="eyebrow">Kentucky’s Red River Gorge</p>
      <h1>Red River Gorge Hiker</h1>
      <p class="lede">Photography, gear, and stories rooted in Kentucky’s Red River Gorge — created by Ryan D. Lewis and proudly supporting Wolfe County Search &amp; Rescue.</p>
      <div class="actions">
        <a class="button" href={`${base}gear/`}>Shop Gear</a>
        <a class="button secondary" href={`${base}collection/`}>Explore Photography</a>
        <a class="text-link" href={`${base}search-and-rescue/`}>How We Support SAR</a>
      </div>
    </div>

    <article class="featured-sticker">
      <a class="featured-sticker-image" href={`${base}gear/${featuredGear.slug}/`} aria-label={`View ${featuredGear.title}`}>
        <img
          src={`${base}${featuredGear.image.avif}`}
          width={featuredGear.image.width}
          height={featuredGear.image.height}
          alt={featuredGear.image.alt}
          loading="eager"
          fetchpriority="high"
        />
      </a>
      <div>
        <p class="eyebrow">Featured Gear</p>
        <h2>Red River Gorge Hiker {featuredGear.title}</h2>
        <p><strong>{featuredGear.priceLabel}</strong> · {featuredGear.specification}</p>
        <p>{featuredGear.description}</p>
        <div class="actions">
          <a class="button" href={`${base}gear/${featuredGear.slug}/`}>View {featuredGear.title}</a>
          <a class="text-link" href={`${base}gear/`}>Browse all Gear</a>
        </div>
      </div>
    </article>
  </section>

  <section class="section home-collection-section">
    <div class="section-intro">
      <p class="eyebrow">Original photography</p>
      <h2>Ryan D. Lewis’s Red River Gorge photography</h2>
      <p>Ryan’s photographs come from time spent hiking, backpacking, camping, and exploring the Red River Gorge and Clifty Wilderness.</p>
      <a class="text-link" href={`${base}collection/`}>Explore the photography collection →</a>
    </div>
    <div class="grid collection-mosaic home-collection-mosaic">
      {photographs.map((photo, index) => <Card photo={photo} featured={index === 0} />)}
    </div>
  </section>

  <section class="section feature-grid home-feature-grid">
    <article>
      <p class="eyebrow">Community support</p>
      <h2>Proud support for Wolfe County Search &amp; Rescue</h2>
      <p>Red River Gorge Hiker supports Wolfe County Search &amp; Rescue independently. This is not a partnership, sponsorship, endorsement, or commercial arrangement.</p>
      <a href={`${base}search-and-rescue/`}>How We Support SAR</a>
    </article>
    <article>
      <p class="eyebrow">Stories &amp; exploration</p>
      <h2>Stories from the Gorge</h2>
      <p>The photographs are rooted in the days that produced them — storms clearing, winter travel, waterfalls, and changing light.</p>
      <a href={`${base}exploring-the-gorge/`}>Read the stories</a>
    </article>
    <article>
      <p class="eyebrow">Photography products</p>
      <h2>Prints &amp; puzzles</h2>
      <p>Original photographs are available in selected wall-art formats, with three photographs also offered as 500-piece jigsaw puzzles.</p>
      <div class="simple-links"><a href={`${base}prints/`}>View prints</a><a href={`${base}puzzles/`}>View puzzles</a></div>
    </article>
    <article>
      <p class="eyebrow">Behind the brand</p>
      <h2>About Ryan</h2>
      <p>Ryan D. Lewis is an explorer and photographer whose work centers on Kentucky’s Red River Gorge and Clifty Wilderness.</p>
      <a href={`${base}about/`}>About Ryan</a>
    </article>
  </section>
</Base>
