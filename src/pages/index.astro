---
import Base from '../layouts/Base.astro'; import Artwork from '../components/Artwork.astro'; import Card from '../components/Card.astro'; import {photographs} from '../data/products'; const base=import.meta.env.BASE_URL;
---
<Base title="Kentucky landscape photography" description="A quiet field journal and fine-art photography collection from Kentucky’s Red River Gorge by Ryan D. Lewis."><section class="hero"><div class="hero-copy"><p class="eyebrow">Clifty Wilderness · Kentucky</p><h1>Red River Gorge Hiker</h1><p class="lede">Photography by Ryan D. Lewis</p><p>A regional photography collection shaped by time spent exploring the Red River Gorge.</p></div><Artwork title={photographs[0].title} catalogId={photographs[0].catalogId} eager /></section><section class="collection"><p class="eyebrow">Launch collection</p><h2>Six photographs from the Gorge</h2><div class="grid">{photographs.map(photo=><Card photo={photo}/>)}</div><p><a class="button" href={`${base}collection/`}>View the collection</a></p></section><section class="collection split"><div><h2>Prints and puzzles</h2><p>Explore wall-art options fulfilled by Fine Art America, or see the three approved 500-piece puzzles.</p><a href={`${base}prints/`}>Prints</a> · <a href={`${base}puzzles/`}>Puzzles</a></div><div><h2>Field stories</h2><p>Editorial notes about exploring the Gorge—with sensitive places and unsafe route details left out.</p><a href={`${base}exploring-the-gorge/`}>Read Stories</a></div><div><h2>About</h2><p>Red River Gorge Hiker is the public photography brand of Ryan D. Lewis.</p><a href={`${base}about/`}>About the work</a></div><div><h2>Displays and partners</h2><p>Updates on approved community displays and potential local arrangements.</p><a href={`${base}displays-and-partners/`}>Current status</a></div></section></Base>
