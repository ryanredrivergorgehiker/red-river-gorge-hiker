---
import Base from '../layouts/Base.astro';
import '../styles/home-brand.css';
const base = import.meta.env.BASE_URL;
---
<Base title="Red River Gorge Hiker" titleTag="Red River Gorge Hiker | Photography, Gear & Stories from Kentucky’s Red River Gorge" description="Photography, gear, and stories rooted in Kentucky’s Red River Gorge — created by Ryan D. Lewis and proudly supporting Wolfe County Search & Rescue.">
  <section class="home-brand-hero">
    <div class="home-brand-copy">
      <p class="eyebrow">Kentucky’s Red River Gorge</p>
      <h1>Red River Gorge Hiker</h1>
      <p class="lede">Photography, gear, and stories rooted in Kentucky’s Red River Gorge — created by Ryan D. Lewis and proudly supporting Wolfe County Search &amp; Rescue.</p>
      <div class="actions">
        <a class="button" href={`${base}gear/`}>Shop Gear</a>
        <a class="button secondary" href={`${base}collection/`}>Explore Photography</a>
        <a class="text-link" href={`${base}search-and-rescue/`}>How We Support SAR</a>
      </div>
    </div>
    <article class="featured-sticker">
      <a href={`${base}gear/sticker/`}>
        <img src={`${base}assets/merchandise/rrgh-merch-sticker-218cc04a.avif`} width="983" height="1000" alt="Red River Gorge Hiker logo sticker applied to the rear of a vehicle." loading="eager" />
      </a>
      <div>
        <p class="eyebrow">Featured Gear</p>
        <h2>Red River Gorge Hiker Sticker</h2>
        <p>3 × 3 inches · $3.50</p>
        <a class="button" href={`${base}gear/sticker/`}>View Sticker</a>
      </div>
    </article>
  </section>
</Base>
