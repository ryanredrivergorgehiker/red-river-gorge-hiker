---
import Base from '../layouts/Base.astro';
import Artwork from '../components/Artwork.astro';
import Card from '../components/Card.astro';
import { photographs } from '../data/products';
import { merchandiseProducts } from '../data/merchandise';
import '../styles/home-brand.css';
const base=import.meta.env.BASE_URL;
const heroPhoto=photographs.find((p)=>p.slug==='double-rainbow-at-eagles-point-buttress');
const featuredGear=merchandiseProducts.find((p)=>p.slug==='sticker');
if(!heroPhoto) throw new Error('Homepage hero photograph missing.');
if(!featuredGear) throw new Error('Featured Gear product missing.');
---
<Base title="Red River Gorge Hiker" titleTag="Red River Gorge Hiker | Photography, Gear & Stories from Kentucky’s Red River Gorge" description="Photography, gear, and stories rooted in Kentucky’s Red River Gorge, with original imagery from the Gorge and Clifty Wilderness and proud support for Wolfe County Search & Rescue.">
<section class="home-emotional-hero" aria-labelledby="home-title">
<a class="hero-photo-link" href={`${base}photographs/${heroPhoto.slug}/`} aria-label={`Explore ${heroPhoto.title}`}><div class="hero-artwork"><Artwork title={heroPhoto.title} catalogId={heroPhoto.catalogId} alt={heroPhoto.altText} eager={true} sizes="(max-width: 700px) 100vw, (max-width: 1440px) 100vw, 1440px" showCaption={false}/></div></a>
<div class="home-identity-copy"><h1 id="home-title">Red River Gorge Hiker</h1><p class="home-identity-line">For the people who hike it, love it, and keep coming back.</p><div class="actions home-hero-actions"><a class="button" href={`${base}gear/`}>Shop Gear</a><a class="button secondary" href={`${base}collection/`}>Explore Photography</a><a class="text-link" href={`${base}search-and-rescue/`}>How We Support SAR</a></div></div>
</section>
<section class="section featured-gear-section">
<div class="featured-gear-copy"><p class="eyebrow">Featured Gear</p><h2>A simple way to say it.</h2><p class="featured-identity-line">I’m a Red River Gorge hiker.</p><h3>Red River Gorge Hiker {featuredGear.title}</h3><p class="featured-gear-meta"><strong>{featuredGear.priceLabel}</strong> · {featuredGear.specification}</p><p class="featured-gear-description">{featuredGear.description}</p><div class="actions"><a class="button" href={`${base}gear/${featuredGear.slug}/`}>Get the Sticker</a><a class="button secondary" href={`${base}gear/`}>Shop All Gear</a></div></div>
<a class="featured-gear-image" href={`${base}gear/${featuredGear.slug}/`} aria-label={`View ${featuredGear.title}`}><img src={`${base}${featuredGear.image.avif}`} width={featuredGear.image.width} height={featuredGear.image.height} alt={featuredGear.image.alt} loading="lazy"/></a>
</section>
<section class="section home-collection-section"><div class="section-intro home-photography-intro"><p class="eyebrow">Original photography</p><h2>The Red River Gorge, captured.</h2><p>Original photography from the Gorge and Clifty Wilderness.</p><a class="text-link" href={`${base}collection/`}>Explore the Photography →</a></div><div class="grid collection-mosaic home-collection-mosaic">{photographs.map((photo,index)=><Card photo={photo} featured={index===0} showDescription={false}/>)}</div></section>
<section class="section home-sar-section"><p class="eyebrow">Community purpose</p><h2>Proudly supporting Wolfe County Search &amp; Rescue.</h2><p>Learn about Red River Gorge Hiker’s independent support and Gorge safety resources.</p><a class="button secondary" href={`${base}search-and-rescue/`}>How We Support SAR</a></section>
<section class="section home-discovery-section"><div class="section-intro"><p class="eyebrow">Keep exploring</p><h2>More from the Gorge.</h2></div><div class="home-discovery-grid"><article><h3>Stories from the Gorge</h3><p>Field notes, changing weather, winter travel, waterfalls, and the moments behind the photographs.</p><a href={`${base}exploring-the-gorge/`}>Read the Stories</a></article><article><h3>Prints</h3><p>Bring an original Red River Gorge photograph into your own space.</p><a href={`${base}prints/`}>View Prints</a></article><article><h3>Puzzles</h3><p>Selected Gorge photographs are also available as 500-piece jigsaw puzzles.</p><a href={`${base}puzzles/`}>View Puzzles</a></article></div></section>
</Base>
