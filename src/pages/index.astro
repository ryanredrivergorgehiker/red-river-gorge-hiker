---
import Base from '../layouts/Base.astro';
import Artwork from '../components/Artwork.astro';
import Card from '../components/Card.astro';
import { photographs } from '../data/products';
import { merchandiseProducts } from '../data/merchandise';
import '../styles/home-brand.css';

const base = import.meta.env.BASE_URL;
const heroPhoto = photographs.find((photo) => photo.slug === 'double-rainbow-at-eagles-point-buttress');
const featuredGear = merchandiseProducts.find((product) => product.slug === 'sticker');

if (!heroPhoto) throw new Error('Homepage hero photograph missing.');
if (!featuredGear) throw new Error('Featured Gear product missing.');

const homepagePhotographs = photographs.filter((photo) => photo.slug !== heroPhoto.slug);
---
<Base
  title="Red River Gorge Hiker"
  titleTag="Red River Gorge Hiker | Photography, Gear & Stories from Kentucky’s Red River Gorge"
  description="Photography, gear, and stories rooted in Kentucky’s Red River Gorge, with original imagery from the Gorge and Clifty Wilderness and proud support for Wolfe County Search & Rescue."
>
  <div class="home-panorama-wrap">
    <section class="home-panorama-hero" aria-labelledby="home-title">
      <div class="home-panorama-media" aria-hidden="true">
        <Artwork
          title={heroPhoto.title}
          catalogId={heroPhoto.catalogId}
          alt=""
          eager={true}
          sizes="100vw"
          showCaption={false}
        />
      </div>
      <div class="home-panorama-shade" aria-hidden="true"></div>
      <div class="home-panorama-content">
        <p class="home-panorama-eyebrow">Kentucky’s Red River Gorge</p>
        <h1 id="home-title">Red River Gorge Hiker</h1>
        <p class="home-panorama-primary">For the people who hike it, love it, and keep coming back.</p>
        <p class="home-panorama-supporting">Gear, original photography, stories, and proud support for Wolfe County Search &amp; Rescue.</p>
        <div class="home-panorama-actions">
          <a class="home-hero-button home-hero-button-primary" href={`${base}gear/`}>Shop Gear</a>
          <a class="home-hero-button home-hero-button-light" href={`${base}collection/`}>Explore Photography</a>
        </div>
        <a class="home-panorama-support-link" href={`${base}search-and-rescue/`}>How We Support SAR →</a>
      </div>
    </section>
  </div>

  <section class="section featured-sticker">
    <a href={`${base}gear/${featuredGear.slug}/`} aria-label={`View ${featuredGear.title}`}>
      <img
        src={`${base}${featuredGear.image.avif}`}
        width={featuredGear.image.width}
        height={featuredGear.image.height}
        alt={featuredGear.image.alt}
        loading="lazy"
      />
    </a>
    <div>
      <p class="eyebrow">Featured Gear</p>
      <h2>A simple way to say it.</h2>
      <p class="lede">I’m a Red River Gorge hiker.</p>
      <h3>Red River Gorge Hiker {featuredGear.title}</h3>
      <p><strong>{featuredGear.priceLabel}</strong> · {featuredGear.specification}</p>
      <p>{featuredGear.description}</p>
      <div class="actions">
        <a class="button" href={`${base}gear/${featuredGear.slug}/`}>Get the Sticker</a>
        <a class="button secondary" href={`${base}gear/`}>Shop All Gear</a>
      </div>
    </div>
  </section>

  <section class="section home-collection-section">
    <div class="section-intro">
      <p class="eyebrow">Original photography</p>
      <h2>The Red River Gorge, captured.</h2>
      <p class="lede">Original photography from the Gorge and Clifty Wilderness.</p>
      <a class="text-link" href={`${base}collection/`}>Explore the Photography →</a>
    </div>
    <div class="grid home-mosaic">
      {homepagePhotographs.map((photo) => <Card photo={photo} showDescription={false} />)}
    </div>
  </section>

  <section class="section feature-grid home-feature-grid">
    <article>
      <p class="eyebrow">Stories &amp; exploration</p>
      <h2>Stories from the Gorge</h2>
      <p>Field notes, changing weather, winter travel, waterfalls, and the moments behind the photographs.</p>
      <a href={`${base}exploring-the-gorge/`}>Read the Stories</a>
    </article>
    <article>
      <p class="eyebrow">Photography products</p>
      <h2>Prints</h2>
      <p>Bring an original Red River Gorge photograph into your own space.</p>
      <a href={`${base}prints/`}>View Prints</a>
    </article>
    <article>
      <p class="eyebrow">Photography products</p>
      <h2>Puzzles</h2>
      <p>Selected Gorge photographs are also available as 500-piece jigsaw puzzles.</p>
      <a href={`${base}puzzles/`}>View Puzzles</a>
    </article>
    <article>
      <p class="eyebrow">Community purpose</p>
      <h2>Proudly supporting SAR</h2>
      <p>Learn how Red River Gorge Hiker supports local rescue and shares Gorge safety resources.</p>
      <a href={`${base}search-and-rescue/`}>How We Support SAR</a>
    </article>
  </section>
</Base>
