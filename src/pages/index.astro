---
import Base from '../layouts/Base.astro';
import Artwork from '../components/Artwork.astro';
import Card from '../components/Card.astro';
import { photographs } from '../data/products';

const base = import.meta.env.BASE_URL;
const featuredPhotograph = photographs[0];

if (!featuredPhotograph) {
  throw new Error('The collection requires at least one photograph.');
}
---
<Base
  title="Photography from Kentucky’s Red River Gorge"
  description="Landscape photography and stories from Kentucky’s Red River Gorge and Clifty Wilderness by Ryan D. Lewis."
>
  <section class="home-hero">
    <div class="home-hero-media">
      <a
        class="hero-link"
        href={`${base}photographs/${featuredPhotograph.slug}/`}
        aria-label={`Read the story behind ${featuredPhotograph.title}`}
      >
        <Artwork
          title={featuredPhotograph.title}
          catalogId={featuredPhotograph.catalogId}
          alt={featuredPhotograph.altText}
          sizes="(max-width: 1180px) calc(100vw - 3rem), 1180px"
          eager
        />
      </a>
    </div>
    <div class="home-hero-copy">
      <h1>Photography from Kentucky’s Red River Gorge</h1>
      <p class="lede">Landscape photographs by Ryan D. Lewis, made while hiking, backpacking, camping, and exploring the Red River Gorge and Clifty Wilderness.</p>
      <div class="actions">
        <a class="button" href={`${base}collection/`}>View the collection</a>
        <a class="text-link" href={`${base}photographs/double-rainbow-at-eagles-point-buttress/`}>Read the story behind the rainbow</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-intro">
      <h2>The collection</h2>
      <p>Six photographs from the Red River Gorge and Clifty Wilderness, each with its own story and available print options.</p>
    </div>
    <div class="grid collection-mosaic home-collection-mosaic">
      {photographs.map((photo, index) => <Card photo={photo} featured={index === 0} />)}
    </div>
  </section>

  <section class="section feature-grid">
    <article>
      <h2>Fine-art prints</h2>
      <p>All six photographs are available in selected wall-art formats through Fine Art America, which handles ordering, production, and shipping.</p>
      <a href={`${base}prints/`}>View prints</a>
    </article>
    <article>
      <h2>Jigsaw puzzles</h2>
      <p>Winter at Red-byrd Arch, Sunrise at Eagle’s Nest, and Ice at West of Copperas Pillar are available as 18 × 24-inch, 500-piece puzzles.</p>
      <a href={`${base}puzzles/`}>View puzzles</a>
    </article>
    <article>
      <h2>Stories behind the photographs</h2>
      <p>The photographs are rooted in the days that produced them—storms clearing, winter travel, remote waterfall exploration, and changing light.</p>
      <a href={`${base}exploring-the-gorge/`}>Read the stories</a>
    </article>
    <article>
      <h2>About Ryan</h2>
      <p>Ryan D. Lewis is an explorer and photographer whose work centers on Kentucky’s Red River Gorge and Clifty Wilderness.</p>
      <a href={`${base}about/`}>About Ryan</a>
    </article>
  </section>
</Base>
