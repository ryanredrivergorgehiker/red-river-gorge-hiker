---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RouteMap from '../../components/RouteMap.astro';
import '../../styles/routes.css';

const entries = await getCollection('routes');
const base = import.meta.env.BASE_URL;
const routes = entries.map((entry) => ({
  routeId: entry.data.routeId,
  slug: entry.id,
  title: entry.data.title,
  tripType: entry.data.tripType,
  trailStatus: entry.data.trailStatus,
  publicationClass: entry.data.publicationClass,
  geometryUrl: base + entry.data.webGeometry.publicPath.replace(/^\//, '')
}));
---
<Base
  title="Interactive Hikes & Routes Map"
  titleTag="Interactive Hikes & Routes Map | Red River Gorge Hiker"
  description="Interactive Red River Gorge planning map with RRGH routes, Forest Service trails and roads, county boundaries, Kentucky topo, LiDAR hillshade, aerial imagery, USGS topo, distance measurement, and trail-snapped planning."
  canonicalPath="/routes/map/"
>
  <div class="page route-page route-map-page">
    <p class="eyebrow">Explore the Gorge</p>
    <h1>Interactive Hikes &amp; Routes Map</h1>
    <p class="route-lede">
      Build the map you want: stack topo, aerial, LiDAR, trails, roads, counties, RRGH routes, and landmarks; change each layer’s opacity; measure freehand distance; or click visible trails to build a snapped route plan.
    </p>
    <p><a class="route-text-link" href={base + 'routes/'}>Browse route guides →</a></p>
    <RouteMap routes={routes} mode="full" />
  </div>
</Base>
