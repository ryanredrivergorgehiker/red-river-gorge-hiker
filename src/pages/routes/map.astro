---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RouteMap from '../../components/RouteMap.astro';
import '../../styles/routes.css';

const entries = await getCollection('routes');
const base = import.meta.env.BASE_URL;
const routes = entries.map((entry) => ({
  routeId: entry.data.routeId,
  slug: entry.id,
  title: entry.data.title,
  tripType: entry.data.tripType,
  trailStatus: entry.data.trailStatus,
  publicationClass: entry.data.publicationClass,
  geometryUrl: base + entry.data.webGeometry.publicPath.replace(/^\//, '')
}));
---
<Base
  title="Interactive Hikes & Routes Map"
  titleTag="Interactive Hikes & Routes Map | Red River Gorge Hiker"
  description="Interactive Red River Gorge planning map with route-type filters, RRGH routes, Forest Service trails and roads, county boundaries, Kentucky topo, LiDAR hillshade, aerial imagery, USGS topo, straight-line measurement, trail-following planning, and GPX export."
  canonicalPath="/routes/map/"
>
  <div class="page route-page route-map-page">
    <header class="route-map-page-header">
      <div class="route-map-page-title">
        <p class="eyebrow">Explore the Gorge</p>
        <h1>Interactive Hikes &amp; Routes Map</h1>
      </div>
      <div class="route-map-page-intro">
        <p>
          Start with a clean view or a more detailed terrain view, then adjust any layer yourself.
          Filter RRGH routes by trip type, measure direct point-to-point distance, or build a route that follows the available trail network and save it as GPX.
        </p>
        <a class="route-text-link" href={base + 'routes/'}>Browse route guides →</a>
      </div>
    </header>
    <RouteMap routes={routes} mode="full" />
  </div>
</Base>
