---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { photographs } from '../data/products';
---
<Base
  title="The Launch Collection"
  description="Six photographs made in Kentucky’s Red River Gorge and Clifty Wilderness by Ryan D. Lewis."
>
  <div class="page">
    <p class="eyebrow">Red River Gorge Hiker</p>
    <h1>The Launch Collection</h1>
    <div class="prose-wide">
      <p class="lede">Six photographs made in Kentucky’s Red River Gorge and Clifty Wilderness, presented in the launch order selected by Ryan D. Lewis.</p>
      <p>Open any photograph to see the full image, its story, capture details, and available print or puzzle options.</p>
    </div>
    <div class="grid collection-grid">
      {photographs.map((photo) => <Card photo={photo} />)}
    </div>
  </div>
</Base>
