---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { photographs } from '../data/products';
---
<Base
  title="The Launch Collection"
  description="Six photographs made in Kentucky’s Red River Gorge and Clifty Wilderness by Ryan D. Lewis."
>
  <div class="page">
    <p class="eyebrow">Red River Gorge Hiker</p>
    <h1>The Launch Collection</h1>
    <div class="prose-wide">
      <p class="lede">The first Red River Gorge Hiker collection brings together six photographs made in the Red River Gorge and Clifty Wilderness. The sequence moves from a signature summer panorama through winter arches, sunrise, waterfalls, and extensive ice, ending with the story of a remote cascade Ryan discovered and documented.</p>
      <p>Each photograph has its own page with the approved story, location wording, environmental context, wall-art link, copyright notice, and related work.</p>
    </div>
    <div class="grid collection-grid">
      {photographs.map((photo) => <Card photo={photo} />)}
    </div>
  </div>
</Base>
